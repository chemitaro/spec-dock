package spec

// 要件（Issue）。型 specdock/v1。

schema: "specdock/v1"

assurance: {
	level:  "standard"
	reason: "表示を足すだけで、エージェントへの操作やデータの書き込みはなく、PR を戻せば元に戻る"
}

purpose: """
	リポジトリの構造の図（`/r/<repo>/graph`）の上に、Orca の指揮の関係（親のエージェント → 子のエージェント）を、親の印から子の印への黄色の動く線で出し、
	箱を持たない親と子を、すべての Initiative の上の『指揮の帯』に出す。Epic epic-00615 の中心の機能（slice `iss-00616`）。
	"""

background: """
	正本は Epic epic-00615 の requirement.cue（R-01〜R-09、F-01〜F-05）と design.cue（D-02〜D-05、D-07、D-10）。この Issue は、その要件を、今の main の実際の形に合わせて満たす。
	前提はすべて main に入った（2026-11-17、統括の依頼書）：orca-web iss-00043（要約の `agents[].parent {id, worktreeId}`・`agents[].startedAt`・`worktrees[].main`、部品の `orderAgents` と `buildMarks` の並び、印の `data-agent-id`）、
	SpecDock iss-00620（稼働の印の専用の行 `.gx-agents`、`markRows`・`nodeMarkRows`・`MARK_ROW`・`MARK_INSET`、測った幅 `V.marks`）、iss-00621（`markIds`・`markAgentAt`・`openAgent`、枠の worktree の印）、
	iss-00627（縮めた枠の実寸 `heads`・`fit`、配置と実寸の一致）、iss-00614・iss-00629（`views/graph/draw.js` と『横断の構造』）。

	タスク担当が確かめた今の事実（2026-11-17、`3f5f8d8e9`）：
	- 手元の orca-web の要約は、spec-dock の Issue の worktree のエージェントに、main のチェックアウトの統括を指す `parent` を返す。同じ worktree の親子（タスク担当 → 実装担当）もある。
	- Issue の箱（`.gx-box`、高さは配置が決める）の中身は上から流れるので、題名が1行の箱と2行の箱で、稼働の印の行の縦の位置が違う（題名の行の数は DOM でしか分からない）。
	- 入れ子の枠の見出しの印の行は、見出しの題名の行（高さ 22px。縮めた Epic の枠で題名が2行なら、iss-00627 の `fit` の分だけ高い）の下にある。
	- 構造の図の凡例は `draw.js` の `renderLegend` で、『横断の構造』と共有している。
	"""

includes: [
	"純粋な計算 `views/graph/command.js`（組、居場所、帯の項目と寸法、端、三次ベジェ、同じ箱の弧、波紋、`cmdAudit`）と、印の位置 `markSpots`（`layout.js`、`markRows` と同じ詰め）",
	"構造の図の、世界の中の指揮の層（線の本体・下地の光）、端の層（箱の中の短い線・端の点・波紋）、『指揮の帯』",
	"点の流れ・止まった点線・薄い線、波紋、減らす設定、指揮の色の札（明・暗・明示の暗）、凡例の行",
	"印（箱・枠の見出し・帯）を押したときの線の目立たせと、帯のエージェントの詳細の欄のチャット",
	"箱の印の行を箱の下の内側の縁に寄せる CSS（統括の了承、2026-11-17）",
	"『収める』と初めの見え方に帯を含めること、390px",
	"実機の確かめ用の検査 `window.specdockCmdAudit`（`cmdAudit` と、`markSpots` と描いた印の差）",
]

excludes: [
	"『横断の構造』への適用（iss-00617）。`allgraph.js` と `allgraph/compose.js` は変えない（共有の部品の既定の動きは変えない）",
	"orca-web の変更、SpecDock のサーバー・API・保存の変更",
	"線そのものを押す操作、線の表示を切り替えるボタン、キーボードで箱の中の個々の印を選ぶこと（Epic の excludes のまま）",
	"依存の線の道（`router.js`）と `specdockEdgeAudit` の中身の変更",
]

requirements: {
	"R-01": {
		title: "要約の指揮の親で組を作り、居場所を決める（Epic R-01・R-02）"
		text: """
			Epic R-01・R-02 のとおり。組は `parent.id` が同じ要約の別のエージェントの `id` を指すものだけ。居場所は、Scope の箱・枠の印 → 畳んだ塊 → いちばん近い描かれた祖先の枠 → 帯、の順。
			リポジトリの構造の図には、少なくとも一方の端がこのリポジトリの worktree にいる組だけを出す。
			「このリポジトリの worktree」は、構造の `worktrees.paths` にパスがある worktree と、それらと同じ `project.id` を持つ worktree（`matchWorktrees` と同じ判定）。
			"""
		acceptance: [
			"報告書の実データの形の合成の要約（5組、うち1組は別のリポジトリの統括、2組は同じ worktree の親子（Issue の worktree の中、main のチェックアウトの中））から、5組がそのまま得られる（node のテスト）",
			"`parent` のないエージェント、`parent.id` が null・要約にいない id・自分の id・文字列でない・`parent` が object でない、からは組ができず、輪があっても各組を1回だけ数えて止まる",
			"箱のある worktree の子の端が `mark`（その箱のその子の印）、『これから』で隠れた Issue の子の端が、いちばん近い描かれた祖先の枠（`frame`）、畳んだ塊に入った Scope の子の端が `group`、main のチェックアウトの統括の端が `band`",
			"両端ともほかのリポジトリにいる組が、組の結果に入らない",
		]
	}
	"R-02": {
		title: "『指揮の帯』を、すべての Initiative の上に、折り返さない1行で出す（Epic R-03）"
		text: """
			帯は世界の中のいちばん上にあり、図とともに拡大・移動する。帯の項目は worktree ごとで、札は、このリポジトリの main のチェックアウト（`main === true`）なら「main のチェックアウト」、このリポジトリのほかの worktree ならブランチ名、
			ほかのリポジトリなら「<project.name> · <branch>」（F-04 の札を含む）。項目の並びは、このリポジトリの main のチェックアウト → このリポジトリのほか（札の順）→ ほかのリポジトリ（札の順）。
			項目の中のエージェントは、その worktree の部品の並び（`orderAgents`）から帯に出すものだけを取り出した順で、各エージェントを今の稼働の印（部品の `renderAgentMarks`）で描いたボタンにする。
			組の端（R-01 で帯に決まったもの）だけを出す。帯に出すものがなければ、帯の要素はない。
			"""
		acceptance: [
			"spec-dock の実データの形の合成の入力で、帯に「main のチェックアウト」の項目が1つあり、統括と調べの担当の2人の印が並ぶ",
			"ほかのリポジトリの統括の札が「<project.name> · <branch>」、`branch` が null の札が「ブランチ不明」、ほかのリポジトリで `project` が null の札が「ほかのリポジトリ · <branch>」",
			"帯の項目の中のエージェントの並びが、その worktree の `orderAgents` の並びから、帯に出さないエージェントを除いた順と同じ",
			"組が1つもないとき、世界の中に帯・指揮の層・端の層の要素がなく、世界の HTML が今と同じ（今の golden と HTML の検査が通る）",
			"1440 と 390 の写しで、帯の項目が1行で、札が読める",
		]
	}
	"R-03": {
		title: "親の印から子の印へ、緩い三次ベジェで線を描き、同じ箱・帯の同じ項目の親子は外へふくらむ弧で結ぶ（Epic R-04）"
		text: """
			端が印なら、線はその印から出て、その印に入る。印の位置は DOM を測らず、配置の矩形、測った印の幅（iss-00620）、描いた並びの記録（iss-00621 の `markIds`）から求める。
			線の本体と下地の光は世界の中の指揮の層（枠の上・箱の下）、箱の中の短い線と端の点と波紋は端の層（箱・塊の上・依存の線の下）に描き、どちらも押せない。
			同じ箱・枠・帯の同じ項目の親子は、外へふくらむ弧で結ぶ。箱は Epic D-10 の弧（縁の選び、弦 40px 以上、ふくらみ `min(16, room − 3)`、浅くする・向きを変える、依存の線との重なり）、入れ子の枠の見出しは印の下から下へふくらむ弧、帯の項目は帯の上へふくらむ弧（decisions）。
			両端が同じ塊か同じ祖先の枠（どちらにも印がない）なら線を引かない。依存の線の道と edgeAudit に入らない。
			"""
		acceptance: [
			"指揮の層が枠の要素より後ろ・箱の要素より前、端の層が塊の要素より後ろ・依存の線の SVG より前にあり（重なりの順）、どちらも `pointer-events: none`",
			"線があっても、`specdockEdgeAudit()` の違反の数が線のないときと同じ（0）",
			"`markSpots` の各印の矩形と、描いた `.orca-mark` の位置（箱の要素までの offset の和）の差、帯の各ボタンの計算と描いた位置の差が、実機の写しのすべてで 1px 以内（`specdockCmdAudit().spotDrift`）",
			"同じ箱の同じ行の2人・違う行の2人の組、入れ子の枠の見出しの2人の組、帯の同じ項目の2人の組に、それぞれ弧があり、弦が 40px 以上で、`cmdAudit` の `boxOverlaps` と `edgeOverlaps` が 0（node のテストと実機）",
			"作業中の Epic の枠の見出しの統括の印から、枠の中の Issue の箱の子の印へ線が出て、その線が枠の上の縁より上へ出ない（node のテスト）",
		]
	}
	"R-04": {
		title: "子の状態で線の動きを変え、親の端に波紋を出し、減らす設定で止める（Epic R-05）"
		text: "子の印が working（monitoring を含む）なら点が親から子へ流れ、waiting・blocked・sleeping・unknown なら止まった点線、done なら薄い動かない線。親の端に波紋。動きは CSS の stroke-dashoffset と transform・opacity だけ。`prefers-reduced-motion: reduce` では点は止まり、波紋は動かない1つの輪。"
		acceptance: [
			"working の子への線だけに点の流れのアニメーション（どの線でも端から端まで 2.5 秒）があり、waiting の子への線は止まった点線、done の子への線は薄い止まった線（node のテストで `state`、CSS の静的な検査で規則、実機の写し）",
			"減らす設定の写しで、アニメーションが動かず（`getAnimations()` が空か止まっている）、波紋の輪が1つ",
			"`graph.css` の指揮の規則（D-05 の範囲）に、SVG の `<animate>`・`animateMotion`・canvas・`filter: blur` がない",
		]
	}
	"R-05": {
		title: "指揮の色の札を定め、凡例に足す（Epic R-06）"
		text: """
			`--sd-cmd`（線）と `--sd-cmd-glow`（下地の光）を、`app.css` の明るいテーマ・暗いテーマ（`prefers-color-scheme: dark`）・明示の暗いテーマ（`[data-theme="dark"]`）の3か所に定める。
			値は D-05 のとおり（明 #8a8100、暗 #fff04d）。構造の図の凡例の『そのほか』に「指揮（親 → 子）」の行（線と波紋の見本）を、Orca との連携が有効な画面だけに足す。
			"""
		acceptance: [
			"3か所に `--sd-cmd` と `--sd-cmd-glow` があり、`--sd-cmd` の色相が `--sd-blocked` より黄の側に 10° 以上（明 56.1° と 39.3°、暗 54.9° と 43.4°）",
			"`--sd-cmd` と図の背景 `--ds-bg-2` のコントラストが、明 3:1 以上（3.75）、暗 3:1 以上（15.1）（テストで計算する）",
			"Orca との連携が有効な構造の図の凡例に「指揮（親 → 子）」の行があり、有効でない画面と『横断の構造』の凡例の HTML は今と同じ",
		]
	}
	"R-06": {
		title: "印を押すと線が目立ち、帯のエージェントは詳細の欄でチャットが開く（Epic R-07）"
		text: """
			構造の図の稼働の印（箱・枠の見出し・帯）を押すと、そのエージェントが親か子である線だけが目立ち、ほかの指揮の線は薄くなる。
			帯のエージェント（ボタン。キーボードの Enter・Space でも押せる）を押すと、Scope の選びを解き、構造の図の横の欄（スマホでは下からのシート）に、そのエージェントの見出しとチャット（`/embed/agent?id=…`、エージェントのタブと同じ `agentFrame` と sandbox）を開く。
			箱・枠の見出しの印は、今どおり（iss-00621）その Scope を選び、押したエージェントを選んだエージェントのタブを開く。
			もう一度同じ帯のエージェントを押す、欄を閉じる、Esc、図の空いたところを押す、印でないところで箱を選ぶ、のどれかで目立たせを解く。押したエージェントが要約から消えたら、目立たせを解き、帯の詳細の欄なら欄も閉じる。
			"""
		acceptance: [
			"帯の統括を押すと、その統括の線（指揮の層と端の層の両方の要素）と波紋だけに `is-cmd-hl`、ほかの線に `is-cmd-off` が付き、欄に `/embed/agent?id=<統括の id>` の iframe が開き、ボタンが `aria-pressed=\"true\"`",
			"箱の中の親の印を押すと、その親の線だけが目立ち、その箱の Scope の欄のエージェントのタブで、その親が選ばれている",
			"欄を閉じる・Esc・空いたところを押す、で目立たせが解ける。帯のボタンを Enter で押しても同じに開く。欄を開いたまま構造が描き直されても、チャットの iframe が作り直されない",
			"線の要素が押せない（`pointer-events: none`）",
		]
	}
	"R-07": {
		title: "線と帯はいつも出し、『収める』と初めの見え方に帯を含め、スマホでも出す（Epic R-08）"
		text: "Orca との連携が使え、組が1つ以上あれば、線と帯をいつも出す（切り替えのボタンを足さない）。1440・1000・390 の幅で、ページが横にはみ出さない。『収める』と初めの見え方の外接の四角に帯を含める。"
		acceptance: [
			"1440・1000・390 × 明・暗の写しで、線と帯が出て、ページに横のスクロールがない（`document.documentElement.scrollWidth <= innerWidth`）",
			"『収める』の後、帯の上の縁から図の下の縁までが図の領域に収まる",
		]
	}
	"R-08": {
		title: "要約が変わっても配置をやり直さず、帯の出入りで箱を動かさない（Epic R-09）"
		text: """
			線と帯の計算は今の要約の購読に乗り、新しい読み取りを足さない。印の行の数が変わらない要約の更新では配置（`routeLayout`）をやり直さず、線と帯だけを計算し直す。
			入力（要約、配置、印の幅と並び）が同じなら、指揮の層を描き直さない（点の流れが跳ねない）。帯が出たり消えたりしても、図の箱と枠は画面の上で動かない。
			"""
		acceptance: [
			"印の行の数が変わらない要約の更新（組の増減、子の状態の変化）で、`routeLayout` を呼ぶ回数が増えない（画面の node の試しで数える）",
			"同じ入力の2回目の描き直しで、指揮の層の要素が置き換わらない（同じ要素のまま）",
			"帯が出た更新の前後で、同じ箱の画面の上の位置（`getBoundingClientRect`）が変わらない（画面の node の試しか実機）",
		]
	}
}

