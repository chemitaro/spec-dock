package spec

// 設計（Issue）。型 specdock/v1。

goals: [
	"広げの要求を、実際に足りない1つの通り道について、その通り道に閉じた線分の鎖から見積もる",
	"寄せの位置の決め方（並びの順、詰め、中央への寄せ）は、動かない線分との前後のほかは変えない",
]

current: """
	router.js の nudgePass は、同じ向きの線分を、重なりうる組（conf）の union-find で束にし、束ごとに並びの順
	（交差の少ない前後の位相順）で手前から詰める。束の中で、ある線分の詰めの位置が望む範囲の上端を超えた最大の量を
	over とし、束の中の動く線分のうち、下端がいちばん奥のもの（ma）の下の障害物と、上端がいちばん手前のもの（mb）の
	上の障害物を、広げる組（widen: oa, ob, amount = over）にする。
	範囲の広い線分（箱の上下の空いた所を通る）が束を列の向こう側の通り道とつなぐと、over が別の通り道の鎖の長さに
	なり（taikyohiyou の epic-02233 の最初の回で 254。通り道の幅は 24）、ma と mb が別々の通り道から選ばれる
	（例 iss-02244|iss-02244）。routeLayout はその組を列の間の鍵（cc<まとまり>#k）に写して足し、解けないので10回まで
	繰り返す。
	"""

target: """
	束の詰めと位置はそのままに、広げの要求だけを通り道ごとに見積もる。動かない線分の前後は、入る余地で決め、
	押された動かない線分の手前の動く線分のうち奥に余地のあるものを奥へ回す。
	"""

design: {
	"D-01": {
		title: "広げの要求を通り道ごとに見積もる（router.js の nudgePass）"
		text: """
			束の over が 0.5 を超えるときだけ、もう一度、並びの順に、各線分の「通り道の中の鎖」の位置を数える。
			線分 s の鎖の位置は、s の望む範囲の下端（動かない線分は自分の位置）と、s より手前に並び s と重なりうる線分 p
			のうち、s の通り道の中にあるものの鎖の位置 + S の最大である。p が s の通り道の中にあるとは、
			- 動く p：p の範囲の下端が s の範囲の下端以上で、p の範囲の上端が s の上端以下か、p の鎖の位置が s の上端以下
			- 動かない p：p の位置が s の範囲の中
			のこと。動く線分 s で、両側が障害物か図の端（lob、hib が -1 以上）で、鎖の位置が望む範囲の上端を 0.5 より
			超えるとき、組 (s.lob, s.hib) に、その超えた量を求める。同じ組は最大の量を1つにまとめ、組ごとに widen に入れる。
			片側が自分の曲がり（-2）の線分は求めない（F-01）。
			返す widen の形（axis、oa、ob、amount）と、routeLayout と gapFor の扱いは変えない。
			数え直しは over のある束だけで行い、束の中の組の数に比例する（詰めと同じ大きさ）。見積もりが正しくなると
			解けない広げの繰り返しが減るので、配線の回数と時間は減る（R-04）。
			"""
		satisfies: ["R-01", "R-02", "R-04", "F-01"]
	}
	"D-02": {
		title: "動かない線分と動く線分の前後を、入る余地で決める（router.js の nudgePass）"
		text: """
			- 並びの比べ方（cmp）で、片方が動かない線分 f、もう片方が動く線分 m のとき、m が f の手前に入れる
			  （m の望む範囲の下端 + S ≦ f の位置）か、奥に入れる（f の位置 + S ≦ m の望む範囲の上端）かを見て、
			  片方だけなら、その前後にする。両方入れるときと、どちらも入れないときは、今までどおり位置の順にする。
			- 詰めた結果、動かない線分 f が手前の線分に押される（求める位置が f の位置を 0.5 より超える）とき、
			  f と重なりうる手前の動く線分のうち、詰めの位置が f の位置 − S より奥にあり、f の奥に入る余地がある
			  （f の位置 + S ≦ 望む範囲の上端）ものを、f のすぐ奥へ並べ直して詰め直す。最大4回まで（F-02）。
			"""
		satisfies: ["R-03", "F-02"]
	}
	"D-03": {
		title: "列の間の幅を測る検査（tests/js/dashboard_graph_check.mjs の passages）"
		text: """
			配置の結果の箱と畳んだまとまりのうち、道筋（path）に、まとまりの格子の行（rr…）とその中の段の列（cc…、i が
			段の番号）を持つものを、格子ごとに段の列へ分ける。隣り合う段 k と k + 1 について、段 k のいちばん右の右端から、
			段 k + 1 のいちばん左の左端までを列の間とし（正の幅のときだけ）、その中を縦に通る線分の位置（四捨五入した x）
			の数を線の本数 n とする。各列の間の幅、n、上限 max(44, 8n + 12) を返す。
			"""
		satisfies: ["R-01", "R-02"]
	}
	"D-04": {
		title: "線の多い合成の構造（tests/support/dashboard_graph.py）"
		text: """
			taikyohiyou の epic-02233 と同じ依存の形の、Initiative 1つ、Epic 1つ、Issue 22件の構造を作る。1つの Issue から
			多くへ（iss-02254 の形）、多くから1つへ（iss-02253 の形。17件と2件から）、列を越える長い線を持ち、終わった Issue と
			開いた Issue が混じる。代表の構造の検査（線の検査と速さ）にも加える。
			"""
		satisfies: ["R-01", "R-02", "R-03"]
	}
}

compatibility: """
	公開の JSON や CLI の契約は変わらない。配布資産のうち、ダッシュボードの router.js だけが変わる（static-inventory.json
	の対象ではない JavaScript の資産）。配置の見た目は、線の多い構造で列の間が狭くなり、配線の繰り返しの回数が減る。
	次の版（0.9.0）の移行の注記：「構造の図で、線の多い Epic の列の間に空いた極端に広い隙間を直した（#578）。
	利用者の操作や保存した選択は変わらない」。
	"""

risks: [
	"広げの要求が減るので、ある構造では車線が足りず、線の検査の違反が出るおそれ：代表の構造と合成の構造のすべての組み合わせで違反0を確かめる",
	"#575（layout.js の最上位の並べ方）と同時に走る：router.js だけを変え、PR の前に origin/main を取り込み直して、テストをやり直す",
]
