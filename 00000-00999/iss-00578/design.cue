package spec

// 設計（Issue）。型 specdock/v1。

goals: [
	"広げの要求を、実際に足りない1つの通り道について、その通り道に閉じた線分の鎖から見積もる（左右と上下の両方。nudgePass は向き V に共通）",
	"線の多い入口の辺のために、箱とその行が出入りの格子の分だけ高くならないようにする",
	"寄せの位置の決め方（中央への寄せ、交差の少ない前後）と、配置の並べ方は変えない",
]

current: """
	router.js の nudgePass は、同じ向きの線分を、重なりうる組（conf）の union-find で束にし、束ごとに並びの順
	（交差の少ない前後の位相順）で手前から詰める。束の中で、ある線分の詰めの位置が望む範囲の上端を超えた最大の量を
	over とし、束の中の動く線分のうち、下端がいちばん奥のもの（ma）の下の障害物と、上端がいちばん手前のもの（mb）の
	上の障害物を、広げる組（widen: oa, ob, amount = over）にする。
	範囲の広い線分（箱の上下の空いた所を通る）が束を列の向こう側の通り道とつなぐと、over が別の通り道の鎖の長さに
	なり（taikyohiyou の epic-02233 の最初の回で 254。通り道の幅は 24）、ma と mb が別々の通り道から選ばれる
	（例 iss-02244|iss-02244）。routeLayout はその組を列の間の鍵（cc<まとまり>#k）に写して足し、解けないので10回まで
	繰り返す。
	上下では、入口は 2S の格子（出口の格子から S ずらした高さ）にだけ置くので、k 本の入口の辺は 2S·k の高さが要り、
	layout.js の portRoom がその分だけ箱を伸ばす（grow）。行の高さはいちばん高い箱で決まるので、iss-02253（20本）が
	344 に伸び、その行のほかの箱の下に、16 おきの横の線の帯ができる。さらに routeLayout は、箱を伸ばす回（出入りの
	位置が詰まった配線）の広げも足すので、最初の回の混んだ配線の見積もりが残る。
	"""

target: """
	広げの要求を通り道ごとに見積もり（D-01）、範囲を超えて押される線分のために並びを直す（D-02）。線の多い入口の辺は
	S おきに置き（D-05）、箱を伸ばす回は通り道を広げない（D-06）。
	"""

design: {
	"D-01": {
		title: "広げの要求を通り道ごとに見積もる（router.js の nudgePass）"
		text: """
			関数 lacking()。寄せの後に、重なる2本（y の範囲が 0.5 より重なる、別の線の組）の位置が S − 0.5 より近く残れば、
			動く線分の側の組 (lob, hib) に S − 距離 を求める（中央への寄せで範囲の端に止められた残り。F-02）。
			束の over が 0.5 を超えるときは、もう一度、並びの順に、各線分の「通り道の中の鎖」の位置を数える。
			線分 s の鎖の位置は、s の望む範囲の下端（動かない線分は自分の位置）と、s より手前に並び s と重なりうる線分 p
			のうち、s の通り道の中にあるものの鎖の位置 + S の最大である。p が s の通り道の中にあるとは、
			- 動く p：p.lo ≧ s.lo − EPS であり、かつ（p.hi ≦ s.hi + EPS または p の鎖の位置 ≦ s.hi + EPS）
			- 動かない p：s.lo − EPS ≦ p の位置 ≦ s.hi + EPS
			のこと。lo、hi は、線分の両側の障害物（余白 M0 を含む）と自分の曲がりで決まる動ける範囲（range() の lo、hi）で、
			望む範囲（dlo0、dhi0）ではない。EPS は 0.01。動く線分 s で、両側が障害物か図の端（lob、hib が -1 以上）で、鎖の位置が望む範囲の上端を 0.5 より
			超えるとき、組 (s.lob, s.hib) に、その超えた量を求める。同じ組は最大の量を1つにまとめ、組ごとに widen に入れる。
			片側が自分の曲がり（-2）の線分は求めない（F-01）。
			返す widen の形（axis、oa、ob、amount）と、routeLayout と gapFor の扱いは変えない。
			数え直しは over のある束だけで行い、束の中の組の数に比例する（詰めと同じ大きさ）。見積もりが正しくなると
			解けない広げの繰り返しが減るので、配線の回数と時間は減る（R-04）。
			"""
		satisfies: ["R-01", "R-02", "R-04", "F-01"]
	}
	"D-02": {
		title: "押されて範囲を超える線分のために、押している鎖の中の逃げられる線分を奥へ回す（router.js の nudgePass）"
		text: """
			並びの順は通り道の範囲を見ないので、範囲の広い線分が、別の通り道の鎖に押されたまま、狭い線分や動かない線分の
			手前に並び、それを自分の範囲の外へ押す（位置は中央への寄せで範囲の端に止められ、車線が重なる）。
			- 並びの比べ方（cmp）で、片方が動かない線分 f、もう片方が動く線分 m のとき、m が f の手前に入れる
			  （m.dlo0 + S ≦ f の位置 + 0.5）か、奥に入れる（f の位置 + S ≦ m.dhi0 + 0.5）かを見て、片方だけなら、その前後に
			  する。両方入れるときと、どちらも入れないときは、今までどおり位置の順にする。
			- 詰めでは、各線分を押した手前の線分（求める位置を決めたもの）を覚える。詰めた結果、線分 s が自分の上限
			  （動く線分は dhi0、動かない線分は自分の位置）を 0.5 より超えるとき、s を押した線分から、押した線分を手前へ
			  たどり、最初に見つかった「逃げられる」線分 p を、s のすぐ奥へ並べ直して詰め直す。p が逃げられるとは、p が
			  動き、p.hi > s の上端（動く s は s.hi、動かない s は s の位置）+ EPS で、s の下端（動く s は s.dlo0、動かない s は
			  s の位置）+ S ≦ p.dhi0 + 0.5 のこと。並びの順のいちばん手前の、逃げられる線分のある s から1回に1つ回し、
			  最大12回まで繰り返す（F-02）。
			- 逃げられる線分がないか、12回で解けないときは、そのまま詰めた位置を使う。広げの要求は D-01 だけが決める
			  （動かない線分の押されの分は広げを求めない）。
			"""
		satisfies: ["R-03", "F-02"]
	}
	"D-03": {
		title: "列の間と行の帯を測る検査（tests/js/dashboard_graph_check.mjs の passages）"
		text: """
			配置の結果の箱と畳んだまとまりのうち、道筋（path）に、まとまりの格子の行（rr…、i が行の番号）とその中の段の
			列（cc…、i が段の番号）を持つものを、格子ごとに集める。
			- axis "x"：隣り合う段 k と k + 1 について、段 k のいちばん右の右端から、段 k + 1 のいちばん左の左端までを列の間とし
			  （正の幅のときだけ）、その中を縦に通る線分の位置（四捨五入した x）の数を n とする。
			- axis "y"：同じ段の列で、行 r の箱と行 r + 1 の箱（どちらもあるとき）について、上の箱の下端から下の箱の上端まで
			  を帯とし（正の幅のときだけ）、その帯の中を、格子の幅にわたって横に通る線分の高さ（四捨五入した y）の数を n とする。
			各項目に axis、key、k、row（y のとき）、gap、runs（n）を返す。上限はテストが max(基本, 8n + 12) + 24 で数える
			（基本は x が 44、y が 12）。
			"""
		satisfies: ["R-01", "R-02", "R-05"]
	}
	"D-04": {
		title: "線の多い合成の構造（tests/support/dashboard_graph.py）"
		text: """
			taikyohiyou の epic-02233 と同じ依存の形の、Initiative 1つ、Epic 1つ、Issue 22件の構造を作る。1つの Issue から
			多くへ（iss-02254 の形）、多くから1つへ（iss-02253 の形。17件と2件から）、列を越える長い線を持ち、終わった Issue と
			開いた Issue が混じる。代表の構造の検査（線の検査と速さ）にも加える。
			"""
		satisfies: ["R-01", "R-02", "R-03", "R-05"]
	}
	"D-05": {
		title: "線の多い入口の辺は S おきに置く（router.js の assignPorts、entrySlots、portNeed）"
		text: """
			- 出口の辺を先に置き（2S の格子。今までどおり）、入口の辺は、向かいの出口の高さを知って置く。
			- 入口の辺の枠は、2S の格子（出口の格子から S ずらした高さ）の枠で k 本が入るなら、今までどおりそれを使う。
			  入りきらず、G.fineEntries（入れ子の表し方）のときは、S おきの枠を使う。ただし、出口の格子の高さ y の枠は、
			  y で辺のすぐ左にある障害物（x2 ≦ 箱の x1 で、y を含む、x2 のいちばん大きい、片方の向きだけを塞ぐものでない
			  障害物）が、y から S − 0.5 未満の高さに出口を持つときは使わない（F-03）。S おきの枠が 2S の枠より多いときだけ使う。
			- portNeed(G)：辺ごとに、箱（または枠の見出し）を何 px 高くすればよいかを返す。出口の辺は今までどおり
			  portSpan(k) − (p2 − p1)。入口の辺は、上の枠の数が k に足りないとき、足りない数を、今の枠の密度（1px あたりの
			  枠の数）で割った高さ（portSpan(k) − (p2 − p1) を上限とする）。layout.js の portRoom はこれを使う。
			- graphInput は fineEntries = 入れ子の表し方か、を G に入れる。
			"""
		satisfies: ["R-05", "R-02", "F-03"]
	}
	"D-06": {
		title: "箱を伸ばす回は通り道を広げない（layout.js の routeLayout）"
		text: """
			ある回で portRoom が箱を伸ばすとき（出入りの位置が足りない）、その回の widen は鍵に写さず、箱を伸ばすだけにする。
			その回の配線は、端の線分が辺に詰められているので、通り道の不足の見積もりに使えない。次の回の配線で見積もる。
			回の数の上限（ROUNDS = 10）と、収まらないときに違反の少ない回を残すことは変えない。
			"""
		satisfies: ["R-01", "R-05", "R-02"]
	}
}

compatibility: """
	公開の JSON や CLI の契約は変わらない。配布資産のうち、ダッシュボードの router.js と layout.js だけが変わる
	（static-inventory.json の対象ではない JavaScript の資産）。router.js は portNeed を足して出し、layout.js は
	portSpan を使わなくなる（portSpan は出したまま）。配置の見た目は、線の多い構造で列の間と行の帯が狭くなり、
	線の多い入口の辺の入口が 8px おきになり、配線の繰り返しの回数が減る。
	次の版（0.9.0）の移行の注記：「構造の図で、線の多い Epic の列と列の間、行と行の間に空いた極端に広い隙間を直した
	（#578）。線の多い箱の左の辺では、入る線が 8px おきに並ぶ。利用者の操作や保存した選択は変わらない」。
	"""

risks: [
	"広げの要求が減るので、ある構造では車線が足りず、線の検査の違反が出るおそれ：代表の構造と合成の構造のすべての組み合わせで違反0を確かめる",
	"#575（layout.js の最上位の並べ方）と同時に走る：layout.js は portRoom と routeLayout の数行だけを変え、PR の前に origin/main を取り込み直して、テストをやり直す",
	"入口を S おきにすると、木の表し方では左の狭い通り道で車線が足りなくなった：入れ子の表し方だけに限る（decisions）",
]
