package spec

// 要件（Issue）。型 specdock/v1。書き方は spec-dock/docs/authoring/ のガイドにある。
// 文章の項目には Markdown を書いてよい。型にない項目は、必要に応じて足してよい。

// 型の版。消さない。
schema: "specdock/v1"

// 保証レベル（light、standard、strict、critical）と、その理由。
// 失敗したときの影響と回復の難しさで選ぶ（工数や作業の難しさでは選ばない）。
// 具体化や作業の途中で、上げても下げてもよい。正本はここだけで、ほかの場所に写さない。
assurance: {
	level:  "standard"
	reason: "全リポジトリの構造の図の配置を変える。誤りは表示に限られ版を戻せば直るが、毎日見る画面の見え方に関わる"
}

purpose: "構造の図で、依存の線の多い Epic でも、Issue の列と列の間と、行と行の間が、そこを通る線の本数に見合う幅に収まり、極端に広い隙間が空かない"

background: """
	利用者の報告（2026-11-06）：退去費用プロジェクト（taikyohiyou_project）の構造の図で、init-02234 → epic-02233 の
	Issue の列と列の間に、左右に極端に広い隙間が空く（統括の再現で、1列目の右端から2列目の左端まで図の座標で約 540、
	間を通る縦の線は 8 本ほど）。密に詰まった形に戻ることもあり、形はよく変わる。続く報告（同日、統括経由）：上下にも、
	iss-02252／iss-02238 の行と iss-02251／iss-02248 の行の間に、横の線（14本ほど）だけが通る広い空きがある。
	この Epic は、1つの Issue（iss-02254）から多くの Issue へ、多くの Issue から iss-02253 へ線が集まる、線の多い構造である。
	原因（調べた結果。report.md に数字）：
	- 左右：配線の寄せ（router.js の nudgePass）が、重なりうる線分を束にまとめるとき、箱の上下の空いた所を通る範囲の
	  広い線分を介して、別々の列の間の線分を1つの束にまとめる。並びの順が通り道の範囲を見ないので、ある通り道の線分の
	  詰めが、箱の列の向こう側の通り道の鎖に押され、足りない幅が箱の幅ほどに見積もられる。さらに、広げる組の両側の
	  障害物を、束の中の別々の通り道から選ぶので、広げても解けない。配置（layout.js の routeLayout）は、それを10回まで
	  繰り返して列の間を足し続ける。
	- 上下：格子の行の高さは、その行のいちばん高い箱で決まる。行の右端の iss-02253 は、左の辺に20本の線が入るので、
	  入口の位置の格子（2S = 16 おき）のために 88 から 344 に伸び、行全体が高くなる。その行のほかの箱の下には、
	  iss-02253 へ入る横の線が 16 おきに並ぶ帯ができる。最初の回（箱がまだ伸びる前の、出入りの位置が詰まった配線）で
	  見積もった広げも残る。
	"""

includes: [
	"配線の寄せが返す広げの要求（どの通り道を、どれだけ広げるか）を、通り道ごとに正しく見積もる（左右と上下の両方）",
	"寄せの並びで、範囲を超えて押される線分のために、押している鎖の中の逃げられる線分を奥へ回す",
	"線の多い入口の辺に、入口を S おきに置き、箱が出入りの格子のためだけに高くならないようにする（入れ子の表し方）",
	"出入りの位置が足りない回は箱を伸ばすだけにし、その回の配線から通り道を広げない",
	"線の多い合成の構造で、列の間と行の帯の上限を確かめるテスト",
]

excludes: [
	"配置の決まり（Epic 427 の R-15：つながりは1行で左から右、途中で折り返さない、まとまりの境目で折り返す。依存でつながったものは同じ行にそろえる）の変更。行の高さがその行のいちばん高い箱（枠）で決まることは変えない",
	"線の通らない帯（同じ行の高い Epic の枠に合わせて行が高くなる帯）",
	"最上位の並べ方（#575）、状態の色とアイコン（#574）",
	"木の表し方の配置（木では入口を S おきにしない）",
	"版の番号と migration.md の変更（0.9.0 のリリースで統括が行う）",
]

requirements: {
	"R-01": {
		title: "列の間の幅は、そこを通る線の本数に見合う幅に収まる"
		text: """
			1つのまとまり（依存でつながった兄弟の格子）の、隣り合う段の列の間（左の列のいちばん右の箱の右端から、
			右の列のいちばん左の箱の左端まで）の幅は、そこを縦に通る線の本数 n（線の縦の線分の位置の数）に対して、
			max(44, 8n + 12) に、決まった余白 24 を足した値を超えない。8 は車線の間隔、12 は両側の余白（10 ずつ）から
			1車線分を引いた値、44 は列の間の基本の幅である。
			"""
		acceptance: [
			"線の多い合成の構造（1つから多くへ、多くから1つへ、列を越える長い線を持つ、epic-02233 と同じ依存の形）で、PC の幅（1400）、スマートフォンの幅（374）、既定の幅、終わったものも出す・畳まない、焦点の組み合わせのすべてで、どの列の間も上の上限以下である",
			"修正の前のコードでは、同じテストが落ちる（列の間が上限を大きく超える）",
			"上限はテストの合成の構造で確かめる条件である。実データでは、直す前の数百から数千の超えが数十以下になることを report.md の数字で示す",
			"実データ（taikyohiyou_project と spec-dock）で、1440、1000、390 の幅の、直す前と後の列の間の幅が report.md にある",
		]
	}
	"R-02": {
		title: "同じ線の数なら、形が変わっても列の間と行の帯は同じくらいの幅になる"
		text: "見える幅、終わったものの表示、畳むかどうか、焦点で配置の形が変わっても、列の間と行の帯の幅は R-01 と R-05 の上限に収まる。形が変わること自体は許す。"
		acceptance: [
			"R-01 の合成の構造の、すべての表し方の組み合わせで、列の間が R-01 の上限以下で、行の帯が R-05 の上限以下である",
		]
	}
	"R-03": {
		title: "線の検査の違反を増やさない"
		text: "配線の検査（edgeAudit：箱の上を通る線、自分の箱に入る線、近すぎる車線、斜めの線分、近すぎる出入り、木の親子の線に沿う線、配線の失敗）の違反は、代表の構造と合成の構造のどの表し方でも0のままである。"
		acceptance: [
			"既存の代表の構造（spec-dock のスナップショット、250件の生成、seed 15、seed 18）のすべての組み合わせで違反が0である",
			"R-01 の合成の構造のすべての組み合わせで違反が0である",
		]
	}
	"R-04": {
		title: "250件の構造を1秒以内に配線する"
		acceptance: [
			"250件の生成の構造の、入れ子と木の組み合わせと、PC とスマートフォンの幅の入れ子で、配線がどれも1000ms 未満である",
		]
	}
	"R-06": {
		title: "両端が同じ枠の中にある線は、その枠の外へ遠回りしない"
		text: """
			線の両端（始点と終点の箱）を含むいちばん内側の枠（Epic または Initiative）の外へ、余白 M（10）と2車線（16）より
			遠く出る線はない。統括の確認（2026-11-06）で、直した後の写しに、iss-02254 → iss-02246 の線が Epic の枠の外
			（354px 外）へ出て戻る形が見つかった。寄せが、箱のない高さを通る縦の線分を、動ける範囲（枠の外まで広がる）の端や
			中央へ動かしたためで、仕組みは直す前からある（main でも、spec-dock のスナップショットで 6 件）。
			"""
		acceptance: [
			"線の検査に frameExits（両端を含むいちばん内側の枠から 26px より外へ出る線の数）があり、代表の構造と合成の構造のすべての組み合わせで 0 である",
			"修正の前のコード（a74637053 の前の 3d9bcc54b と、origin/main）では、spec-dock のスナップショットで frameExits が 0 でなく、同じテストが落ちる",
			"実データ（taikyohiyou の 15:50 の構造、1424×743）で、iss-02254 → iss-02246 の線が Epic の枠の中を通る",
		]
	}
	"R-05": {
		title: "行の帯の幅は、そこを通る横の線の本数に見合う幅に収まる"
		text: """
			1つのまとまりの格子の、同じ段の列で、行 r の箱の下端から、すぐ下の行 r + 1 の箱の上端までの帯の幅は、
			その帯を格子の幅にわたって横に通る線の本数 n（横の線分の高さの数）に対して、max(12, 8n + 12) に、決まった余白
			24 を足した値を超えない。12 は行の間の基本の幅である。
			"""
		acceptance: [
			"R-01 の合成の構造のすべての組み合わせで、どの行の帯も上の上限以下である",
			"修正の前のコードでは、同じテストが落ちる",
			"利用者の示した場所（taikyohiyou の epic-02233、iss-02252 → iss-02251、iss-02238 → iss-02248）の、1440、1000、390 の幅の直す前と後の帯の幅と横の線の本数が report.md にある",
		]
	}
}

failures: {
	"F-01": {
		title: "列の間を広げても足りない通り道（線分が自分の曲がりに挟まれる）は、広げを求めない"
		text: "今までと同じく、通り道の片側が線分の自分の曲がり（-2）のときは、広げても解けないので要求しない。"
	}
	"F-02": {
		title: "線分が手前の線分に押されて自分の範囲を超えるときは、押している鎖の中の逃げられる線分を奥へ回し、重なりを残さない"
		text: "出入りの端の線分は寄せで動かず、狭い通り道の線分は動ける範囲が狭い。範囲の広い線分が別の通り道の鎖に押されたまま手前に並び、それらを範囲の外へ押すときは、押している鎖の中の、奥へ逃げられる線分を奥へ並べ直す（12回まで。押されの合計が減らなければ戻してやめる）。寄せの後に、重なる2本が車線の間隔より近く残れば、その通り道の不足として広げを求める。残った重なりは線の検査が数え、R-03 のテストが、代表と合成の構造で残らないことを確かめる。"
	}
	"F-04": {
		title: "枠の余白に車線が入りきらないときは、重ねずに枠の線のすぐ外へはみ出す"
		text: "目指す範囲を枠の中に限るので、枠の下の余白（12px）より多くの横の線が箱の下を回るとき、詰めが目指す範囲からあふれる。そのときは、重ねずに本来の範囲（障害物まで）へはみ出す。枠の余白は広げの鍵がないので広げない。はみ出しは 26px までを検査が許す（R-06）。"
	}
	"F-03": {
		title: "入口を S おきに置くとき、向かいの出口と同じ高さには置かない"
		text: "出口と入口の端の線分は、どちらも寄せで動かない。入口を出口の格子（2S おきの高さ）に置くときは、その高さで辺のすぐ左にある障害物が、その高さに出口を持たないときだけにする。"
	}
}

constraints: [
	"編集してよいのは `src/spec_dock/assets/dashboard/views/graph*`、`tests/`、この Issue の Scope のディレクトリだけ",
	"配置の決まり（Epic 427 の R-15）を変えない。layout.js の並べ方と、広げの鍵（gapFor）の対応は変えない（layout.js は、出入りの位置の不足の数え方と、広げの繰り返しだけを変える）",
	"版の番号と migration.md を変えない",
]

decisions: [
	"上限の余白 24（3車線分）は、合成の構造で修正後の最大の超え（列の間も行の帯も 10）に余裕を持たせ、修正前の超え（列の間 870、行の帯 151）を確実に落とす値として選んだ（2026-11-06、作業者）",
	"入口を S おきにするのは入れ子の表し方だけにする。木の表し方は1行に箱が1つで、行の帯の問題が起きず、S おきにすると、木の左の狭い通り道で車線が足りなくなった（合成の構造で近すぎる車線 8 件）",
	"線の通らない帯（同じ行の高い Epic の枠に合わせて行が高くなる帯。実データの Initiative の格子で 600 ほど）は、行をそろえる配置の決まりによるもので、この Issue では直さない。report.md に数字を書く",
	"上下の範囲の追加は統括の指示（2026-11-06）による",
	"枠の外への遠回りの修正（R-06、F-04、D-07、D-08）は、PR #579 の確認での統括の指示（2026-11-06）による。検査の許し 26px（余白 M と2車線）は、枠の下の余白からあふれた車線（spec-dock の実データで最大 22px）を数えず、遠回り（354px）を数える値として選んだ",
	"範囲の広い線分（動ける範囲が 160 より広い。隣の列や行に箱のない所を通る）を A* の位置にとどめるのは、入れ子の表し方だけにする。木では左の狭い所に長い線が並び、寄せないと車線が重なった（taikyohiyou の木の表し方で近すぎる車線 1 → 16）",
]
