package spec

// 要件（Issue）。型 specdock/v1。書き方は spec-dock/docs/authoring/ のガイドにある。
// 文章の項目には Markdown を書いてよい。型にない項目は、必要に応じて足してよい。

// 型の版。消さない。
schema: "specdock/v1"

// 保証レベル（light、standard、strict、critical）と、その理由。
// 失敗したときの影響と回復の難しさで選ぶ（工数や作業の難しさでは選ばない）。
// 具体化や作業の途中で、上げても下げてもよい。正本はここだけで、ほかの場所に写さない。
assurance: {
	level:  "standard"
	reason: "全リポジトリの構造の図の配置を変える。誤りは表示に限られ版を戻せば直るが、毎日見る画面の見え方に関わる"
}

purpose: "構造の図で、依存の線の多い Epic でも、Issue の列と列の間が、そこを通る線の本数に見合う幅に収まり、極端に広い隙間が空かない"

background: """
	利用者の報告（2026-11-06）：退去費用プロジェクト（taikyohiyou_project）の構造の図で、init-02234 → epic-02233 の
	Issue の列と列の間に、左右に極端に広い隙間が空く（統括の再現で、1列目の右端から2列目の左端まで図の座標で約 540、
	間を通る縦の線は 8 本ほど）。密に詰まった形に戻ることもあり、形はよく変わる。
	この Epic は、1つの Issue（iss-02254）から多くの Issue へ、多くの Issue から iss-02253 へ線が集まる、線の多い構造である。
	原因（調べた結果。report.md に数字）：配線の寄せ（router.js の nudgePass）が、重なりうる線分を束にまとめるとき、
	箱の上下の空いた所を通る範囲の広い線分を介して、別々の列の間の線分を1つの束にまとめる。並びの順が通り道の範囲を
	見ないので、ある通り道の線分の詰めが、箱の列の向こう側の通り道の鎖に押され、足りない幅が箱の幅ほどに見積もられる。
	さらに、広げる組の両側の障害物を、束の中の別々の通り道から選ぶので、広げても解けない。配置（layout.js の
	routeLayout）は、それを10回まで繰り返して列の間を足し続ける。
	"""

includes: [
	"配線の寄せが返す広げの要求（どの通り道を、どれだけ広げるか）を、通り道ごとに正しく見積もる",
	"寄せの並びで、動かない線分（出入りの端の線分）と動く線分の前後を、入る余地で決める",
	"線の多い合成の構造で、列の間の幅の上限を確かめるテスト",
]

excludes: [
	"配置の決まり（Epic 427 の R-15：つながりは1行で左から右、途中で折り返さない、まとまりの境目で折り返す）の変更",
	"最上位の並べ方（#575）、状態の色とアイコン（#574）",
	"木の表し方の配置",
	"版の番号と migration.md の変更（0.9.0 のリリースで統括が行う）",
]

requirements: {
	"R-01": {
		title: "列の間の幅は、そこを通る線の本数に見合う幅に収まる"
		text: """
			1つのまとまり（依存でつながった兄弟の格子）の、隣り合う段の列の間（左の列のいちばん右の箱の右端から、
			右の列のいちばん左の箱の左端まで）の幅は、そこを縦に通る線の本数 n（線の縦の線分の位置の数）に対して、
			max(44, 8n + 12) に、決まった余白 24 を足した値を超えない。8 は車線の間隔、12 は両側の余白（10 ずつ）から
			1車線分を引いた値、44 は列の間の基本の幅である。
			"""
		acceptance: [
			"線の多い合成の構造（1つから多くへ、多くから1つへ、列を越える長い線を持つ、epic-02233 と同じ依存の形）で、PC の幅（1400）、スマートフォンの幅（374）、既定の幅、終わったものも出す・畳まないの組み合わせのすべてで、どの列の間も上の上限以下である",
			"修正の前のコードでは、同じテストが落ちる（列の間が上限を大きく超える）",
			"実データ（taikyohiyou_project と spec-dock）で、1440、1000、390 の幅の、直す前と後の列の間の幅が report.md にある",
		]
	}
	"R-02": {
		title: "同じ線の数なら、形が変わっても列の間は同じくらいの幅になる"
		text: "見える幅、終わったものの表示、畳むかどうかで配置の形が変わっても、列の間の幅は R-01 の上限に収まる。形が変わること自体は許す。"
		acceptance: [
			"R-01 の合成の構造の、すべての表し方の組み合わせで、列の間が R-01 の上限以下である",
		]
	}
	"R-03": {
		title: "線の検査の違反を増やさない"
		text: "配線の検査（edgeAudit：箱の上を通る線、自分の箱に入る線、近すぎる車線、斜めの線分、近すぎる出入り、木の親子の線に沿う線、配線の失敗）の違反は、代表の構造と合成の構造のどの表し方でも0のままである。"
		acceptance: [
			"既存の代表の構造（spec-dock のスナップショット、250件の生成、seed 15、seed 18）のすべての組み合わせで違反が0である",
			"R-01 の合成の構造のすべての組み合わせで違反が0である",
		]
	}
	"R-04": {
		title: "250件の構造を1秒以内に配線する"
		acceptance: [
			"250件の生成の構造の、入れ子と木の組み合わせと、PC とスマートフォンの幅の入れ子で、配線がどれも1000ms 未満である",
		]
	}
}

failures: {
	"F-01": {
		title: "列の間を広げても足りない通り道（線分が自分の曲がりに挟まれる）は、広げを求めない"
		text: "今までと同じく、通り道の片側が線分の自分の曲がり（-2）のときは、広げても解けないので要求しない。"
	}
	"F-02": {
		title: "動かない線分が手前の線分に押されるときは、奥に余地のある線分を奥へ回し、重なりを残さない"
		text: "出入りの端の線分は寄せで動かない。それと重なる動く線分が手前に並び、その線分を押すときは、動かない線分の奥に入る余地のある線分を、その奥へ並べ直す（数回まで）。"
	}
}

constraints: [
	"編集してよいのは `src/spec_dock/assets/dashboard/views/graph*`、`tests/`、この Issue の Scope のディレクトリだけ",
	"配置の決まり（Epic 427 の R-15）を変えない。layout.js の並べ方と、広げの鍵（gapFor）の対応は変えない",
	"版の番号と migration.md を変えない",
]

decisions: [
	"上限の余白 24（3車線分）は、合成の構造で修正後の最大の超え（2）に余裕を持たせ、修正前の超え（870）を確実に落とす値として選んだ（2026-11-06、作業者）",
	"広げは、最初の回の混んだ配線で見積もった分を、後の回で戻さない（今までどおり）。そのため実データでは、上限から 20〜50 ほど広い列の間が残ることがある。report.md に数字を書く",
]
