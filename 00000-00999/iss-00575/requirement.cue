package spec

// 要件（Issue）。型 specdock/v1。

schema: "specdock/v1"

assurance: {
	level:  "light"
	reason: "配置の決まりを最上位にも広げるだけ"
}

purpose:    "構造の図で Initiative も画面に合わせて横に並べ、全体を大きく見せて、画面をシンプルでコンパクトに使えるようにする"
background: "Initiative の中の Epic は画面の幅で折り返して横に並ぶ（#560）が、Initiative どうしは縦に積まれ、全体表示では画面の中央に細い縦の列ができて小さく縮む。利用者の要望（2026-11-05、epic-00573）。最初の実装は「100%表示の幅の残りに入れば並べる」方式で、実データでは一度も並ばなかったため、統括の指示で「全体表示の倍率が最大になる切れ目」の方式に改めた"

requirements: {
	"R-01": {
		title: "最上位の Initiative を、全体を画面に収めたときの倍率が最大になる切れ目で並べる"
		text:  "各 Initiative は自然な幅と高さのまま、活動順に棚に詰める。行の切れ目の候補（並びの先頭から k 個を横に並べた幅）をすべて試し、倍率 = min(1, 見える幅 ÷ 全体の幅, 見える高さ ÷ 全体の高さ) が最大のものを採る。同じなら全体の面積が小さいほう、それも同じなら先の候補を採る。この選びは、最上位のすべてのブロック（Initiative のほか、親のない Epic や Issue、折りたたみの塊）に同じように働く。見える高さが見える幅以上（縦長、スマートフォン）のときは、今までの幅での折り返し（縦積み）にする。"
		acceptance: ["Initiative が4つ（それぞれ Epic 1つに Issue 4つ）の構造で、1400×760 と 1920×1080 では 2つずつ2行になり、各 Initiative の幅は同じ（狭めない）", "同じ構造で、幅374・高さ800では1列に縦積み", "spec-dock の実データで 1440×900 と 1920×1080 では、少なくとも1行に2つ並び、全体表示の倍率が縦積みより上がる。390px では縦積み", "高さを渡さない呼び出し（node の確認など）は、今までの折り返しのまま"]
	}
	"R-02": {
		title: "並べ方のほかの決まりは #560 と同じ"
		text:  "Initiative の中の Epic の並べ方、依存でつながった Initiative を一つのまとまりとして行の途中で折り返さないこと、活動順は変えない。"
		acceptance: ["依存でつながった Initiative の鎖が1行に残り、切れ目が鎖の中に落ちない", "並びは活動順（縦積みの順と、行を左から右へ読む順が同じ）"]
	}
	"R-03": {
		title: "見える領域の大きさが変わり終わったときだけ並べ直す"
		text:  "図の領域の実寸（幅と高さ）を layout に渡す。大きさが変わり終わってから（200ms 変わらない）並べ直す。拡大縮小、配線の広げ直し、同じデータでの再描画では配置を動かさない（Scope が増減すれば配置は変わりうる）。"
		acceptance: ["edgeAudit の違反が、代表的な構造のすべての見せ方（高さありを含む）で0のまま", "配線の広げ直しの前後で、Initiative が並ぶ行が変わらない", "窓の高さを変えて元に戻すと、元の配置に戻る。ブラウザーのエラーは0"]
	}
}

constraints: ["編集の範囲は views/graph*、tests/、この Issue の Scope だけ", "版の番号と migration.md は変えない"]
decisions: ["Initiative が1つなら今までと同じ", "Initiative を狭めて作り直す仕組み（root#shares）は、この方式では要らないので外した", "見える高さは、ツールバーの高さ（選択で出入りする）を引かず、図の領域の高さ − 16px とする。切れ目の選びは、この見積もりの違いでは変わらないことを実データで確かめた"]
