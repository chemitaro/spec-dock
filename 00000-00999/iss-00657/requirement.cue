package spec

// 要件（Issue）。型 specdock/v1。

schema: "specdock/v1"

assurance: {
	level:  "standard"
	reason: "指揮の線の動きの決まりを変える（iss-00646 の重さの目標を保つ）"
}

purpose: """
	構造の図（`/r/<repo>/graph`）と『横断の構造』（`/graph`）の黄色い指揮の線（`flow` の線）の点を、間を広げてゆっくり流し、1つの組の形で進む向きが分かるようにする。
	本人が見て、情報が親から子へ進んでいると一目で読め、点滅に見えないこと。iss-00646 の軽さ（合成スレッドの opacity の切り替え、線ごとの小さな SVG、動かす間・画面の外・裏で止める）は保つ。
	"""

background: """
	本人の指摘（2026-11-18）：黄色い動く点線の動きが速すぎて、情報がどちらへ進んでいるのか分かりにくい。流れているというより、チカチカ点滅しているように見える。

	統括が読んだ原因：iss-00646 で、点の流れを『2px ずつずらした4枚の絵を、opacity のアニメーションで順に見せる』形にした（`views/graph/command_motion.js` の `MOTION = {phases: 4, step: 2, tick: 0.05}`、点の間 8px、`graph.css` の `stroke-dasharray: 0.1 7.9` と `sd-cmd-phase .2s`）。0.2秒ごとに同じ絵に戻り、点の間が狭くどの点がどこへ移ったか目で追えないため、5Hz の点滅に見え、向きが読めない。

	タスク担当が確かめた今の事実（2026-11-18、`92e26aff7`）：
	- 流れる線は、本体の層（`.gx-cmd`）に光の下地だけの止めた SVG 1つと、`cl-line` の点の線を持つ切り替えの SVG 4つ（`.cl-ph`、`data-ph` 0〜3、ずらし 0・−2・−4・−6px、`animation-delay` 0・−0.15・−0.1・−0.05秒）を置く。端の層（`.gx-cmd-top`）の箱の中の短い線にも同じ4枚がある。
	- iss-00648（ホップの弧、マージ待ち）の設計で、箱の中の短い線（`stubs`）はなくなり、子の端は下向きの三角の矢じり（`cl-arrow`）と受けた印の縁（`cl-in`）になる。端の層には切り替えの絵がなくなる。
	- 波紋は HTML の輪の組（`.cr`）で、`sd-cmd-ripple 2.4s ease-out`、2つ目は 1.2秒遅れ。
	- 減らす設定（prefers-reduced-motion）では、ずらし 0 の1枚だけを見せ、波紋は止まった輪1つ。今は点の形が一様なので、止まった絵では流れる向きが分からない。
	"""

includes: [
	"流れる線の点の間、1つの組の形（進む向きの先が大きく明るく、後ろが小さく薄い）、速さ、1回のずれ、切り替えの枚数と1枚の時間（`command_motion.js` の `MOTION` と `graph.css` の写し）",
	"波紋の時間（点の流れと合う落ち着いた速さ）",
	"減らす設定での、止まった組の形",
	"node のテスト（MOTION の値、遅延、ずれ、組の形）と CSS・画面のテストの期待",
	"直す前と後の測り（同じ台本の TaskDuration）、連続の写し、線の検査",
	"Epic epic-00615 の文書の動きの決まり（R-05、制約、D-04、decisions）",
]

excludes: [
	"色（`--sd-cmd`・`--sd-cmd-glow`）、光の下地の太さ 6、`wait`・`done` の線の形と太さ、選んだ線を太くすること自体",
	"線の通り道と端（iss-00648 のホップの弧、矢じり、印の縁）、帯、凡例、波紋の大きさ",
	"止める仕組み（`createMotion`、is-still・is-off）と層の並び、`specdockCmdAudit` の項目",
	"依存の線、箱、枠、図を動かす操作、Python の API・保存・モデル・orca-web",
]

requirements: {
	"R-01": {
		title: "流れる線の点は、間を広げた大小2つの点の組で、進む向きが止まった絵でも分かる"
		text: """
			`flow` の線（本体。iss-00648 の後も切り替えの絵を持つのは本体だけ）の点を、24px ごとの組にする。1つの組は、進む向き（親から子）の先にある大きく明るい頭の点（直径 3.5px、不透明）と、その 6px 後ろの小さく薄い尾の点（直径 2px、不透明度 .45）の2つ。
			頭と尾はどちらも指揮の色（`--sd-cmd`）の丸い点で、依存の線や子の端の三角の矢じりと形で紛れない。選んだ線（`is-cmd-hl`）では、頭を 4.5px、尾を 3px にする（今の『選んだ線を 2 から 3 に太くする』の比を保つ）。
			線の太さの決まり（`wait` の点線 2、光の下地 6、`done` の線 2）と色は変えない。
			"""
		acceptance: [
			"切り替えの絵の各々に、頭と尾の2本の点の線があり、どちらも `stroke-dasharray` の周期が 24px、尾のずらしが頭より +6px（道の向きに 6px 後ろ）になっている（node のテストと CSS の静的な検査）",
			"CSS で、頭の点が太さ 3.5（選んだ線で 4.5）・不透明、尾の点が太さ 2（選んだ線で 3）・不透明度 .45、どちらも丸い端と `--sd-cmd`（静的な検査）",
			"実機の写し（1440 × 明・暗、両方の画面）で、1つの止まった写しだけを見ても、大きな点が小さな点の子の側にあり、向きが読める",
		]
	}
	"R-02": {
		title: "点の組は 20px/秒で、0.1秒ごとに 2px ずつ、なめらかに流れる"
		text: """
			切り替えの絵を 12枚（ずらし 0・−2・…・−22px）にし、各々を 0.1秒ずつ1枚だけ見せる（1周 1.2秒で、組が1つ分の 24px 進む）。速さは 20px/秒で、どの線も一様。1回のずれは 2px（組の間 24px の 1/12）で、点滅ではなく動きとして読める。
			切り替えは今と同じく、合成スレッドで動く `opacity` の CSS アニメーション（`steps(1, end)`）だけで行い、各々の `animation-delay` は i 枚目が 0.1·i 秒から見える値（−((12−i) mod 12)·0.1 秒）。
			"""
		acceptance: [
			"`MOTION` が `{phases: 12, step: 2, tick: 0.1, gap: 24, tail: 6, pad: 4}` で、`phaseDelay(0..11)`・`phaseOffset(0..11)` が上の値。0.01秒刻みの 0〜2.4秒のどの時刻でも、見える絵がちょうど1枚で、見える絵のずらしが 0.1秒ごとに −2 ずつ進み、1.2秒で 0 に戻る（node のテスト）",
			"CSS の切り替えが `sd-cmd-phase 1.2s steps(1, end) infinite` で、keyframes は `opacity` だけ（0% で 1、1/12 の所で 0、100% で 0）。`MOTION` の写しの数（周期・1周の秒・組の間・尾のずれ）が CSS と同じ（静的な検査）",
			"1440×900 で、0.1秒ごとの連続の写し（10枚以上）を前と後で残し、後で組が子の向きへ 2px ずつ進むのが追える（report.md）",
		]
	}
	"R-03": {
		title: "波紋は、点の流れと合う落ち着いた速さで広がる"
		text: """
			波紋（HTML の輪の組）の1つの輪の時間を 2.4秒から 3.6秒（点の1周 1.2秒の3倍）にし、2つ目の輪を 1.8秒遅らせる。動き方（`ease-out`、`scale(.4)` から `scale(2.2)`、不透明度 .9 から 0）と大きさは変えない。
			"""
		acceptance: [
			"CSS の波紋が `sd-cmd-ripple 3.6s ease-out infinite`、2つ目の輪の遅れが 1.8s、keyframes は今のまま（静的な検査）",
		]
	}
	"R-04": {
		title: "iss-00646 の軽さを保つ"
		text: """
			線ごとの外接の四角の SVG、合成スレッドの opacity の切り替え、図を動かす間・画面の外・裏で止める仕組み（`createMotion`）を保つ。枚数が 4 から 12 に増えても、同じ台本（Epic epic-00615 の `.workbench/perf-measure.mjs`、1440×900、deviceScaleFactor 2、読み込みの15秒後から10秒）の動きありの TaskDuration が、iss-00646 の受入（横断の構造 0.11秒以下、spec-dock の構造の図 0.07秒以下／10秒）を超えない。
			超えるときは、枚数と刻みを見直すか、統括に問う（統括の決定4）。
			"""
		acceptance: [
			"同じ台本の動きありと減らす設定の TaskDuration を、両方の画面で前と後に測り、後が横断 0.11秒以下、単体 0.07秒以下（report.md、測りのときの流れる線の数と切り替えの絵の数も書く）",
			"実機で `specdockEdgeAudit()` の違反0、`specdockCmdAudit()` の `boxOverlaps`・`edgeOverlaps`・`heads` 0、`spotDrift` ≤ 0.4、ブラウザーのエラー0（両方の画面）",
			"止める仕組みの今のテスト（is-still・is-off・見張り）がそのまま通り、`specdockCmdAudit().motion.phases` が流れる線1本につき 12 になる（画面のテスト）",
		]
	}
	"R-05": {
		title: "減らす設定では動かさず、止まった組の形で向きを示す"
		text: """
			prefers-reduced-motion では、今と同じく切り替えのアニメーションを止め、ずらし 0 の1枚だけを見せる。その1枚にも頭と尾の組があるので、止まった絵で向きが分かる。波紋は今と同じく止まった輪1つ（1.4倍、不透明度 .6、2つ目は出さない）。
			"""
		acceptance: [
			"減らす設定の CSS で、`.cl-ph` のアニメーションがなく、`data-ph=\"0\"` だけが見え、波紋は動かない（静的な検査）",
			"実機の減らす設定の写しで、組の形（大きな点が子の側）が見える",
		]
	}
}

failures: {
	"F-01": {
		title: "組の間より短い線でも、点が1つも見えない線にならない"
		text:  "道の長さが組の間（24px）より短い流れる線でも、少なくとも頭の点が通る（周期の中で頭の点が道の上に来る時間がある）。点が見えない時間があっても、光の下地は止まった絵として常に見える（今と同じ）。エラーにしない。"
	}
}

constraints: [
	"Epic epic-00615 の constraints（動きは CSS の opacity と transform だけ、新しい色を足さない、`router.js` と edgeAudit を変えない、純粋な関数と node のテスト、公開の文書とテストに実際のパス・IP・セッションの id を書かない）",
	"書いてよいのは `src/spec_dock/assets/dashboard/`、`tests/`、`src/spec_dock/assets/static-inventory.json`（sha256 が変わるなら）、この Issue と epic-00615 の Scope のディレクトリ（依頼書）",
	"本人の環境に特化した決まりを入れず、どの線にも同じに効く一様な数にする（本人の方針）。テストの値も合成の値にする",
	"線の道（`commandModel` の `links[].d`・`from`・`to`・`ripples`）を変えない。実装は iss-00648 のマージの後の `origin/main` から始める（依頼書）",
]

decisions: [
	"2026-11-18 統括（依頼書の決定1〜6）：点の組の間を約 24〜32px にする。1つの組を、先が明るく大きく後ろが小さく薄い形にする（作り方は担当に任せる。依存の線や矢じりと紛れない形）。速さ約 15〜25px/s、1回のずれ 2px 程度以下、点滅に見えない枚数と刻み。iss-00646 の方法と重さの受入を保つ。波紋も落ち着いた速さにそろえる。減らす設定では動かさず、組の形で向きを示す。色・太さ・光の下地・線の通り道は変えない。",
	"2026-11-18 タスク担当：組の間 24px、1回のずれ 2px、1枚 0.1秒、12枚、20px/秒、1周 1.2秒にする。ずれを 2px に保ち枚数を最も少なくする組み合わせで（24 は範囲の下の端。32px なら 16枚になり層が増える）、速さは範囲の中央。0.1秒の刻みは 2px の動きとして読め、点滅の周期（1周 1.2秒）は目で追える長さ。",
	"2026-11-18 タスク担当：組の形は『大小2つの点』（頭 3.5px・不透明、尾 2px・.45、尾は 6px 後ろ）にし、同じ道を2本の点の線（ずらしだけが違う）で描く。印を置く方式（矢じり・三角）は子の端の矢じり（iss-00648）と紛れるので選ばない。彗星の尾を線分で描く方式は、丸い点の今の見た目から離れ、`wait` の点線との区別も弱くなるので選ばない。",
	"2026-11-18 タスク担当：『太さは変えない』は、線（`wait`・`done`）と光の下地の太さの意味に読み、組の頭と尾の点の大きさは統括の決定2（先が大きく後ろが小さい）で変える。選んだ線では今の比（2 → 3、1.5倍）で頭と尾を大きくする。",
	"2026-11-18 タスク担当：波紋は 3.6秒（点の1周の3倍）、2つ目は 1.8秒遅れ。`wait` の止まった点線（8px の間）は流れる線と区別するため今のまま。",
]

questions: []
