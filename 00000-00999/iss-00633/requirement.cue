package spec

// 要件（Issue）。型 specdock/v1。

schema: "specdock/v1"

assurance: {
	level:  "standard"
	reason: "ダッシュボードの表示だけを直し、データや操作には触れない"
}

purpose: """
	構造の図の木の表示（入れ子でない表示、mode tree）でも、依存の線どうしが車線の間隔（8px）より近く重ならないようにする。
	木の『全体』で、線の通り道の計算（router.js の寄せ）と、広げの繰り返し（layout.js の routeLayout）が、違反を残したまま終わる原因を直す。
	入れ子の表示の結果は変えない。
	"""

background: """
	iss-00627 の report.md の『次の提案』：木の表示の taikyohiyou_project『全体』で、node の routeLayout の audit に overlaps が 9 ある（iss-00627 の前から同じ。入れ子の表示はすべて0）。
	この PC の今のデータ（2026-11-17）では同じ組が 3。iss-00627 の固定した入力（`tests/fixtures/issue627/route_inputs.json` の product、稼働の印なし）で 9 が再現する。

	この Issue の測り（2026-11-17、report.md の『原因』）で、原因は2つ。

	1. 寄せの詰め方が、同時に重なる本数より多い車線を階段に積む（router.js の nudgePass）。束の並びの順は、重なる組のすべてに前後を決め（交差の数が同じ組も、A* の位置と線の番号で決める）、
	   手前の線分 + S より奥に詰める。木では、Initiative の親の線と Epic の列の間の長い通り道を、範囲の少しずつずれる長い縦の線分が何十本も通るので、
	   前後の鎖が通り道を1本ずつ奥へ押し、同時に重なるのは 10〜11 本（通り道は 43 車線ぶん）なのに 136〜176px あふれる。
	   あふれた分を `lacking()` が不足として申告し、木の字下げ（`tree.indent` は全部の段に効く1つの間）が毎回広がり、10 回の繰り返しが落ち着かない（違反の数 1351 → … → 9）。
	2. 広げの要求がないのに検査の違反が残る巡を、落ち着いたと見なして違反0と報告する（layout.js の routeLayout）。横の寄せは縦の線分の長さを変えるので、
	   最後の横の寄せの後に縦の線分の近い重なりが残ることがあり、その巡が、それより前の違反0の巡を押しのけて採られる（1 を直しただけの試作で、housing-lifecycle『全体』の木が 0 → 4）。

	統括の決定（依頼書、2026-11-17）：原因を特定し、木の表示でも違反0にする。直しで入れ子の表示の結果が悪くならないこと（iss-00627 の 240 組の node の比べを、木と入れ子の両方でやり直し、悪化0）。見た目が変わるなら前後を写す。
	"""

includes: [
	"`views/graph/router.js` の寄せ（木の表示で、詰めが範囲からあふれる束の詰め直し）",
	"`views/graph/layout.js` の routeLayout の、落ち着いた巡の判定",
	"テスト（`tests/unit/presentation/`、`tests/js/`）",
	"node の比べ（240 組と固定した入力）と、実機の前後の写し",
]

excludes: [
	"入れ子の表示の寄せ（入れ子の束は今の並べ方のまま）",
	"箱・枠の大きさ、配置の並び方、`SIZE`、広げの間の名前（gap key）、繰り返しの回数 `ROUNDS`",
	"検査（`audit`、`specdockEdgeAudit`）の規則",
	"構造の API、モデル、orca-web の部品",
]

requirements: {
	"R-01": {
		title: "木の表示で、詰めが範囲からあふれる束を、同時に重なる本数に近い車線に詰め直す"
		text: """
			木の表示の寄せで、今の並べ方の詰めが目指す範囲からあふれる束（over > 0.5px）は、交差の数で前後の決まる組の順だけを守り（守ると範囲からあふれる線分では捨てる）、
			ほかの組はどちら側に置いてもよいとして、手前から、重なる線分のどれとも S − 0.5px 以上（audit の車線の閾値）離れた最初の位置に詰め直す。詰め直しのほうがあふれが小さく、近い組（S − 0.5px 未満の重なる2本）が増えないときだけ採り、
			採った束の不足は、置いた位置の超えから申告する。
			"""
		acceptance: [
			"左に親の線、右に箱の列、箱 i から i + 5 への線を持つ小さな入力（木の表示、40 個の箱、通り道 120px）を route(G) に渡すと、audit の overlaps が0で、広げの要求の最大が S 以下",
			"入れ子の表示（G.nested）の束は、この詰め直しを使わない（コードの条件と、R-04 の入れ子の組の経路が直す前と同じこと）",
		]
	}
	"R-02": {
		title: "検査の違反が残る巡を、落ち着いたと見なさない"
		text: """
			routeLayout は、広げの要求と出入りの位置の不足がなく、かつ検査の違反（boxHits・ownHits・overlaps・diagonal・portShare・trunkOverlaps・failed）が0の巡だけを、落ち着いたとして採る。
			広げの要求がなくても違反が残る巡は、ほかの巡と同じく違反の数で比べ（少ないもの、同じなら早いもの）、そこで繰り返しを終える。返す `problems` は、採った巡の検査の違反の数と一致する。
			"""
		acceptance: [
			"固定した入力と R-03 の組で、routeLayout の返す problems が、返した経路の audit の違反の数と一致する",
		]
	}
	"R-03": {
		title: "木の表示の『全体』で、線の違反が0"
		text: """
			iss-00627 の固定した入力（product と business、稼働の印あり・なし）と、この PC の8つのリポジトリの構造の、木の表示 × 範囲3（全体・いま・これから）で、node の routeLayout の audit の違反が0。
			"""
		acceptance: [
			"固定した入力の product・business の木の『全体』（稼働の印なし）で違反0（テスト）",
			"8つのリポジトリ × 範囲3 と固定した入力 × 範囲3 × 稼働の印あり・なしの木で違反0（比べの結果を report.md に残す）",
			"実機（この PC の状態の置き場の写し、倍率 100%、稼働の印の後）で、taikyohiyou_project の木の『全体』の `specdockEdgeAudit()` の違反が0（1440 の明暗）",
		]
	}
	"R-04": {
		title: "入れ子の表示と、ほかの構造を悪くしない"
		text: """
			iss-00627 R-05 と同じ 240 組（Scope のある 8 つのリポジトリ × 入れ子（範囲3 × 見える幅 344・360・600・872・984・1240・1312・1344・1424）・木（範囲3 × 1240））と、固定した入力の2つの構造の同じ 60 組で、
			直す前と後の node の audit を比べ、違反の数が増える組が0。入れ子の組は経路まで同じ。
			"""
		acceptance: [
			"比べの結果（増えた組0、減った組、経路が同じ組、変わった組）を report.md に残す",
			"既存の構造の図のテスト（入れ子と木の run を持つ写し `graph_dom_golden.json` など）が書き直しなしで通る（試作で確かめた。写しが変わるなら、変わった run と理由を report.md に書いて書き直す）",
		]
	}
	"R-05": {
		title: "見た目が変わる組は、前後を写す"
		text: "線の経路が変わる木の組のうち、違反のあった taikyohiyou_project の木の『全体』を、直す前と後で写し（倍率 100%、1440、明暗）、report.md に残す。"
		acceptance: [
			"前後の写しが Artifact として report.md から辿れる",
		]
	}
}

failures: {
	"F-01": {
		title: "詰め直しが良くならない束は、今の並べ方のまま"
		text:  "詰め直しのあふれが今より 0.5px 以上小さくないか、近い組が増えるときは、その束は今の並べ方の結果と不足の申告を使う。"
	}
	"F-02": {
		title: "どの巡も違反0にならないときは、最も違反の少ない巡を採る"
		text:  "10 回の繰り返しのどの巡も違反0で落ち着かないときは、今どおり、違反の最も少ない巡（同じなら早いもの）を採り、その違反の数を problems に返す。"
	}
}

constraints: [
	"検査の規則（router の `audit`、画面の `specdockEdgeAudit`）は変えない。線を描いた後に違反を隠す直し方はしない（iss-00627 と同じ）",
	"入れ子の表示の結果を悪くしない（統括の決定）。D-01 の詰め直しは入れ子に使わない。D-02 の落ち着きの判定は入れ子にも効くが、落ち着いた巡が違反0なら今と同じ巡を採るので、R-04 の入れ子の組では経路まで同じ（違反を残して落ち着いていた入れ子の構造では、違反の少ない巡に変わりうる）",
	"本人の環境に特化した名前や決まりを入れない。普遍的でシンプルな仕組みにする（本人の方針）",
]

decisions: [
	"原因を特定し、木の表示でも違反0にする。入れ子の結果を悪くせず、240 組の比べを木と入れ子の両方でやり直す。見た目が変わるなら前後を写す（統括、依頼書 2026-11-17）",
	"詰め直しは木の表示だけに使う。入れ子の束は短い通り道で今きれいに解けており、経路を変えない（タスク担当、2026-11-17。試作で入れ子にも使うと 270 組のうち 121 組の経路が変わり、違反は変わらなかった）",
	"巡の回数 `ROUNDS` と木の字下げの広げ方は変えない（タスク担当。2つの直しで、木の30組はすべて9巡以内で落ち着いた）",
]
