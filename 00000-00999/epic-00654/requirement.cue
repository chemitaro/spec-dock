package spec

// 要件（Epic）。型 specdock/v1。

schema: "specdock/v1"

assurance: {
	level:  "standard"
	reason: "構造の図と横断の構造の操作の決まりを変える"
}

purpose: "構造の図と横断の構造を、キーボードとマウスで直感的に動かせるようにする（本人の要望 2026-11-17）。この Epic は Issue iss-00655 の1つだけを持つ。"

includes: ["両方の図の、マウスのホイール・トラックパッド・矢印キー・+ - 0 の操作"]
excludes: ["ドラッグ・タッチ・ボタン・線や箱の描き方", "Python の API・保存"]

requirements: {
	"R-01": {
		title: "マウスのホイールで、カーソルの位置を中心に拡大・縮小する"
		acceptance: ["iss-00655 の R-01 の受入"]
	}
	"R-02": {
		title: "トラックパッド（2本指で動かす、ピンチで拡大・縮小）は今のまま"
		acceptance: ["iss-00655 の R-02・R-03 の受入"]
	}
	"R-03": {
		title: "矢印キーで図を動かし、+・-・0 で拡大・縮小・全体を収める。入力欄やボタンの操作を邪魔しない"
		acceptance: ["iss-00655 の R-04・R-05 の受入"]
	}
	"R-04": {
		title: "両方の図で同じ動きにし、処理を1か所に寄せ、操作の説明を書き直す"
		acceptance: ["iss-00655 の R-06・R-07 の受入"]
	}
}

constraints: ["本人の環境に特化した決まりを入れない（本人の方針）"]
decisions: ["統括の決定（依頼書 2026-11-17）：ホイール・トラックパッド・矢印キー・横取りしない場面・1か所に寄せることの6項目。詳細は iss-00655 の decisions"]
