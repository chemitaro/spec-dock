package spec

// 要件（Issue）。型 specdock/v1。

schema: "specdock/v1"

assurance: {
	level:  "standard"
	reason: "ダッシュボードの表示だけを直し、データや操作には触れない"
}

purpose: """
	『横断の構造』（`/graph`）で、リポジトリごとに繰り返される同じ種類の知らせ（構造が古い、PR の状態が分からない など）を、
	ページの上に種類ごとに1回だけまとめ、リポジトリの枠の中の場所を空ける。あわせて、縮めた枠の測り直し（iss-00627）が
	横断の構造でも各リポジトリの図と同じに働くことを、実機で確かめて記録する。
	"""

background: """
	iss-00629 の写し（`iss-00629/artifacts/20261117t005333z--allgraph-1440-light-next-first.png`）では、各リポジトリの枠の見出しの下に
	「3時間前から更新されていません（定期の同期を確かめてください）。次の1手：spec-dock canonical status」と「PR の状態が分かりません。」が
	リポジトリごとに繰り返し出て、1つの枠で 48px を取る（compose.js の REPO.warn 24px × 2）。

	縮めた枠の測り直し：iss-00629 の report の『次の提案』は「allgraph.js は #630 の測り直しを使っていない」と書くが、
	このタスク担当の確かめ（2026-11-17）では、iss-00627 のコミット `10610ce89` で allgraph.js の `checkRows` に `compactNeeds`・`headsDiffer`・`tallNeeds` が入り、
	リポジトリごとの `r.heads` が routeLayout と `sigOf` に渡っている（静的な検査 `test_dashboard_graph_fit.py` もある）。iss-00627 の実機の表でも `/graph` の18組ではみ出し0。
	統括はこの事実を了解した（2026-11-17、msg_9cf3dc66bd23）。
	"""

includes: [
	"`views/_shared/logic.js` の `overviewWarnings` の知らせに、種類（kind）と、種類ごとの値（detail）を足す（文と level は変えない）",
	"`views/allgraph/` の新しい純粋な部品（知らせを、上にまとめるものと枠に残すものに分ける）",
	"`views/allgraph.js` と `views/allgraph.css`：上の帯のまとめの行、枠の知らせの行の数、最初の表示の上端",
	"テスト（`tests/js/`、`tests/unit/presentation/`、`tests/unit/infra/`）",
	"実機の確かめ（`/graph` のまとめの行、縮めた枠のはみ出し0、線の検査0、写し）",
]

excludes: [
	"各リポジトリ単体の構造の図（`views/graph.js`）と『横断の概況』（`views/overview.js`）の知らせの表示",
	"知らせの文・level・次の1手の中身、知らせを作る API",
	"縮めた枠の測り直しの仕組みそのもの（iss-00627 のまま）",
	"本人の環境に特化した決まり（特定のリポジトリの名前による扱い）",
]

requirements: {
	"R-01": {
		title: "文が決まった種類の知らせは、ページの上に種類ごとに1行でまとまる"
		text: """
			次の種類の知らせは、当てはまるリポジトリが1つでも、上の帯（状態のチップの下、拡大縮小しない）に種類ごとに1行だけ出し、
			当てはまるリポジトリの名前を一覧の順に並べる：構造が古い（その経った時間を名前に添える）、スナップショットがない、知らない版、読めない（最後に読めた時間を添える）、
			構造の異常（件数を添える）、PR の状態が分からない。行は重さ（error、warning、info）の順、同じ重さでは上の種類の順。
			行の印と色は今の知らせと同じ（level による）。次の1手があれば、行の終わりに1回だけ出す。
			名前はリポジトリの name。同じ name の別のリポジトリが一覧にあるときだけ owner/name。長い行は1行のまま省略し（…）、全文を title に持つ。
			範囲（これから・いま・全体）によらず、読み込みを終えた一覧のすべてのリポジトリを数える（枠が出ていないリポジトリも名前に出る）。
			"""
		acceptance: [
			"node の検査で、2つのリポジトリが古く、1つが PR の状態が分からないとき、まとめの行が2行（warning の『構造が更新されていません』に2つの名前と時間、info の『PR の状態が分かりません』に1つの名前）で、どの枠にもその知らせの行がない",
			"同じ name が2つあるときだけ owner/name になる、行の順が重さの順、次の1手が1回だけ出ることを、純粋な部品の node の検査で確かめる",
			"『これから』で枠の出ないリポジトリも、まとめの行の名前に出る",
		]
	}
	"R-02": {
		title: "リポジトリの枠には、そのリポジトリにだけある知らせだけが残る"
		text: """
			文がリポジトリごとに違う知らせ（リポジトリを読めなかった理由、二重のクローン REPOSITORY_AMBIGUOUS の文）だけを、今と同じ形で枠の見出しの下に出す。
			ただし、読めないリポジトリ（画面の状態が failed：API の失敗、または Scope が0件でスナップショットが ok でない）は、その知らせのすべてが読めない理由なので、種類によらず枠に残し、まとめの行には出さない（F-01）。
			枠の知らせの行の高さ（compose の warns）と、『これから』で知らせだけで枠を出す規則（alerts）は、枠に残る知らせだけで数える（上へ移した知らせのためだけの空の枠は出さない）。
			"""
		acceptance: [
			"node の検査で、読めなかったリポジトリの枠に『このリポジトリを読めませんでした（…）』の行が残り、その枠の高さは知らせの行1つ分",
			"『これから』で、表示する Scope がなく、古いだけのリポジトリの枠は出ない（名前はまとめの行に出る）",
			"Scope が0件でスナップショットが読めない（failed の）リポジトリの枠には『構造のスナップショットが読めません』の行が残り、まとめの行にその名前は出ない",
		]
	}
	"R-03": {
		title: "最初の表示と画面の操作が、まとめの行の下から始まる"
		text: "最初の表示（PC の幅合わせ、スマホの 74%）と『収める』の上端は、まとめの行を含む上の帯の下端から 8px 下。まとめの行は、文字の行の矩形（全文の title を見るため）だけがポインターを受け、行の外（帯の空いたところ）では図のドラッグ・拡大がそのまま効く。"
		acceptance: [
			"node の検査（styled）で、まとめの行があるとき最初の表示の ty が、まとめの行の下端 + 8 以上",
			"静的な検査で、allgraph.css の `.ax-sum` が pointer-events: none、その `li` が pointer-events: auto で、行の幅が中身の幅（fit-content、max-width 100%）",
			"実機の写し（1440・390、明暗）で、まとめの行がチップの下にあり、図の最初の表示と重ならない",
		]
	}
	"R-04": {
		title: "横断の構造で、縮めた枠の測り直しが働き、線の検査が0のまま"
		text: """
			実機（この PC の状態の置き場の写し、`dashboard serve --offline`）の `/graph` で、1440・1000・390 × 『これから・いま・全体』× 明暗の18組について、
			倍率 100%、稼働の印の後に、`window.specdockEdgeAudit()` の total の違反（boxHits・ownHits・overlaps・diagonal・portShare・trunkOverlaps・frameExits・failed・missing・markOverflow）が0、
			縮めた枠（`.gx-frame.is-compact`）に scrollHeight が clientHeight を越えるものが0。
			"""
		acceptance: [
			"18組の数を report.md の表に残す",
		]
	}
	"R-05": {
		title: "ほかの画面の知らせは変わらない"
		text: "各リポジトリ単体の構造の図と『横断の概況』の知らせの文・level・次の1手・並びは今と同じ。`overviewWarnings` に足す項目（kind・detail）は、ほかの項目を変えない。"
		acceptance: [
			"既存の `overviewWarnings` の検査（level と text）と横断の概況の検査がそのまま通る",
			"`overviewWarnings` の各種類に kind が付くことを node の検査で確かめる",
		]
	}
}

failures: {
	"F-01": {
		title: "読み込み中・読めないリポジトリは、まとめの行を壊さない"
		text:  "読み込み中のリポジトリは数えない。読めない（failed の）リポジトリは、知らせのすべてを枠に持ち、まとめの行に出ない（Scope が0件でスナップショットが読めない・ない・知らない版のときも、枠が理由を示す）。知らせが1つもなければ、まとめの帯は隠れ（hidden）、上の帯の高さは今と同じ。"
	}
}

constraints: [
	"新しい色の値やトークンを足さない（allgraph.css の決まり）",
	"compose.js の REPO の寸法と、縮めた枠の測り直しの仕組みは変えない",
	"普遍的でシンプルな規則にし、特定のリポジトリの名前で扱いを変えない（本人の方針）",
]

decisions: [
	"縮めた枠の測り直しは iss-00627 で allgraph.js に既に入っている。この Issue では実機で確かめて記録する（統括、2026-11-17、msg_9cf3dc66bd23）",
	"判断A 案a：上へまとめるかは種類で決める（当てはまるのが1つでも上へ）。枠に残すのは文がリポジトリごとに違うもの（読めなかった理由、REPOSITORY_AMBIGUOUS）だけ（同上）",
	"判断B 案a：まとめの行は上の帯（状態のチップの下、拡大縮小しない固定の行）に種類ごとに1行。名前は name（同じ name が2つのときだけ owner/name）、長ければ省略し全文を title。最初の表示の上端はこの行の下（同上）",
	"判断C 案a：『これから』で知らせだけで枠を出す規則は、枠に残る知らせだけで数える（同上）",
]
