package spec

// 要件（Issue）。型 specdock/v1。

schema: "specdock/v1"

assurance: {
	level:  "standard"
	reason: "ダッシュボードの表示だけを変え、データや操作には触れない"
}

purpose: """
	構造の図（`/r/<repo>/graph`）と『横断の構造』（`/graph`）の指揮の線を、親の側の上の縁から出て、子の側の上の縁から入る、上にふくらむ弧（ホップ、跳ねて渡る形）にする。
	今の『下から出て下から入る』U 字の回り込みをなくし、どの線も同じ形で読めるようにする。
	"""

background: """
	本人の指摘（2026-11-17）：今の指揮の線は、親の印の下から出て子の印の下から入るので、U 字に回り込んで、いびつに見える（統括の議論の資料）。本人の決定：上から出て、上から入る。ホップしているような見た目がよい。

	タスク担当が確かめた今の事実（2026-11-17、`92e26aff7`、試しのサーバー）：
	- 端は `views/graph/command.js` の `commandModel` が決める。箱（Issue の箱・木の枠の箱）の印は、印の下の辺の中央から箱の下の縁まで短い線（`stubs`、端の層）で出て、出口は箱の下の縁、出る向きは下。入れ子の枠の見出しの印と帯の印は、印（帯は項目）の下の縁から下へ出る。塊・祖先の枠は相手に向いた縁（枠が相手を中に含むときは内側の下の縁）。
	- 道は三次ベジェ（`M P C c1 c2 C`、制御点は両端の出る向きに長さ `min(140, max(24, 0.45·距離))`）。両端が下向きなので、横に並ぶ2つの端は下へ回り込む U 字になる（実データ：帯の統括 → 帯のタスク担当で `M 188 12 C 188 105.6 396 105.6 396 12`）。
	- 同じ箱の親子は箱の下（違う行なら右）の縁の外へ 8〜16px ふくらむ弧（`boxArc`）、同じ枠は見出しの下 12px の弧（`frameArc`）、帯の同じ項目は項目の上 16px の弧（`bandArc`）。弦は 40px 以上に広げる。
	- 端の層（`.gx-cmd-top`、箱の上）には、箱の中の短い線と、子の端の点（`cl-dot`、半径 2.5）がある。線の本体の層（`.gx-cmd`）は枠の上・箱の下。
	- 箱の行と行の間は 14px（`BASE.wrapRow`、依存の線の道で広がることがある）。箱の上に別の箱があると、箱の上の縁の外の余白は 14px しかない。
	- 線の形・端の位置・弧は、iss-00646（線ごとの SVG、合成スレッドの切り替え）の後もこの計算のまま。
	"""

includes: [
	"`commandModel` の端（すべて上の縁、上向き）、道（ホップの弧）、同じ箱・同じ枠・帯の同じ項目の弧、`top`",
	"端の層の描き方：子の端の下向きの矢じりと、受けた印の縁の指揮の色",
	"Epic epic-00615 の requirement.cue・design.cue の該当の節（R-04・R-05・制約・D-02・D-04・D-10）を、iss-00646 の決定とこの Issue の決定に合わせて直す",
	"直す前と後の写しと測り（同じ台本）",
]

excludes: [
	"点の流れ・波紋・状態ごとの見え方・色・太さ・帯の形と寸法・押したときの動き（今のまま）",
	"iss-00646 の描き方（線ごとの小さな SVG、止めた絵4枚の opacity の切り替え、動かす間・画面の外・裏で止める）",
	"依存の線、箱、枠の配置と寸法（行の間の余白を広げない）、凡例",
	"Python の API・保存・モデル・orca-web",
]

requirements: {
	"R-01": {
		title: "どの指揮の線も、親の側の上の縁から上へ出て、子の側の上の縁へ上から入る"
		text: """
			端の位置（配置の計算で決め、DOM では測らない）：
			- 箱（Issue の箱・木の枠の箱）・入れ子の枠の見出しの印：その印の中央の真上の、その箱（枠）の上の縁。箱の中には線を引かない（箱の中の短い線をやめる）。
			- 帯の印：その印の中央の真上の、帯の項目の上の縁。
			- 塊・祖先の枠（印のない端）：その塊・枠の上の縁の中央。同じ縁から出る線は、今と同じ 10px ずつずらす。枠が相手を中に含むときも上の縁。
			- 印の位置が分からない（F-04 の今の扱い）：その箱・枠の上の縁の中央。
			出る向きと入る向きは、どの端でも上（子が親より上にある場合も、下にある場合も変えない）。
			"""
		acceptance: [
			"node のテストで、箱・枠の見出し・帯・塊・祖先の枠（相手を含む場合を含む）・印の位置が分からない端の、それぞれの `from`・`to` が上の縁の上（y が縁の y に一致）にあり、印のある端は x が印の中央に一致する",
			"どの線の `stubs` も空で、端の層に箱の中を通る道がない",
			"道の始めの制御点が `from` より上、終わりの制御点が `to` より上にある（子が親より上・下・同じ高さのどれでも）",
		]
	}
	"R-02": {
		title: "道は、上にふくらむ1本の弧（ホップ）で、高さは端の間の水平の距離と高さの差で決まる"
		text: """
			違う箱・枠・項目の間の線は、三次ベジェ1本の、上にふくらむ弧にする。弧の高さ H は、2つの端の水平の距離 dx と上の縁の高さの差 dy から、下限と上限の間で決める（数は設計の HOP）。
			頂点は、高い方の端よりちょうど H 上にある（2つの端の高さが違っても、H を越えて上へはみ出さない）。
			2つの端の水平の距離が小さい（真上・真下に近い）ときも、弧が1本の縦の線につぶれないよう、横にふくらませる。
			弧の頂点が、上にある枠の見出しの文字と重なっても、iss-00617 の『見出しの文字を線の上に出す』で文字が読める（`heads` が 0）。
			弧が上にある箱の後ろを通るときは、今の曲線と同じく、箱の後ろ（線の本体の層は箱の下）を通る。
			"""
		acceptance: [
			"node のテストで、同じ高さの端と高さの違う端（差 700px を含む）の弧の頂点（道の細かい点の y の最小）が、高い方の端より H（±0.5px）上にあり、H が dx・dy とともに増え、下限と上限の間にある",
			"dx が 0 の2つの端（真下の子）の弧が、両端を結ぶ縦の線から横に 8px 以上離れる点を持つ",
			"実機で `specdockCmdAudit()` の `heads` が 0",
		]
	}
	"R-03": {
		title: "同じ箱・同じ枠・帯の同じ項目の中の親子も、上の縁から出て同じ上の縁へ戻る小さなホップにする"
		text: """
			同じ箱（同じ Issue）・同じ入れ子の枠・帯の同じ項目の中の親子は、その上の縁の、それぞれの印の真上から出て戻る、小さな上にふくらむ弧で結ぶ。前の『箱の下（右）の縁の外の弧』と『枠の見出しの下の弧』はやめる。
			弧の高さは下限 18px（統括の決定の目安 16〜20px）。2つの印が縦に重なり、真上の点が 12px より近いときは、箱の中で 12px 離す。
			弧の上に別の箱・枠・塊・帯の項目があり、18px の弧が入らない（上の余白から 3px を引いた値が 18 より小さい）ときは、その余白に収まる高さ（8px 以上）に下げ、`crowded` に数える。8px も入らないときは 8px にし、重なりを数える。
			"""
		acceptance: [
			"node のテストで、同じ箱の同じ行・違う行の2人、同じ枠の見出しの2人、帯の同じ項目の2人に、上の縁から出て同じ上の縁へ戻る弧（`kind: \"arc\"`）があり、頂点が縁より 18px 上で、弦が 12px 以上",
			"上の余白が 14px（行の間）の箱の中の親子の弧が 11px に下がり、`crowded` が 1、`boxOverlaps` が 0",
			"実データで `specdockCmdAudit()` の `boxOverlaps`・`edgeOverlaps` が 0",
		]
	}
	"R-04": {
		title: "受けた側に小さな下向きの矢じりを付け、受けた印の縁を指揮の色にする"
		text: """
			子の端（上の縁）に、先を縁に付けた小さな下向きの矢じり（指揮の色の塗り）を描き、子の端の点（`cl-dot`）をやめる。
			子の端に印があれば、その印の四角の縁を、指揮の色の細い線（1.5px）で囲む（届いたことを示す）。帯の印は帯の層の中に描く（帯の項目は端の層の上にある）。
			矢じりと縁は動かない絵で、状態（`done` は薄い）と押したときの強調・薄め（`is-cmd-hl`・`is-cmd-off`）に、線と同じに従う。減らす設定でも同じに見える。
			"""
		acceptance: [
			"node のテストで、印のある子の線の端の層に、先が `to` にある下向きの矢じり1つと、印の四角を囲む縁1つがあり、`cl-dot` がない。帯の子の縁は帯の層の入れ物（`.gx-band-cr`）に入る",
			"CSS の静的な検査で、矢じりの塗りと縁の線が指揮の札（`--sd-cmd`）の色で、`done` で薄く、押したときの薄めが縁にも効く",
			"実機の写しで、両方の画面・明暗で、矢じりと縁が見える",
		]
	}
	"R-05": {
		title: "点の流れ・波紋・状態・色・帯・押したときの動き・軽くした描き方は変えない"
		text: """
			点の流れ（止めた絵4枚の opacity の切り替え、40px/秒）、波紋（親の端の HTML の輪）、状態ごとの見え方（working は流れる、待ちは止まった点線、done は薄い）、色、帯、押したときの動き、線ごとの小さな SVG、動かす間・画面の外・裏で止める仕組みは、iss-00646 のまま。
			動きの重さは戻らない：iss-00646 の台本で、動きありの TaskDuration が、横断の構造 0.11秒以下、spec-dock の構造の図 0.07秒以下／10秒。
			"""
		acceptance: [
			"iss-00646 の node・CSS・画面のテスト（command_motion、層の HTML、止める仕組み）が、端の層の中身の期待のほかは変えずに通る",
			"同じ台本の直す前と後の数が report.md にあり、後が上の数以下",
			"実機で `specdockEdgeAudit()` の違反が0、`specdockCmdAudit()` の `spotDrift` ≤ 0.4、`spotMissing` 0",
		]
	}
	"R-06": {
		title: "Epic epic-00615 の文書を、今の決定に合わせる"
		text: """
			epic-00615 の requirement.cue（R-04・R-05・制約の動きの行）と design.cue（D-02 の端と道、D-04 の動き、D-10 の弧）の、『下から出る端・箱の中の短い線・下や右の縁の外の弧』と『端から端まで2〜3秒、stroke-dashoffset』を、この Issue の決定（上の縁のホップ）と iss-00646 の決定（止めた絵4枚の opacity の切り替え、一様に 40px/秒、波紋は HTML の輪）に置き換える。履歴の決定（decisions）は消さず、置き換えた決定を足す。
			"""
		acceptance: [
			"epic-00615 の requirement.cue・design.cue に、下から出る端・`stubs`・下や右の縁の弧・『2〜3秒』・stroke-dashoffset の動きを今の決まりとして書いた文がなく、`spec-dock scope check epic-615` が誤りなしで通る",
			"Epic の文書の直しが、この Issue の仕様と一緒に spec-review を通る",
		]
	}
}

failures: {
	"F-01": {
		title: "印の位置が分からない端は、上の縁の中央から出入りし、印の縁は描かない"
	}
	"F-02": {
		title: "横断の構造で、弧の頂点が世界の上の縁より上に出ないよう、高さを下げる"
	}
}

constraints: [
	"線のつながり・居場所・端と道の計算は、DOM のない純粋な関数（`command.js`）に置き、node のテストで確かめる",
	"動きは iss-00646 の仕組みだけ（SVG の `<animate>`・`animateMotion`・canvas・`blur(`・JS の時計の描き直しを使わない）",
	"本人の環境に特化した名前の決まりを入れない",
]

decisions: [
	"2026-11-17 本人：上から出て、上から入る。ホップしている（跳ねて渡る）ような見た目がよい。",
	"2026-11-17 統括（依頼書の決定1〜5）：すべての線を親の側の上から出て子の側の上から入る上にふくらむ弧にする。箱の中の印は箱の中を通さず印の真上の箱の上の縁から出入りし、帯の印はその印の上の縁。受けた側に小さな下向きの矢じりと受けた印の縁の指揮の色。高さは水平の距離と高さの差に応じる。同じ箱の親子も同じホップで、高さの下限は 16〜20px。子が親より上でも向きは変えない。点・波紋・状態・色・帯・押したときの動き・iss-00646 の描き方は変えない。cmdAudit と依存の線の違反0を保つ。Epic の D-04・R-05 の直しは、この Issue に限って許す。",
	"2026-11-17 タスク担当（仕様のレビュー round-1 の P1-1）：頂点の高さは、制御点の長さの倍率 λ を二分探索で決めて、高さの差があってもちょうど H にする（4/3 の固定の倍率では、高さの差が大きいと頂点が上へはみ出し、上限と天井を越えるため）。",
	"2026-11-17 タスク担当：子の端の点（`cl-dot`）は矢じりに置き換える（同じ場所に2つの印を重ねない）。",
	"2026-11-17 タスク担当：入れ子の枠の見出しの印の端も、印の真上の枠の上の縁にする（決定1の『印の真上の上の縁』をすべての印に同じに当てる）。",
	"2026-11-17 統括（タスク担当の問い msg_49b208d3c7a7 への答え msg_35a70745c7b6）：問1は A。同じ箱のホップは 18px、上の余白が足りなければ余白 − 3px まで下げ（下限 8px）、crowded に数える（配置を動かさず、線が箱に隠れて切れない）。問2はタスク担当の案のとおり（帯の項目と間の箱の後ろを通る、違う箱の間の弧は 18〜56px で下げない、枠の見出しの印の端も印の真上の枠の上の縁、子の端は矢じり）。写しで、同じ箱のホップが 11px に下がった例と 18px の例の両方を見せる。",
]
