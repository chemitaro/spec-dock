package spec

// 要件（Epic）。型 specdock/v1。書き方は spec-dock/docs/authoring/ のガイドにある。

// 型の版。消さない。
schema: "specdock/v1"

// 保証レベル。正本はここだけ。
assurance: {
	level:  "strict"
	reason: "ダッシュボードから、メッセージの送信などの書き込みの操作をできるようにする。Tailscale を通して同じ tailnet の端末から操作が届くので、偽の要求や誤った相手への送信が、エージェントの作業とリポジトリに及ぶ。送った操作は取り消せないことがある。"
}

purpose: "SpecDock のダッシュボードの横の欄と詳しい画面に「エージェント」のタブを足し、その Scope に対応する worktree のエージェントを選んで、orca-web の詳細とチャット（会話の表示と送信）をその場で使えるようにする（ダッシュボードの第3段階）。"

background: """
	2026-11-03 の利用者の決定：チャットは SpecDock の中に作らず、独立したサービス orca-web（epic-00471 の背景を参照）の部分として作る。この Epic は、SpecDock のダッシュボードで worktree とその中のエージェントを選び、orca-web のチャットの画面を埋め込む側を受け持つ。

	2026-11-14 の本人の要望：「SpecDock の Issue に紐づく worktree にいるエージェントを、SpecDock の詳細の画面に取り込む」。orca-web の詳細とチャット（orca-web の iss-00028）は完成し、本人が試しの画面（orca-web の iss-00014）で確かめた。

	2026-11-03 の時点で未決だった2点は、2026-11-14 の統括の決定で決まった（decisions）：埋め込みは orca-web の `/embed/agent` の iframe にする。送信は orca-web の iframe の中だけで行い、SpecDock は見るだけのまま。

	orca-web の詳細とチャットの契約（README の「エージェントの詳細とチャット」「送る」、2026-11-14 の main で確かめた事実）：

	- `<iframe src="<orca-web>/embed/agent?id=<エージェントの id を URL の符号にしたもの>&theme=<light|dark>">`。`id` は要約の `agents[].id`（要約の `detail` は `/embed/agent?id=…` の道）。置ける画面は `ORCA_WEB_READ_ORIGINS` のオリジンだけ（`frame-ancestors`）。
	- 中には題名と「Orca で開く」、畳んだ詳細（worktree、種類、状態、モデル、親と子、PR と CI）、会話、入力欄と送るボタン。幅 390px 以下では「Orca で開く」を出さない。
	- 送信の守りはすべて orca-web の中にある：同じオリジンの JSON、`POST /api/token` の短期のトークン、宛先の指紋（表示した宛先と送る宛先が違えば送らない）、設定のファイルの `sendEnabled`（既定は止まっている）、送る前の記録、結果不明の自動の送り直しをしない。会話と送信の API は同じオリジンだけで、CORS を付けない。

	SpecDock の今の状態（2026-11-14 の main `89f51588a`、iss-00589 の PR #590 のマージの後で確かめた事実）：

	- 横の欄（`views/_shared/panel.js`、iss-00587）と詳しい画面（`views/scope.js`）は、同じタブの並び `SCOPE_TABS`（`views/_shared/scope_tabs.js`）を使い、説明資料、概要、依存、配下、文書、Artifact、人のタスクの順。タブの中身の HTML が同じなら、欄は中身を置き換えない（iss-00587 R-08）。
	- iss-00589（文書のタブを詰める、2026-11-14 に完了）が、文書と説明資料のタブを、1行の細い帯（`.sd-framebar`、`frameBar(left, href)`）と、その下で残りの高さをすべて使う枠（`.sd-framebox`）の形にそろえた。横の欄では `.pn-body` の flex の列と `flex: 1`、詳しい画面では `height: max(420px, calc(100dvh - 120px))` で高さを決める。
	- epic-00471 の iss-00591 が、orca-web の場所、要約の読みの輪、Scope と worktree の対応と状態（`core/orca.js`、`core/orca_match.js`）を作る。
	"""

includes: [
	"共有のタブの並び（`SCOPE_TABS`）への「エージェント」のタブ（横の欄と詳しい画面の両方に出る）",
	"タブの中の、対応した worktree のエージェントの一覧（稼働の印つき）と、選んだエージェントの orca-web の詳細とチャットの iframe",
	"タブを出す条件、選びの持ち方、描き直しで iframe を読み込み直さないこと、Scope を変えたときに前の iframe を残さないこと",
	"orca-web に届かないとき、連携を切ったとき、埋め込みの画面の中、エージェントがいなくなったときの示し方",
	"配る文書への、エージェントのタブの説明",
]

excludes: [
	"第1段階（epic-00427）と第2段階（epic-00471）の表示の機能（稼働の印、Orca で開く、対応の計算）",
	"orca-web の側の変更（チャットの画面、送信の守り、`sendEnabled`、CORS と `frame-ancestors` の許す先）",
	"SpecDock のサーバーや画面からの書き込み（送信、トークンの取得、Orca の操作）",
	"company-os（nestboard）のダッシュボードへの埋め込み",
	"エージェントのいない worktree へ、新しくエージェントを起こすこと",
]

requirements: {
	"R-01": {
		title: "共有のタブの2番目に「エージェント」のタブがあり、対応した worktree にエージェントがいるときだけ出る"
		text: """
			`SCOPE_TABS` の説明資料の次（2番目）に、キー `agents`、名前「エージェント」のタブを足す。数の札は、対応した worktree のエージェントの数。
			横の欄と詳しい画面の両方に、同じタブとして出る。タブを出す条件は R-06 と合わせて次のとおり：

			- 連携が有効で状態が ok（iss-00591 の `orcaStatus`）のときは、対応した worktree（epic-00471 R-04）にエージェントが1人以上いるときだけ出す。
			- 状態が ok でない（届かない、Orca に届いていない、読み込み中、設定が壊れている）ときは、その Scope に SpecDock の worktree の記録が1つ以上あるときだけ出し、中に理由を示す（R-06）。
			- 連携を切っている（`enabled: false`）ときと、worktree の記録のない Scope では出さない。
			- 状態が ok でエージェントが0人でも、その Scope で選んでいたエージェント（R-02 の自動の選びを含む）がいなくなった知らせ（R-05）を示している間は、タブを出したままにする。
			- 埋め込みの画面でも、出す条件は同じ。中身は R-06 の知らせになる。

			タブを出さなくなったとき、そのタブを選んでいたら、今の既定のタブの選び（説明資料か概要）に戻る。
			"""
		acceptance: [
			"作業中のエージェントのいる Issue を選ぶと、横の欄のタブの2番目に「エージェント」があり、数の札が人数と同じ",
			"同じ Issue の詳しい画面にも、2番目に同じタブがある",
			"worktree のない Scope と、エージェントのいない worktree の Scope（選んでいたエージェントがいなくなった知らせの間を除く）には、タブがない",
			"`orca_web.enabled` が false のとき、どの Scope にもタブがない",
		]
	}
	"R-02": {
		title: "タブの中に、エージェントの一覧と、選んだエージェントの詳細とチャットがある"
		text: """
			タブの上に、対応した worktree のエージェントの一覧を置く。各行は、orca-web の稼働の印（`renderAgentMarks` にそのエージェントだけを渡したもの）、種類（`agentType`）、worktree のブランチを持ち、押すとそのエージェントを選ぶ。
			まだ選びがなく、エージェントが1人だけなら、すぐにそのエージェントを選び、その選びを覚える（押す手間をなくす）。一覧は1行の小さな見出しになる。2人以上なら、選ぶまで iframe を出さず、「エージェントを選ぶ」と示す。
			選びは、横の欄では欄の中に（iss-00587 の選びと同じく、ページの問い合わせを変えない）、詳しい画面では問い合わせの `agent` に持つ（自動の選びは、履歴を増やさずに問い合わせを書き換える）。
			覚えた選びは、人が一覧から選び直すまで、ほかのエージェントに自動で移らない。人数が増えても減っても、選びは変わらない。
			"""
		acceptance: [
			"エージェントが1人の Issue でタブを開くと、押さずにそのエージェントのチャットが出る",
			"エージェントが2人の Issue でタブを開くと、一覧が出て、押したエージェントのチャットが出る",
			"詳しい画面で選ぶと、URL の問い合わせに `agent` が入り、読み込み直しても同じエージェントが選ばれている",
			"横の欄で選んでも、ページの URL は変わらない",
			"1人のエージェント A のチャットが自動で開いた後、A が消えて別のエージェント B だけが残っても、B のチャットは自動で開かず、A がいなくなった知らせと一覧が出る",
			"A のチャットを開いたまま同じ Scope に B が加わっても、A が選ばれたままである",
		]
	}
	"R-03": {
		title: "詳細とチャットは orca-web の iframe で、タブの残りの高さをすべて使う"
		text: """
			選んだエージェントの `<orca-web>/embed/agent?id=<URL の符号にした id>&theme=<light|dark>` を iframe で置く。`theme` は SpecDock の今の明暗。
			iframe は、一覧の行の下の残りの高さをすべて使い、枠の外に二重のスクロールを作らない（iss-00589 の文書と説明資料の枠と同じ形と高さの決め方）。スマホの下から出る欄（3段のシート）でも、全体に広げたときに画面いっぱいに使える。
			iframe の `title` に、エージェントの種類と worktree のブランチを書く。
			"""
		acceptance: [
			"1440 の横の欄で、iframe の下端が欄の下端（足の帯の上）にそろい、欄の中身に縦のスクロールの棒が出ない",
			"390 で欄を全体に広げると、iframe が画面の高さの大半を使う",
			"暗い明暗で開くと、iframe の URL に `theme=dark` がある",
		]
	}
	"R-04": {
		title: "送信は orca-web の iframe の中だけで行い、SpecDock は書き込みに関わらない"
		text: """
			SpecDock のサーバーと画面は、orca-web の書き込みの口（トークン、送信の意図と確定、Orca で開く、設定）を呼ばない。iframe に本文、トークン、宛先を渡さない（`postMessage` を使わない）。iframe の URL に載せるのはエージェントの `id` と `theme` だけ。
			送れるか、送った結果、結果不明の帯は、orca-web の画面がそのまま示す。SpecDock は送信の可否を上書きしたり隠したりしない。
			"""
		acceptance: [
			"送信の操作の間、SpecDock の画面の文書（親）から orca-web への要求は、要約の GET と部品の読み込みだけで、送信の口への要求はすべて iframe の文書から出る（開発者ツールのネットワークの記録で確かめる）",
			"この Epic と epic-00471 で足す画面のファイルに、orca-web の書き込みの口の道（`/api/token`、`/api/send/`、`/api/open`、`/api/settings`）と `postMessage` がない",
				"ダッシュボードの画面のコードの `postMessage` は、今ある埋め込みの知らせ（`core/embed.js` の `window.parent` への1か所）だけで、iframe へは送らない",
		]
	}
	"R-05": {
		title: "選んだ相手と違うエージェントのチャットを見せない"
		text: """
			iframe は、今選んでいる Scope の、今対応している worktree の、選んだエージェントのものだけを置く。
			- Scope を変えたら、前の Scope の iframe を外す（欄が別の Scope を示しているのに、前の Scope のチャットが残らない）。
			- 要約の読み直しで、選んだエージェント（自動の選びを含む）がその Scope の対応した worktree にいなくなったら、iframe を外し、「このエージェントはいなくなった」と示して一覧に戻す。知らせは、人が一覧から選び直すか、別の Scope に移るまで残す（同じ Scope で別のタブに移って戻っても残る）。最後の1人がいなくなったときも、タブは知らせのために残る（R-01）。
			- 一覧の各行と iframe の `title` に、worktree のブランチを出し、送る前に相手の worktree を確かめられる。
			"""
		acceptance: [
			"Scope A のチャットを開いたまま Scope B を選ぶと、A の iframe がなくなる",
			"選んだエージェントが要約から消えると、次の読み直しの後に iframe がなくなり、知らせが出る",
			"選んでいたエージェントがその Scope の最後の1人で、それが消えたときも、タブが残って知らせが出る",
			"いなくなったエージェントが、後の読み直しで同じ id で戻っても、人が一覧から選び直すまでチャットは戻らず、知らせが残る",
		]
	}
	"R-06": {
		title: "orca-web を使えないときは、タブの中に理由を1行で示す"
		text: """
			R-01 の条件でタブを出しているが、詳細とチャットを置けないときは、iframe を置かず、理由を1行の知らせで示す。
			- 届かない（読みか import の失敗、形の違い）：「orca-web（<オリジン>）に届かない」と、確かめること（動いているか、`ORCA_WEB_READ_ORIGINS` がこの画面のオリジンを許しているか）。
			- Orca に届いていない（`connection.state` が unreachable）、読み始め（starting）：orca-web の `connection.state` の言葉で示す。
			- 読み込み中：「orca-web を読んでいる」。
			- 設定の `orca_web` の節が壊れている：その理由（`server.orca_web.problem`）と、直すファイル。
			- 埋め込みの画面の中：「埋め込みの画面ではチャットを開けない」と、SpecDock を直接開くリンク。
			状態が ok に戻ったら、知らせを消し、前の選びのエージェントがまだいればそのチャットを置く。
			"""
		acceptance: [
			"orca-web を止めると、エージェントのタブの中が「orca-web（http://127.0.0.1:8791）に届かない」の知らせになり、図とボードは動く",
			"orca-web を起動し直すと、次の読み直しの後に知らせが消え、チャットが出る",
			"埋め込みの画面（`embed`）では、タブの中が埋め込みの知らせになり、iframe がない",
		]
	}
	"R-07": {
		title: "描き直しで、詳細とチャットの iframe を読み込み直さない"
		text: """
			構造の描き直し、要約の 10 秒ごとの読み直し、Scope の JSON の読み直しでは、同じ Scope、同じエージェント、同じ明暗の間、iframe を作り直さず、読み込み直さない（入力欄に書きかけた本文が消えない）。同じ Scope のほかのエージェントが増えたり減ったりして一覧が変わっても、選んだエージェントの iframe は残す。
			次のときだけ、置き直してよい（書きかけの本文は消えうる）：明暗を変えたとき（新しい `theme` で置き直す）。選んだエージェントの worktree のブランチか種類が、要約の読み直しで変わったとき（相手の文脈が変わったので、新しいブランチと種類を title に出して置き直し、送る前に確かめ直せるようにする）。
			"""
		acceptance: [
			"チャットの入力欄に本文を書いたまま 60 秒待っても、本文が残り、iframe の読み込みが1回だけである",
			"チャットを開いたまま、同じ Scope にエージェントが1人加わるか、選んでいないエージェントがいなくなっても、iframe の読み込みが増えない",
			"選んだエージェントの worktree のブランチの名前が変わると、iframe の title が新しいブランチになって置き直される（同じなら置き直されない）",
		]
	}
	"R-08": {
		title: "配る文書に、エージェントのタブの説明を書く"
		text: "配る文書に、エージェントのタブを出す条件、送信は orca-web の中で行われ `sendEnabled` で止まっていること、届かないときの知らせの意味を書く。実際の IP は書かない。"
		acceptance: [
			"配る文書に、エージェントのタブの条件と、送信が orca-web の設定で止まっていることの説明がある",
		]
	}
}

