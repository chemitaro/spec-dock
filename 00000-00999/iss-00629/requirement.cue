package spec

// 要件（Issue）。型 specdock/v1。書き方は spec-dock/docs/authoring/ のガイドにある。

// 型の版。消さない。
schema: "specdock/v1"

assurance: {
	level:  "standard"
	reason: "ダッシュボードの表示だけを変え、データや操作には触れない"
}

purpose: """
	『横断の構造』（`/graph`、iss-00614）を開いたとき、リポジトリの枠が縦に1列に積まれて画面の横が空き、全体が小さくしか見えない問題を直す。
	リポジトリの枠の並びを、各リポジトリの中の Initiative と同じ考え（iss-00583：100% で見える幅で、左から右へ並べ、収まらなければ折り返す）にそろえ、最初の表示を『幅に合わせる』にして、文字が読める大きさで縦に読み進められるようにする。
	"""

background: """
	- iss-00614（#628、マージ済み）の写し `iss-00614/artifacts/20261116t215825z--allgraph-1440-light-next.png`：1440 の『これから』で『収める』の倍率は 12%（全体 6%・2%、390 では 7%・2%・1%）。
	- タスク担当の実データでの測り（2026-11-17、iss-00614 の試しの 18614 の写し、node で compose と routeLayout）：『これから』の世界は 1440 で 2412×6788 px（収める 10.6%）、1000 で 2104×8015、390 で 2104×10341。中の図は見える幅（bodyWidth）で折り返しても、折り返せない Initiative の塊のため幅が見える幅とほぼ同じか超える（housing-lifecycle 2024、input-devices 2332、taikyohiyou_project 1242、spec-dock 1078 px）。そのため、見える幅で折り返す限り、兄弟の枠が横に並ぶ余地はほとんどなく、『収める』の倍率はほとんど上がらない（試算 10.6% のまま）。
	- 見える幅を超えて折り返す案（枠の並びだけを倍率が最大になる幅で折り返す：21.6%、中の図も：25.5%）は、統括が採らなかった（下の decisions）。
	"""

includes: [
	"リポジトリの枠の組み立て（`views/allgraph/compose.js`）：枠の中で、親の自分の構造の図と子のリポジトリの枠を、見える幅で左から右へ並べて折り返す",
	"『横断の構造』の最初の表示（`views/allgraph.js` の `initialView`）：PC の幅で『幅に合わせる』",
	"node と偽の DOM のテストの更新と追加、実データでの測りと写し（report.md）、本人が見る試しの URL",
]

excludes: [
	"見える幅を超えて折り返す並び（統括の決定 2026-11-17。本人が望めば別に検討）",
	"各リポジトリの中の構造の図の配置（`views/graph/layout.js`）と、構造の図の画面（`graph.js`）の見え方と動き",
	"『収める』の式（iss-00614 の下限 0.002 を含む）、拡大縮小、移動、範囲の選び、保存（`specdock.allgraph.v1`）",
	"既存の線の違反の修正（iss-00627）、指揮の帯の描画（epic-00615 の iss-00617）",
]

requirements: {
	"R-01": {
		title: "リポジトリの枠の中で、親の図と子の枠を、見える幅で左から右へ並べて折り返す"
		text: """
			枠の中身（見出し・警告の行・帯の下）では、親の自分の構造の図（中身の種類が `graph` のとき）を先頭に、子のリポジトリの枠をその後に今の順（一覧の API の並び）で、親の中身が使える幅 `bodyWidth(width, 親の深さ)` まで左から右へ `REPO.gap` を空けて並べ、入らなければ次の行へ折り返す。行の高さはその行のいちばん高いもの。
			親の図の右に空きがあれば、子の枠がそこに入る。中身の種類が `graph` でないとき（読み込み中、Scope がない、この範囲で見せるものがない）は、今どおりその1行の中身の下に、子の枠だけを同じ決まりで並べる。
			兄弟の枠（最上位を含む）は、今どおり見える幅で左から右へ並べて折り返す。並びの順は変えない。
			中の構造の図そのもの（routeLayout に渡す幅 `bodyWidth(width, 深さ)`）は変えず、単体の構造の図と同じ折り返しのまま描く。
			"""
		acceptance: [
			"合成の入力で、親の図の幅と子の枠の幅の和（と gap）が `bodyWidth(width, 親の深さ)` 以下なら、子の枠は親の図と同じ行（同じ y）で図の右に `REPO.gap` を空けて置かれ、超えるなら親の図の下の行に置かれる",
			"どの行も、2つ以上が並ぶなら `bodyWidth(width, 親の深さ)` の幅の中に収まる（1つで超えるものはその行に1つ）",
			"子の枠は親の枠の中にあり、親の図の四角とも兄弟の枠とも重ならない。並びの順（order）は iss-00614 と同じ（深さ優先、親が先、兄弟は一覧の順）",
			"中身の種類が graph でない親（loading・empty・quiet で高さが1行）では、子の枠はその1行の下に `REPO.pad` を空けて並ぶ（高さ0の中身なら見出し・警告の行・帯のすぐ下から）",
			"この PC の登録の形の合成の9つで、入れ子（会社 → 事業 → プロダクト）と外の spec-dock・orca-web が iss-00614 と同じに成り立つ",
			"実データで、狭い枠が横に並んだ分の世界の寸法の前後を report.md に書く",
		]
	}
	"R-02": {
		title: "後から足す帯の高さの入力を保つ"
		text: """
			iss-00614 の R-04（組み立ての入力に、リポジトリごとの帯の高さを渡せる）を、新しい並びでも保つ。帯は見出しと警告の行のすぐ下で、帯の高さ h を渡すと、その枠の中身の並び（親の図と子の枠）が h だけ下がり、枠が h だけ高くなる。
			"""
		acceptance: [
			"帯の高さを渡さないときと全部 0 のときの出力が同じ",
			"ある枠に h を渡すと、その枠の band の四角が見出しと警告の行の下から h の高さにあり、body の y と、その枠の子孫の枠のすべての y が h 増え、枠の高さが h 増え、重なりのなさ（R-01）が保たれる",
		]
	}
	"R-03": {
		title: "最初の表示は、PC の幅で『幅に合わせる』（左上に合わせ、縦に読み進める）"
		text: """
			『横断の構造』を開いて最初に描くとき、画面の幅（今の `isPhone` が見る幅）が 640 px より広ければ、倍率 `s = min(1, (図の領域の幅 − 16) ÷ 世界の幅)`、世界の左端を図の領域の左から 8 px、上端を道具の帯の下から 8 px に置く。世界の幅が図の領域に収まり、横にはみ出さない。縦は、今どおりの移動とホイールで読み進める。
			スマホ（640 px 以下）は今どおり倍率 0.74・左から 4 px（構造の図と同じ。統括への確認：msg_09212d9431f7）。
			『収める』（全体を1画面に）は今のまま道具の帯に残し、式も変えない。
			最初の表示は、本人が図を動かすまで世界に付いていく：リポジトリの構造が届いて世界の幅が変わるたび（読み込み、配置のやり直し、範囲の切り替え、更新）、本人がまだ動かしていなければ、描き直すたびに同じ式で幅に合わせ直す（読み込み中の小さな世界で倍率が 1 に決まったまま、後から広がった世界が横にはみ出すのを防ぐ）。
			本人が動かした後（移動、ホイール、拡大・縮小・100% の道具、ピンチ、『収める』、選んだ箱へ寄せる動き）は、その倍率と位置を、構造の図（graph.js）と同じく、この画面にいる間は保ち、保存はしない（範囲を変えても、更新しても保ち、画面を離れたら次は最初の表示から）。
			"""
		acceptance: [
			"偽の DOM で、図の領域が 1440 幅・世界の幅が図の領域より広いとき、最初の transform の倍率が `(図の領域の幅 − 16) ÷ 世界の幅`、translate の x が 8、y が道具の帯の下 + 8 で、`8 + 世界の幅 × 倍率 ≤ 図の領域の幅 − 8`",
			"世界の幅が図の領域より狭いとき、倍率は 1、x は 8",
			"画面の幅が 640 以下では、倍率 0.74、x が 4（今と同じ）",
			"『収める』を押した後の倍率と位置は iss-00614 と同じ式（今のテストが変えずに通る）",
			"構造の読み込みが最初の描画より後に届いて世界が図の領域より広くなったとき、本人が動かしていなければ、倍率がその世界の幅に合わせ直される（読み込み中の世界での倍率 1 のままにならない）",
			"範囲を変えて世界の幅が変わったとき、本人が動かしていなければ幅に合わせ直され、拡大や移動をした後なら倍率と位置が保たれる",
			"実データで、最初の表示の倍率を 1440・1000・390 で測って report.md に書く（見込み 1440 で約 59%、1000 で約 47%）。1440・1000 で横のはみ出しがない",
		]
	}
	"R-04": {
		title: "線の検査で、各リポジトリ単体と比べて新しい違反が0"
		text: "実機の写しで、edgeAudit の違反を、リポジトリごと・範囲ごと・幅ごとに単体の構造の図と比べ、新しい違反が0であることを確かめる（iss-00614 の扱いと同じ。既存の違反は iss-00627 で直す）。中の図の配置は変えないので、比べの前提は iss-00614 と同じ。"
		acceptance: [
			"report.md に、1440・1000・390 × 3範囲の、リポジトリごとの allgraph と単体の違反の数の比べがあり、allgraph の違反が単体を上回る組がない",
			"ブラウザーのエラー0、ページの横のスクロールなし（道具の帯と枠の見出しの重なりなし）",
		]
	}
}

