package spec

// 要件（Issue）。型 specdock/v1。書き方は spec-dock/docs/authoring/ のガイドにある。

schema: "specdock/v1"

assurance: {
	level:  "standard"
	reason: "表示の配置だけを変え、データや操作には触れない。ただし構造の図はすべての利用者の主な画面で、配置の誤り（重なり、線の違反）は目に見えて使いにくくなるので、レビューと最終品質ゲートを通す"
}

purpose:    "構造の図で、依存でつながった塊を左に寄せ、空いた右や下に、つながりのない Scope を詰めて、大きな空白をなくす。最上位の Initiative も、100% の表示で見える幅で折り返す"
background: """
	本人の要望（2026-11-13、写し epic-00573/.workbench/iss-00583-before.png、housing-lifecycle の init-00001 の epic-00313）。

	1. Epic の中（Initiative の中の Epic も同じ）で、つながりのない Issue（332、331、330…）が1行目に横に並び、その右に背の高い塊（325〜326）が来て、
	   1行目の高さが塊に合わせて伸び、左下が大きく空く。
	2. Epic の中の Issue、Initiative の中の Epic は画面の幅で折り返すが、Initiative どうしは画面から大きくはみ出して横に並ぶ。

	原因（タスク担当が layout.js と実データで確かめた。report.md の「原因」）：

	- 1：`childrenBlock` は、依存でつながったまとまり（`components`）と、つながりのない1つの Scope を区別せず、活動順（`byActivity`）に一列に並べ、
	  `shelfBlock` で幅を超えるところで折り返すだけ。棚の高さは棚の中で一番高いものに合わせるので、背の高い塊と1枚の箱が同じ棚に乗ると、箱の下が空く。
	  塊と1枚の箱を分けて詰める規則がない。
	- 2：依存のせいではない。最上位だけ `widestRoom`（iss-00575 R-01）が「全体を画面に収めたときの倍率が最大になる切れ目」を選ぶ。候補は 100% で見える幅を
	  超えてよいので、横長の画面では、はみ出す横並びが選ばれる。実データ（housing-lifecycle、幅 1424・高さ 792）では最上位が [4, 5] の2行に切られ、
	  全体の幅が 4980px になる（見える幅で折り返せば 2682px。残りの超過は、1つの Initiative の中の折り返せない鎖の幅）。
	"""

includes: [
	"src/spec_dock/assets/dashboard/views/graph/layout.js の入れ子の配置（childrenBlock とその下請け）",
	"tests/ の構造の図のテスト（合成の構造と、改める前の決定に合わせた期待の更新）",
	"実データの写し（直す前と後）を report.md に残す",
]
excludes: [
	"木の表示（mode: tree）",
	"配線（router.js）の規則",
	"graph.js、graph.css などページの側",
	"Epic と Initiative の文書",
]

requirements: {
	"R-01": {
		title: "依存でつながった塊を先に置き、つながりのない Scope を、塊の棚の空きに詰める"
		text: """
			ある親の子（最上位を含む、入れ子の表示のすべての段）のうち、依存でつながった2つ以上のまとまり（塊）を先に、活動順に左から右へ棚に並べ、
			見える幅で折り返す（塊は途中で折り返さない）。そのあと、つながりのない1つの Scope（箱か枠）と片付けの候補の塊（チップ）を、活動順に1つずつ、
			塊の棚の空き（棚の右の空き、次に、棚の高さより低い塊の下の空き）の、最初に入る場所に置く。どこにも入らないものだけを、塊の棚の下に、
			今までどおりの棚（見える幅で折り返す）で並べる。
			"""
		acceptance: [
			"epic-00313 に似せた合成の構造（つながりのない5つの Issue、2つの鎖、6つから1つへ集まる背の高い塊、4列2行の塊）を幅 1440 で並べると、つながりのない5つは、どれも最初の塊の棚の縦の範囲の中にあり、塊の右か、塊の下にある",
			"同じ構造で、Epic の枠の高さが、直す前より低い（直す前の値をテストに書く）",
			"同じ構造で、幅 1000 と 1440 と 1920 で、兄弟のどの2つの四角も重ならず（gaps のない配置と、routeLayout が採った配置の両方）、どの棚も見える幅の中にある（1つで見える幅を超える塊を除く）",
			"housing-lifecycle の実データの写し（1440、1000）で、epic-00313 のつながりのない Issue が塊の棚の右か下にあり、epic-00313 の枠の高さが直す前より低い（数を report.md に書く）。spec-dock の写しでは、重なりがなく edgeAudit の違反が0",
		]
	}
	"R-02": {
		title: "最上位も、100% の表示で見える幅で折り返す"
		text: """
			最上位の並びも、ほかの段と同じく、見える幅（options.width − 2 × 余白）を超えるところで折り返す。全体の倍率で切れ目を選ぶ方式（iss-00575 R-01 の widestRoom）はやめる。
			1つで見える幅を超えるブロック（折り返せない鎖を持つ Initiative など）だけは、その行に1つで置く。
			options.height は今までどおり受け取るが、配置には使わない（ページが大きさの変化で並べ直す合図として渡し続ける）。
			"""
		acceptance: [
			"合成の4つの Initiative で、1400×760 と 1920×1080 のどちらでも、2つ以上が並ぶ行は、見える幅の中に収まる",
			"housing-lifecycle の実データを node で幅 1424・高さ 792 と幅 984・高さ 692 に並べると、全体の幅は、高さを渡さないときと同じになる（倍率で選ぶ切れ目がない）",
			"実データの写し（1440、1000）で、Initiative が見える幅で折り返す（2つ以上が並ぶ行が、見える幅を超えない）",
		]
	}
	"R-03": {
		title: "変えないもの"
		text: """
			依存でつながった塊を途中で折り返さない、塊の中の配置（段の列と行、iss-00560）、依存の線の向き（左から右）、edgeAudit の違反0、
			配線の広げ直しで配置が動かないこと（最初の配置で決めた置き場を、広げ直しの回でも使う）、大きさが変わり終わってからの並べ直し（iss-00575 R-03、graph.js）、
			縦長の画面（スマートフォン）の縦積み、木の表示。
			"""
		acceptance: [
			"代表の構造と合成の構造の、すべての表し方で edgeAudit の違反が0のまま（高さあり、幅 1000・1440・1920 を含む）",
			"配線の広げ直し（gaps あり）の前後で、どの Scope も同じ棚、同じ置き場（塊の右か下か、何番目か）にある",
			"幅374・高さ800では、Initiative が1列に縦に積まれる",
			"250件の生成の構造の配線が、今までどおり1秒の中に収まる",
		]
	}
	"R-04": {
		title: "直す前と後の実データの写しを残す"
		text:  "spec-dock と housing-lifecycle の実データで、PC の幅（1440、1000）と 390px の写しを、直す前と後で report.md に残す。全体の幅と見える幅の数字、edgeAudit、ブラウザーのエラーの数も書く。"
		acceptance: ["report.md に、直す前と後の写し（2つのリポジトリ × 3つの幅）と、全体の幅・見える幅・edgeAudit・エラーの数がある"]
	}
}

failures: {
	"F-01": {
		title: "塊の棚に入らない Scope は、塊の棚の下の棚に置き、重ならず、塊を押さない"
		text:  "棚の高さより背の高い Scope、どの空きにも入らない幅の Scope は、塊の棚の下の、今までどおりの棚に置く。塊の棚の高さは塊だけで決まり、詰めたもので伸びない（広げ直しの回を除く）。"
	}
	"F-02": {
		title: "塊のない段は、今までと同じに並ぶ"
		text:  "子に依存でつながったまとまりがない段（依存のない Initiative の並び、依存のない Issue だけの Epic など）は、直す前と同じ座標に並ぶ（活動順に、見える幅で折り返す）。最上位は、直す前に高さを渡さなかったときの座標と同じになる（R-02 で高さを使わなくなるため）。"
	}
	"F-03": {
		title: "つながりのない Scope だけの段で、活動順は変わらない"
		text:  "つながりのない Scope どうしの順は、活動順のままにする（空きの埋め方で、後の Scope が前の Scope より前の場所に入ることはあるが、どの場所の中でも活動順に並ぶ）。"
	}
}

constraints: [
	"編集の範囲は src/spec_dock/assets/dashboard/views/graph*（実際には graph/layout.js）、tests/、この Issue の Scope だけ",
	"graph.js と graph.css のコードは変えない（画面の側の変更は要らない）。graph.js の、事実に合わなくなるコメントだけは直す",
	"版の番号と migration.md は変えない",
]

decisions: [
	"2026-11-13 本人（統括経由の依頼書）：塊を左に、ばらばらを右の空きへ。Initiative は画面の幅で折り返す",
	"2026-11-13 タスク担当：塊を先に置き、空きは「棚の右」を先に、次に「低い塊の下」を左から埋める（本人の言葉「空いた右側（や下）の空間」の順）",
	"2026-11-13 タスク担当：最上位の倍率で選ぶ切れ目（widestRoom）はやめ、ほかの段と同じく見える幅で折り返す。候補を見える幅以下に限ると、横長の画面では、ほとんどの場合に最も広い候補（見える幅での折り返し）が選ばれ、違いが残らないため、規則を1つにする",
	"2026-11-13 タスク担当：詰め込みは最上位にも同じように働く（Initiative どうしの依存の鎖があれば、それが塊になる）",
	"2026-11-13 統括：この Issue の PR は統括がマージする（本人が委任）。実装担当は Codex GPT-6.1 Sol / medium を優先する",
]
