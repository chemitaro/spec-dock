package spec

// 要件（Issue）。型 specdock/v1。書き方は spec-dock/docs/authoring/ のガイドにある。

schema: "specdock/v1"

assurance: {
	level:  "standard"
	reason: "ダッシュボードの表示だけを直し、データや操作には触れない"
}

purpose: """
	構造の図（`/r/<repo>/graph`）と『横断の構造』（`/graph`）の上の帯で、画面の幅が 1000 前後のときも、
	状態の札（止められている・着手できる…）と道具の列（拡大縮小・収める・入れ子・全体｜いま｜これから）が、決まった形で崩れずに並ぶようにする。
	"""

background: """
	iss-00632 の report.md の『次の提案』：幅 1000 では、直す前から道具の列が状態の札の下の行に落ちる。

	このタスク担当の測り（2026-11-17、開始のコミット `0ef2dfeae` の wheel、この PC の状態の置き場の写し、headless Chrome、明・全体）：

	| 画面 | 幅 | 状態の札の列 | 道具の列 | 道具の上端 | 帯の高さ |
	|---|---|---|---|---|---|
	| 横断の構造 | 1000 | 779 | 428 | 168（まとめの行2行の下、4行目） | 132 |
	| 横断の構造 | 1280・1440 | 779 | 428・432 | 68（札と同じ行） | 92 |
	| 構造の図 | 1000・1280 | 748 | 519 | 209（札の次の行、右寄せ） | 72 |
	| 構造の図 | 1440 | 748 | 519 | 169（札と同じ行） | 32 |
	| どちらも | 390 | 上の帯（スマホの並び） | 右下の縦の列 | — | — |

	1行に並べるには、帯の幅（1000 では 976）が、札の列 + 16 + 道具の列（横断 1223、構造の図 1283）以上でなければならない。
	1000 前後で1行にするには、札か道具の文字を消して印だけにする（スマホと同じ形）ほかになく、PC で札の意味（文字）が読めなくなる。

	横断の構造では、状態の札とまとめの行（iss-00632）が1つの列（`.gx-left`）にあるので、1行に入らないとき、道具の列はまとめの行の下（4行目）に落ちる。
	構造の図では、道具の列は札の次の行に右寄せで出ており、既に決まった形になっている。
	"""

includes: [
	"`views/allgraph.css`：PC の上の帯の並び（状態の札 → 道具の列 → まとめの行）",
	"テスト（`tests/js/dashboard_allgraph_screen.mjs`、`tests/unit/presentation/test_dashboard_allgraph_screen.py`）",
	"実機の確かめ（1000・1280・1440・390 × 横断の構造・構造の図の写しと寸法、線の検査）",
]

excludes: [
	"スマホ（app の幅 640 以下）の並び",
	"状態の札・道具の列・まとめの行の中身、文字、大きさ、色",
	"構造の図（`views/graph.js`・`views/graph.css`）の帯の並び（測りで既に決まった形と分かったので変えない。R-02 で確かめる）",
	"本人の環境に特化した決まり（特定のリポジトリの名前による扱い）",
]

requirements: {
	"R-01": {
		title: "横断の構造の PC の帯は、状態の札、道具の列、まとめの行の順に、決まった形で並ぶ"
		text: """
			app の幅が 640 を越える（PC）の横断の構造の上の帯は、1行目に状態の札を左から並べる。道具の列は、札と同じ行に入るときはその行の右端に、
			入らないときは次の行の右寄せに出る。まとめの行（iss-00632）は、その下に帯の幅いっぱいまで使って並ぶ（長い行は今と同じく1行のまま省略し、全文は title）。
			道具の列がまとめの行の下に落ちることはない。
			"""
		acceptance: [
			"実機の幅 1000 で、道具の列の上端 = 状態の札の下端 + 8、右端 = 帯の右端（±1px）、まとめの行の上端 = 道具の列の下端 + 8",
			"実機の幅 1280・1440 で、道具の列の上端 = 状態の札の上端（同じ行）、まとめの行の上端 = 札の下端 + 8",
			"静的な検査で、allgraph.css が `@container app not (max-width: 640px)`（スマホの規則のちょうど補い）の中で、横断の構造の `.gx-left` を `display: contents`、`.ax-sum` を `order: 1` と `flex-basis: 100%` にする",
		]
	}
	"R-02": {
		title: "構造の図の帯は、今の決まった形のまま"
		text: "構造の図の上の帯は、道具の列が札と同じ行に入るときはその行の右端に、入らないときは札の列（道筋があればその下の札）の次の行の右寄せに出る（今と同じ）。"
		acceptance: [
			"実機の幅 1000・1280 で、道具の列の上端 = 状態の札の下端 + 8、右端 = 帯の右端（±1px）。1440 で札と同じ行",
			"graph.css の `.gx-bar` と `.gx-tools` の規則は変わらない（差分がない）",
		]
	}
	"R-03": {
		title: "最初の表示と『収める』は、並びの変わった帯の下端に追従する"
		text: "最初の表示（PC の幅合わせ、スマホの 74%）と『収める』の上端は、状態の札・道具の列（PC）・まとめの行のうち最も下の下端 + 8。帯の行の数が変わっても（1行・2行・まとめの行あり）、それに従う。"
		acceptance: [
			"node の検査（styled）で、札・道具・まとめの行の下端を別々の値にしたとき（道具がまとめの行より下、上の両方）、最初の表示の ty と『収める』の上端が、そのうち最も下の下端 + 8",
			"実機の 1000・1280・1440 で、最初の表示の ty が帯の最も下の下端 + 8 以上",
		]
	}
	"R-04": {
		title: "スマホの並びと線の検査は変わらない"
		text: "幅 390 の横断の構造と構造の図で、状態の札・まとめの行・道具の列の位置と大きさは、直す前と同じ。横断の構造の `window.specdockEdgeAudit()` の total の違反は0のまま。"
		acceptance: [
			"実機の 390 で、`.gx-left`・`.gx-next`・`.ax-sum`・`.gx-tools` の矩形が、直す前の wheel と同じ",
			"実機の横断の構造で、Scope の欄を開いた 1440（帯が札の列より狭い）と、まとめの行を隠した形（実機の頁で `.ax-sum` を hidden にする。知らせのない状態の置き場はこの PC の写しから作れないため）の 1000・1440 で、F-01 の並び（札の後に道具が右寄せ、まとめの行はその下、まとめなしでは帯の高さが札と道具だけ）",
			"実機の横断の構造 1000・1280・1440・390 × これから・いま・全体 × 明・暗で、edgeAudit の total の違反（boxHits・ownHits・overlaps・diagonal・portShare・trunkOverlaps・frameExits・failed・missing・markOverflow）が0、横のスクロールがない",
		]
	}
}

failures: {
	"F-01": {
		title: "まとめの行がないときや、欄が開いて帯が狭いときも崩れない"
		text: "まとめの行がない（hidden）ときは、帯は状態の札と道具の列だけで今と同じ高さ。Scope の欄が開いて帯が狭くなったときも、R-01 と同じ順（札 → 道具 → まとめ）で並ぶ。帯が札の列より狭いときは、札の列が今と同じく折り返し、道具の列はその下に右寄せで出る。"
	}
}

constraints: [
	"新しい色の値やトークンを足さない（allgraph.css の決まり）",
	"DOM の構造（`.gx-left` の中の `.gx-next` と `.ax-sum`）は変えない。スマホの並び（graph.css の `@container app (max-width: 640px)`）がそれに依るため",
	"普遍的でシンプルな規則にし、特定のリポジトリの名前で扱いを変えない（本人の方針）",
]

decisions: [
	"判断：1000 前後で1行に並べる案は取らず、決まった形（状態の札を1行目、道具を2行目の右寄せ）にする。理由：1行には帯の幅が横断 1223・構造の図 1283 以上要り、1000 前後では札か道具の文字を消して印だけにするほかない（PC で札の意味が読めなくなる）。1280 では横断の構造が、1440 では両方が既に1行に入る。写しは report.md（このタスク担当、2026-11-17。統括の依頼書が、写しで見比べての選択をタスク担当に任せた）",
	"判断：横断の構造のまとめの行は、道具の列の下に帯の幅いっぱいで並べる（道具の左の空きには入れない）。理由：まとめの行の幅を道具の列の有無で変えずに済み、iss-00632 の『札の列の幅に収める』（width 0・min-width 100%）より省略が減る。1000 の帯の高さは今と同じ 132（同上）",
]
