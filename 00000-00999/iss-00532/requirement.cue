package spec

// 要件（Issue）。型 specdock/v1。書き方は spec-dock/docs/authoring/ のガイドにある。
// 親は epic-00427。plan.cue の slice `iss-00532`（covers: R-06、R-11、R-15、R-16、R-29、R-31、F-11）を、この Issue の番号に書き直した。
// Epic の番号は「Epic R-15」のように書く。この Issue の番号は R-01 などである。

// 型の版。消さない。
schema: "specdock/v1"

// 保証レベル（light、standard、strict、critical）と、その理由。
assurance: {
	level:  "standard"
	reason: "ホームの構造の図と時間の軸を作る。誤った依存や状態の表示は判断を誤らせるが、書き込みはなく、版を戻せば回復できる。"
}

purpose: "ダッシュボードのホームの構造の図（`views/graph.js`）と、時間の軸（`views/timeline.js`）を作る。構造の図は、階層と作業の順番の依存を1枚で示し、状態を記号と図形で示し、依存の線を箱に重ねずに直交の線で引く。時間の軸は、週ごとの作成と完了の累計と、Scope と PR の最近の動きを示す。"

background: """
	- 親の Epic（epic-00427）の設計 D-08 のうち、構造の図と時間の軸をこの Issue が作る。ボード、詳しい画面、横断の概況、検索は #531。
	- 骨組み（#529）の差し込み口 `views/<名前>.js`（`export default {id, title, icon, styles?, render(root, ctx), dispose?()}`）に足す。骨組み（`app.js`、`core/`）と、ほかの画面のファイルは変えない。
	- 状態、推奨順、後に続く数、片付けの候補、同じ親の中の段、上流と下流、大もとの待ち先、「見た」との比較、週ごとの累計、最近の動きは、#528 の `runtime/domain/dashboard_model.py` が決める。画面は、それを構造の API（`presentation/dashboard_api.py`）から読むだけで、判定を別に書かない。
	- 見た目と振る舞いは、利用者が採った試作 d2（`epic-00427/artifacts/20261103t150110z--dashboard-design-d2.html`）に従う。依存の線は、試作の `ROUTER`（直交の可視グラフ、曲がりの罰則つき A*、8px の車線への寄せ、箱から10px、角の丸み R=7、交差の切れ目、出入りの間隔10px）を移す。
	- 試作には2本指のつまみと `gesturestart` の抑止がない（#527 の提案 P-5）。図の上の操作の帯の下に箱が隠れないよう、余白を取る（P-6）。
	"""

includes: [
	"構造の図（ホーム）：入れ子と木の2つの表し方、範囲の絞り込み、依存の線の3つの切り替え、終わったものの切り替え、片付けの候補を畳む、状態の印で目立たせる、段の表示、長い依存の折り返し、拡大・縮小・移動、選んだときの強調と要点、詳しい画面への移動、凡例",
	"依存の線の経路の計算（試作の ROUTER を DOM を知らない ES モジュールに移したもの）と、配置の計算（DOM を知らない ES モジュール）",
	"線の検査（試作の `edgeAudit`）を、pytest から node で走らせるテストに持ち込む",
	"時間の軸：週ごとの作成と完了の累計の図（種類を選べる、点を指すとその週の数）と、Scope と PR の最近の動き",
	"構造の API への項目の追加（依存、段、推奨順の位置、種類ごとの週の累計、保証レベルと worktree のブランチの空の項目）",
	"PC のヘッドレスの Chrome での確かめ（PC の幅と 390px、明るい・暗い、JS のエラー、線の検査）",
]
excludes: [
	"ボード、詳しい画面、横断の概況、検索（#531）",
	"骨組み（`app.js`、`app.css`、`core/`）と `views/index.js` の変更",
	"保証レベルと、このPCの worktree のブランチの取得（統括が #531・#532 の後に手当てする。この Issue は項目を `null` で足し、値があるときだけ出す）",
	"iPhone の Safari での確かめ（#534 で利用者に頼む）",
	"版の番号と `migration.md`（#534）",
]

requirements: {
	"R-01": {
		title: "ホームの構造の図が、入れ子と木の2つの表し方で、階層と状態を1枚で示す"
		text: """
			- 既定は入れ子：Initiative と Epic を枠にし、その中に Issue の箱を置く。木：すべてを箱にし、親子の線でつなぐ。上の帯の道具で切り替える。
			- Issue の箱：状態の地の色と記号、ID と番号、題名（2行まで）、保証レベルの印、PR の印（状態、CI、マージできるか）、作業中のブランチの印、段、後に続く数、変化の印。担当者は出さない。
			- Epic と Initiative の枠：状態の記号、ID と題名、配下の進み具合の帯（終わった数／全体の数）、配下の状態ごとの数、保証レベルの印、片付けの候補の印、後に続く数。
			- 保証レベルとブランチは、API の値があるときだけ出す。
			（Epic R-15）
			"""
		acceptance: [
			"見本の構造で、入れ子では Epic の枠の中に Issue の箱が並び、木では同じ Scope が親子の線でつながった箱になる。切り替えても見る位置と倍率を保つ",
			"箱に ID、番号、題名、状態の記号、PR の印、後に続く数が出て、Epic の枠に進み具合の帯と状態ごとの数が出る。API の `assurance` と `branch` に値を入れると、その印が出る",
		]
	}
	"R-02": {
		title: "依存の線は水平と垂直の線分だけで、箱に重ならず、同じ向きで重ならない"
		text: """
			依存の線は、待ち先の箱の右の辺から出て、待つ箱の左の辺へ入る。水平と垂直の線分だけで引き、角を半径7px で丸め、箱と枠の見出しから10px 離す。同じ通り道の線分を8px の車線に分け、1つの辺の出入りの位置を10px 空ける。直交する交差は許し、下の線を切って見分けられるようにする。車線が足りないときは、配置の隙間を広げて引き直す。親子の間の依存は線にしない。（Epic R-15、D-08）
			"""
		acceptance: [
			"試作の検査 `edgeAudit` と同じ5つの数（ほかの箱への当たり、自分の箱の内側への当たり、車線の重なり、斜めの線分、出入りの位置の衝突）と経路の失敗が、代表のデータ（spec-dock の構造のスナップショットと、250件の見本）のすべての表し方の組み合わせで0件になる",
			"このテストは pytest から node で走り、CI で必ず走る",
		]
	}
	"R-03": {
		title: "依存の線を、すべて、待っているものだけ、なしから選べ、待っている依存と終わった依存を見分けられる"
		text: "既定は「待っているものだけ」（待ち先が開いている依存）。「すべて」では終わった依存も、細い破線で描く。「なし」では線を描かない。（Epic R-15）"
		acceptance: ["3つの切り替えで、線の数が変わり、終わった依存の線が破線になる"]
	}
	"R-04": {
		title: "開いたときは、終わったものを隠し、全体を示し、片付けの候補を畳む"
		text: """
			- 既定では終わったものを隠す。開いた子孫を持つ閉じた親は残す（Epic R-12）。道具で、終わったものも出せる。
			- 片付けの候補（API の `cleanup`）は、同じ入れ物の同じ段の中で、数と印だけの小さな1つのまとまりに畳む。既定は畳む。まとまりを押すと、候補の一覧が要点の欄に出る。
			（Epic R-15、R-20）
			"""
		acceptance: [
			"開いたとき、終わった Issue の箱がなく、開いた配下を持つ閉じた Epic の枠は残り、片付けの候補が「片付けの候補 N」のまとまりになっている",
			"道具で、終わったものを出し、片付けの候補を開ける",
		]
	}
	"R-05": {
		title: "同じ親の中の作業の順番を、左から右の段で示し、同じ段の中は推奨順に並べる"
		text: """
			同じ親の子は、モデルの段（`child_stages`）の順に、左から右の列に並べる。同じ段の中は推奨順（Epic R-31。モデルの `recommended_key`）に上から並べる。親の中に2段以上の順番があるとき、箱に何段目かを示す。段が多いときは、列を折り返して次の行に続ける。後に続くものがある箱と枠には、その数の小さな印を付ける。（Epic R-15、R-31）
			"""
		acceptance: [
			"見本で、待ち先の箱が待つ箱より左の列にあり、同じ列の先頭に後に続く数が一番多い箱が来る",
			"段が7つの親で、列が2行に折り返される",
		]
	}
	"R-06": {
		title: "上の状態の印で目立たせ、範囲を1つの Initiative か Epic に絞れる"
		text: """
			- 図の上に、状態ごとの印（数つき）をボードの列と同じ順（止められている、着手できる、作業中、マージ待ちの直す必要あり・マージできる、不明があれば不明）に置く。押すと、その状態の Issue の箱だけを目立たせ、ほかを淡くする（絞り込まない）。もう一度押すと戻す。画面は移らない。
			- 範囲を、1つの Initiative か Epic に絞れる（要点の欄の「この範囲に絞る」）。絞っているときは、その親の道筋を示し、すぐに全体へ戻れる。絞った範囲は URL の `?focus=<ID>` に持つ。
			（Epic R-15）
			"""
		acceptance: [
			"印を押すと、その状態の箱だけが目立ち、ほかの箱は残ったまま淡くなる。もう一度押すと戻る",
			"Epic に絞ると、その Epic の配下だけが出て、道筋と「全体へ戻る」が出る。戻ると全体が出る",
		]
	}
	"R-07": {
		title: "箱を選ぶと、上流と下流を強調し、要点を出し、詳しい画面へ移れる"
		text: """
			- 箱か枠の見出しを押すと、選んだ1つだけを3px の縁で際立たせ、上流と下流（モデルの `upstream`、`downstream_ids`）の箱を普段のままにし、関係のない箱を淡くする。線は、選んだ箱に直接つながるものを強く（3px）、間接のものを弱く（2px）、関係のないものを淡くする。止められている箱では、大もとの待ち先（モデルの `root_waits`）に「大もと」の札を付ける。
			- 状態の印の強調と選んだときの強調は重ねず、後からした操作を優先する。
			- 要点を、PC では図の右に、スマートフォン（幅 640px 以下）では下から出す。要点を出したまま、ほかの箱を選び直せる。要点の「詳しく」で詳しい画面へ移る。
			- PC では、ダブルクリックで詳しい画面へ直接移る。スマートフォンでは、1回目のタップで選び、同じ箱の2回目のタップで詳しい画面へ移る（ダブルタップは使わない）。
			- 何もない所を押すか Esc で、選ぶのをやめる。
			（Epic R-15）
			"""
		acceptance: [
			"PC で止められている箱を押すと、その箱だけに縁が付き、直接の線が太く、間接の線が細く、関係のない箱と線が淡くなり、大もとの待ち先に札が付き、右に要点が出る",
			"状態の印を押してから箱を選ぶと、選んだときの見え方だけになり、その後に印を押すと、選ぶのがやめられて印の見え方だけになる",
			"PC のダブルクリックと、390px の幅での同じ箱の2回目のタップで、詳しい画面（`/r/…/scopes/<ID>`）へ移る。390px の幅の1回目のタップでは移らず、要点が下から出る",
		]
	}
	"R-08": {
		title: "図を拡大・縮小・移動でき、2本指のつまみでは図だけが拡大し、ページ全体は拡大しない"
		text: """
			- PC：ホイールで移動、Ctrl（Mac は Command）とホイールで拡大・縮小、ドラッグで移動。道具の拡大・縮小・100%・全体を収めるのボタン。
			- スマートフォン：1本指のドラッグで移動、2本指のつまみで拡大・縮小。図の領域に `touch-action: none` を付け、Pointer Events で自分で処理し、Safari の `gesturestart`、`gesturechange`、`gestureend` を止めて、ページ全体の拡大と競合させない。
			- 図の上の操作の帯の下に、帯の高さの余白を取り、開いたときと「全体を収める」の後に、箱が帯に隠れない。
			（Epic R-06、R-15。#527 の提案 P-5、P-6）
			"""
		acceptance: [
			"2本指のつまみを模した Pointer Events で図の倍率だけが変わり、`gesturestart` が `preventDefault` され、`visualViewport.scale` が 1 のまま",
			"開いたときと「全体を収める」の後に、どの箱の上端も操作の帯の下端より下にある",
		]
	}
	"R-09": {
		title: "状態を色と形で示し、凡例をいつでも開ける"
		text: "状態は、色に加えて形の違う記号（作業中＝半円、着手できる＝三角、止められている＝八角形と斜線、不明＝ひし形、終わった＝灰色の印）で示す。PR、CI、マージできるか、保証レベル、変化、段、後に続く数、片付けの候補、線の種類と選んだときの見え方の凡例を、図の左下でいつでも開ける。図の中では文字の状態の名前を減らし、要点の欄では言葉も併記する。（Epic R-11）"
		acceptance: ["白黒にしても、5つの状態の記号が形で見分けられ、凡例を開くと記号と言葉の対応が出る"]
	}
	"R-10": {
		title: "前回見たときからの変化に印を付ける"
		text: "構造の API の各 Scope の `change`（骨組みが「見た」の記録と比べた結果）があれば、箱と枠の右上に印を付け、要点の欄に変化の中身（新しい、状態が変わった、PR が変わった）を言葉で出す。（Epic R-29）"
		acceptance: ["見本で、前回見た後に状態が変わった Scope、新しい Scope、PR が変わった Scope の箱に印が付き、変わっていない箱には付かない"]
	}
	"R-11": {
		title: "時間の軸で、週ごとの作成と完了の累計と、最近の動きを示す"
		text: """
			- 週ごとの累計：作られた Scope の数と、終わった Scope の数の累計を、週（UTC の月曜始まり）ごとの2本の線で示す。数える種類（Initiative、Epic、Issue）を選べる。点を指すと、その週の作成、完了、開いている数を示す。上に、作られた累計、終わった累計、開いている数、直近4週の完了の数を示す。
			- 最近の動き：作られた Scope、終わった Scope、PR が開いた・マージされた出来事を、時刻の新しい順に、日ごとに分けて並べる。出来事を押すと詳しい画面へ移る。
			（Epic R-16）
			"""
		acceptance: [
			"見本の作成と完了の時刻から、選んだ種類の週ごとの累計が正しく出る（種類を外すと、その分が減る）",
			"最近の動きに Scope と PR の出来事が、時刻の新しい順に並ぶ",
		]
	}
	"R-12": {
		title: "PC とスマートフォンの幅で、明るい表示と暗い表示に従って使える"
		text: "PC の幅と 390px の幅で、構造の図と時間の軸が横にはみ出さずに使える。OS の設定と骨組みの `data-theme` に従って、明るい表示と暗い表示を切り替える。JavaScript のエラーを出さない。（Epic R-06）"
		acceptance: ["PC のヘッドレスの Chrome で、PC の幅と 390px、明るいと暗いの4通りで、2つの画面の `scrollWidth` が画面の幅を超えず、JavaScript のエラーが0件"]
	}
	"R-13": {
		title: "250件ほどの構造でも速く描ける"
		text: "Scope が250件ほどの構造で、ホームの構造の図がこのPCで2秒以内に出て、終わったものを含めたすべての構造の図が3秒以内に描ける。（Epic R-15、F-11）"
		acceptance: ["250件の見本で、PC のヘッドレスの Chrome で、開いてから図と線が出るまでが2秒以内、終わったものも出したときが3秒以内"]
	}
}

failures: {
	"F-01": {
		title: "構造がない、読めないときは、空の図の理由を示し、エラーにしない"
		text:  "構造の API がまだ届いていない、読めない、Scope が0件のときは、図の代わりに理由の短い文を出す（理由と次の1手は骨組みの知らせの帯が出す）。時間の軸も同じ。"
	}
	"F-02": {
		title: "経路が見つからない線や、循環した依存でも、図を止めない"
		text:  "経路が見つからない線は、中央で曲がる線で描き、検査の `failed` に数える。段の循環（モデルの `cyclic`）にある子は、1段目に置く。上流と下流の読み取りに失敗したときは、選んだ箱だけを際立たせ、線の強調はしない。"
	}
}

constraints: [
	"状態の判定、推奨順、段、上流と下流、大もとの待ち先、変化、週の累計は、モデルの値を API から読む。画面に判定を別に書かない。",
	"編集するのは `views/graph.js`、`views/timeline.js`、それらだけが使う新しいファイル、`presentation/dashboard_api.py` の項目の追加、テスト、この Scope のディレクトリだけ。",
	"状態の記号は骨組みの `core/ui.js` の `STATES`／`stateIcon`（#531 と共通）を使い、図だけが使う印（PR、CI、保証、段、後に続く数など）は `views/graph/marks.js` に持つ。",
]

decisions: [
	"配置は CSS の流れに任せず、画面の側の純粋な関数（`views/graph/layout.js`）で座標を計算し、箱と枠を絶対の位置に置く。経路の計算と検査を、DOM なしで node から同じ配置に対して走らせるため。箱の高さは題名2行の分で固定する。",
	"木の表し方は、字下げの一覧の形（親の左下から子の左へ、細い親子の線）。親子の線は、依存の線が同じ向きに重ならないよう、縦の通り道だけを塞ぐ障害物として経路の計算に渡す。",
	"上流と下流と大もとの待ち先は、選んだときに Scope の API（`scopes/<ID>`）から読む。読んでいる間に別の箱を選んだら、後の選択だけを使う。",
	"保証レベルとブランチは、API に `assurance: null` と `branch: null` を足し、値があるときだけ出す（2026-11-04 の統括の判断。取得は統括が後で手当てする）。",
	"node がないとき、線の検査のテストは、環境変数 `CI` があれば失敗、なければ理由つきで skip する（2026-11-04 の統括の判断）。",
]
