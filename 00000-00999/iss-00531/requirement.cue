package spec

// 要件（Issue）。型 specdock/v1。書き方は spec-dock/docs/authoring/ のガイドにある。

// 型の版。消さない。
schema: "specdock/v1"

// 保証レベル（light、standard、strict、critical）と、その理由。
assurance: {
	level:  "standard"
	reason: "利用者が次の作業を決める画面（ボード、一覧、詳しい画面、横断の概況、写せるコマンド）を作る。誤った表示は判断を誤らせるが、書き込みはなく、版を戻せば回復できる。"
}

purpose: "ダッシュボードの骨組み（#529）の差し込み口に、状態のボード、Scope の詳しい画面、横断の概況、検索を入れ、利用者が「次に何をするか」を1つのリポジトリの中でも全リポジトリを横断しても決められるようにする。"

background: """
	親は epic-00427（#427）。この Issue は、Epic の plan.cue の slice `iss-00531` が任せた Epic R-06、R-09、R-11、R-12、R-13、R-14、R-17、R-18、R-24、R-29、R-30、R-31、F-05、F-13 を、画面の側で満たす。

	- 状態の判定、ボードの分け方、推奨順、片付けの候補、配下の段、変化の比べ方は #528 のモデル（`runtime/domain/dashboard_model.py`）が持つ。画面はそれを写すだけで、判定を別に書かない。
	- PR の状態は #537 の構造のスナップショットの版2にある。
	- サーバー、API、画面の骨組み（上の帯、通知の帯、5つの差し込み口、5秒ごとの更新、「見た」の送信、埋め込みの約束）は #529 が作った。構造の図と時間の軸は #532 が並行して作る。
	- 見た目と振る舞いは、利用者が採用した試作 d2（`epic-00427/artifacts/20261103t150110z--dashboard-design-d2.html`）の board、detail、overview の部分に従う。
	- #527 の試作の結果のうち、この Issue に関わるのは F-13（埋め込みが使えないときの逃げ道。普通のリンク）だけである。
	"""

includes: [
	"`src/spec_dock/assets/dashboard/views/board.js`、`scope.js`、`overview.js` と、それらだけが使う新しいファイル（`views/_shared/` の部品と CSS、検索）",
	"`runtime/presentation/dashboard_api.py` の構造と Scope の JSON への項目の追加",
	"新しい `runtime/application/dashboard_scope_details.py`（詳しい画面のためのカタログと worktree の読み取り）と、`application/dashboard_http.py` の `scopes/<ID>` の分岐の1か所（統括が許した）",
	"骨組みの `app.js` に、検索を上の帯に付ける1行（統括が許した）",
	"#529 のサーバーの待ち受け（`runtime/infra/dashboard_server.py` の `_Listener`）の待ち行列を 5 から 128 に広げる1行（統括が許した）",
]

excludes: [
	"構造の図（ホーム）と時間の軸（#532）。骨組みの上の帯と通知の帯の作り（#529）。常駐（#530）。撤去（#533）",
	"文書の描画（段階2、#535）。段階1の文書のタブは、文書があるかないかと、説明資料の HTML を開くリンクだけ",
	"写せるコマンド（Epic の 2026-11-03 の決定で置かない）",
	"状態の判定や推奨順の決まりを変えること（#528 のモデルをそのまま使う）",
	"版の番号と `migration.md`（#534）",
]

requirements: {
	"R-01": {
		title: "状態のボードの列と、列の中の推奨順"
		text: """
			ボードの列は、左から 止められている、着手できる、作業中、マージ待ち の順に並べ、終わったものを含める切り替えのときは一番右に 終わった を足す。マージ待ちの列は「マージできる」と「直す必要あり」の2つの段に分け、マージできるを先に置く。列への振り分けはモデルの `lane` と `merge` をそのまま使い、列の中の並びはモデルの推奨順（Epic R-31）をそのまま使う。不明の Scope はどの列にも入れず、列の上に注意の帯で一覧にする。後に続く数が1以上の札には「後に続く N」の印を付ける。（Epic R-13、R-31、R-30）
			"""
		acceptance: [
			"見本で、列が左から 止められている、着手できる、作業中、マージ待ち の順に並び、終わったものを含めると右端に 終わった の列が出る",
			"見本で、下書きでない PR が開いている作業中の Issue がマージ待ちの列に、下書きの PR の Issue が作業中の列に出る。CI が失敗した PR と衝突した PR が「直す必要あり」に、ほかが「マージできる」に分かれる",
			"見本で、着手できる列の先頭に、後に続く開いた Scope の数が一番多いものが来て、その札に「後に続く N」の印が出る",
			"不明の Scope は列に入らず、列の上の注意の帯に出る",
			"Scope が250件ほどの構造で、このPCのブラウザーで、ボードが2秒以内に出る（Epic R-13 の受け入れの条件）",
		]
	}
	"R-02": {
		title: "ボードの上の数の帯、種類の絞り込み、親ごとのまとめ、終わったものの切り替え"
		text: """
			ボードの上に、止められている、着手できる、作業中、マージ待ち（直す必要あり・マージできるの内訳）の数と、終わった割合を出す。種類（すべて、Initiative、Epic、Issue）で絞り込め、親ごとにまとめられる。終わったものを含めるかを切り替えられ、既定は含めない。終わったものを隠しているときも、開いた子孫を持つ閉じた親は、列の上の帯に残す（閉じた親の下の開いた Scope を見失わないため）。これらの表示の切り替えは URL の問い合わせの文字列に持ち、開き直しと共有で同じ表示に戻る。（Epic R-12、R-13、R-17）
