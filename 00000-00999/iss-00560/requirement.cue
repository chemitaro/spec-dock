package spec

// 要件（Issue）。型 specdock/v1。書き方は spec-dock/docs/authoring/ のガイドにある。
// 親は epic-00427。plan.cue の slice `iss-00560`（covers: R-15）と、Epic R-15 の配置の一文（2026-11-04 の利用者の決定）を、
// この Issue の番号に書き直した。Epic の番号は「Epic R-15」のように書く。この Issue の番号は R-01 などである。

// 型の版。消さない。
schema: "specdock/v1"

// 保証レベル（light、standard、strict、critical）と、その理由。
// 失敗したときの影響と回復の難しさで選ぶ（工数や作業の難しさでは選ばない）。
// 具体化や作業の途中で、上げても下げてもよい。正本はここだけで、ほかの場所に写さない。
assurance: {
	level:  "standard"
	reason: "構造の図の配置の決まりを変える。見え方の誤りは版を戻せば直るが、毎日見る画面の主な配置を変える"
}

purpose: "構造の図（入れ子）で、依存の矢印でつながったものを、つながりの順に同じ行にそろえて左から右へ並べ、つながりを1目で追えるようにする。"

background: """
	- 2026-11-04、利用者の言葉：「依存の矢印でつながっているものは、左から右に向かって並べたい。画面サイズに合わせて Epic 単位の折り返しはあってもよいが、次の作業につながっているなら横につなげる。画面に空きがある限り横に広げてほしいわけではない。いま epic-00427 が上、epic-00471 が下、その次の epic-00526 がまた上で、いびつ。順番に並べたほうが見やすい。」
	- 今の配置（#556、`views/graph/layout.js`）は、同じ親の子をモデルの段（`stage.all`／`stage.open`）の列に分け、列の中を活動順に縦に積む（`colsBlock`）。段が1つだけなら1行に右へ並べる（`wrapBlock`。#556 で折り返しをやめた）。列ごとに上から詰めるので、つながりの前後で行（高さ）がずれる。
	- このPCの spec-dock の実データ（2026-11-04）では、init-00423 の epic-00427 と epic-00547 が、配下の終わった Issue どうしの依存（iss-00549 → iss-00552、iss-00534 → iss-00554）で輪になり、モデルの `stage.all` が 427 と 547 で空（段 1 扱い）になる。そのため 425、427、471 が同じ段に縦に積まれ、526 だけが右に出る。
	- 統括が利用者に確かめた（2026-11-04）：つながっていないまとまりは、活動順に左から置き、使える幅を超えるところで、まとまりの境目で次の行へ折り返す（案B）。
	"""

includes: [
	"入れ子の表し方の、同じ親の子（最上位を含む）の配置",
	"依存でつながったまとまりの中の行のそろえと、分かれ・合流での行の入れ替え",
	"つながっていないまとまりの、活動順の並べと、使える幅での折り返し",
	"ウィンドウの幅が変わったときの並べ直し（`views/graph.js`）",
	"PC のヘッドレスの Chrome で、このPCの spec-dock の実際のスナップショットを PC の幅と 390px で写す",
]
excludes: [
	"木の表し方の配置（今のまま）",
	"モデル（`domain/dashboard_model.py`）の段、推奨順、状態、片付けの候補の判定と、構造の API",
	"経路（`router.js`）の作り方",
	"Epic の文書、配布資産の文書、`static-inventory.json`、版の番号と `migration.md`",
	"iPhone の Safari での確かめ（統括が利用者に頼む）",
]

requirements: {
	"R-01": {
		title: "依存の矢印でつながったものは、つながりの順に同じ行にそろえて左から右へ並ぶ"
		text: """
			入れ子の表し方で、同じ親の子（Initiative の中の Epic、Epic の中の Issue、最上位の Scope）のうち、依存の矢印でつながったもの（子の配下どうしの依存を含む。モデルの段と同じ数え方）を1つのまとまりにし、次のとおりに並べる。
			- 左右の順は、兄弟どうしの依存の段で決める。数え方はモデルの段（#556 の決まり：終わった子を出す枠では終わったものも数え、そうでない枠では開いたものだけ）と同じで、前のものが左、後のものが右。依存が輪になるときは、輪を閉じる依存を1つずつ外して段を決める（F-02）。
			- 上下の位置は、まとまりの中で行をそろえる。後のものは、前のものと同じ行に置く。1つの段の中の同じ行には1つだけ置き、行の高さは、その行の最も高いものに合わせる。
			- 分かれ（1つの後に複数が続く）では、後に長く続くものが前のものの行を受け継ぐ。合流（複数の後に1つが続く）では、前のものの行の平均（.5 は上の行）に置く。最初の段の並べ方を入れ替えて、線の交差と上下の行き来が少ないほうを選ぶ。
			- 横は詰める：各箱（枠）は、同じ行の左の箱と、前のもの（依存の元）の右に、列の間（44px）を空けて置く。別の行の幅の広い箱のために、つながりの中に空きを作らない。
			- つながりの途中では折り返さない。まとまりが使える幅より広くても、1行のまま右へ広げる。
			"""
		acceptance: [
			"見本の 425 → 427 → 471 → 526 に当たる4つの Epic が、同じ上端（同じ行）で左から右へ並ぶ",
			"見本の分かれ（1つの後に2つ。一方だけに後が続く）で、後が続くほうが前のものと同じ行に並ぶ",
			"見本の、最初の段の活動順のままでは交差する1つのまとまり（A→C、A→D、C→E、B→E。A が活動順で先）で、B が A より上の行に、E が B と同じ行に並び、交差が0件",
			"見本の、2つの Epic が配下の依存で輪になる親で、例外を出さずに、輪の外の依存のつながり（前 → 輪の一方 → 後）が1行に並ぶ",
			"見本で、同じ段に幅の広い枠があっても、つながりの次の箱が前の箱の右に列の間だけ空けて並ぶ",
			"このPCの spec-dock の実際の構造で、init-00423 の epic-00425 → 427 → 471 → 526 が1行に並ぶ（ヘッドレスの Chrome、report.md に写し）",
		]
	}
	"R-02": {
		title: "つながっていないまとまりは、活動順に左から置き、使える幅でまとまりの境目で折り返す"
		text: """
			- 同じ親の中の、依存でつながっていないまとまり（ひとりの Scope、別のつながり）は、活動順（Epic R-15、#556 の `byActivity`。まとまりの中で最も先に来るもの）に左から右へ置く。
			- 次のまとまりを置くと使える幅を超えるところで、次の行へ折り返す。行は下へ積む。折り返しは、まとまりの境目でだけ行う。1つのまとまりが使える幅より広ければ、その行を1つで占める。
			- 見える幅（W）は、倍率100%で図の見える幅（図の領域の幅から 16px を引いた px。390px の電話では 374px）。使える幅は、最上位では W から図の余白（左右 24px ずつ）を引いた幅（W − 48）、枠の中では、その枠に渡された使える幅から、その枠の左右の余白を引いた幅。空きがあるからといって、まとまりを広げたり離したりはしない。
			- 折り返しの位置は、経路の広げの前の配置で決め、経路を広げる繰り返しの間は変えない。
			- 片付けの候補のまとまり（畳んだもの）は、今までどおり並びの最後に置く。
			"""
		acceptance: [
			"見本で、依存のない12件の Issue を持つ Epic が、W = 1400 では1行に入るだけ並べて折り返し、各行の幅がその Epic の使える幅（1400 − 48 − 24 = 1328px）を超えない",
			"見本で、使える幅より広いつながりは折り返されず、1行を占める",
			"見本の最上位と枠の中で、まとまりが活動順に（上の行から、行の中は左から）並ぶ",
		]
	}
	"R-03": {
		title: "ウィンドウの幅が変わったときだけ並べ直し、拡大・縮小では並べ直さない"
		text: "画面は、図の見える幅（倍率100%の px）を配置に渡す。ウィンドウの幅が変わったときだけ、新しい幅で並べ直す（高さだけの変化、拡大・縮小、移動、選択では並べ直さない）。並べ直しても、拡大の倍率と位置は保つ。"
		acceptance: [
			"PC のヘッドレスの Chrome で、窓の幅を変えると並びの行数が変わり、拡大・縮小のボタンと「全体」では並びが変わらない",
		]
	}
	"R-04": {
		title: "線の検査の違反0を保つ"
		text: "新しい配置で、線の検査（`edgeAudit`、router.js の audit）の違反0を保つ。テストの代表のデータ（spec-dock の固定のスナップショット、種 532・15・18）のすべての表し方と、見える幅を W = 1400（PC）と W = 374（390px）にした表し方、このPCの spec-dock の実際の構造の PC の幅と 390px で確かめる。"
		acceptance: [
			"代表のデータのすべての表し方（使える幅を変えたものを含む）で問題が0件、種 532 が1秒以内",
			"このPCの spec-dock の実際の構造で、PC の幅と 390px の既定の表示の `window.specdockEdgeAudit()` の違反が0件",
		]
	}
}

failures: {
	"F-01": {
		title: "使える幅が分からないときは、決まった幅で並べる"
		text: "配置に見える幅 W が渡されない（node のテスト）か、0 以下か数でないときは、W = 1240（#556 より前の折り返しの幅）として扱う。"
	}
	"F-02": {
		title: "依存の輪や、段とずれた依存があっても止まらない"
		text: "兄弟どうしの依存が輪になるときは、強い依存から順に残し、輪を閉じる依存を外して段と行を決める。強さの順：兄弟そのものどうしの依存 → 開いたものどうしの依存の数が多い → 依存の数が多い → 元の番号が小さい → 先の番号が小さい。外した依存も、まとまりの判定には使わない（外しても同じまとまりに残る）。依存の線は今までどおりすべて描く。配置は例外を出さずに描く。"
	}
}

constraints: [
	"編集してよい範囲：`src/spec_dock/assets/dashboard/views/graph*`、`tests/`、この Scope のディレクトリ",
	"モデルの段、推奨順、活動順の考え方（#556）は変えない（画面は並べるだけ）",
	"配布資産の文書を変えないので、`static-inventory.json` は変えない",
	"#554（人のタスクの印を図に足す）が並んで走る。後にマージするほうが main を取り込む",
]

decisions: [
	"つながっていないまとまりは、活動順に左から置き、使える幅でまとまりの境目で折り返す（案B。統括が利用者に確かめた。2026-11-04）",
	"見える幅 W は、図の見える幅から 16px を引いた幅（初めの表示と「全体」の計算と同じ余白）を倍率100%の px で渡す。390px の電話では 374px",
	"入れ子の左右の段は、モデルの段ではなく、配置の中で兄弟どうしの依存から数える（数え方はモデルと同じで、輪がなければ同じ値）。実データで 427 と 547 の輪がモデルの段を空にし、つながりが1行に並ばないため。木の表し方は今までどおりモデルの段",
	"Epic R-15 の「行を折り返さずに右へ広げ」と、その acceptance の「長い依存の折り返し」は、#560 の一文と食い違う。Epic の文書はこの Issue では変えず、report.md と統括への報告で、統括に直しを頼む。0.6.0 の移行の注記の文も同じく渡す",
	"木の表し方は変えない（slice は入れ子の配置を対象にする。木は1列に並べる表し方のため）",
]
