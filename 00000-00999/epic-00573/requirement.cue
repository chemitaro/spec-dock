package spec

// 要件（Epic）。型 specdock/v1。

schema: "specdock/v1"

assurance: {
	level:  "standard"
	reason: "全リポジトリの画面の状態の色・アイコン・配置を変える。誤りは表示に限られ版を戻せば直るが、毎日見る画面の主な見え方を変える"
}

purpose: "ダッシュボードで、Scope の状態と作業中の進み具合・稼働を一目で見分けられるようにし、構造の図を画面に合わせて密に並べる。"

background: """
	2026-11-05 の利用者の要望（`.workbench/README.md`）：着手できると作業中の色を入れ替え、止められているを黄色にし、作業中の印を動きのあるものにする。
	作業中の印は、計画の手順の進みと「実際に動いているか」を1つの印で示し、30分を境にする。表示を遅くしない。Initiative も画面の幅に合わせて横に並べる。
	見本（`.workbench/state-icons-candidates-20261105.html`）から、作業中＝①区切りの輪、止められている＝②一時停止の丸が選ばれた。
	2026-11-06 に、taikyohiyou_project の構造の図で、列と行の間に極端に広い隙間が空くことが報告された。
	"""

includes: ["状態の色と形", "作業中の進み具合と稼働の印", "構造の図の最上位の並べ方", "構造の図の隙間の直し", "0.9.0 のリリース"]
excludes: ["構造の図の行をそろえる決まり（同じ行の高い枠に合わせる）の変更", "ダッシュボードから書き込む操作"]

requirements: {
	"R-01": {
		title: "状態の色と形を、すべての画面でそろえて見分けられる"
		text:  "着手できる＝深い青の再生の丸、作業中＝鮮やかな緑の区切りの輪、止められている＝黄色の一時停止の丸、不明＝紫の「?」の丸、終わった＝灰色のチェック。凡例、状態の札、図、ボード、概況、詳しい画面、人のタスクの印をそろえる。"
		acceptance: ["5つの状態が、色と形の両方で見分けられる", "明るい表示と暗い表示の両方で、印と地のコントラストが WCAG AA を満たす", "状態でない赤（期限切れ、PR の失敗など）は変わらない"]
	}
	"R-02": {
		title: "作業中の印が、計画の進み具合と、実際に動いているかを示す"
		text:  "Issue は plan.cue の手順（dropped を除く）で輪を区切り、終わった分を塗る。Epic・Initiative は配下の Issue の終わった割合。最後に動いてから30分以内なら次の区切りが点滅し、超えたら「N分動きなし」と添える。"
		acceptance: ["手順の進みが輪の区切りで読める", "30分以内に動いた Scope だけが点滅する", "一覧の画面と prefers-reduced-motion では動かない", "5秒ごとの更新で plan.cue を読み直さない（時刻と大きさで覚える）"]
	}
	"R-03": {
		title: "Initiative が、画面に合わせて横に並ぶ"
		text:  "構造の図の最上位を、全体を画面に収めたときの倍率が最大になる行の幅で並べる。依存の鎖は分けない。窓の大きさが変わり終わったときだけ並べ直す。"
		acceptance: ["1920×1080 と 1440×900 で、実データの Initiative が1行に2つ以上並ぶ", "データの更新では配置が動かない"]
	}
	"R-04": {
		title: "構造の図に、極端に広い隙間ができない"
		text:  "列と列、行と行の間は、そこを通る線の本数に見合う幅に収まる。線は、両端を含む枠の外へ遠回りしない。"
		acceptance: ["taikyohiyou_project の epic-02233 で、列の間と行の間が線の本数に見合う幅になる", "線の検査（edgeAudit）の違反と frameExits が0"]
	}
	"R-05": {
		title: "これらを 0.9.0 として、すべてのリポジトリに配る"
		acceptance: ["v0.9.0 のタグ、この PC への導入、7つのリポジトリの配布資産の更新と canonical check の合格"]
	}
}

failures: {
	"F-01": {
		title: "plan.cue が読めない、または cue がないときは、輪の外枠だけを示し、画面は止めない"
	}
}

decisions: [
	"作業中＝①区切りの輪、止められている＝②一時停止の丸（利用者、2026-11-05）",
	"稼働の境目は30分（利用者、2026-11-05）",
	"最上位の行の幅は、100%表示の画面の幅ではなく、全体表示の倍率が最大になる幅で選ぶ（統括、2026-11-06。100%の幅では実データで一度も並ばなかったため）",
	"上下の隙間も #578 の範囲に含める（利用者の指摘、2026-11-06）",
]
