package spec

// 要件（Issue）。型 specdock/v1。書き方は spec-dock/docs/authoring/ のガイドにある。
// 親は epic-00573。Epic の要件はまだ雛形なので、Epic の作業メモ（.workbench/README.md）と見本
// （.workbench/state-icons-candidates-20261105.html）にある利用者の決定（2026-11-05）から、この Issue の要件を書いた。

// 型の版。消さない。
schema: "specdock/v1"

// 保証レベル（light、standard、strict、critical）と、その理由。
assurance: {
	level:  "standard"
	reason: "全画面の状態の印と色を変え、計画の手順の読み取りを足す"
}

purpose: "ダッシュボードの状態の印を、利用者が選んだ色と丸の形にそろえ、作業中の Scope は、計画の進み具合と「いま動いているか」を1つの印で示す。"

background: """
	- 今の印（`core/ui.js` の `STATES`）：着手できる＝緑の三角、作業中＝暗い青の半円、止められている＝赤の八角形と横棒、不明＝黄色の菱形、終わった＝灰色のチェック。色は `app.css` の `[data-st]` で、DS の意味の色（ok、accent、danger、warn、tip）を借りている。
	- 利用者の要望と決定（2026-11-05、Epic の作業メモ）：着手できる＝深い青の再生の丸（▶）。作業中＝鮮やかな緑の①区切りの輪。止められている＝黄色の②一時停止の丸（‖）。不明＝紫の「?」の丸。終わった＝灰色のチェック（今のまま）。どれも丸の形にそろえる。
	- 作業中の輪は、Issue の `plan.cue` の手順の数で輪を区切り、`done` の手順の区切りを緑に塗る。最後に動いてから30分以内なら「次の区切り」をゆっくり点滅させる。
	- 見本の24px では、点滅の有無の差が小さく見えた。
	- 構造の API は、画面が5秒ごとに `revision` を確かめ、変わったときだけ読み直す。`plan.cue` の評価（`cue`）は重い。#544 は、保証レベルを `requirement.cue` の時刻と大きさで覚えて、この問題を解いた。
	- 構造の API の `active_at`（#556）は、Scope の作成、Issue の最後の更新、閉じた時刻、PR の作成・マージ・閉じた時刻の最も新しいもの。GitHub の構造の同期（1〜2分ごと）で変わる。
	"""

includes: [
	"5つの状態の色と形（明るい表示と暗い表示）と、状態の色を使うすべての所",
	"作業中の Issue の区切りの輪（`plan.cue` の手順）と、作業中の Epic・Initiative の輪（配下の Issue）",
	"いま動いているかの点滅と、「N分（時間）動きなし」の言葉",
	"構造の API と詳しい画面の API の `progress`（作業中の Issue の手順の数）と、その読み取りの覚え方",
	"`plan.cue` の書き換えを5秒ごとの更新に届ける（`revision`）",
	"PC のヘッドレスの Chrome での写し（PC 幅と 390px、明るい・暗い）",
]
excludes: [
	"Initiative の横並び（#575）",
	"版の番号と `migration.md`（次の版のリリースの Issue）",
	"Epic の requirement・design・plan（統括が後で書く）",
	"人のタスクの「期限切れ」の赤（状態ではないので変えない）",
	"マージ待ちの列の色（状態ではないので変えない）",
]

requirements: {
	"R-01": {
		title: "5つの状態が、決まった色と丸の形で示される"
		text: """
			| 状態 | 形 | 色 |
			| --- | --- | --- |
			| 着手できる | 輪の中に再生の三角（▶） | 深い青 |
			| 作業中 | 区切りの輪（R-03、R-04） | 鮮やかな緑 |
			| 止められている | 塗った丸に一時停止の2本（‖） | 黄色 |
			| 不明 | 輪の中に「?」 | 紫 |
			| 終わった | 塗った丸にチェック | 灰色（今のまま） |

			どれも、外形が同じ大きさの丸に収まる。印の言葉（`aria-label`）は今のまま（着手できる、作業中、止められている、不明、終わった）。
			"""
		acceptance: [
			"`stateIcon` が5つの状態で上の形を描き、どの形も、線の太さを含めた外縁が 24 の座標の中心 (12, 12) から半径10.5以内に収まる（node。輪の半径8.6と線の半分1.8で10.4、終わったの丸の半径10）",
			"明るい表示と暗い表示の両方で、状態の色（印の色）は、地（`--ds-bg`、`--ds-bg-2`、`--ds-surface`、`--ds-surface-2`）との差が 3:1 以上、状態の札の文字の色は、札の地との差が 4.5:1 以上（WCAG AA。CSS の値から計算するテスト）",
		]
	}
	"R-02": {
		title: "状態の色を使うすべての所が、新しい色にそろう"
		text: """
			凡例、状態の札（`chip`）、構造の図の箱の左の帯と地、ボードの列の上の帯、概況の区分と数の印、配下の内訳の帯、詳しい画面の表紙の帯、要点の帯、人のタスクの「止める」と「Scope を止めている」、構造の図の「人 n」の印。止められているの斜めの縞も黄色にする。
			状態を表さない赤（人のタスクの期限切れ、PR の閉じた・失敗、保証レベルの critical）と、マージ待ちの列の色は変えない。
			"""
		acceptance: [
			"`app.css` の `[data-st]` の5つの状態が、状態の色の札（`--sd-<状態>`、`-bg`、`-line`、`-ink`）だけを使う",
			"画面の CSS と JavaScript に、止められている・人が止めているを `--ds-danger` で塗る所がない（静的）",
			"ヘッドレスの Chrome の写しで、構造の図・ボード・概況・詳しい画面・人のタスクの状態の色が新しい色である（report.md）",
		]
	}
	"R-03": {
		title: "作業中の Issue は、計画の手順の進み具合を区切りの輪で示す"
		text: """
			- 区切りの数は `plan.cue` の手順のうち `dropped` でないものの数（total）。`done` の数だけ、12時の位置から時計回りに区切りを緑に塗る。残りは灰色の細い区切り。
			- total が12を超えるときは、区切りのない輪で、done／total の割合の弧を緑に塗る。
			- 手順がない、`plan.cue` がない・読めない、Markdown の Scope のときは、区切りのない輪の外枠（緑）だけ。
			- 印の言葉に「作業中（手順 4／8 終わった）」のように数を添える。
			"""
		acceptance: [
			"手順 0／8、4／8、8／8、3／5（1つ dropped）、5／13 と、手順なしで、輪の区切りの数と塗った数、弧、外枠だけの形が上のとおり（node）",
			"構造の図の箱、要点、詳しい画面、ボード、概況、検索の候補の作業中の印が、同じ `stateMark` で描いた輪である（静的：各画面が作業中の印を `stateMark` で描く。ヘッドレスの Chrome：各画面の作業中の印の区切りの数が同じ）",
		]
	}
	"R-04": {
		title: "作業中の Epic・Initiative は、配下の Issue の終わった割合を輪で示す"
		text: "作業中の Epic・Initiative の輪は、配下（孫を含む）の Issue の数を total、そのうち終わった Issue の数を done として、R-03 と同じ規則で描く（12以下は区切り、超えれば弧、配下の Issue がなければ外枠だけ）。配下の Issue の手順は合計しない（decisions）。"
		acceptance: [
			"配下の Issue が5つで2つ終わった作業中の Epic の輪が、5つの区切りのうち2つを塗る（node）",
		]
	}
	"R-05": {
		title: "作業中の印は、最後に動いてから30分以内なら次の区切りをゆっくり点滅させる"
		text: """
			- 最後に動いた時刻：Issue は、`active_at` と `progress.modified_at`（`plan.cue` の最後の書き換え）の新しいほう。Epic・Initiative は、自分と配下のすべての Scope の、同じ時刻の最も新しいもの。
			- 30分以内（動いている）：次の区切り（done の次の1つ）が、緑の太い区切りとして、ゆっくり（約2秒の周期で）現れたり消えたりする。区切りのない輪では、弧の先の短い区切りが点滅する。外枠だけの輪では、外枠に重ねた太い輪が点滅する。手順がすべて終わった（done = total）輪では、輪の中心の小さな丸が点滅する。動いている／止まっているの差が、24px の箱の中ではっきり分かる強さ（不透明度 0.15〜1）にする。
			- 30分を超えた（止まっている）：動かさない。要点（構造の図の横の窓）と詳しい画面の表紙に「N分動きなし」「N時間動きなし」「N日動きなし」を添える。
			- 動かす所：構造の図の箱と枠の頭、要点、詳しい画面の表紙。一覧の画面（概況、人のタスク、ボードの一覧の部分）、凡例、検索の候補では動かさない（形は同じ）。
			- `prefers-reduced-motion: reduce` では、どこでも動かさない（点滅の重ねを描かない。動いていないときと同じ形で、外枠と区切りは見える）。
			- 画面を開いたままでも、30分の境目を過ぎたら、次の5秒ごとの確かめで描き直して点滅を止める。
			"""
		acceptance: [
			"最後に動いた時刻が29分前の作業中の Issue の箱の印に、点滅する次の区切りがあり、31分前の箱にはなく、要点に「31分動きなし」がある（node とヘッドレスの Chrome）",
			"概況・ボード・人のタスクの作業中の印に、点滅する要素がない（node と静的）",
			"`prefers-reduced-motion: reduce` で、点滅の `animation` が `none` になる（静的と、ヘッドレスの Chrome のエミュレーション）",
			"開いたままで30分の境目を過ぎると、`revision` が同じでも描き直す（静的）",
		]
	}
	"R-06": {
		title: "構造の API と詳しい画面の API が、作業中の Issue の手順の数を返す"
		text: """
			- 各 Scope の `progress`：状態が作業中（`doing`）の Issue で、`plan.cue` が読めたときは `{total, done, doing, todo, dropped, modified_at}`（`total` は dropped を除く。`modified_at` は `plan.cue` の更新時刻、UTC の ISO 8601）。それ以外は `null`。
			- `plan.cue` は、時刻と大きさで覚え、変わっていなければ `cue` を走らせない。読むのは作業中の Issue だけ。外の処理は、1つの要求で合わせて3秒を上限にする（保証レベルの読み取りとは別の上限）。
			- `plan.cue` を書き換えると、`revision` が変わり、5秒ごとの確かめで画面に届く。
			"""
		acceptance: [
			"作業中の Issue の `plan.cue` に手順があるカタログで、構造の API のその Issue の `progress` に数が入り、作業中でない Scope と Epic は `null`（ユニット）",
			"同じカタログで2回読むと、2回目は `cue` を走らせない。間に詳しい画面の API を読んでも、次の構造の API は `cue` を走らせない。1つの `plan.cue` を書き換えると、その Issue だけ読み直し、`revision` が変わる（ユニット）",
			"詳しい画面の API の `scope.progress` が、構造の API と同じ値（ユニット）",
		]
	}
	"R-07": {
		title: "PC のヘッドレスの Chrome の写しで、新しい印を確かめる"
		text: "一時の状態の置き場で立てたサーバーと見本のカタログで、PC 幅（1440）と 390px、明るい表示と暗い表示の構造の図・ボード・概況・詳しい画面・人のタスクの写しを撮り、report.md と artifacts に残す。利用者の常駐のサーバーと `~/.local/state/spec-dock/` を使わない。"
		acceptance: [
			"report.md に、4通り（PC・390px × 明るい・暗い）の写しと、ブラウザーの記録のエラー0件が書いてある",
		]
	}
}

failures: {
	"F-01": {
		title: "`plan.cue` が読めない、`cue` がない、時間切れのときは、`progress` を `null` にして、ほかは返す"
		text: "構造の API は 200 で、その Issue の `progress` だけが `null`。印は外枠だけの輪。読めなかった値（構文の誤りなど）は時刻と大きさで覚え、時間切れと `cue` がないときは覚えず、次の要求で読む。"
	}
	"F-02": {
		title: "最後に動いた時刻が分からないときは、動いていないとし、言葉を添えない"
		text: "`active_at` も `modified_at` も読めない時刻のときは、点滅させず、「動きなし」も書かない。"
	}
}

constraints: [
	"編集してよい範囲：`src/spec_dock/assets/dashboard/**`、`runtime/application/dashboard_*.py`、`runtime/presentation/dashboard_api.py`、`tests/`、この Issue の Scope のディレクトリ",
	"`progress` は画面のための項目で、公開の契約ではない（`specdock.dashboard/v1` の `structure` と `scope` は画面のための形）",
	"新しい外の処理を足さない（`cue` だけ。`git` や GitHub を新しく呼ばない）",
]

decisions: [
	"Epic・Initiative の輪は、配下の Issue の終わった割合にする（配下の手順の合計にしない）。理由：構造の API にすでにある値で描け、作業中でない配下の `plan.cue` を読む重い処理が要らない。Epic の計画の単位は Issue なので、意味も読み取りやすい。",
	"最後に動いた時刻に `plan.cue` の更新時刻を加える。理由：`active_at` は GitHub の更新と PR だけで、作業者が手順の `status` を書き換えても変わらない。手順を書き換えた直後に「動いている」を示すため。",
	"灰色の残りの区切りは、地との差 3:1 以上の灰色（`--ds-border-2`）で細く描き、塗った区切りは太く描く。見本の薄い灰色（約1.5:1）では、0／8 の輪が見えないため。",
	"明るい表示の「黄色」は、白い地で 3:1 を満たすよう、琥珀に寄せた濃い黄色にする。暗い表示では見本の明るい黄色を使う。",
	"`plan.cue` は型なしで `cue export -e steps` で読む（`status` が書いてなければ todo）。詳しい画面の文書の描画（型つきの評価）は今のままで、輪の数は構造の API と同じ読み取りから取る。",
]
