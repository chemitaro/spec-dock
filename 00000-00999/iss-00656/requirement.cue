package spec

// 要件（Issue）。型 specdock/v1。書き方は spec-dock/docs/authoring/ のガイドにある。

schema: "specdock/v1"

assurance: {
	level:  "standard"
	reason: "構造の図と横断の構造で共有する欄の見出しの配置を変える"
}

purpose: """
	構造の図・『横断の構造』の Scope の欄（PC の右の欄とスマートフォンの下からの欄）の見出しから、同じ情報の重なりを除き、タブとその中身を広く見せる。
	見出しは『パンくずと今の Scope の ID の行』と『題名』の2行（足す情報があるときだけ状態の帯の1行）にし、タブの下で選んだタブの名前を繰り返す行をなくす。
	"""

background: """
	本人の指摘（2026-11-18、写しは Epic の `.workbench/iss-00656-before-pc.png`）：PC のブラウザーで Issue を選んだときの右の欄の上の部分に、同じ情報が何度も出て、場所を取っている。大事なのはタブとその中身なのに、見出しが大きい。小さな画面では中身の割合がさらに減る。

	タスク担当が確かめた今の事実（`92e26aff7`）：
	- 欄の見出し（`views/_shared/panel.js` の `header()`）は、上から、状態の札・マージの札・エージェントの印・Orca で開く・閉じるの行（`.pn-head`）、ID の札と `#番号・種類`（`.pn-kicker`）、題名（`.pn-title`、行数の制限なし）、状態の印と理由の文の帯（`.pn-why`。いつも出る）、『N分動きなし』（`.pn-idle`）、パンくず（`.pn-path`。祖先のボタンと、最後に今の ID）の順に並ぶ。
	- 理由の文（構造の API の `reason.text`、`domain/dashboard_model.py` の `_reason`）は、終わった（`closed`）は『終わった』、自分で作業中（`in_progress`）は『作業中』で、状態の名前と同じ。着手できる（`no_waits`）は『待っているものはない』。ほかは足す情報を持つ（『#12・#13 を待つ』『親 … が閉じている』『配下の 2件が作業中』『PR #N をマージできる』『PR #N を直す必要がある（CI が失敗）』『構造が分からない（…）』など）。
	- そのため作業中の Issue では、『作業中』が札と帯で2回、今の ID が札・パンくずの最後の2回（`#番号・種類` を加えると3つ）出る。
	- マージの札（`mergeBadge`、『マージ待ち・マージできる』『マージ待ち・直す必要あり』）は、理由の文（`pr_mergeable`・`pr_needs_fix`）と同じことを言う。
	- 説明資料のタブ（`views/_shared/scope_tabs.js` の `explanationTab`）は、枠の上に『□ 説明資料』と新しいタブで開く印の帯（`frameBar`）を置き、名前はタブの名前を繰り返す。文書のタブの帯は文書の選び（要件・設計・計画…）を持ち、エージェントのタブの帯はエージェントの選びを持つ（どちらも名前の繰り返しではない）。
	- 下の行（`.pn-foot`）の『詳しい画面』と『新しいタブで開く』は Scope の詳しい画面（同じ画面と新しいタブ）、『GitHub』は Issue。見出しの『Open』は orca-web（Orca で開く）。枠の帯の印は枠の文書（説明資料の HTML、文書の HTML）を新しいタブで開く。行き先はすべて違う。
	- スマートフォン（幅 640px 以下）の下からの欄の全体の段は、見出しを『状態の札・ID・題名（1行）・Orca で開く・閉じる』の1行に詰め、マージの札・種類・帯・動きなし・パンくずを隠す。最小と通常の段は PC と同じ見出し。
	"""

includes: [
	"Scope の欄（`views/_shared/panel.js`・`panel.css`）の見出しの並びと、状態の帯を出す条件",
	"タブの中身の枠の上の帯のうち、選んだタブの名前を繰り返す帯（説明資料）をなくし、枠を新しいタブで開く印をタブの行の右端に移す（欄と詳しい画面の両方。`scope_tabs.js`・`scope_tabs.css`・`views/scope.js`・`scope.css`）",
	"同じ部品（`createScopePanel`）を使う3つの画面の欄：構造の図・『横断の構造』・ボード（PC とスマートフォンの下からの欄の3段）",
	"同じ欄に描く『片付けの候補』の見出し（`.pn-head` を持つ）を崩さないこと",
	"直す前と後の見出しの高さと説明資料の枠の高さの測り、写し",
]

excludes: [
	"詳しい画面の見出し（`.sd-cover`）の並び（タブの行の印だけを変える）",
	"説明資料の中身（Scope ごとに書かれた HTML の見出しなど）",
	"下の行（詳しい画面・新しいタブで開く・GitHub）の並びと行き先（変えない。理由は decisions）",
	"欄の幅、下からの欄の3段の高さと引っぱりの動き（iss-00650 の範囲）、タブの並びと中身",
	"Python の API・保存・モデル・orca-web の部品",
]

requirements: {
	"R-01": {
		title: "見出しの1行目に、祖先のパンくずと今の Scope の ID・番号・種類を1つにまとめ、右に状態の札・エージェントの印・Orca で開く・閉じるを置く"
		text: """
			見出しの1行目の左は、祖先のパンくず（根から親まで。各々を押すとその Scope を欄に出す、今と同じ）に続けて、今の Scope の ID と `#番号・種類` をひとまとまりで出す。祖先がない Scope は、パンくずの代わりに『最上位』を示す小さな印（title と aria-label が『最上位』）を出す。
			右は、状態の札（1つ。作業中の区切りの輪と点滅を含め今と同じ部品）、エージェントの印（今と同じ上限 4）、Orca で開く、閉じるの順。
			今の Scope の ID は、欄の見出し（`.pn-top`）の中でこの1回だけ出す。1行に収まらない幅では、まず祖先の ID を省略記号で縮め（押せるまま、title に ID と題名）、次に `#番号・種類` を縮める。今の ID と右の部品は縮めない。
			それでも収まらないとき（狭い欄で祖先が多く、エージェントの印も多いとき）は、パンくずと今の ID のまとまりを、右の部品の行の下の1行に送る（右の部品は上の行の右端に残る）。どの場合も、見出しは欄の横にはみ出さない。
			"""
		acceptance: [
			"偽の DOM で、欄の見出しの文字の中に今の Scope の ID がちょうど1回あり、祖先の ID がその前に順に並ぶ（Issue・Epic・Initiative、祖先のない Scope）",
			"祖先のボタンを押すとその Scope が選ばれる（今のテストの意味を保つ）。祖先のない Scope に『最上位』の印がある",
			"実機で、1440×900 と 1000×800 の作業中の Issue（祖先2つ、エージェントの印 0〜2）の欄の1行目が1行に収まる",
			"実機で、1000×800 でエージェントの印を4つにした欄の見出しが、1行に収まるか、パンくずのまとまりが右の部品の下の1行に送られ、どちらでも `.pn-head` の `scrollWidth` が `clientWidth` を超えない（閉じるは右上に残る）",
		]
	}
	"R-02": {
		title: "見出しの2行目は題名だけにし、長い題名は2行で切る"
		text:  "題名は1行目の下に置き、2行を超える分は省略記号で切る。切ったときも全文を title で読める。"
		acceptance: [
			"CSS で、欄の題名が2行で切れる（`-webkit-line-clamp: 2` か同等。静的な検査）",
			"偽の DOM で、題名の要素の title が題名の全文",
		]
	}
	"R-03": {
		title: "状態の帯は、足す情報があるときだけ1行で出す"
		text: """
			帯（`.pn-why`）は、理由が状態の名前のほかに何かを足すとき、または『N分動きなし』があるときだけ出す。理由が足さないのは、理由の文が空、状態の名前（`STATES[state].label`）と同じ、または理由の符号が `closed`・`in_progress`・`no_waits` のとき。
			帯は1行で、理由の文（足すときだけ）と『N分動きなし』（あるときだけ、時計の印つき）を並べ、収まらない分は省略記号で切り、全文を title で読める。帯の左の線は今と同じ状態の色。状態の札が1行目にあるので、帯には状態の印を出さない。
			『N分動きなし』は帯の中に入れ、別の行（`.pn-idle`）としては出さない。
			"""
		acceptance: [
			"偽の DOM で、自分で作業中の Issue（理由『作業中』、動きあり）・終わった Scope・着手できる Scope に帯がなく、見出しの文字の中で状態の名前が札の1回だけ",
			"偽の DOM で、止められている Scope（『#12 を待つ』）、配下が作業中の Epic（『配下の 2件が作業中』）、PR の理由の Scope、理由の分からない Scope に帯があり、その文が理由の文",
			"偽の DOM で、30分を超えて動きのない作業中の Issue に、帯が1つ（理由『作業中』は出さず『N分動きなし』だけ）。止められていて理由のある Scope に動きなしは出ない（今の idleText のまま）",
			"CSS で、帯が1行（`white-space: nowrap` と省略記号）",
		]
	}
	"R-04": {
		title: "マージの札は、帯の理由に1つにまとめる"
		text: """
			欄の見出しにマージの札（`mergeBadge`）を出さない。代わりに、マージ待ちの Scope（`scope.merge` が `needs_fix` か `mergeable`）では、帯を必ず出し（R-03 の出さない決まりより優先）、帯の先頭にマージの印（直す必要ありは `zap` の危うい色、マージできるは `check` の良い色。今の札と同じ印と色）を付ける。
			理由の文が足すとき（ふだんは『PR #N をマージできる』など）はそれを並べ、理由が足さないときは、今の札の言葉（『マージ待ち・マージできる』『マージ待ち・直す必要あり』）を帯の文にする。マージの状態は、見出しから札が消えても必ず帯で見える。
			"""
		acceptance: [
			"偽の DOM で、マージ待ちの Scope の欄の見出しに `マージ待ち` の札（`.sd-badge`）がなく、帯に理由の文とマージの印がある（直す必要ありとマージできるで印と色の種類が違う）",
			"偽の DOM と node のテストで、マージ待ちで理由の符号が足さないもの（`in_progress` など）でも帯が出て、マージの印と札の言葉がある（統括の条件）",
		]
	}
	"R-05": {
		title: "選んだタブの名前を繰り返す帯をなくし、枠を新しいタブで開く印をタブの行の右端に置く"
		text: """
			説明資料のタブは、枠の上の帯（『説明資料』の名前と印）を出さず、枠だけを置く。文書のタブの帯は、文書の選びだけを持つ（印を出さない）。エージェントのタブの帯は今のまま。
			枠を新しいタブで開く印は、タブの行に1つ置く。欄ではタブの行の右端（タブの並びの外。タブが横にはみ出して送るときも見える）、詳しい画面ではタブの並びのすぐ右（凡例は今のまま行の右端）。説明資料のタブで説明資料が書かれているとき（枠があるとき）は説明資料、文書のタブで枠に文書を出しているときはその文書を開く。ほかのタブ、枠のないとき（雛形・まだない・読めない）は印を出さない。
			印の名前（aria-label と title）は『<名前>を新しいタブで開く』（説明資料、または文書の名前。例『要件を新しいタブで開く』）にし、下の行の『新しいタブで開く』（詳しい画面）と区別する。
			欄（構造の図・横断の構造）と Scope の詳しい画面の両方で同じにする。雛形の説明資料の知らせの中のリンク（『雛形を新しいタブで開く』）は今のまま。
			"""
		acceptance: [
			"偽の DOM と HTML の検査で、説明資料のタブの中身に `sd-framebar` がなく、枠（`sd-explain`）が中身の最初にある",
			"偽の DOM で、欄のタブの行の右端に、説明資料のタブなら説明資料の href、文書のタブなら選んだ文書の href の印がちょうど1つあり、ほかのタブにはない。タブを切り替え・文書を選び直すと印が変わる",
			"詳しい画面のタブの行にも同じ印がある（偽の DOM）",
			"文書のタブの帯に文書の選びがあり、新しいタブで開く印がない",
		]
	}
	"R-06": {
		title: "スマートフォンの下からの欄も同じ見出しにし、今の見た目を悪くしない"
		text: """
			最小と通常の段は、PC と同じ新しい見出し（R-01〜R-04）。全体の段は、今と同じく1行（今と同じ並び：状態の札・エージェントの印・今の ID・題名（1行）・Orca で開く・閉じる）にし、祖先のパンくず・`#番号・種類`・帯を隠す。
			取っ手と見出しの帯を引いて動かすこと、つまみのタップ、下の行の印だけのボタンは今のまま。
			"""
		acceptance: [
			"CSS で、全体の段に祖先のパンくず・`#番号・種類`・帯を隠す規則があり、題名が1行（静的な検査）",
			"実機（390×844）で、通常の段と全体の段の写しが直す前と比べて重ならず、見出しが前より低いか同じ。引っぱりとタップの今のテストが通る",
		]
	}
	"R-07": {
		title: "見出しの高さを減らし、タブの中身を広げる"
		text:  "欄の見出し（欄の上端からタブの行の上まで）の高さを、直す前の半分程度にする。説明資料のタブの枠の見える高さが、その分だけ増える。"
		acceptance: [
			"実機（1440×900 と 1000×800、作業中の Issue）で、見出しの高さが直す前の 60% 以下、説明資料の枠の見える高さが直す前より増える。前と後の数が report.md にある",
			"実機の写し（直す前と後、Issue・Epic・Initiative・止められている Scope・エージェントのいる Scope の欄、構造の図と横断の構造とボード、明るい表示と暗い表示、1440・1280・1000、スマートフォン 390）が report.md から辿れる",
		]
	}
	"R-08": {
		title: "情報と動きを失わない"
		text: """
			省いたものは別の場所で辿れる：今の ID は1行目、状態の名前は札（と aria-label）、理由は帯（足すときだけ）と詳しい画面、マージは帯の印、種類と番号は1行目、祖先は title つきのパンくず。
			状態の色と動き（作業中の区切りの輪と点滅、帯の左の線と欄の上の線の色）、エージェントの印と押したときにそのエージェントのタブが開く動き（iss-00621）、Orca で開く、要約の更新で見出しの札と印を書き直さない動き（iss-00592 R-02）を保つ。
			"""
		acceptance: [
			"今の欄の振る舞いのテスト（印を押して開く、Orca で開く、見出しの書き直しを数える、祖先のボタン、引っぱり）が、見出しの形の変化に合わせた期待で通る",
			"偽の DOM で、同じ状態での描き直し（要約の知らせ）で、見出しの札と印の部分を書き直さない",
		]
	}
}

failures: {
	"F-01": {
		title: "理由がない・空のときは帯を出さず、エラーにしない"
		text:  "構造の API の `reason` がない、または `text` が空のときは、動きなしがなければ帯を出さない。理由の符号だけがない場合は、文と状態の名前の比べで決める。"
	}
	"F-02": {
		title: "説明資料・文書の href がないときは、タブの行に印を出さない"
		text:  "詳しい内容を読み込み中、読めない、カタログに Scope がない、枠を出さない（説明資料が雛形・まだない、文書の描画の失敗）ときは、タブの行の印を出さない。前の Scope や前のタブの印を残さない。"
	}
}

constraints: [
	"書いてよいのは `src/spec_dock/assets/dashboard/`、`tests/`、`src/spec_dock/assets/static-inventory.json`（sha256 が変わるなら）、この Issue と epic-00573 の Scope のディレクトリ（依頼書）",
	"本人の環境に特化した決まりを入れず、どのリポジトリにも同じに効く仕組みにする（本人の方針）。テストの値も合成の値にする",
	"PC だけの特別な重ね方をせず、スマートフォンの見出しの考え（省く・1つにまとめる）にそろえる（統括の決定1）",
	"実装は iss-00650 のマージの後の `origin/main` から始め、PR の直前にも `origin/main` を取り込み直す（依頼書）",
	"公開の文書とテストに、実際のパス・IP・セッションの id を書かない",
]

decisions: [
	"2026-11-18 統括（依頼書の決定1〜6）：PC もスマートフォンと同じ考えで詰める。見出しは2行（＋タブ）を目安に、1行目はパンくず（祖先だけ）に続けて今の ID と `#番号・種類`、右に状態の札・エージェントの印・Orca で開く・閉じる。2行目は題名（2行で切る）。状態の帯は足す情報があるときだけ1行。動きなしも同じ考えでまとめる。タブの名前を繰り返す行を除き、その行にしかない操作はタブの行の右端か枠の右上へ。下の行は残してよいが重なる操作は1か所に。情報は消さない。状態の色と動き、エージェントの印、押して開く動きは保つ。",
	"2026-11-18 統括（タスク担当の問い msg_8e66f1ecf9c5 への答え msg_c9108f2abbf4）：4つとも推奨のとおり。(1) no_waits も帯を出さない。(2) マージの札は帯の先頭にまとめる。ただしマージの状態は見出しから消えても必ず帯に出す（帯を出さない決まりより優先）ことをテストで確かめる。(3) 新しいタブで開く印はタブの行に1か所、名前は『説明資料を新しいタブで開く』など。(4) 下の行は変えない。最上位の印と、受入の『直す前の 60% 以下』も了承。",
	"2026-11-18 タスク担当（仕様のレビュー round-1 の P1 を受けて）：狭い欄で1行目に収まらないときは、パンくずのまとまりを右の部品の下の1行に送る（右の部品と閉じるの位置を動かさないため `wrap-reverse`）。状態の札や印を隠す・数を減らすより、情報を消さず仕組みが単純なため。",
	"2026-11-18 タスク担当：帯を出さない理由は『文が空、文が状態の名前と同じ、符号が closed・in_progress・no_waits』。`no_waits`（『待っているものはない』）は『着手できる』の言い換えで何も足さないため。符号が増えても、文が状態の名前と違えば出る（何かを足すと見なす）。",
	"2026-11-18 タスク担当：マージの札は帯の理由（PR の番号と直す理由を持つ）と同じことを言うので、見出しから除き、帯の先頭の印で見分けを保つ（R-04）。",
	"2026-11-18 タスク担当：新しいタブで開く印の場所は『タブの行の右端』を選ぶ。枠の右上に重ねると、説明資料の HTML が自分の右上に持つ道具の帯（探す・文字・図・表示）を覆うため。文書のタブの印も同じ場所に移し、印の置き場を1か所にそろえる。",
	"2026-11-18 タスク担当：下の行（詳しい画面・新しいタブで開く・GitHub）は変えない。見出しの『Open』は orca-web、タブの行の印は枠の文書、下の行は詳しい画面と GitHub で、行き先が重ならないため（決定4）。名前の紛れは、タブの行の印を『<名前>を新しいタブで開く』と呼んで避ける。",
]

questions: []
