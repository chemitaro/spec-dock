package spec

// 要件（Issue）。型 specdock/v1。

schema: "specdock/v1"

assurance: {
	level:  "standard"
	reason: "ダッシュボードの表示だけを変え、データや操作には触れない"
}

purpose: """
	構造の図の箱と枠で、(1) 依存の線で分かる『後に続く』の数を出さない、(2) 対応した worktree の AI エージェント（orca-web の稼働の印）を、
	上限なしにすべて、箱の中に収めて出す。収まらないときは稼働の印を次の行に折り返し、その分だけ箱（枠）を縦に伸ばす。
	"""

background: """
	iss-00592 で、構造の図の箱と枠に orca-web の稼働の印を出した（箱は上限 2、枠は 3。越えると『+N』）。
	印の置き場（`.sd-orca`）は下の段（`.gx-marks`）の右端にあり、折り返さない（`flex: none`）ので、ほかの印（保証レベル・PR・worktree・人のタスク・後に続く）と合わせて
	箱の幅を越えると、右の縁からはみ出す。本人の写し（2026-11-17、iss-00613 の箱：保証レベル・PR・worktree・『後に続く 3』に続けて Claude の 7m と 39m）がその例。
	本人の要望（2026-11-17）：(1) 構造の図の『後に続く』の数は、依存の線で見て分かるので要らない。(2) エージェントが箱に収まるようにし、収まらなければ改行して箱の高さを広げる。
	構造の図の部品は、epic-00612 の『横断の構造』（iss-00614）でもそのまま使う。
	"""

includes: [
	"`views/graph.js` の箱・枠の印の行と凡例、`views/graph/marks.js` の `dnMark`",
	"`views/graph/layout.js` の箱・枠の高さ（印の行の数を入力に持つ）",
	"`views/_shared/orca_marks.js` と `views/_shared/parts.js` の印の置き場の上限（構造の図の「すべて」）",
	"`views/graph.css` の印の行の折り返し",
	"テスト（`tests/unit/presentation/`、`tests/unit/infra/`、`tests/js/`、`tests/fixtures/issue544/`）と、変われば `static-inventory.json` の sha256",
	"実機の写し（エージェントが1人・3人・6人の箱、iss-00613 の箱、1440・390、明暗）",
]

excludes: [
	"ボードの札の『後に続く』の数と、ボードの並び順（後に続く数の多い順）",
	"横の欄の依存のタブ、横の欄の見出しとボードの札の稼働の印の上限（4）",
	"構造の API の `downstream` とモデル",
	"orca-web の部品（`agent-marks.js`・`agent-marks.css`）と、その色・字体・大きさ",
	"箱・枠の幅、配置の並び方（段・行・折り返し）",
]

requirements: {
	"R-01": {
		title: "構造の図の箱・枠・凡例に『後に続く』の数が出ない"
		text: """
			構造の図の箱（入れ子の Issue、木の箱と枠の箱）、入れ子の枠の要約の行、凡例から、『後に続く』の数（`dnMark`、下向きの矢印と数）をなくす。
			箱の読み上げの名前（aria-label）からも「後に続く n件」を除く（見えない数を読み上げない）。
			同じ部品を使う『横断の構造』からも消える。
			"""
		acceptance: [
			"`downstream` が 3 の Scope の箱（入れ子・木）、枠の箱（木）、入れ子の枠の HTML に `class=\"dn\"` も「後に続く」もない",
			"凡例に「後に続く数」の行がない",
			"`views/graph/marks.js` に `dnMark` がない",
		]
	}
	"R-02": {
		title: "ボードと横の欄の『後に続く』は今どおり"
		text:  "ボードの札の『後に続く』の数（`parts.js` の `downMark`）、ボードの並び順、横の欄の依存のタブ、構造の API の `downstream` は変えない。"
		acceptance: [
			"`downstream` が 2 の Scope のボードの札に、今どおり `sd-dn` の『後に続く 2件』が出る",
			"ボードの並び順の説明（後に続く数の多い順）と、横の欄の依存のタブの文が変わらない",
		]
	}
	"R-03": {
		title: "構造の図の箱と枠では、対応した worktree のエージェントをすべて1人1つの印で出す"
		text: """
			構造の図の箱と枠（入れ子の枠の見出し、木の枠の箱）の印の置き場は、上限を持たず、エージェントの数だけ印を描く（『+N』にまとめない）。
			並び順は orca-web の部品のまま（要対応 → 作業中 → 不明 → 完了 → スリープ）。
			横の欄の見出しとボードの札の上限（4）は変えない。
			"""
		acceptance: [
			"エージェントが6人の worktree に対応した箱の置き場に、orca-web の部品が6つの `.orca-mark` を描き、`.orca-mark--more` がない",
			"同じ worktree で、ボードの札と横の欄の見出しは今どおり 3つの印と『+3』（上限 4）",
		]
	}
	"R-04": {
		title: "稼働の印は、ほかの印の行の残りに全部入るときだけ1行目の右寄せに置き、入らなければまとめて次の行から箱の幅で折り返す"
		text: """
			統括の決定（2026-11-17）の折り返しの規則：

			1. 下の段のほかの印（箱：保証レベル・片付けの候補・PR・worktree・人のタスク。木の枠の箱：進み具合の棒・数・状態の数・保証レベル・片付けの候補・人のタスク）は、今の並びのまま1行目に置く。
			2. 稼働の印は、そのエージェントすべてが1行目の残りの幅に収まるときだけ、1行目の右寄せに置く（今と同じ見た目）。
			3. 1つでも収まらないときは、稼働の印をまとめて次の行に移し（ほかの印と同じ行に分けて置かない）、その行から箱の中の幅で折り返す。稼働の印どうしの途中で行をまたぐのはよい。折り返した稼働の印の行は左寄せ。
			4. ほかの印が1つもない箱では、稼働の印が1行目から箱の中の幅で折り返す。
			ほかの印は、稼働の印を次の行に移した箱でも折り返さない（ほかの印だけで箱の幅を越える箱のはみ出しは今からの不具合で、この Issue の範囲外）。

			入れ子の枠の見出しの行（状態の印・Initiative の印・ID・題名・稼働の印）も同じ規則で、題名に決まった最小の幅（D-01 の `FRAME_TITLE_MIN`）を残して収まらないときは、稼働の印を見出しの下の行に移す。
			"""
		acceptance: [
			"印の行の数を決める純粋な関数が、ほかの印の幅・稼働の印の幅の並び・箱の中の幅から、1行目の右寄せ（1）か、次の行からの折り返し（1 + 稼働の印の行の数）か、ほかの印がないときの折り返し（稼働の印の行の数）を返す",
			"実機で、エージェントが1人・3人・6人の箱と iss-00613 の箱の稼働の印が、どれも箱の右の縁と下の縁の内にある（edgeAudit の `markOverflow` 0）",
		]
	}
	"R-05": {
		title: "印の行が増えた分だけ箱（枠）の高さが伸び、幅と並び方は変わらない"
		text: """
			配置（`layout.js`）は、箱・枠ごとの印の測った幅を入力に持ち、R-04 の規則で行の数を決め、増えた行1つにつき決まった高さ（D-01 の `MARK_ROW`）だけ、箱の高さ（入れ子の枠では見出しの高さ）を伸ばす。
			箱と枠の幅、段・行・折り返しの並び方は変えない。印の入力がない（または全部1行の）ときの配置は、今と1つも変わらない。
			依存の線は伸びた高さで引き、配置の検査（edgeAudit）の違反は0のまま。
			"""
		acceptance: [
			"印の入力がない、空、全部1行のどの配置も、今の配置と同じ（nodes・groups・edges・trunks・wraps。iss-00603 の digest の比較がそのまま通る）",
			"行が3つの箱の高さが 88 + 2 × MARK_ROW、行が2つの入れ子の枠の見出しが今より MARK_ROW 高く、中身がその分下がる。幅は変わらない",
			"エージェントが1人・3人・6人の箱を含む構造（入れ子・木、全体・いま・これから、focus）で、routeLayout の audit の違反0",
		]
	}
	"R-06": {
		title: "要約のたびではなく、印の行の数が変わったときだけ配置をやり直す"
		text: """
			orca-web の要約（10秒ごと）が来たら印を描き直し、印を測って行の数を求める。今の配置の行の数と同じなら、配置をやり直さず印だけを描き直す。
			違うときだけ、拡大・位置・選択を保ったまま配置をやり直す。測れないとき（部品の CSS がまだ効いていない、図が隠れている）は、配置を変えない。
			部品の CSS や字体があとから効いて印の大きさが変わったときも、行の数が変われば配置をやり直す。
			"""
		acceptance: [
			"経過の文字だけが変わり行の数が同じ要約では、箱の要素が作り直されない（配置をやり直さない）",
			"エージェントが増えて行の数が変わる要約では、配置をやり直し、拡大と位置が変わらない",
		]
	}
	"R-07": {
		title: "色・字体・部品の見た目は変えない"
		text:  "稼働の印は orca-web の部品のまま描く（色・字体・大きさ・印どうしの横の間）。SpecDock のデザインシステムの変数を使い、新しい色を足さない。行と行の間（4px）だけを構造の図で決める。"
		acceptance: [
			"変更した CSS に新しい色の値（#…、rgb(…)、新しい変数）がない",
		]
	}
}

failures: {
	"F-01": {
		title: "orca-web が切れている、要約が読めない、対応する worktree がないときは、今どおり印を出さず、箱の高さも今のまま"
	}
	"F-02": {
		title: "印を測れないとき（部品の CSS が効いていない、幅が0、図が隠れている）は、配置を変えず、次の要約か大きさの変化で測り直す"
	}
	"F-03": {
		title: "測るたびに行の数が揺れても、1つの要約・大きさの変化につき配置のやり直しは2回まで"
	}
}

constraints: [
	"変えてよいのは `src/spec_dock/assets/dashboard/`、`tests/`、`src/spec_dock/assets/static-inventory.json`（sha256 が変わるなら）、この Scope のディレクトリ",
	"orca-web の部品（`agent-marks.js` の `buildMarks`・`renderAgentMarks`、`max` の意味）は変えずに使う",
	"並行する iss-00613（API）と後の iss-00614（横断の構造）が同じ部品に触れるので、PR の直前に `origin/main` を取り込み直し、テストとゲートを最後のコミットでやり直す",
]

decisions: [
	"統括の決定1〜6（依頼書、2026-11-17）：dnMark を構造の図の箱・枠・凡例から消す、稼働の印の上限をやめる、折り返して箱の高さを伸ばす、行の数が変わったときだけ配置をやり直す、横の欄とボードの上限4は変えない、色・字体は変えない",
	"統括の決定（2026-11-17、msg_d3189662ed1a）：R-04 の折り返しの規則1〜4（ほかの印は1行目、稼働の印は全部入るときだけ1行目の右寄せ、入らなければまとめて次の行から折り返す、高さは使った行の数）",
	"タスク担当の判断：箱の読み上げの名前からも「後に続く n件」を除く（見えない数を読み上げない）。折り返した稼働の印の行は左寄せ（読む順の先頭が要対応になる）",
	"タスク担当の判断：印の幅は部品の実寸を測る（D-03）。理由は design.cue の D-03",
]

questions: []
