package spec

// 要件（Issue）。型 specdock/v1。書き方は spec-dock/docs/authoring/ のガイドにある。

schema: "specdock/v1"

assurance: {
	level:  "standard"
	reason: "ダッシュボードの表示だけを変え、データや操作には触れない。ただしボードと構造の図という主な画面の操作が変わるので、レビューと最終品質ゲートを通す"
}

purpose: "ボードと構造の図で Scope を選んだときの欄に、説明資料を最初のタブとして埋め込み、詳しい画面と同じタブを欄の中で切り替えて読めるようにして、ページの移り変わりを減らす"

background: """
	本人の要望（2026-11-14、統括の依頼書 epic-00573/.workbench/owner-iss-00587.md）。

	1. 構造の図で箱を選ぶと出る欄（graph.js の renderPanel。PC は右に幅 372px、スマホは下から高さ 58〜74%）には、状態、道筋、種類、保証、段、配下の数しかなく、
	   重要な情報がほとんどない。「詳しく」を押すと詳しい画面（views/scope.js）に移り、そこで概要・依存・配下・文書・Artifact・人のタスクのタブを切り替えて読む。
	   この詳しい画面のタブを、欄の中で切り替えて読みたい。
	2. 説明資料（explanation.html）は、その Scope が何かを一番わかりやすく示す。今は詳しい画面の文書のタブから新しいタブで開くだけ。欄の最初のタブに埋め込みたい。
	3. 欄の幅は、もっと広げてよい。
	4. 詳しい画面へ移る道は残す。欄から「拡大して開く」形で、別のタブでも開けるとよい。
	5. ボードでも構造の図でも、Scope の札を押すと同じ欄が出る（今のボードは、札を押すと詳しい画面へ移る）。

	追加の要望（2026-11-14、統括の連絡 msg_8a44c6e4ebc3）：スマホで下から出る欄は取っ手があるのに動かない。指のスワイプで、
	(1) 一番下まで下げた最小、(2) 今の通常の高さ（画面の真ん中ぐらい）、(3) 画面全体を覆う、の3段を行き来できるようにする。全体にしたとき、
	説明資料やタブの中身が画面いっぱいに読めること。

	後で、この欄に Orca のエージェント（orca-web の詳細とチャットの iframe、稼働の印）のタブを足す予定がある（epic-00471、epic-00526、orca-web の iss-00027・iss-00028）。
	"""

includes: [
	"src/spec_dock/assets/dashboard/ の欄（新しい共有の部品）、構造の図（graph.js、graph.css）、ボード（board.js、board.css）、詳しい画面（scope.js、scope.css）、共有の部品（views/_shared/）",
	"欄のタブと詳しい画面のタブを、1つの部品で描くための scope.js のタブの中身の切り出し",
	"Scope の JSON の文書の項目に、説明資料が雛形のままかを示す値を足す（runtime/application/dashboard_scope_details.py）",
	"tests/ の該当するテスト",
	"直す前と後の写し（1440、1000、390）を report.md に残す",
]
excludes: [
	"Orca のエージェントのタブ（後の Issue。今回は足せる作りにするだけ）",
	"時間の軸、概要（overview）、人のタスクの画面の選んだときの動き",
	"説明資料の中身や design-system（ds.css、ds.js）の変更",
	"サーバーの配り方（/files/ の sandbox と frame-ancestors）の変更",
	"Epic と Initiative の文書",
]

requirements: {
	"R-01": {
		title: "ボードと構造の図で、Scope を押すと同じ欄が出る"
		text: """
			構造の図の箱と枠の見出しを押したとき（今と同じ）、ボードの札を普通に押したとき（左クリック、タップ）に、同じ部品の欄が開き、その Scope を示す。
			ボードの札は、Ctrl・Cmd・Shift を押しながらのクリックや中クリックでは、今までどおり詳しい画面を新しいタブで開く（札は詳しい画面への普通のリンクのまま）。
			詳しい画面のタブの中の札（依存・配下）は、今までどおり詳しい画面へ移る。欄のタブの中の札や Scope のリンクを普通に押すと、その Scope を欄に示す（ページは移らない）。
			"""
		acceptance: [
			"ボード（1440）で札を押すと、URL が変わらずに欄が開き、押した Scope の ID と題名が欄の見出しにある",
			"構造の図（1440、1000、390）で箱を押すと、同じ見出しとタブの並びの欄が開く",
			"ボードの札の href は詳しい画面の道のままで、修飾キー付きのクリックはボードの欄を開かない",
			"欄の依存や配下のタブで別の Scope の札を押すと、ページが移らずに欄がその Scope に変わる",
		]
	}
	"R-02": {
		title: "欄に、詳しい画面と同じタブを出し、中で切り替えられる"
		text: """
			欄のタブは、説明資料、概要、依存、配下、文書、Artifact、人のタスクの順（説明資料が最初）。説明資料のほかの中身は、詳しい画面の同じタブと同じ部品で描く。
			タブを切り替えてもページは移らない。最初に選ばれるタブは、説明資料が書かれていれば説明資料、雛形のまま・ない・読めないときは概要。
			利用者がタブを選んだら、同じページの中で別の Scope を選んでも、そのタブを保つ。欄の中のタブの中の切り替え（配下の「終わったものも示す」、文書の「ここに表示」）も、欄の中で働き、ボードや図の URL の問い合わせを変えない。
			"""
		acceptance: [
			"欄のタブの並びが 説明資料・概要・依存・配下・文書・Artifact・人のタスク で、件数の小さな数字が詳しい画面と同じ",
			"説明資料が書かれた Scope では説明資料のタブが、雛形のままの Scope（epic-00471）では概要のタブが、最初に選ばれている",
			"タブを押しても location.href が変わらない",
			"欄の配下のタブで「終わったものも示す」を押しても、ボードの URL の done が変わらない",
		]
	}
	"R-03": {
		title: "説明資料を、欄のタブの中に埋め込んで読める"
		text: """
			説明資料が書かれていれば、説明資料のタブいっぱいに、同じオリジンの /r/…/files/<ID>/explanation.html を sandbox の枠（allow-scripts allow-popups）で示す。
			枠はタブの残りの高さをすべて使い、中身は枠の中でスクロールする。タブの上に「新しいタブで開く」を置く。
			雛形のまま（雛形の印が残る）なら、「説明資料は雛形のまま（まだ書かれていない）」と、書き方（spec-dock/docs/authoring/explanation.md）を示し、雛形を新しいタブで開くリンクを置く（枠は出さない）。
			ないなら「説明資料はまだない」と書き方を示す。カタログを読めないなら、文書のタブと同じ知らせ（次の1手）を示す。
			"""
		acceptance: [
			"epic-00573（書かれている）で、説明資料のタブに iframe があり、その src が /r/github.com/chemitaro/spec-dock/files/epic-00573/explanation.html、sandbox が allow-scripts allow-popups",
			"epic-00471（雛形）で、説明資料のタブに枠がなく、雛形のままの知らせがある",
			"説明資料のない Scope（iss-00407）で、まだないの知らせがある",
		]
	}
	"R-04": {
		title: "詳しい画面にも、同じ説明資料のタブを最初に出す"
		text: """
			詳しい画面のタブも、説明資料を最初にした同じ並びにする。問い合わせの tab がないときの最初のタブは、欄と同じ規則（説明資料が書かれていれば説明資料、ほかは概要）。
			詳しい画面のタブのリンクは、どのタブも tab を明示する（概要は tab=summary）。今までの tab=deps などの URL は同じタブを開く。
			"""
		acceptance: [
			"/r/…/scopes/epic-00573 で説明資料のタブが選ばれ、/r/…/scopes/epic-00573?tab=summary で概要が選ばれる",
			"/r/…/scopes/epic-00471（雛形）と /r/…/scopes/iss-00407（ない）では概要が選ばれる",
		]
	}
	"R-05": {
		title: "欄を広げ、図やボードの操作の邪魔をしない"
		text: """
			PC（画面の幅 641px 以上）の欄の幅は、ダッシュボードの幅の 44% を 380px から 720px の間に収めた値（1440 で約 634px、1000 で 440px）。
			欄が開いている間、構造の図の上の帯（状態の札と道具）は欄の左に収まり、道具が欄の下に隠れない。選んだ箱を真ん中に寄せるときは、欄を除いた残りの真ん中に寄せる。
			ボードは、欄が開いている間、列が欄の左に収まり（列の並びの右に欄の幅の余白）、隠れずにスクロールできる。
			"""
		acceptance: [
			"1440 で欄の幅が 600〜660px、1000 で 430〜450px",
			"1440 と 1000 の構造の図で欄を開いたとき、上の帯の道具のどのボタンも欄と重ならない",
			"1440 のボードで欄を開いたとき、一番右の列の右端が欄の左端より左にある",
		]
	}
	"R-06": {
		title: "欄から詳しい画面へ、同じページでも新しいタブでも移れる"
		text: """
			欄の下の帯に、「詳しい画面」（同じページの中で詳しい画面へ移る。いまのタブを tab に持つ）と、「新しいタブで開く」（同じ詳しい画面を新しいタブで開く）を置く。
			今の GitHub のリンクと、構造の図の「この範囲に絞る」は残す。埋め込み（embed=1）のときは、同じページの移動は embed=1 を保ち、新しいタブは embed のない道で開く。
			"""
		acceptance: [
			"欄で依存のタブを選んで「詳しい画面」を押すと、/r/…/scopes/<ID>?tab=deps に移り、依存のタブが選ばれている",
			"「新しいタブで開く」のリンクが target=_blank で、href が詳しい画面の道（tab 付き）",
		]
	}
	"R-07": {
		title: "スマホでは、下からの欄をスワイプで3段に動かせ、全体で読める"
		text: """
			画面の幅 640px 以下では、欄は画面の下から出るシートで、高さは3段：最小（取っ手と見出しの1行だけ、約 120px）、通常（画面の高さの 58%、開いたときの既定）、全体（画面全体を覆う）。
			取っ手と見出しの帯を指で上下に動かすと、シートが指に付いて動き、離したとき、速く払えばその向きの次の段へ、ゆっくりなら近い段へ止まる。最小からさらに下へ 48px より多く下げて離すと閉じる（選びを外す）。
			取っ手を押す（タップ）と、通常と全体を行き来する。取っ手はボタンで、名前（高さを変える）を持つ。
			タブの中身と説明資料の枠の中のスクロールは、シートを動かさない（シートを動かすのは取っ手と見出しの帯だけ）。全体では、タブの中身と説明資料の枠が、見出しと下の帯を除いた画面いっぱいに広がる。
			別の Scope を選んでも、段を保つ（最小のときは通常に戻す）。画面の向きや大きさが変わったら、同じ段の高さに合わせ直す。
			"""
		acceptance: [
			"390×844 で、見出しの帯を上へ払うと全体（シートの上端が 0〜8px）に、下へ払うと通常（高さが 844 の 58% ±16px）に、さらに下へで最小（120px ±24px）に止まる",
			"390×844 で全体のとき、説明資料の枠の高さが 600px 以上",
			"390×844 で説明資料の枠や概要の中身をスクロールしても、シートの高さが変わらない",
			"最小からさらに下へ下げて離すと、欄が閉じる",
		]
	}
	"R-08": {
		title: "5秒ごとの更新で、欄の読んでいる場所を失わない"
		text: """
			更新（新しい revision）で欄を描き直しても、説明資料の枠は src が同じなら読み込み直さず、タブの中身のスクロールの位置、選んだタブ、シートの段を保つ。
			選んだ Scope の詳しい JSON は、revision が変わったときに読み直す。
			"""
		acceptance: [
			"欄で説明資料を開いたまま、描き直し（render の呼び出し）をしても、iframe の要素が同じもの（=== で等しい）",
		]
	}
	"R-09": {
		title: "後で Orca のエージェントのタブを足せる作りにする"
		text: """
			欄のタブは、1つの並び（キー、名前、件数、描き方）で決まり、新しいタブは、その並びに1つ足すだけで、欄と詳しい画面に出せる。今回は足さない。
			"""
		acceptance: [
			"欄と詳しい画面のタブが、1つの並びの定義から作られている（コードで確かめる）",
		]
	}
	"R-10": {
		title: "直す前と後の写しを report.md に残す"
		text: "spec-dock の実データで、1440、1000、390 の幅で、ボードと構造の図から欄を開き、説明資料が最初のタブに出ること、タブの切り替え、詳しい画面へ移れること、390 のスワイプの3段と全体で読めることを、直す前と後の写しで残す。"
		acceptance: [
			"report.md に、直す前と後の写しの道と、見たことの記録がある",
		]
	}
}

failures: {
	"F-01": {
		title: "選んだ Scope の詳しい JSON を読めないとき、欄は構造の中身で見出しを示し、タブには読めなかったことを示す"
		text:  "見出し（状態、ID、題名、理由、道筋）は構造の JSON から描く。タブの中身は「詳しい内容を読めなかった（次の更新で読み直す）」。次の revision の変化か、選び直しで読み直す。"
	}
	"F-02": {
		title: "選んだ Scope が構造から消えたら、欄を閉じる"
	}
	"F-03": {
		title: "説明資料を読めない（雛形かどうかを判定できない）ときは、書かれているものとして枠で示す"
		text:  "サーバーは skeleton を null にし、画面は枠を出す（枠の中には、サーバーの答え（404 など）がそのまま出る）。"
	}
	"F-04": {
		title: "古い選びへの答えは捨てる"
		text:  "選びを変えた後に、前の Scope の詳しい JSON が届いても、欄に出さない。"
	}
}

constraints: [
	"画面の外への読み込みはしない（今のテストの制約）。説明資料の枠は同じオリジンの /files/ の道だけを使い、サーバーの sandbox と frame-ancestors は変えない",
	"利用者の文字は esc() を通す",
	"欄のタブの中身は、詳しい画面と同じ関数で描く（二重に作らない）",
	"Scope の JSON に足すのは項目の追加だけ（今の項目は変えない）",
]

decisions: [
	"説明資料の埋め込みは、同じオリジンの iframe（sandbox allow-scripts allow-popups）にする。本文の取り込みは、design-system の ds.js をシェルに読み込む必要があり、説明資料の HTML がダッシュボードの DOM と混ざるので採らない（タスク担当、2026-11-14）",
	"最初のタブは、説明資料が書かれていればそれ、ほかは概要（空の最初のタブを避ける）。詳しい画面も同じ規則（タスク担当、2026-11-14）",
	"スマホのシートを動かすのは取っ手と見出しの帯だけにし、中身と枠のスクロールとぶつけない（統括の求め、タスク担当の決定、2026-11-14）",
	"欄の選びは URL に持たない（今の構造の図と同じ）。詳しい画面への道だけが URL を持つ（タスク担当、2026-11-14）",
]
