package spec

// 要件（Issue）。型 specdock/v1。

schema: "specdock/v1"

assurance: {
	level:  "standard"
	reason: "ダッシュボードの表示の速さだけを直し、データや操作には触れない"
}

purpose: """
	構造の図（`/r/<repo>/graph`）と『横断の構造』（`/graph`）の指揮の線（iss-00616・iss-00617）の動きを軽くし、本人が感じる『もっさり』をなくす。
	点の流れと波紋を、ブラウザーの主スレッドで毎コマ描き直さない形にし、図を動かす間・画面の外・ページが裏のときは止める。見た目は変えない（点の速さだけは統括の決定で一様にする）。
	"""

background: """
	本人の指摘（2026-11-17）：構造の図と横断の構造が重い。統括の測り（headless Chrome、1440×900、deviceScaleFactor 2、読み込みの15秒後から10秒、CDP Performance の TaskDuration。台本は Epic epic-00615 の `.workbench/perf-measure.mjs`）：
	横断の構造は動きありで 0.54秒／10秒、prefers-reduced-motion で 0.02秒。spec-dock の構造の図は 0.32秒と 0.01秒。原因は指揮の線のアニメーション。

	タスク担当が確かめた今の事実（2026-11-17、`2fa809271`、試しのサーバーと同じ台本）：
	- 指揮の線は、世界と同じ大きさの1枚の SVG（`.gx-cmd`、端の層 `.gx-cmd-top`）に描かれ、`flow` の線と箱の中の短い線（stubs）が `stroke-dashoffset` を CSS アニメーション（`sd-cmd-flow 2.5s linear`、`--cl-len` は線の長さを 8 の倍数に切り上げた値）で動かし、波紋は SVG の円の `transform`・`opacity`（`sd-cmd-ripple 2.4s ease-out`）を動かす。どちらも主スレッドで毎コマ、スタイルの計算・描画の記録・レイヤーの組み立てを起こす。
	- 測り（同じ台本）：今は横断 0.533、単体 0.334。CSS に `steps(25)` を足すだけでは横断 0.29（Chrome は steps でも毎コマ描き直す）。JS で 10コマ/秒に動かし、線ごとの SVG に分けても単体 0.15〜0.18（1コマあたり約1ms の主スレッドの仕事が残る）。
	- 試作『線ごとの外接の SVG ＋ 点の線を 2px ずつずらした止めた絵を4枚重ね、合成スレッドで動く opacity の steps で切り替える。波紋は HTML の輪の transform・opacity』で、同じ台本で単体 0.015、横断 0.044（ずれ0、違反0、写しで見た目は同じ）。
	- 今の点の模様の速さは線の長さ次第（`len / 2.5` px/秒。今の線で 112〜205px/秒）。10コマ/秒で同じ速さにすると1コマの移動が点の周期 8px を超え、止まって見えたり逆向きに見えたりする。
	- 図を動かす口は、両方の画面の `applyT()`（ドラッグ・2本指・ホイール・拡大縮小のボタン・収める・中央へ）だけ。慣性の動きは画面の中にはない（トラックパッドの慣性はホイールのイベントとして届く）。
	"""

includes: [
	"両方の画面の指揮の層（`.gx-cmd`・`.gx-cmd-top`）と帯の波紋（`.gx-band-cr`）の HTML の形と CSS",
	"点の流れの描き方（止めた絵の切り替え）と波紋の描き方（HTML の輪）",
	"図を動かす間・画面の外・ページが裏のときに動きを止める仕組み",
	"`specdockCmdAudit()` に、動きの状態の数えを足す",
	"直す前と後の測り（同じ台本、ドラッグの間の長いタスク）",
]

excludes: [
	"線の道・端の向き・つなぎ方（本人に別に問うていて、別の Issue で変える）",
	"線の色・太さ・波紋の大きさと時間・同じ箱のアーチ・帯の形と寸法・凡例",
	"依存の線、箱、枠、図を動かす操作そのもの（世界の transform の付け方）",
	"Python の API・保存・モデル・orca-web",
]

requirements: {
	"R-01": {
		title: "点の流れと波紋を、主スレッドで毎コマ描き直さない"
		text: """
			`flow` の線（本体と箱の中の短い線）の点は、点の線を 2px ずつずらした止めた絵4枚（ずらし 0・2・4・6px）を重ね、0.05秒ごとに1枚だけを見せる切り替えで流す。切り替えは、合成スレッドで動く `opacity` の CSS アニメーション（`steps`）だけで行う。
			点は親から子の向きに、0.05秒ごとに 2px（40px/秒、点の間隔 8px を 0.2秒で1つ）進む。どの線でも同じ速さ（統括の決定 2026-11-17 問1 B）。
			波紋は、HTML の輪（縁 1.5px の丸）の `transform`・`opacity` の CSS アニメーション（今と同じ `ease-out` の 2.4秒、2つ目は 1.2秒遅れ）にし、合成スレッドで動かす（統括の決定 問2 A）。
			SVG の `<animate>`・`animateMotion`・canvas・`blur(`・JS の時計（`setInterval`・`requestAnimationFrame` での描き直し）は使わない。
			"""
		acceptance: [
			"同じ台本（`perf-measure.mjs` と同じ条件）で、動きありの TaskDuration が、横断の構造 0.11秒以下、spec-dock の構造の図 0.07秒以下／10秒（今の5分の1以下）。直す前と後の数が report.md にある",
			"`flow` の線ごとに、ずらし 0・−2・−4・−6px の点の線を持つ止めた絵が4枚あり、各々の `animation-delay` が、i 枚目が 0.05·i 秒から見える値（−((4−i) mod 4)·0.05 秒）になっている（node のテスト）",
			"指揮の CSS に `@keyframes sd-cmd-flow`（`stroke-dashoffset` の動き）がなく、切り替えの keyframes は `opacity` だけ、波紋の keyframes は `transform` と `opacity` だけ（静的な検査）",
			"実機の写しで、点が親から子へ流れ、波紋が今と同じに広がる（両方の画面、明・暗）",
		]
	}
	"R-02": {
		title: "線と波紋ごとに、その外接の四角の大きさの SVG（波紋は HTML の輪）に分けて置く"
		text: """
			指揮の層は、世界と同じ大きさの1枚の SVG をやめ、層の入れ物（`div.gx-cmd`・`div.gx-cmd-top`、class と重なりの順と `pointer-events: none` は今と同じ）の中に、線ごとの SVG を置く。
			各 SVG は、その線の道（三次ベジェの制御点と折れ線の点）の外接の四角に、光の下地と丸い端の分の余白を足した整数の四角で、`left`・`top` と `viewBox` を同じ四角にする（道の座標は今と同じ世界の座標のまま）。
			光の下地（`cl-glow`）と、`wait`・`done` の線、端の点（`cl-dot`）は、動かない止めた絵にする。波紋は、中心に置いた HTML の輪の組にする（帯の中の波紋も同じ）。
			"""
		acceptance: [
			"組があるとき、世界に世界と同じ大きさの SVG がない（`.gx-cmd`・`.gx-cmd-top`・`.gx-band-cr` が SVG でない。偽の DOM と実機）",
			"線ごとの SVG の四角が、その線のすべての道の点を余白の分だけ内側に含み、`viewBox` と `left`・`top`・`width`・`height` が同じ数（node のテスト）",
			"実機で `specdockCmdAudit()` の `spotDrift` ≤ 0.4、`boxOverlaps`・`edgeOverlaps`・`heads` が0、`specdockEdgeAudit()` の違反が0（両方の画面）",
			"拡大縮小と移動で、線と波紋が世界と一緒に動く（実機の写し）",
		]
	}
	"R-03": {
		title: "図を動かしている間と、その後 0.3秒は、点の流れと波紋をその場で止める"
		text: """
			両方の画面で、世界の位置か倍率が変わる（`applyT()`）たびに、図の領域（`.gx-view`）に止める印を付け、最後の変化から 0.3秒たったら外す。印の間、点の切り替えと波紋のアニメーションを `animation-play-state: paused` にする（その場で止まり、再開で跳ばない。統括の決定）。
			"""
		acceptance: [
			"偽の DOM で、図を動かす操作（ドラッグ・ホイール）の後に止める印があり、0.3秒より後に外れる。続けて動かすと、最後の動きから数える",
			"CSS で、止める印の下の点の切り替えと波紋が `animation-play-state: paused`（静的な検査）",
			"同じ台本のドラッグ（CDP の Input.dispatchMouseEvent で約4秒）の間の長いタスク（50ms 超）の数と、1秒あたりのコマの数を、直す前と後で report.md に書く。後の長いタスクが前より増えない",
		]
	}
	"R-04": {
		title: "画面の外の線と波紋、ページが裏のときは、動かさない"
		text: """
			点の切り替えの絵と波紋のそれぞれを、図の領域を root にした IntersectionObserver で見張り、図の領域に重ならないものを止める（`animation-play-state: paused`）。
			ページが裏になったら（`document.visibilityState` が `hidden`）止め、表に戻ったら、図を動かしている間でなければ動かす。層を描き直したら見張り直し、画面を離れたら見張りをやめる。
			"""
		acceptance: [
			"偽の DOM と偽の IntersectionObserver で、重ならないと知らされた絵と波紋が止まり、重なると知らされると動く。層を描き直すと新しい要素を見張り、古い要素の見張りをやめる。画面を離れると見張りをやめる",
			"偽の DOM で、visibilitychange で裏になると止める印が付き、表に戻ると外れる（図を動かしている間は外れない）",
		]
	}
	"R-05": {
		title: "見た目と、減らす設定の形を変えない"
		text: """
			色（`--sd-cmd`・`--sd-cmd-glow`）、太さ（本体 2、光 6、選んだ線 3、波紋の縁 1.5）、点の形（`stroke-dasharray: 0.1 7.9`、丸い端）、流れの向き、`wait` の止まった点線、`done` の薄い線、波紋の大きさ（半径 7 の 0.4〜2.2 倍）と時間、同じ箱のアーチ、帯、指揮の選びの目立たせ・淡くする形を変えない。
			prefers-reduced-motion では、今と同じく、点は止まった点線（ずらし0の1枚だけを見せる）、波紋は止まった輪1つ（1.4倍、不透明度 .6、2つ目は出さない）。
			組がないときの世界の HTML は今と同じ（層を置かない）。
			"""
		acceptance: [
			"減らす設定の CSS で、切り替えのアニメーションがなく、ずらし0の絵だけが見え、波紋は動かず 1.4倍・.6 で2つ目がない（静的な検査）",
			"偽の DOM で、指揮の選び（帯の押し）で選んだ線のすべての絵（本体・4枚・端）に `is-cmd-hl`、ほかに `is-cmd-off` が付き、層に `has-cmd-sel` が付く（今のテストの意味を保つ）",
			"組がないとき、両方の画面の世界の HTML が今と同じ（今のテストがそのまま通る）",
			"実機の写し（両方の画面、1440 × 明・暗）で、直す前と後の線・点・波紋の見え方が同じ（点の位置の位相を除く）",
		]
	}
}

failures: {
	"F-01": {
		title: "IntersectionObserver がないときは、画面の外でも止めない"
		text:  "IntersectionObserver が使えないブラウザーでは、画面の外の見張りを行わず、動かしたままにする（今と同じ見え方。図を動かす間と裏のときの止めは効く）。エラーを出さない。"
	}
	"F-02": {
		title: "組がない・層を消したときは、見張りも止める印も残さない"
		text:  "組がなくなって層を消したとき、画面を離れたときは、見張りをやめ、止める印の時計を消す。消した要素を見張り続けない。"
	}
}

constraints: [
	"Epic epic-00615 の constraints（動きは CSS だけ、新しい色を足さない、`router.js` と edgeAudit を変えない、純粋な関数と node のテスト、公開の文書とテストに実際のパス・IP・セッションの id を書かない）",
	"書いてよいのは `src/spec_dock/assets/dashboard/`、`tests/`、`src/spec_dock/assets/static-inventory.json`（sha256 が変わるなら）、この Issue の Scope のディレクトリ（依頼書）",
	"本人の環境に特化した決まりを入れず、どのリポジトリにも同じに効く仕組みにする（本人の方針）。テストの値も合成の値にする",
	"線の道（`commandModel` の `links[].d`・`stubs`・`from`・`to`・`ripples`）と `commandKey`・`crossKey` の結果を変えない",
]

decisions: [
	"2026-11-17 統括（依頼書の決定1〜5）：図を動かしている間とその後0.3秒は止める。描き直しの回数を減らす（約10コマの歩み）。線と波紋ごとに外接の四角の SVG に分け、光の下地は止めた絵にする。画面の外と裏では止める。見た目（色・太さ・流れの向き・波紋・同じ箱のアーチ・帯）とつなぎ方は変えない。",
	"2026-11-17 統括（タスク担当の問い msg_d901a879de0f への答え msg_b598780e1110）：試作の方式（線ごとの小さな SVG、ずらした止めた絵を合成スレッドの opacity で切り替え、波紋は HTML の輪の transform・opacity）で進める。問1は B：点は 0.05秒ごとに 2px、40px/秒・20コマ（今の速さから 20px/秒に落とすと『指令が流れている』感じが弱くなるため）。合成スレッドなので主スレッドの重さが変わらないことを同じ台本の数で示す。問2は A：波紋は今のなめらかな ease-out のまま。止めた形は『その場で止める（paused、再開で跳ばない）』。",
	"2026-11-17 タスク担当：決定2の『steps() で約10コマ』は、主スレッドの描き直しを減らすための手段で、測りで steps だけでは足りないと分かったので、統括の了承した切り替えの方式で置き換える（切り替え自体は `steps` の opacity）。",
	"2026-11-17 タスク担当：止める印は `applyT()` で付ける（ドラッグ・2本指・ホイール・拡大縮小のボタン・収める・中央へのすべて。プログラムが動かすときも 0.3秒止まるが、見た目の害はなく、仕組みが1つで済む）。画面に慣性の動きはないので、慣性の扱いはホイールのイベント（トラックパッドの慣性）で兼ねる。",
	"2026-11-17 タスク担当：点の切り替えの4枚は、線ごとの SVG を4つ（各々が1枚）にする（合成スレッドで切り替えるには、各々が独立したレイヤーになれる要素である必要がある。SVG の中の要素はレイヤーにならない）。",
]

questions: []
