package spec

// 要件（Issue）。型 specdock/v1。書き方は spec-dock/docs/authoring/ のガイドにある。
// 文章の項目には Markdown を書いてよい。型にない項目は、必要に応じて足してよい。

// 型の版。消さない。
schema: "specdock/v1"

// 保証レベル（light、standard、strict、critical）と、その理由。
// 失敗したときの影響と回復の難しさで選ぶ（工数や作業の難しさでは選ばない）。
// 具体化や作業の途中で、上げても下げてもよい。正本はここだけで、ほかの場所に写さない。
assurance: {
	level:  "light"
	reason: "配布する文書と雛形のコメントの例だけを直す。型と振る舞いは変えない"
}

purpose:    "配布する文書と雛形の execution の例を、仕様化と実装のセッションを分けた形にする"
background: "セッションのモデルと推論は起動のときに決まり、エージェント自身は変えられない。仕様化と実装を1つのセッションで行う例だと、計画に書いた実装の値が使われない。"

// 対象と対象外（任意）。
// includes: ["..."]
// excludes: ["..."]

// 観測できる要件。番号（R-01、R-02、…）をキーにする。
// title は必須。acceptance（観測できる受け入れの条件）は standard 以上で必須。
requirements: {
	"R-01": {
		title: "execution の例が、仕様化のセッションと実装のセッションを分けて書かれている"
		text:  "cue.md の2つの例と Issue の plan.cue 雛形のコメントの例で、spec と impl を別のセッションにし、手順の session は実装（impl）を指すと書く。型は変えない。"
	}
	"R-02": {
		title: "セッションの値が決まる時点の説明がある"
		text:  "「セッションのモデルと推論は起動のときに決まるので、計画で選べるのは、計画の後に起動するセッション（実装担当）の値。計画を書いたセッションの値は事実として記録する」を、特定のスキルやモデルの名前なしで添える。"
	}
}

// 失敗・境界の条件。番号（F-01、…）をキーにする。
// title は必須。impact（起きたときの影響）と recovery（回復のしかた）は strict 以上で必須。
failures: {
	// "F-01": {
	// 	title:    "〜のときは、何も書かずに止まる"
	// 	impact:   "〜"
	// 	recovery: "〜"
	// }
}

// 制約・前提、合意した判断、未解決事項（任意）。
// constraints: ["..."]
// decisions: ["..."]
// questions: ["..."]
