package spec

// 要件（Epic）。型 specdock/v1。

schema: "specdock/v1"

assurance: {
	level:  "standard"
	reason: "ダッシュボードの表示を足すだけで、データや操作には触れない"
}

purpose: """
	SpecDock のダッシュボードが表示しているすべてのリポジトリの仕事を、1枚の画面『横断の構造』に、チェックアウトの入れ子（この PC では company-os → 事業 → プロダクト …）のまま描く。
	既定の見せる範囲は『これから』で、どのリポジトリで何に取り組み、次に何をするかを1ページで見渡せるようにする。
	"""

background: """
	本人の要望（2026-11-16、依頼書 `.workbench/planner-epic-00612.md`）：『これから』の見せる範囲（iss-00603）で、リポジトリごとに今の仕事とこれからの仕事がコンパクトに見えるようになった。
	次は、表示しているすべてのリポジトリの仕事を1枚の構造の図にまとめたい。無秩序に並べるのではなく、会社の入れ子をそのまま表す：company-os の中に事業（businesses）、その中にプロダクト（products）、今後はサービス（services）が入るかもしれない。
	company-os の外のプロジェクト（spec-dock、orca-web など）も今後足されうる。それは company-os の外に出す。

	統括が確かめたこの PC の登録（`canonical-registry.json` の `catalogs[].main_checkout`、`<ws>` は本人のワークスペースの根）：
	company-os の中に businesses/housing-lifecycle（その中に products/taikyohiyou_project）と businesses/input-devices（その中に products/generic-mona、products/tenting-cradle、products/yubisaki）、
	その外に tools/spec-dock と tools/orca-web。各リポジトリは自分の main のチェックアウトを1つ登録している。

	今の画面：横断の画面は `/`（横断の概況、各リポジトリの札）と `/todos`（人のタスク）。リポジトリの画面は `/r/<host>/<owner>/<name>/`（構造の図）などで、構造の図は1つのリポジトリの構造の API（`/api/v1/r/<repo>/structure`）を `views/graph/layout.js`（配置）と `router.js`（線）で描く。
	`GET /api/v1/repositories` は、出すリポジトリの一覧（鍵の順）を返すが、リポジトリどうしの入れ子と、登録の main のチェックアウトのパスは返さない。
	なお、構造の API（`…/structure`）は、今も worktree の一覧（`worktrees.paths`、各 Scope の `worktrees[].path`）として道を返している（稼働の印の対応に使う。この Epic では変えない）。統括の決定7の「パスはブラウザーに出さない」は、入れ子を決めるために登録のチェックアウトの道を新しく渡さない、という意味で扱う。
	"""

includes: [
	"`GET /api/v1/repositories` の各リポジトリに、入れ子の親を足す（サーバーが決め、パスは出さない。段の札は iss-00635 でなくした）",
	"横断の画面に『横断の構造』（`/graph`）を足す：リポジトリの枠の入れ子、見せる範囲、状態で目立たせる、横の欄、稼働の印、収める・拡大・移動",
	"契約の文書（配る側の `src/spec_dock/assets/spec_dock/docs/reference_cli.md` のダッシュボードのサーバーの契約。dogfood の写し `spec-dock/docs/reference_cli.md` は配布の更新で揃える）の更新",
]

excludes: [
	"リポジトリの画面（`/r/…/graph` など）、横断の概況、人のタスクの見え方の変更（`/graph` へのタブが増えるほかは変えない）",
	"『これから』の親の規則そのもの（iss-00611 が決める。この Epic はそれに従う）",
	"リポジトリをまたぐ依存の線（そういう依存はない）",
	"入れ子を決める設定のファイル（足さない）",
	"木の表示（入れ子だけで描く）と、URL の focus（この範囲に絞る）の横断の画面での実現",
	"構造の API が今返している worktree の道（変えない。統括の決定7は、入れ子のために道を新しく渡さないことと読む）",
	"ダッシュボードから書き込む操作、「見た」の記録（横断の構造は、概況と同じく「見た」を送らない）",
	"リリースと配布（統括が別の Issue で行う）",
]

requirements: {
	"R-01": {
		title: "リポジトリの入れ子を、登録された main のチェックアウトのパスで決める"
		text: """
			出すリポジトリ A の main のチェックアウトが、出す別のリポジトリ B の main のチェックアウトの中にあれば、A は B の子とする。候補が複数あれば、いちばん近い祖先（いちばん深い B）を採る。
			どの出すリポジトリの中にもないリポジトリは最上位に並ぶ。設定のファイルは足さない。
			"""
		acceptance: [
			"この PC の登録の形（9つ）の合成の入力で、company-os・spec-dock・orca-web が最上位、housing-lifecycle と input-devices の親が company-os、taikyohiyou_project の親が housing-lifecycle、generic-mona・tenting-cradle・yubisaki の親が input-devices になる",
			"名前の頭が同じだけの隣のディレクトリ（`<ws>/a` と `<ws>/a-b`）は親子にならない",
		]
	}
	"R-02": {
		title: "ディレクトリの名前に意味を持たせず、入れ子はパスの包含だけで決める"
		text: """
			入れ子は、チェックアウトのパスの包含（R-01）だけで決め、途中のディレクトリの名前を読まない。名前を読み替える表や、名前で分かれる処理を持たない。
			（iss-00613・iss-00614 で入れた段の札（`businesses` → 事業、`products` → プロダクト、`services` → サービス）は、特定の置き方を前提にした決まりだったので、iss-00635 でなくした。）
			"""
		acceptance: [
			"途中が `businesses/…/products` の道と、`groups/…/team` の道で、親の決まり方が同じ",
			"一覧の API の応答と画面の見出しに、途中のディレクトリの名前とその読み替えが現れない",
		]
	}
	"R-03": {
		title: "入れ子は、サーバーが一覧の API で返し、パスはブラウザーに出さない"
		text: """
			`GET /api/v1/repositories` の各リポジトリに、親のリポジトリの鍵（なければ null）を足す。
			今ある項目、その意味、並び（鍵の順）は変えない（項目を足すだけなので、契約の版 `specdock.dashboard/v1` は変えない）。iss-00635 で消した `tier` は 0.9.5 だけで配り、使う者がないので、版の規則の例外として版を変えずに消し、契約の文書に明記する（統括 2026-11-17）。
			チェックアウトのパスとディレクトリの名前そのものは返さない。
			"""
		acceptance: [
			"一覧の API の応答の各リポジトリに `parent` があり（`tier` はない。iss-00635）、今の項目と並びが今と同じ",
			"応答の JSON のどこにも、登録の `main_checkout` やカタログの道の文字列が現れない",
			"`src/spec_dock/assets/spec_dock/docs/reference_cli.md` のダッシュボードのサーバーの契約に、`parent` の項目と決め方が書かれている",
		]
	}
	"R-04": {
		title: "横断の画面に『横断の構造』を足す"
		text: """
			画面の道は `/graph`（リポジトリの構造の図 `/r/<repo>/graph` と、人のタスク `/todos`・`/r/<repo>/todos` の決まりに合わせる）。
			リポジトリを選んでいないときの上の帯のタブを、『横断の概況』『横断の構造』『人のタスク』の順にする。ページの題名は「横断の構造 · すべてのリポジトリ · SpecDock」。
			"""
		acceptance: [
			"`/graph` を開くと『横断の構造』が描かれ、上の帯のタブで『横断の構造』が選ばれている",
			"`/` と `/todos` の上の帯に『横断の構造』のタブがあり、押すと `/graph` へ移る。`?embed=1` は移った先でも保たれる",
			"`/r/…` の画面のタブは今のまま",
		]
	}
	"R-05": {
		title: "各リポジトリを、そのリポジトリの構造の図を入れたリポジトリの枠で描き、入れ子のまま並べる"
		text: """
			リポジトリの枠の中に、そのリポジトリの構造の図（Initiative・Epic・Issue の枠と箱、畳んだ塊、依存の線、状態の印、進み具合の輪）を、今の部品と今の配置の規則（入れ子）のまま入れる。
			子のリポジトリの枠は、親のリポジトリの枠の中の、親の構造の図の後ろ（下）に並べる。最上位のリポジトリの枠は、画面の幅で折り返して並べる。
			リポジトリの枠の見出しには、リポジトリの名前（owner/name）だけを出し（段の札は iss-00635 でなくした）、Initiative の枠と見分けられる形にする。新しい色は足さない（今の色の札だけを使う）。
			Scope の箱の ID は、リポジトリをまたいで重なることがあるが、ほかのリポジトリの箱と混ざらない。
			"""
		acceptance: [
			"この PC の登録の形で、company-os の枠の中に housing-lifecycle と input-devices の枠が、その中にそれぞれのプロダクトの枠があり、spec-dock と orca-web の枠は company-os の枠の外にある",
			"子のリポジトリの枠が、親の構造の図のどの枠・箱とも重ならず、その下にある",
			"リポジトリの枠の見出しに名前があり（段の札はない）、Initiative の枠と形で見分けられる",
			"`app.css` と画面の CSS に、新しい色の値（16進や rgb の直書き、新しい色の札）が足されていない",
		]
	}
	"R-06": {
		title: "『全体・いま・これから』をそのまま使い、このページの既定は『これから』"
		text: """
			見せる範囲の切り替えは、リポジトリの構造の図と同じ3つで、すべてのリポジトリの枠に同じ範囲を当てる。このページの既定は『これから』で、選びはこのページだけの覚えに残す（リポジトリの構造の図の覚えとは別）。
			『これから』の各リポジトリの中の見え方は、リポジトリの構造の図の『これから』と同じ（iss-00611 の親の規則を含む）。
			『これから』では、見える Scope が1つもないリポジトリの枠は出さない。ただし、子のリポジトリの枠が1つでも出るなら、親の枠は入れ物として出す（中の構造の図は空）。
			『全体』『いま』では、出すリポジトリをすべて枠で出す（Scope のないリポジトリは、枠の中に「Scope はまだありません」）。
			"""
		acceptance: [
			"初めて開いたとき（覚えがないとき）に『これから』が選ばれている",
			"『これから』で、見える Scope のないリポジトリの枠がなく、見える子のリポジトリを持つ親の枠は入れ物として出る",
			"1つのリポジトリの枠の中の箱と枠の集まりが、そのリポジトリの構造の図の同じ範囲（入れ子）と同じ",
			"選んだ範囲が、ページを開き直しても残り、リポジトリの構造の図の範囲の覚えは変わらない",
		]
	}
	"R-07": {
		title: "箱を押すと、そのリポジトリの文脈で今と同じ横の欄が出て、稼働の印も今どおり出る"
		text: """
			箱や枠を押すと、リポジトリの構造の図と同じ横の欄（概要、説明資料、エージェント、依存などのタブ）が、そのリポジトリの構造とスコープの API で開く。
			『詳しい画面』はそのリポジトリの詳しい画面（`/r/<repo>/scopes/<ID>`）へ移る。選んだ Scope の上流・下流の目立たせと依存の線は、そのリポジトリの中だけ。
			orca-web の稼働の印と「Orca で開く」は、リポジトリの構造の図と同じ条件で、そのリポジトリの構造から対応を決めて出す。
			状態で目立たせる札（止められている・着手できる…）は、すべてのリポジトリの箱に当てる。
			"""
		acceptance: [
			"2つのリポジトリにある同じ ID の Scope の一方を押すと、そのリポジトリの Scope の欄が開き、もう一方は選ばれない",
			"横の欄の『詳しい画面』の行き先が `/r/<そのリポジトリ>/scopes/<ID>`",
			"稼働の印が、対応した worktree のあるリポジトリの箱にだけ出る（orca-web の要約の合成の入力で）",
		]
	}
	"R-08": {
		title: "PC の幅とスマホの幅で読め、『収める』で1枚に収まる"
		text: """
			1440 と 1000 の幅、スマホの 390px で、道具の帯と枠の見出しが読め、ページの横にはみ出さない。『収める』で、出しているすべてのリポジトリの枠が1つの画面に収まる。拡大・縮小・移動はリポジトリの構造の図と同じ操作で行う。
			"""
		acceptance: [
			"この PC の実データで、1440・1000・390 × 明・暗の写しで、道具の帯と枠の見出しが重ならず、ページに横のスクロールがない",
			"『収める』の後、すべてのリポジトリの枠の外接の四角が、図の領域に収まる",
			"すべてのリポジトリの線の検査（edgeAudit）の違反が0、ブラウザーのエラーが0",
		]
	}
	"R-09": {
		title: "読み込みと更新は、リポジトリごとに行い、変わらないものを描き直さない"
		text: """
			ページは、一覧の API の入れ子に従い、各リポジトリの構造の API を読んで組み立てる。届いたリポジトリから順に描く。
			5秒ごと（ページが見えている間）に各リポジトリの版（revision）を読み、変わったリポジトリだけ構造を読み直して配置し直す。変わらないリポジトリの配置と線は計算し直さない。
			"""
		acceptance: [
			"版が変わらない更新では、どのリポジトリの配置も計算し直されない（数で確かめる）",
			"1つのリポジトリの版が変わったとき、そのリポジトリだけが読み直される",
		]
	}
}

failures: {
	"F-01": {
		title: "1つのリポジトリの構造が読めないときは、その枠に理由を出し、ほかは描く"
		text:  "構造の API の失敗、スナップショットがない・読めない、などは、その枠の中に理由（概況と同じ言葉と次の1手）を出す。前回読めた Scope があれば、それを描き、理由を枠の見出しの下に添える（概況と構造の図と同じ）。『これから』でも、理由のある枠は出す（中に見えるものがあるか分からないため）。"
	}
	"F-02": {
		title: "1つのチェックアウトに決まらないリポジトリは、最上位に並び、親にならない"
		text:  "同じリポジトリの2つのクローンを登録している（ambiguous）など、main のチェックアウトが1つに決まらないリポジトリは、最上位に並び、ほかのリポジトリの親にならない。"
	}
	"F-03": {
		title: "隠したリポジトリは出さず、その中のリポジトリは、出す祖先の子になる"
		text: """
			隠したリポジトリ（隠す印、設定）は一覧に出ない。その中にあるリポジトリは、いちばん近い出す祖先の子になる（なければ最上位）。
			"""
	}
	"F-04": {
		title: "『これから』で、どのリポジトリにも見えるものがないときは、知らせを出す"
		text:  "道具の帯は残し、図の場所に「これから進める Scope は、どのリポジトリにもありません。全体で、終わったものを見られます。」を出す。表示しているリポジトリが0なら、概況と同じ知らせを出す。"
	}
}

constraints: [
	"配置と組み立ては DOM のない純粋な計算に置き、node のテストで確かめる（今の `layout.js` と同じ）",
	"リポジトリの構造の図（`views/graph.js`）の見え方と動きを変えない。部品を共有するために取り出すときも、graph.js が出す HTML は変えない。今のテストのうち、振る舞いを確かめるもの（node の配置・線・範囲のテスト、HTTP のテスト）はそのまま通る。graph.js のソースの文字列を調べるテスト（例 `tests/unit/infra/test_dashboard_orca_views_js.py`、`test_dashboard_shell_polish.py`、`test_dashboard_state_marks.py`）は、調べる場所を取り出し先（`views/graph/draw.js`）に移してよいが、確かめる中身（文字列と数）は変えない",
	"新しい色、字体を足さない。リポジトリの枠は今の色の札と線の形で見分ける",
	"公開のリポジトリの文書とテストに、この PC の実際のパスを書かない（合成のパスを使う）",
]

decisions: [
	"2026-11-16 統括（依頼書の決定1）：入れ子は、登録されたリポジトリの main のチェックアウトのパスで決め、いちばん近い祖先の子とする。設定のファイルは足さない。どの登録の中にもないものは最上位。",
	"2026-11-16 統括（決定2）：段の札は親から子へのパスの途中のディレクトリの名前。businesses → 事業、products → プロダクト、services → サービス。知らない名前はそのまま。親の直下は札なし。",
	"2026-11-16 統括（決定3〜6）：横断の画面に『横断の構造』を足す。各リポジトリを枠にし、中に今の部品のまま構造の図を入れ、子のリポジトリの枠は親の Initiative の後ろに並べる。新しい色は足さない。範囲は3つのまま既定は『これから』、見える Scope のないリポジトリは出さず、見える子を持つ親は入れ物として出す。横の欄・詳しい画面・稼働の印はそのリポジトリの文脈。依存の線はリポジトリの中だけ。",
