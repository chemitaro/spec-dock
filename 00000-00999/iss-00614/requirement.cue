package spec

// 要件（Issue）。型 specdock/v1。

schema: "specdock/v1"

assurance: {
	level:  "standard"
	reason: "ダッシュボードに見るだけの画面を足すだけで、データや操作には触れず、PR を戻せば元に戻る"
}

purpose: """
	ダッシュボードの横断の画面に『横断の構造』（`/graph`）を足し、表示しているすべてのリポジトリの構造の図を、会社の入れ子（company-os → 事業 → プロダクト …）のリポジトリの枠に入れて1枚に描く。
	既定の見せる範囲は『これから』で、どのリポジトリで何に取り組み、次に何をするかを1ページで見渡せるようにする。
	Epic epic-00612 の slice `iss-00614`（Epic の R-04〜R-09、F-01、F-04。設計 D-03〜D-07）を、この Issue の観測できる要件にする。
	"""

background: """
	本人の要望と統括の決定は Epic の `requirement.cue` の `decisions` と `.workbench/planner-epic-00612.md` にある。
	前提の Issue はマージ済み：iss-00613（`GET /api/v1/repositories` の各リポジトリの `parent`・`tier`）、iss-00611（『これから』で、中に見えるもののない親を出さない）、iss-00620（稼働の印をエージェントの行に置き、行の数が変わったときだけ配置をやり直す）、iss-00603（『全体・いま・これから』）、iss-00607（線をすべて描く）。
	この後に epic-00615（指揮の線）が、この画面の世界の座標に線と『指揮の帯』を重ねる（iss-00617）。そのため、リポジトリの枠の見出しと中身の間に、枠ごとの高さの帯を後から足せる配置の入力をこの Issue で用意する（帯そのものは描かない）。
	"""

includes: [
	"`/graph` の道、殻の HTML（サーバー）、上の帯のタブ、ページの題名、殻の中の移動",
	"`views/graph.js` の箱・枠・塊の HTML と線の class の決め方を `views/graph/draw.js` に取り出す（graph.js が出す HTML は変えない）",
	"リポジトリの枠の組み立ての純粋な計算 `views/allgraph/compose.js`（入れ子、出すかどうか、寸法、折り返し、後から足す帯の高さの入力）",
	"『横断の構造』の画面 `views/allgraph.js` と `views/allgraph.css`（読み込み、更新、見せる範囲、状態で目立たせる札、凡例、選びと横の欄、稼働の印とエージェントの行、収める・拡大・移動、線の検査）",
	"契約の文書（配る側の `src/spec_dock/assets/spec_dock/docs/reference_cli.md` の「画面の道」）の更新",
	"実データ（この PC の登録の写し）での写しと、本人が見る試しの URL",
]

excludes: [
	"リポジトリの画面（`/r/…`）、横断の概況、人のタスクの見え方と動きの変更（横断の画面のタブが1つ増えるほかは変えない）",
	"一覧の API の `parent`・`tier` の決め方（iss-00613 で済み）と、『これから』の親の規則（iss-00611）",
	"リポジトリをまたぐ依存の線、木の表示、URL の focus の横断の画面での実現",
	"指揮の線と『指揮の帯』の描画（epic-00615）。この Issue は帯の高さを受ける配置の入力だけを用意する",
	"ダッシュボードから書き込む操作と「見た」の記録（この画面は「見た」を送らない）",
	"リリースと配布、dogfood の写し `spec-dock/docs/reference_cli.md` の更新（配布の更新で揃う）",
]

requirements: {
	"R-01": {
		title: "`/graph` で『横断の構造』が開き、横断の画面のタブから行ける"
		text: """
			`/graph`（と `/graph/`）はサーバーが殻の HTML を返し、殻は view `allgraph` を描く。ページの題名は「横断の構造 · すべてのリポジトリ · SpecDock」。
			リポジトリを選んでいないときの上の帯のタブ（PC の帯とスマホの下のタブ）は『横断の概況』『横断の構造』『人のタスク』の順。`?embed=1` は移った先でも保たれる。
			`/r/…` の画面のタブ、`/` と `/todos` の見え方は、タブが1つ増えるほかは変えない。
			"""
		acceptance: [
			"`GET /graph` と `GET /graph/` が殻の HTML（200）を返し、`GET /graph/x` は今と同じく 404",
			"`parseRoute` が `/graph` を `{view: \"allgraph\", repository: null}` にし、`/graph?embed=1` の `embed` が true",
			"`/`・`/todos`・`/graph` の上の帯のタブが3つで、上の順。`/graph` では『横断の構造』が選ばれ、embed のときは各タブの href に `embed=1` がある",
			"`/r/<repo>/` の画面のタブは今の4つのまま",
			"`/graph` のページの題名が「横断の構造 · すべてのリポジトリ · SpecDock」",
			"配る側の `reference_cli.md` の「画面の道」に `/graph`（横断の構造）と `/todos`（人のタスク）がある",
		]
	}
	"R-02": {
		title: "リポジトリの構造の図の見え方と動きを変えずに、描く部品を共有する"
		text: """
			箱・枠・塊の HTML と線の class の決め方を `views/graph/draw.js` に取り出し、`graph.js` と `allgraph.js` が同じ関数で描く。
			`graph.js` が出す HTML（世界の中身、道具の帯、凡例）は、取り出す前と1文字も変わらない。graph.js のソースの文字列を調べる今のテストは、調べるファイルを draw.js に移してよいが、確かめる文字列と数は変えない。
			"""
		acceptance: [
			"開始のコミットの graph.js で偽の DOM に描いた世界の HTML（入れ子・木 × 全体・いま・これから、focus、選び、状態の札、片付けの候補、稼働の印の行を含む複数の構造）が、取り出した後の graph.js の HTML と同じ",
			"node の配置・線・範囲・道具の帯のテストと HTTP のテストが、変えずに通る",
			"調べる場所を draw.js に移したソースの文字列のテストの、確かめる文字列と数が開始のコミットと同じ",
		]
	}
	"R-03": {
		title: "各リポジトリを、そのリポジトリの構造の図を入れたリポジトリの枠で描き、入れ子のまま並べる"
		text: """
			一覧の API の並び（鍵の順）と `parent` で木を作る（`parent` が同じ一覧にないリポジトリは最上位）。
			リポジトリの枠は、見出し（folder のアイコン、`owner/name`、段の札）、警告の行、後から足す帯、中の構造の図、子のリポジトリの枠の棚の順に上から並べる。
			中の構造の図は、そのリポジトリの構造を今の配置（`routeLayout`、入れ子）と今の部品で描いたもので、その深さで使える幅で折り返す。子の枠は親の中の構造の図の下に、左から右へ詰めて折り返す。最上位の枠は図の領域の幅で折り返す。
			リポジトリの枠は Initiative の枠と形で見分けられ、新しい色の値は足さない。同じ ID の Scope が2つのリポジトリにあっても、DOM と選びで混ざらない。
			"""
		acceptance: [
			"この PC の登録の形（9つ）の合成の入力で、company-os の枠が housing-lifecycle と input-devices の枠を、housing-lifecycle が taikyohiyou_project を、input-devices が generic-mona・tenting-cradle・yubisaki の枠を幾何で含み、spec-dock と orca-web の枠は company-os の外にある",
			"子の枠が、親の中の構造の図の四角とも、兄弟の枠とも重ならない",
			"見出しに `owner/name` と段の札（［事業］、［プロダクト］。2つ以上は「 › 」でつなぐ）がある",
			"`allgraph.css` に、16進・`rgb(`・`hsl(` の色の値と、新しい色の札（`--` で始まる色の定義）がない",
			"2つのリポジトリに同じ ID の箱があるとき、それぞれの箱はそのリポジトリの枠の要素の中にあり、片方を選ぶと他方は選ばれない",
		]
	}
	"R-04": {
		title: "枠の見出しと中身の間に、後から帯の高さを足せる"
		text: """
			組み立ての入力に、リポジトリごとの帯の高さ（px、既定は 0）を渡せる。帯の高さを渡すと、その枠の中の構造の図と子の棚がその分だけ下がり、枠がその分だけ高くなり、出力にその枠の帯の四角が入る。
			この Issue は帯を描かない（どの枠も 0 で呼ぶ）。
			"""
		acceptance: [
			"帯の高さ 0 と、入力を渡さないときの組み立ての出力が同じ",
			"あるリポジトリに帯の高さ h を渡すと、その枠の body の y と高さが h 増え、帯の四角（見出しの下から h の高さ）が出力にあり、重なりのなさ（R-03 の2つ目）が保たれる",
		]
	}
	"R-05": {
		title: "『全体・いま・これから』をすべての枠に当て、このページの既定は『これから』"
		text: """
			道具の帯に、構造の図と同じ『全体・いま・これから』を置き、選んだ範囲をすべてのリポジトリの枠に当てる。既定は『これから』。選びは `localStorage` の `specdock.allgraph.v1` に残し、構造の図の `specdock.graph.v3` には触れない。読めない・壊れた値なら既定。
			『これから』では、構造が読め、見えるもの（箱・枠・塊）が0で、info でない警告がないリポジトリの枠は、出す子の枠がなければ出さない。出す子があれば、中の構造の図が空の入れ物として出す。
			読み込み中、読めない、info でない警告のあるリポジトリの枠は『これから』でも出す（info だけの警告は出すかを変えない）。『全体』『いま』ではすべての枠を出す（Scope のないリポジトリは「Scope はまだありません」）。
			1つのリポジトリの枠の中の箱と枠の集まりは、そのリポジトリの構造の図の同じ範囲（入れ子）と同じ。
			"""
		acceptance: [
			"覚えがないとき・壊れた値のときに『これから』が選ばれる",
			"`specdock.allgraph.v1` に `{\"range\": \"all\"}` があれば、ページを開き直したとき（画面を新しく描いたとき）に『全体』が選ばれる",
			"範囲を変えると `specdock.allgraph.v1` に `{\"range\": …}` が書かれ、`specdock.graph.v3` は変わらない",
			"『これから』で、見えるものが0のリポジトリ（子なし）の枠がない。見える子を持つ親は、中の図が空の入れ物として出る。読み込み中・読めない・info でない警告のある枠は出て、info の警告だけの見えるもの0の枠（子なし）は出ない",
			"『全体』『いま』で、出すリポジトリの枠がすべて出る",
			"1つのリポジトリの枠の中の箱・枠・塊の ID の集まりが、同じ構造・同じ範囲・入れ子の routeLayout の node と group の集まりと同じ",
		]
	}
	"R-06": {
		title: "箱を押すと、そのリポジトリの文脈で今と同じ横の欄が開き、稼働の印も今どおり出る"
		text: """
			箱や枠の見出しを押すと、構造の図と同じ横の欄（`createScopePanel`）が、そのリポジトリの構造とスコープの API で開く。欄の『詳しい画面』は `/r/<そのリポジトリ>/scopes/<ID>` で、押すとそのリポジトリの詳しい画面のページへ移る。『この範囲に絞る』は `/r/<そのリポジトリ>/?focus=<ID>` へ移る。
			選んだ Scope の上流・下流の目立たせと依存の線は、そのリポジトリの中だけ。状態で目立たせる札の数は出しているすべてのリポジトリの合計で、押すとすべての枠の箱に当たる。
			orca-web の稼働の印と「Orca で開く」は、構造の図と同じ条件で、そのリポジトリの構造から対応を決めて出す。印はエージェントの行（iss-00620）に置き、行の数が変わったときだけそのリポジトリの配置をやり直す（1回の知らせか描画につき、リポジトリごとに2回まで）。
			"""
		acceptance: [
			"箱を押すとスコープの API がそのリポジトリの鍵で呼ばれ、欄が開き、欄の『詳しい画面』の href が `/r/<そのリポジトリ>/scopes/<ID>`（embed のときは `embed=1` つき）",
			"欄が orca-web の知らせで描き直されても、欄の文脈のリポジトリと構造は選んだリポジトリのまま",
			"稼働の印が、対応した worktree のあるリポジトリの箱にだけ出る（orca-web の要約の合成の入力で）",
			"稼働の印の行の数が変わったリポジトリだけが配置し直される",
			"状態で目立たせる札の数が、出している枠のリポジトリの Issue の合計",
		]
	}
	"R-07": {
		title: "PC の幅とスマホの幅で読め、『収める』で1枚に収まる"
		text: """
			1440・1000 の幅とスマホの 390px で、道具の帯と枠の見出しが読め、ページの横にはみ出さない。初めの見え方、『収める』、拡大・縮小・移動（ドラッグ、ホイール、Ctrl とホイール、2本指）は構造の図と同じ式と操作。窓の大きさが変わり終わったとき（200ms）だけ、幅を変えて組み立て直す。
			390px 以下では横の欄は今の下からのシートになる。
			`window.specdockEdgeAudit()` は、リポジトリごとの線の検査（構造の図の edgeAudit と同じ項目）と合計を返す。
			"""
		acceptance: [
			"この PC の実データで 1440・1000・390 × 明・暗の写しに、道具の帯と枠の見出しの重なりがなく、ページの横のスクロールがない",
			"『収める』の後、出しているすべての枠の外接の四角が図の領域に収まる",
			"すべてのリポジトリの edgeAudit の違反（boxHits・ownHits・overlaps・diagonal・portShare・failed・missing・markOverflow）が0、ブラウザーのエラーが0",
		]
	}
	"R-08": {
		title: "読み込みと更新はリポジトリごとに行い、変わらないものを配置し直さない"
		text: """
			各リポジトリの構造を `api.structure(鍵, null)` で並べて読み、届いたものから描く。リポジトリの配置は、（版、範囲、使える幅、30分の動きの印の組、エージェントの行の寸法）が同じなら計算し直さない。重い計算の間に、リポジトリごとに一度描画へ戻す。
			5秒ごと（ページが見えている間）に各リポジトリの版を読み、変わったリポジトリだけ構造を読み直す。「見た」は送らない。
			"""
		acceptance: [
			"版が変わらない更新を何度しても、どのリポジトリの routeLayout も呼ばれない（数で確かめる）",
			"1つのリポジトリの版が変わると、そのリポジトリだけ構造が読み直され、配置し直される",
			"この画面は `POST …/seen` を送らない",
		]
	}
}

failures: {
	"F-01": {
		title: "1つのリポジトリの構造が読めないときは、その枠に理由を出し、ほかは描く"
		text: """
			構造の API の失敗、スナップショットがない・読めない（`scopes` が空）は、その枠の警告の行に、概況と同じ言葉と次の1手（`overviewWarnings`）を出す。
			`scopes` があれば、`snapshot.status` によらずそれを描き、`ok` でない理由は警告の行に添える。『これから』でも、info でない警告のある枠は出す。
			"""
	}
	"F-02": {
		title: "『これから』でどのリポジトリにも見えるものがないとき、表示しているリポジトリが0のときは、知らせを出す"
		text: """
			『これから』で出す枠が1つもなければ、道具の帯は残し、図の場所に「これから進める Scope は、どのリポジトリにもありません。全体で、終わったものを見られます。」を出す。
			表示しているリポジトリが0なら、概況と同じ知らせ（「表示しているリポジトリがありません。`spec-dock dashboard list` で確かめてください。」）を出す。
			"""
	}
	"F-03": {
		title: "親の鍵が一覧にない、たどると戻ってくるときは、最上位に置く"
		text: "`parent` が同じ一覧にない、または親をたどると自分に戻るリポジトリは、最上位に置き、二度描かない。"
	}
}

constraints: [
	"組み立て（compose.js）は DOM のない純粋な計算に置き、node のテストで確かめる（今の `layout.js` と同じ）",
	"Epic の `requirement.cue` の constraints（graph.js の見え方と動きを変えない、ソースの文字列のテストは調べる場所だけを移す、新しい色と字体を足さない、公開の文書とテストにこの PC の実際のパスを書かない）に従う",
	"常駐のダッシュボード（47800）、常駐の orca-web、道具の環境の spec-dock には触れない。実機の確かめは隔離した venv と一時の状態の置き場と別のポートで行う",
]

decisions: [
	"2026-11-16 統括・計画の担当：Epic の decisions のとおり（道 `/graph`、既定『これから』、入れ物の親、横の欄・詳しい画面・稼働の印はそのリポジトリの文脈、線はリポジトリの中だけ、1つ読めなくてもほかは描く、木と focus は持たない）。",
	"2026-11-17 統括（依頼書）：epic-00615 の『指揮の帯』のために、枠の見出しと中身の間の余白を、枠ごとに後から足せる配置の入力にする（この Issue では描かない）。",
	"2026-11-17 タスク担当：警告は1件1行（はみ出す文は省略し、全文は title に出す）の決まった高さで置き、組み立てを DOM の測りなしの純粋な計算に保つ。",
	"2026-11-17 タスク担当：リポジトリの枠は世界の中に平らに並べた要素（`section.ax-repo`）とし、入れ子は座標で表す（DOM の入れ子にしないので、`[data-repo]` の中の `[data-id]` の探しが子のリポジトリの箱と混ざらない）。",
	"2026-11-17 タスク担当：画面の殻の構造（`.gx`、`.gx-view`、`.gx-world`、`.gx-bar`、`.panel`）と graph.css をそのまま使い、リポジトリの枠の見え方と、子の結合子や view の名前で当たる共有の CSS の規則（部品の絶対配置、main、横の欄の幅）の allgraph の分を allgraph.css に書く。保存は Epic のとおり `{range}` だけ（凡例の開閉は覚えない）。",
]
