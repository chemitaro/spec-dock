package spec

// 要件（Epic）。型 specdock/v1。

schema: "specdock/v1"

assurance: {
	level:  "standard"
	reason: "表示を足すだけで、エージェントへの操作やデータの書き込みはしない"
}

purpose: """
	Orca のオーケストレーションで、だれ（統括・タスク担当）がだれ（worker）を指揮しているかを、SpecDock の構造の図（リポジトリの構造の図と『横断の構造』）の上に、
	黄色の、電波のようにふわふわと動く線で出す。どの Scope の仕事を、どのエージェントが指揮しているかを、図を見ただけで分かるようにする。
	"""

background: """
	本人の要望（2026-11-16）：構造の図の箱には、orca-web の稼働の印で「その worktree にいるエージェント」が出るようになった（epic-00471、epic-00526）。
	次は、エージェントどうしの指揮の関係（親 → 子）を、図の上に線で見たい。

	調べの報告書（`.workbench/research-report.md`、2026-11-16、Orca 1.4.259・orca-web main で確かめた事実）：
	- Orca は、Dispatch の記録を持つ pane ごとに親を計算し（親 ＝ 作った人、いなければ Run の統括）、`orca worktree ps` の各エージェントの `parentPaneKey` で出している。実データの親子の5組は、すべて別の行の `paneKey` に完全に一致した。
	- 構造化 Chat の統括は、CLI の記録には現れず、子の `parentPaneKey` が指す pane としてだけ外から識別できる。
	- handoff（別のエージェントに渡すだけのもの）には Dispatch がなく、`parentPaneKey` が出ない。解放した worker は ps から消える。仕事を終えて端末が残る子（done）は ps に残る。
	- orca-web の状態の文書（`/api/state`）の各エージェントは `paneKey` と `parentPaneKey` を持つが、SpecDock が読む要約（`GET /api/worktrees/summary`、`orca-web.worktree-summary/v1`）には、親の項目がない。
	- 構造の図は、`layout.js` の座標（世界の座標）で枠・箱・塊を置き、世界ごと拡大・移動している。依存の線の SVG も世界の中にある。

	本人は、統括が作った議論の資料（2026-11-17）を見て、作り方（案 A）と、問い1〜11の答え（すべて推奨）を決めた（decisions）。
	"""

includes: [
	"リポジトリの構造の図（`/r/<repo>/graph`）に、指揮の線、親の端の波紋、すべての Initiative の上の『指揮の帯』を出す",
	"『横断の構造』（`/graph`、epic-00612）に、リポジトリをまたぐ指揮の線、リポジトリの枠ごとの帯、どの枠にも入らない親の帯を出す",
	"帯のエージェントを押したときの、親子の線の目立たせと、詳細の欄でのそのエージェントのチャット（orca-web の `/embed/agent`）",
	"新しい色の札（指揮の色）と凡例の行",
	"orca-web の要約に、指揮の親と main の印を足すこと（orca-web の Issue が持つ。この Epic の前提。plan.cue の `prerequisites`）",
]

excludes: [
	"handoff など、Orca に親子の記録がない関係（出せない）",
	"解放した worker の線、指揮の歴史（Task・Dispatch の記録）",
	"orca-web の Run の木（`/api/runs/<id>/tree`）を使うこと、その木が構造化 Chat の統括を結べていない穴を直すこと（統括が別に扱う）",
	"指揮の線そのものを押す操作、線の表示を切り替えるボタン",
	"エージェントへの操作（送信、止める、開く以外）、Orca への書き込み",
	"SpecDock のサーバーが Orca や orca-web を読むこと（epic-00471 の境界のまま）",
	"ボード、タイムライン、詳しい画面、横断の概況への線",
	"リリースと配布（統括が別の Issue で行う）",
]

requirements: {
	"R-01": {
		title: "要約の指揮の親で、子と親のエージェントを結ぶ"
		text: """
			orca-web の要約の各エージェントの `parent.id` が、同じ要約にいる別のエージェントの `id` を指すとき、その2人を指揮の1組（親 → 子）とする。
			範囲は Orca のオーケストレーション（worker-start で始めた worker）で、orca-web が要約に親を出すものだけ。推測で結ばない（パス、ブランチ、時刻、名前から親を決めない）。
			仕事を終えて端末が残る子（印が done）も組に入る。解放されて要約から消えた子は、組から消える。
			"""
		acceptance: [
			"報告書の実データの形の合成の要約（親子5組、うち1組は別のリポジトリの統括、1組は同じ worktree の親子）から、5組がそのまま得られる",
			"`parent` のないエージェント、`parent.id` が null のエージェントからは、組ができない",
			"子が要約から消えると、次の更新でその組の線がなくなる",
		]
	}
	"R-02": {
		title: "各エージェントの居場所を、図に描かれているものから決める"
		text: """
			組の端のエージェントは、次の順に居場所を決める。
			1. その worktree に対応する Scope（今の稼働の印と同じ対応）の箱か枠が描かれていれば、それ。
			2. その Scope が、今の見せる範囲で畳んだ塊に入っていれば、その塊。
			3. その Scope が描かれていなければ（『これから』で隠れた、など）、いちばん近い描かれた祖先の枠。帯には入れない。
			4. 上のどれにも当たらない（どの Scope にも対応しない worktree：main のチェックアウト、Scope の記録がない worktree、ほかのリポジトリ。描かれた祖先もない）なら、『指揮の帯』。
			"""
		acceptance: [
			"箱のある worktree の子の線が、その箱に届く",
			"『これから』で隠れた Issue の worktree の子の線が、いちばん近い見える祖先の枠に届き、帯にその子が出ない",
			"main のチェックアウトの統括が帯に出て、その統括から子の箱へ線が出る",
		]
	}
	"R-03": {
		title: "すべての Initiative の上に『指揮の帯』を置き、箱を持たない線の端のエージェントだけを並べる"
		text: """
			帯は図の世界のいちばん上（すべての Initiative の上）にあり、図とともに拡大・移動する。帯に出すのは、組の端（親でも子でも）で、R-02 で帯に決まったエージェントだけ。組に入らないエージェントは出さない。
			項目は worktree ごとにまとめ、札は、このリポジトリなら「main のチェックアウト」（要約の worktree の `main` が true）かブランチ名、ほかのリポジトリなら「<project.name> · <branch>」。
			各エージェントは、今の稼働の印（orca-web の部品）で描く。帯に出すものがなければ、帯はない（図は今のまま）。
			帯は、どの幅でも折り返さない1行で、入りきらない分は、図と同じドラッグ（スマホでは指の移動）で横に動かして見る。
			"""
		acceptance: [
			"spec-dock の実データの形の合成の入力で、帯に「main のチェックアウト」の項目が1つあり、統括と調べの担当の2人の印が並ぶ",
			"ほかのリポジトリの統括の札が「<project.name> · <branch>」になる",
			"組が1つもないとき、帯の要素がなく、構造の図の HTML と見え方が今と同じ",
		]
	}
	"R-04": {
		title: "指揮の線を、枠の上・箱の下の層に、緩い曲線で描く"
		text: """
			線は親の端から子の端への緩い三次ベジェ曲線で、依存の線（直交の道と矢印）と形で見分けられる。同じ親から複数の子へ出るときは、出口を少しずつずらす。
			層は世界の中の SVG で、枠の上、箱の下にあり、押せない（ポインターの操作を受けない）。依存の線の道と検査（edgeAudit）に入らない。
			同じ箱か枠に両端が決まる組（同じ worktree の親子など）には線を引かず、その箱の親の印に小さな電波の輪を付ける。
			"""
		acceptance: [
			"線の層が、枠の要素より後ろ、箱の要素より前にあり、`pointer-events` が none",
			"線があっても、edgeAudit の違反の数が、線のないときと同じ（0）",
			"同じ worktree の親子の組に線がなく、その箱に電波の輪がある",
		]
	}
	"R-05": {
		title: "子の状態で線の動きを変え、親の端に波紋を出す"
		text: """
			子の印が working（monitoring を含む）なら、親から子へ点がゆるやかに流れる。waiting・blocked・sleeping・unknown なら、止まった点線。done なら、薄い、動かない線。
			親の端には、輪が広がって消える波紋をゆるやかに繰り返す。動きは CSS の stroke-dashoffset（点の流れ）と transform・opacity（波紋）だけで作る。
			`prefers-reduced-motion: reduce` では、点は流れず止まった点線になり、波紋は動かない1つの輪になる。
			"""
		acceptance: [
			"working の子への線だけに点の流れのアニメーションがあり、waiting の子への線は止まった点線、done の子への線は薄い実線か止まった線",
			"減らす設定で、アニメーションが動かず、波紋の輪が1つ",
		]
	}
	"R-06": {
		title: "指揮の色を黄色の新しい札で定め、凡例に足す"
		text: """
			色は、琥珀（止められている、`--sd-blocked`）より明るい、レモン寄りの黄。新しい色の札（例 `--sd-cmd` と下地の光の札）を、明るいテーマと暗いテーマのそれぞれで定める。
			明るいテーマでは、白地で見えるよう少し濃い黄にし、太く薄い下地の光を重ねる。止められている（箱の塗りと四角い枠）とは、動く曲線と波紋の形で見分ける。
			凡例に「指揮（親 → 子）」の行を足す。
			"""
		acceptance: [
			"指揮の色の札が、明るいテーマ・暗いテーマ・明示の暗いテーマの3か所で定まり、色相が `--sd-blocked` より黄の側（10°以上）にある",
			"指揮の線の色の、図の背景とのコントラストが、両方のテーマで 3:1 以上（下地の光を数えない）",
			"凡例に「指揮（親 → 子）」の行があり、線の見本がある",
		]
	}
	"R-07": {
		title: "帯のエージェントを押すと、その親子の線が目立ち、詳細の欄でそのエージェントのチャットが開く"
		text: """
			帯のエージェント（ボタン。キーボードでも押せる）を押すと、そのエージェントが親か子である線だけが目立ち、ほかの指揮の線は薄くなる。
			同時に、図の横の欄（スマホでは下からのシート）に、そのエージェントの詳細とチャット（orca-web の `/embed/agent`、エージェントのタブと同じ枠の決まり）が開く。
			欄を閉じる、Esc、図の空いたところを押す、箱を選ぶ、のどれかで、目立たせを解く。線そのものは押せない。
			"""
		acceptance: [
			"帯の統括を押すと、その統括の子への線だけが目立ち、欄にその統括のチャットの枠（`/embed/agent?id=<統括の id>`）が開く",
			"欄を閉じると、線の目立たせが解ける",
		]
	}
	"R-08": {
		title: "線と帯はいつも出し、スマホの幅でも出す"
		text: """
			Orca との連携が使えて（稼働の印が出る条件）、組が1つ以上あれば、線と帯はいつも出す。道具の帯に切り替えのボタンを足さない。
			1440・1000 の幅と、スマホの 390px で、線と帯が出て、帯の札が読め、ページの横にはみ出さない。『収める』と初めの見え方の外接の四角に帯を含める。
			"""
		acceptance: [
			"1440・1000・390 × 明・暗の写しで、線と帯が出て、ページに横のスクロールがない",
			"『収める』の後、帯と図の全体が図の領域に収まる",
		]
	}
	"R-09": {
		title: "要約が変わったら線と帯だけを計算し直し、箱を画面の上で動かさない"
		text: """
			線の計算は、今の要約の購読（10 秒ごと）に乗り、新しい読み取りやポーリングを足さない。要約だけが変わったときは、配置を計算し直さず、線と帯だけを計算し直す。配置が変わったときは、両方を計算し直す。
			帯が出たり消えたりしても、図の箱と枠は、画面の上で動かない（帯の高さの分だけ、見る位置を補う）。
			"""
		acceptance: [
			"要約だけが変わった更新で、配置の計算の回数が増えない（数で確かめる）",
			"帯が出た更新の前後で、同じ箱の画面の上の位置が変わらない",
		]
	}
	"R-10": {
		title: "『横断の構造』で、リポジトリをまたぐ線と、リポジトリの枠ごとの帯を出す"
		text: """
			『横断の構造』では、全体の世界に置いた1枚の線の層で、リポジトリをまたぐ組も結ぶ。各エージェントの居場所は、その worktree が対応するリポジトリの枠の中で、R-02 の順に決める。
			帯は、各リポジトリの枠の見出しのすぐ下に置き、そのリポジトリの、帯に決まったエージェントを並べる（札はそのリポジトリの中の札：「main のチェックアウト」かブランチ名）。
			『横断の構造』に枠が出ていないリポジトリ（隠した、登録していない、など）のエージェントは、全体のいちばん上の帯「ほかの場所」に、「<project.name> · <branch>」の札で置く。
			帯のエージェントを押したときの動き（R-07）、色と動き（R-04〜R-06）、更新（R-09）は、リポジトリの構造の図と同じ。
			"""
		acceptance: [
			"company-os の main のチェックアウトの統括と、別のリポジトリの Issue の worker の合成の組で、company-os の枠の帯から、そのリポジトリの枠の中の箱へ線が出る",
			"どのリポジトリの枠にも対応しない worktree の親が、帯「ほかの場所」に出る",
			"線があっても、すべてのリポジトリの edgeAudit の違反が0",
		]
	}
	"R-11": {
		title: "『これから』で見える Scope がないリポジトリでも、帯に親がいれば、帯だけの入れ物の枠として出す"
		text: """
			epic-00612 の R-06 は、『これから』で見える Scope が1つもないリポジトリの枠を出さない。指揮している親（帯に決まったエージェント）がそのリポジトリにいるときだけ、その枠を、見出しと帯だけの入れ物として出す。これが R-06 の、ただ1つの例外。
			親がいなくなれば（組が消えれば）、次の更新で、その枠は今の規則どおり消える。
			"""
		acceptance: [
			"『これから』で見える Scope のないリポジトリの main のチェックアウトに統括がいて、別のリポジトリに子がいるとき、そのリポジトリの枠が帯だけで出る",
			"その統括の組が消えると、その枠が出なくなる",
		]
	}
}

failures: {
	"F-01": {
		title: "要約に親の項目がない（古い orca-web）・Orca に届かない・要約が読めないときは、線も帯も出さず、ほかは今のまま"
		text:  "要約の `agents[].parent` がどのエージェントにもない、稼働の印が出ない状態（`orca.status()` が ok でない）、のときは、組を作らない。エラーや知らせは足さず、構造の図と稼働の印は今のとおり描く。worktree の `main` がないときは、札をブランチ名にする。"
	}
	"F-02": {
		title: "親が見えないときは、線を引かない"
		text:  "`parent.id` が null、または要約にいないエージェントを指すときは、その子の組を作らない（推測で結ばない）。その子は、ほかの組の親でなければ帯にも出ない。"
	}
	"F-03": {
		title: "形の違う親の項目、自分を指す親、循環は、組にしない"
		text:  "`parent` が object でない、`id` が文字列でない、自分の `id` を指す、のときは、その子の組を作らない。親子が輪になっていても、各組を1回だけ数え、計算が止まらない。ほかの組はそのまま描く。"
	}
	"F-04": {
		title: "札にする項目がないときも、帯の項目を描く"
		text:  "worktree の `branch` が null なら「ブランチ不明」、ほかのリポジトリで `project` が null なら「ほかのリポジトリ · <branch>」を札にする。"
	}
}

constraints: [
	"作り方は案 A（decisions）：orca-web が要約で親を id に解き、SpecDock は DOM の位置ではなく自分の配置の計算（世界の座標）で線の端を決める。`getBoundingClientRect` で端を決めない",
	"SpecDock の画面は、orca-web の今の読み取りの口（要約と部品）だけを読む。SpecDock のサーバーは Orca・orca-web を読まず、Orca の CLI を呼ばない（epic-00471 の境界）。新しいポーリングを足さない",
	"線のつながり・居場所・帯の項目・端と曲線の計算は、DOM のない純粋な関数に置き、node のテストで確かめる（`layout.js` と同じ流儀）",
	"組がないときは、リポジトリの構造の図と『横断の構造』の HTML と見え方を変えない。依存の線の道（`router.js`）と edgeAudit を変えない",
	"動きは CSS の stroke-dashoffset と transform・opacity だけで作る。SVG の `<animate>`・`animateMotion`、canvas、`filter: blur` は使わない",
	"新しい色は、指揮の色の札（線と下地の光）だけ。epic-00612 の『新しい色を足さない』は、その Epic の中の制約として扱い、この Epic は本人の決定でこの札だけを足す",
	"公開のリポジトリの文書とテストに、この PC の実際のパス、IP、セッションの id を書かない（合成の値を使う）",
	"作り始めるのは『横断の構造』（iss-00614）ができた後（本人の順序）。リポジトリの構造の図の部品は iss-00614 が `views/graph/draw.js` に取り出すので、その後の形に足す",
]

decisions: [
