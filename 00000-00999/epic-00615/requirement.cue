package spec

// 要件（Epic）。型 specdock/v1。

schema: "specdock/v1"

assurance: {
	level:  "standard"
	reason: "表示を足すだけで、エージェントへの操作やデータの書き込みはしない"
}

purpose: """
	Orca のオーケストレーションで、だれ（統括・タスク担当）がだれ（worker）を指揮しているかを、SpecDock の構造の図（リポジトリの構造の図と『横断の構造』）の上に、
	黄色の、電波のようにふわふわと動く線で出す。どの Scope の仕事を、どのエージェントが指揮しているかを、図を見ただけで分かるようにする。
	"""

background: """
	本人の要望（2026-11-16）：構造の図の箱には、orca-web の稼働の印で「その worktree にいるエージェント」が出るようになった（epic-00471、epic-00526）。
	次は、エージェントどうしの指揮の関係（親 → 子）を、図の上に線で見たい。

	調べの報告書（`.workbench/research-report.md`、2026-11-16、Orca 1.4.259・orca-web main で確かめた事実）：
	- Orca は、Dispatch の記録を持つ pane ごとに親を計算し（親 ＝ 作った人、いなければ Run の統括）、`orca worktree ps` の各エージェントの `parentPaneKey` で出している。実データの親子の5組は、すべて別の行の `paneKey` に完全に一致した。
	- 構造化 Chat の統括は、CLI の記録には現れず、子の `parentPaneKey` が指す pane としてだけ外から識別できる。
	- handoff（別のエージェントに渡すだけのもの）には Dispatch がなく、`parentPaneKey` が出ない。解放した worker は ps から消える。仕事を終えて端末が残る子（done）は ps に残る。
	- orca-web の状態の文書（`/api/state`）の各エージェントは `paneKey` と `parentPaneKey` を持つが、SpecDock が読む要約（`GET /api/worktrees/summary`、`orca-web.worktree-summary/v1`）には、親の項目がない。
	- 構造の図は、`layout.js` の座標（世界の座標）で枠・箱・塊を置き、世界ごと拡大・移動している。依存の線の SVG も世界の中にある。

	本人は、統括が作った議論の資料（2026-11-17）を見て、作り方（案 A）と、問い1〜11の答え（すべて推奨）を決めた（decisions）。

	改訂（2026-11-17、統括の依頼書 `planner-epic-00615-r2.md` と統括の連絡 msg_08985a5e64f0・msg_aa9c18d2ef1d）：本人は、線の端を箱や枠ではなくエージェントの印にし、同じ箱の中の親子も線で結び、
	どこの稼働の印を押してもそのエージェントのチャットを開き、Epic・Initiative の枠にもブランチの印を出し、印の並び順を指揮の関係で決め、印を専用の行に置く、と決めた。
	統括が確かめた事実：Epic・Initiative も `spec-dock work start` で worktree を持て、`matchWorktrees` は Scope の種類を区別しないので、その worktree のエージェントは枠の見出しの印の置き場に出る。
	worktree の印（`wtMark`）は Issue の箱にだけある。印を押すと横の欄のエージェントのタブが開くが、押したエージェントではなく、前の選びか最後に置かれたエージェントが開く。
	iss-00620（epic-00573）が、構造の図の箱と枠の稼働の印を上限なしにすべて出し、ほかの印の下の専用の行に置いて折り返し、配置が印の行の数を知る形にする。
	"""

includes: [
	"リポジトリの構造の図（`/r/<repo>/graph`）に、親のエージェントの印から子のエージェントの印への指揮の線（同じ箱の中の親子は箱の外へふくらむ弧）、親の端の波紋、すべての Initiative の上の『指揮の帯』を出す",
	"『横断の構造』（`/graph`、epic-00612）に、リポジトリをまたぐ指揮の線、リポジトリの枠ごとの帯、どの枠にも入らない親の帯を出す",
	"稼働の印（構造の図・横断の構造・ボード・横の欄の見出し・指揮の帯のどこでも）を押したときに、そのエージェントを選んだ状態で横の欄のチャット（orca-web の `/embed/agent`）を開き、構造の図ではその親子の線を目立たせる",
	"作業中の Epic・Initiative の枠に、Issue の箱と同じ worktree の印（ブランチの title つき）を出す",
	"ボードの札の稼働の印を、ほかの印の下の専用の行に置く（構造の図の箱と枠の専用の行は iss-00620 が作る）",
	"新しい色の札（指揮の色）と凡例の行",
	"orca-web の要約に、指揮の親と main の印を足し、稼働の印の並び順を指揮の関係で決めること（orca-web の Issue が持つ。この Epic の前提。plan.cue の `prerequisites`）",
]

excludes: [
	"handoff など、Orca に親子の記録がない関係（出せない）",
	"解放した worker の線、指揮の歴史（Task・Dispatch の記録）",
	"orca-web の Run の木（`/api/runs/<id>/tree`）を使うこと、その木が構造化 Chat の統括を結べていない穴を直すこと（統括が別に扱う）",
	"指揮の線そのものを押す操作、線の表示を切り替えるボタン",
	"エージェントへの操作（送信、止める、開く以外）、Orca への書き込み",
	"SpecDock のサーバーが Orca や orca-web を読むこと（epic-00471 の境界のまま）",
	"ボード、タイムライン、詳しい画面、横断の概況への線（ボードの印を押したときの動きと専用の行は含む）",
	"箱の中の個々の稼働の印をキーボードで選ぶこと（印は箱のボタンの中の絵のまま。キーボードでは横の欄のエージェントのタブで選ぶ。帯のエージェントはボタンなのでキーボードで押せる）",
	"リリースと配布（統括が別の Issue で行う）",
]

requirements: {
	"R-01": {
		title: "要約の指揮の親で、子と親のエージェントを結ぶ"
		text: """
			orca-web の要約の各エージェントの `parent.id` が、同じ要約にいる別のエージェントの `id` を指すとき、その2人を指揮の1組（親 → 子）とする。
			範囲は Orca のオーケストレーション（worker-start で始めた worker）で、orca-web が要約に親を出すものだけ。推測で結ばない（パス、ブランチ、時刻、名前から親を決めない）。
			仕事を終えて端末が残る子（印が done）も組に入る。解放されて要約から消えた子は、組から消える。
			"""
		acceptance: [
			"報告書の実データの形の合成の要約（親子5組、うち1組は別のリポジトリの統括、2組は同じ worktree の親子（Issue の worktree の中、main のチェックアウトの中））から、5組がそのまま得られる",
			"`parent` のないエージェント、`parent.id` が null のエージェントからは、組ができない",
			"子が要約から消えると、次の更新でその組の線がなくなる",
		]
	}
	"R-02": {
		title: "各エージェントの居場所を、図に描かれているものから決める"
		text: """
			組の端のエージェントは、次の順に居場所を決める。
			1. その worktree に対応する Scope（今の稼働の印と同じ対応。Scope の種類を問わない）の箱か枠が描かれていれば、その箱か枠の中の、**そのエージェントの稼働の印**（iss-00620 の専用の行。Issue の箱は箱の下、Epic・Initiative の入れ子の枠は見出しの中の題名の行の下）。
			2. その Scope が、今の見せる範囲で畳んだ塊に入っていれば、その塊（塊には印がないので、塊の縁）。
			3. その Scope が描かれていなければ（『これから』で隠れた、など）、いちばん近い描かれた祖先の枠。帯には入れない。
			4. 上のどれにも当たらない（どの Scope にも対応しない worktree：main のチェックアウト、Scope の記録がない worktree、ほかのリポジトリ。描かれた祖先もない）なら、『指揮の帯』。
			リポジトリの構造の図に出すのは、少なくとも一方の端がこのリポジトリの worktree にいる組だけにする（両端ともほかのリポジトリにいる組は、その図の『この図の Scope の仕事をだれが指揮しているか』に関わらないので出さない）。『横断の構造』は、すべての組を出す（R-10）。
			"""
		acceptance: [
			"箱のある worktree の子の線が、その箱の中の、その子の稼働の印に届く（箱の縁ではなく印の位置）",
			"作業中の Epic の worktree にいる統括の線が、その Epic の入れ子の枠の見出しの、その統括の印から出る",
			"『これから』で隠れた Issue の worktree の子の線が、いちばん近い見える祖先の枠に届き、帯にその子が出ない",
			"main のチェックアウトの統括が帯に出て、その統括から子の箱へ線が出る",
			"両端ともほかのリポジトリにいる組が、リポジトリの構造の図の帯にも線にも出ない",
		]
	}
	"R-03": {
		title: "すべての Initiative の上に『指揮の帯』を置き、箱を持たない線の端のエージェントだけを並べる"
		text: """
			帯は図の世界のいちばん上（すべての Initiative の上）にあり、図とともに拡大・移動する。帯に出すのは、組の端（親でも子でも）で、R-02 で帯に決まったエージェントだけ。組に入らないエージェントは出さない。
			項目は worktree ごとにまとめ、札は、このリポジトリなら「main のチェックアウト」（要約の worktree の `main` が true）かブランチ名、ほかのリポジトリなら「<project.name> · <branch>」。
			各エージェントは、今の稼働の印（orca-web の部品）で描き、項目の中の並びは、その worktree の印の並び（R-14）に従う。帯に出すものがなければ、帯はない（図は今のまま）。
			帯は、どの幅でも折り返さない1行で、入りきらない分は、図と同じドラッグ（スマホでは指の移動）で横に動かして見る。
			"""
		acceptance: [
			"spec-dock の実データの形の合成の入力で、帯に「main のチェックアウト」の項目が1つあり、統括と調べの担当の2人の印が並ぶ",
			"ほかのリポジトリの統括の札が「<project.name> · <branch>」になる",
			"帯の項目の中のエージェントの並びが、その worktree の要約の `buildMarks` の並びから、帯に出さないエージェントを除いた順と同じ（R-14）",
			"組が1つもないとき、帯の要素がなく、構造の図の HTML と見え方が今と同じ",
		]
	}
	"R-04": {
		title: "指揮の線を、親の印から子の印へ、緩い曲線で描く。同じ箱の中の親子は、箱の外へふくらむ弧で結ぶ"
		text: """
			線は、統括 → 子、Epic・Initiative のエージェント → その中の Issue のエージェント、Issue → Issue、帯のエージェント → 箱の中のエージェントのどれも、親の端（R-02）から子の端への1種類の線で、
			上にふくらむ三次ベジェの弧（ホップ）で描き、依存の線（直交の道と矢印）と形で見分けられる。端が印なら、線はその印の中央の真上の、箱（枠・帯の項目）の上の縁から上へ出て、子の印の真上の上の縁へ上から入る（iss-00648）。箱の中には線を引かない。印の位置は DOM ではなく配置の計算（iss-00620 の印の専用の行と並び）から決める。
			Epic・Initiative のエージェントがその中の Issue を指揮するときも、枠の上の縁から出て、枠の中の Issue の箱の上の縁へ入る同じ弧になる（特別な描き方を足さない）。子の端には小さな下向きの矢じりを付け、受けた印の縁を指揮の色にする（iss-00648）。
			線の本体の層は世界の中の SVG で、枠の上、箱の下にある。子の端の矢じりと受けた印の縁と親の端の波紋は、箱の上・依存の線の下の薄い層に描く（帯の印の縁と帯の親の波紋は、帯の層の中に描く）。どちらの層も押せない（ポインターの操作を受けない）。依存の線の道と検査（edgeAudit）に入らない。
			同じ箱か枠（同じ worktree）の中の親子、帯の同じ項目の中の親子も、線で結ぶ。その線は、箱（枠・帯の項目）の上の縁の、それぞれの印の真上から出て戻る小さな上にふくらむ弧（高さの下限 18px、iss-00648）。
			弧は、隣の箱・枠・塊と重ならず、依存の線と平行に重ならないよう、今の配置の箱の上の余白の中に収める（収まらないときは低くする。D-10）。点の流れ・下地の光・親の端の波紋は、ほかの線と同じ。
			同じ塊、同じ祖先の枠に両端が決まる組（どちらの端にも印がない）は、線を引かない。
			"""
		acceptance: [
			"線の本体の層が、枠の要素より後ろ、箱の要素より前にあり、端の層が、塊の要素より後ろ、依存の線の SVG より前にあり、どちらも `pointer-events` が none",
			"線があっても、edgeAudit の違反の数が、線のないときと同じ（0）",
			"箱の印の線の端の x が、描いた `.orca-mark` の中央（箱の中の offset から求めた世界の座標）と 1px 以内で一致し、y がその箱の上の縁にある（iss-00648）",
			"同じ worktree の親子の組（同じ行の2人、違う行の2人）に、それぞれ箱の上の縁の外へふくらむ弧があり、指揮の検査（D-10 の `cmdAudit`）の、弧と箱・枠・塊の重なり、弧と依存の線の平行な重なりが、どちらも0",
			"作業中の Epic の worktree の統括から、その枠の中の Issue の箱の子の印へ、線が出る。その線は、統括の印の真上の枠の上の縁から出て、子の印の真上の箱の上の縁へ上から入る（iss-00648）",
		]
	}
	"R-05": {
		title: "子の状態で線の動きを変え、親の端に波紋を出す"
		text: """
			子の印が working（monitoring を含む）なら、親から子へ点がゆるやかに流れる。waiting・blocked・sleeping・unknown なら、止まった点線。done なら、薄い、動かない線。
			親の端には、輪が広がって消える波紋をゆるやかに繰り返す。点の流れは、組の間 24px の大小2つの点の組（進む向きの先が大きく明るい頭、6px 後ろが小さく薄い尾）を、2px ずつずらした止めた絵12枚の合成スレッドの opacity の切り替え（0.1秒ごと）で見せ、どの線も一様に 20px/秒で流す。止まった1枚でも組の形で向きが分かる。波紋は HTML の輪の transform・opacity で、1つの輪 3.6秒、2つ目は 1.8秒遅れ（iss-00646、iss-00657）。
			`prefers-reduced-motion: reduce` では、点は流れず止まった組の点線（組の形で向きが分かる）になり、波紋は動かない1つの輪になる。
			"""
		acceptance: [
			"working の子への線だけに点の流れのアニメーションがあり、waiting の子への線は止まった点線、done の子への線は薄い実線か止まった線",
			"減らす設定で、アニメーションが動かず、波紋の輪が1つ",
		]
	}
	"R-06": {
		title: "指揮の色を黄色の新しい札で定め、凡例に足す"
		text: """
			色は、琥珀（止められている、`--sd-blocked`）より明るい、レモン寄りの黄。新しい色の札（例 `--sd-cmd` と下地の光の札）を、明るいテーマと暗いテーマのそれぞれで定める。
			明るいテーマでは、白地で見えるよう少し濃い黄にし、太く薄い下地の光を重ねる。止められている（箱の塗りと四角い枠）とは、動く曲線と波紋の形で見分ける。
			凡例に「指揮（親 → 子）」の行を足す。
			"""
		acceptance: [
			"指揮の色の札が、明るいテーマ・暗いテーマ・明示の暗いテーマの3か所で定まり、色相が `--sd-blocked` より黄の側（10°以上）にある",
			"指揮の線の色の、図の背景とのコントラストが、両方のテーマで 3:1 以上（下地の光を数えない）",
			"凡例に「指揮（親 → 子）」の行があり、線の見本がある",
		]
	}
	"R-07": {
		title: "稼働の印を押すと、そのエージェントの親子の線が目立ち、横の欄でそのエージェントのチャットが開く"
		text: """
