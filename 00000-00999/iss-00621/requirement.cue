package spec

// 要件（Issue）。型 specdock/v1。書き方は spec-dock/docs/authoring/ のガイドにある。

schema: "specdock/v1"

assurance: {
	level:  "standard"
	reason: "表示と横の欄の開き方だけを変え、エージェントへの操作やデータの書き込みはなく、PR を戻せば元に戻る"
}

purpose: "作業中の Epic・Initiative の worktree が構造の図で見分けられ、どこの稼働の印を押しても、押したそのエージェントのチャットがすぐ開くようにする。ボードの札でも、稼働の印をほかの印と混ぜずに見せる。"

background: """
	Epic epic-00615（Orca のエージェントの指揮の関係を構造の図に出す）の切り分けの1つ（slice `iss-00621`、Epic の R-12・R-13・R-14・R-15・F-06、D-08・D-09）。
	今は、worktree の印（`wtMark`、ブランチの title つき）は Issue の箱にだけあり、Epic・Initiative も `spec-dock work start` で worktree を持てるのに、その枠には出ない。
	稼働の印を押すと横の欄のエージェントのタブは開くが、選ばれるのは前の選びか最後に置かれたエージェントで、押した印のエージェントではない。
	ボードの札の稼働の印は、PR・人のタスクなどほかの印と同じ行の終わりに置かれている。
	iss-00620（構造の図の稼働の印の専用の行）と iss-00614（`views/graph/draw.js` の取り出しと『横断の構造』）は main に入った（edfabc759）。orca-web の iss-00043（印の `data-agent-id` と並び）も orca-web の main に入った（27b01fe）。
	"""

includes: [
	"リポジトリの構造の図と『横断の構造』の、入れ子の枠の見出しと木の表示の枠の箱の worktree の印",
	"構造の図・『横断の構造』・ボードの札・横の欄の見出しの稼働の印を押したときの、横の欄のエージェントのタブの選び",
	"ボードの札の稼働の印の専用の行",
	"押した印とエージェントを結ぶ記録（`data-agent-id` がない部品でも結ぶ）",
]

excludes: [
	"指揮の線・帯・弧（iss-00616・iss-00617）。帯のエージェントの押し（Epic の R-07、iss-00616）",
	"稼働の印の並びそのもの（orca-web の iss-00043 が作った。SpecDock は並べ替えない）",
	"印の上限（ボードと横の欄の見出しの 4）と『+N』、札の幅、ボードの並び順、箱を押したとき・欄を開き直したときの動き",
	"API・保存・モデルの変更",
]

requirements: {
	"R-01": {
		title: "作業中の Epic・Initiative の枠に、Issue の箱と同じ worktree の印を出す"
		text: """
			Epic の R-12。`state` が `doing` で、構造の API の `branch` がある Epic・Initiative について、Issue の箱と同じ worktree の印（`wtMark`、title「worktree：<branch>」、aria-label「worktree <branch>」）を、
			入れ子の枠の見出し（`.gx-fh`）と、木の表示の枠の箱（`tframe` の `.gx-marks`）に出す。『横断の構造』も同じ部品で出す。
			見出しの行（状態の印・Initiative の印・ID・題名・worktree の印）は1行のまま（題名が縮む）で、稼働の印の専用の行には入れない。作業中でない、または `branch` がない枠は今のまま。
			"""
		acceptance: [
			"`state` が doing で `branch` が `worktree/epic-01234` の Epic の入れ子の枠の見出し（`.gx-fh`）と、木の表示の枠の箱の `.gx-marks` に、title が「worktree：worktree/epic-01234」の `.wt` の印がそれぞれ1つある（node のテスト）",
			"`state` が doing でない、または `branch` が null の Epic・Initiative の枠の HTML が、今と同じ（node のテスト）",
			"見出しの `.wt` は `.gx-agents`（稼働の印の専用の行）の外にあり、見出しの aria-label は今と同じ",
			"実機で、worktree にエージェントがいる作業中の Epic の枠の見出しに、worktree の印とそのエージェントの稼働の印が出て、見出しの題名の行が1行のまま（worktree の印が次の行へ折り返さない）",
			"実機で、線の検査（`specdockEdgeAudit`）の違反が0のまま",
		]
	}
	"R-02": {
		title: "どこの稼働の印を押しても、横の欄のエージェントのタブを、押したエージェントを選んだ状態で開く"
		text: """
			Epic の R-13。構造の図（箱・枠の見出し）、『横断の構造』の箱と枠、ボードの札、横の欄の見出しの稼働の印を押すと、今どおりその Scope を選び（横の欄の見出しでは今の Scope のまま）、
			横の欄のエージェントのタブを開き、押した印のエージェントを選ぶ（前の選びや最後に置かれたエージェントではない）。スマホでは下からのシートで同じに開く。
			押した印とエージェントは、印の要素に `data-agent-id` があればそれで、なければ描いたときの並びの記録で結ぶ（R-04）。
			まとめた印（『+N』）を押したときは、今どおりエージェントのタブを開き、選びは変えない。
			押していない場所の動き（箱を押す、欄を開き直す、エージェントのタブの帯の項目を押す）は今のまま。
			"""
		acceptance: [
			"エージェントが3人の worktree に対応した構造の図の箱で、2つ目の印を押すと、その箱が選ばれ、横の欄のエージェントのタブで2つ目のエージェントのチャットの枠（`/embed/agent?id=<その id>`）が開く（実機）",
			"同じことが、Epic の枠の見出しの印、ボードの札の印、横の欄の見出しの印、『横断の構造』の箱の印で成り立つ（静的な検査と実機）",
			"横の欄の `openAgent(id)` で、エージェントのタブが選ばれ、欄の選び（`agent`）が `id` になり、別のエージェントを前に選んでいても `id` の枠が描かれる。`openAgent(null)` は今の `preferTab(\"agents\")` と同じで、選びを変えない（node のテスト）",
			"『+N』を押すと、エージェントのタブが開き、選んでいたエージェントが変わらない（node のテスト）",
			"スマホの幅で、選ばれた箱の印を押すと、詳しい画面へ移らず、シートでエージェントのタブが押したエージェントで開く（静的な検査と実機の 390）",
		]
	}
	"R-03": {
		title: "SpecDock は稼働の印を並べ替えず、部品の並びをそのまま描き、結ぶ"
		text: """
			Epic の R-14 のうち SpecDock の側。印の並びは orca-web の部品の `buildMarks` が作る（iss-00043）。SpecDock は自分で並べ替えず、`buildMarks` の結果の並びをそのまま描き、押した印の対応（R-04）にもその並びを使う。
			iss-00043 は orca-web の main に入ったので、実データ（手元の orca-web の要約）で、印の並びと押した印の選びを確かめて report.md に残す。
			"""
		acceptance: [
			"`paintOrcaMarks` が記録する並びが、部品の `buildMarks` の `marks[].id` の順と同じ（node のテスト。SpecDock の側に並べ替えのコードがない）",
			"実データで、同じ worktree に2人以上のエージェントがいる箱・枠の印の並びが、その worktree の要約の `buildMarks` の並びと同じで、押した印のエージェントが選ばれる（実機、report.md）",
		]
	}
	"R-04": {
		title: "押した印のエージェントを、`data-agent-id` か描いたときの並びの記録で求める"
		text: """
			稼働の印の置き場（`.sd-orca[data-orca-scope]`）ごとに、描いたときのエージェントの id の並びを記録し、押した要素から、そのエージェントの id を求める。
			印の要素に `data-agent-id` があればそれを使う（iss-00043 の後）。なければ、置き場の中の `.orca-mark`（『+N』の `--more` を除く）の何番目かを数え、記録のその番目の id を使う。
			"""
		acceptance: [
			"`data-agent-id` のある印を押すと、その値が返る（node のテスト）",
			"`data-agent-id` のない印（今の orca-web の部品と同じ形）で、3つの印のそれぞれを押すと、記録の同じ番目の id が返る（node のテスト）",
			"印の中の子の要素（種類のロゴ、経過の時刻）を押しても、その印の id が返る（node のテスト）",
			"置き場が描き直され（エージェントが変わり）た後は、新しい並びで結ぶ。描き直しの要らない要約（同じ key）では記録が残る（node のテスト）",
		]
	}
	"R-05": {
		title: "ボードの札の稼働の印を、ほかの印の下の専用の行に置く"
		text: """
			Epic の R-15。ボードの札（orca-web とつながっているときの札）の稼働の印の置き場を、ほかの印（PR・配下の数・人のタスク・後に続く数）の行（`.sd-card__meta`）から外し、その下の専用の行の要素に置く。
			印の上限 4 と『+N』、札の幅、ボードの並び順は変えない。専用の行は、中に `.orca-mark` がない札では見えず（`display: none`）、高さを取らない。orca-web とつながっていない画面の札の HTML は今のまま。
			"""
		acceptance: [
			"`card(scope, ctx, {orca: true})` の HTML で、稼働の印の置き場（`orcaSlot(id, 4)`）が `.sd-card__meta` の中になく、その後の専用の行の要素の中にある（node のテスト）",
			"`card(scope, ctx)`（orca なし）の HTML が今と同じ（node のテスト）",
			"CSS で、専用の行は中に `.orca-mark` がなければ `display: none`。ほかの印がなく稼働の印だけの札で、ほかの印の行が出ない（静的な検査と実機）",
			"エージェントのいない札（対応する worktree がない、エージェントが0、要約が読めない）の高さが、今と同じ（実機）",
			"1440・390 × 明・暗の写しで、札の印が札の縁の内にある（実機）",
		]
	}
}

failures: {
	"F-01": {
		title: "押した印とエージェントを結べないときは、今どおりエージェントのタブを開くだけにする"
		text: """
			Epic の F-06。押した印の要素に `data-agent-id` がなく、描いたときの並びの記録もない、記録と置き場の中の印の数が違う、押したのが『+N』、記録のその番目の id が null、のどれかのときは、
			エージェントのタブを開くだけにし、前の選びのままにする（別のエージェントを推測で選ばない）。
			"""
	}
	"F-02": {
		title: "置き場の描きが失敗したときは、記録を残さない"
		text:  "部品の読み込みや描きで例外が出て置き場を空にしたとき（今の `paintOrcaMarks` の catch）は、その置き場の記録も消す（古い並びで別のエージェントを選ばない）。要約が空（key が空）のときの記録は空の並び。"
	}
}

constraints: [
	"書いてよいのは `src/spec_dock/assets/dashboard/`、`tests/`、`src/spec_dock/assets/static-inventory.json`（sha256 が変わるなら）、この Issue の Scope のディレクトリ（統括の依頼書）",
	"orca-web の部品の `onSelect`（印をボタンにする）は使わない。箱の `role=\"button\"` の中にボタンが入れ子になるため（Epic の決定、2026-11-17）。印の要素は今のまま絵（`role=\"img\"`）",
	"色は足さない（デザインシステムの変数だけ）",
	"線の検査（`specdockEdgeAudit`）の違反0を保つ（iss-00627 で0になった）",
	"実機の確かめは、隔離した venv と一時の状態の置き場で別のポートに立て、常駐のダッシュボード（47800）と常駐の orca-web（8791）の設定、道具の環境に触れない。エージェントに何も送らない",
]

decisions: [
	"2026-11-17 本人（Epic の改訂の依頼書 planner-epic-00615-r2.md の決定3・4）：どこの印を押しても、そのエージェントのチャットを開く。作業中の Epic・Initiative の枠にもブランチの印を出す",
	"2026-11-17 本人（統括の連絡 msg_08985a5e64f0・msg_aa9c18d2ef1d の B）：ボードの札にも、構造の図の箱と同じエージェントの専用の行を置く",
	"2026-11-17 タスク担当：記録は置き場の要素への WeakMap にする（Epic の D-09 が Issue に任せた選び）。HTML に id を書き出さないので、置き場の HTML が Scope の ID と max だけで決まる今の契約（iss-00592 D-02）を変えず、描き直しの比べ（`marksKey`）も今のまま",
	"2026-11-17 タスク担当：枠の見出しの worktree の印は、題名（配置の規則で `flex: 1`）の後に置くので、見出しの右の端に寄る。題名が縮み、見出しは1行のまま",
]
