package spec

// 要件（Issue）。型 specdock/v1。書き方は spec-dock/docs/authoring/ のガイドにある。

// 型の版。消さない。
schema: "specdock/v1"

// 保証レベル。正本はここだけ。
assurance: {
	level:  "strict"
	reason: "選びの直しは、違う相手のチャットが開く道を閉じるため。エージェントのタブの選びは、送信できる orca-web のチャットの相手を決める（iss-00593 と同じ考え）。印の数と箱の高さは見た目だけだが、同じ変更に入るので、変更全体を strict で確かめる"
}

purpose: "稼働しているエージェントを、構造の図の箱と枠、ボードの札、横の欄の見出しに1人1つの印ですべて出し（入りきらなければ折り返し、構造の図の箱はその分だけ高くする）、iss-00601 が調べたエージェントのタブの5つの小さな点を直す。"

background: """
	親は epic-00526（ダッシュボードからエージェントを操作する）。印は epic-00471 の iss-00592 が、エージェントのタブは iss-00593 が作った。

	本人の要望（2026-11-16、統括経由）：「複数のエージェントが稼働している場合、1つか2つしか出ていなかった。稼働しているエージェントは四角の中にすべて含めてほしい。3台稼働していれば3つ表示してほしい」。

	統括の決定（依頼書 task_a02f6618c98b、2026-11-16）：

	- 構造の図の箱、ボードの札、横の欄の見出しのどれでも、対応した worktree のエージェントをすべて1人1つの印で出す。「+N」にまとめない。
	- 1行に入りきらないときは、印の行を折り返して2行目以降に並べる。構造の図の箱は、印の行が増えた分だけ箱の高さを伸ばす（`layout.js` の箱の高さを印の行の数に応じて決め、配置と線の計算がその高さを使う。edgeAudit の違反0を保つ）。箱の幅は変えない。
	- 印の並び順は orca-web の部品の順（状態の重さの順）のまま。経過の表記（now・5m・3h・2d）も出す。
	- orca-web の側で同じ構造化のセッションが2回数えられている問題は orca-web の iss-00039 で直す。SpecDock の側で重複を消す処理は足さない（正本は orca-web の要約）。
	- iss-00601 の report.md の5点をすべて直す（本人が了承）。直し方は調べの案を出発点にし、それぞれを再現するテストを足す。

	今の状態（main `16f0cf122` を読んだ事実）：

	- 置き場の上限：構造の図の Issue の箱と木の枠の箱は `orcaSlot(s.id, 2)`、入れ子の枠の見出しは `orcaSlot(s.id, 3)`（`views/graph.js`）、横の欄の見出しとボードの札は `orcaSlot(scope.id, 4)`（`views/_shared/panel.js`、`parts.js`）。`paintOrcaMarks`（`views/_shared/orca_marks.js`）が `data-orca-max` を orca-web の `buildMarks`／`renderAgentMarks` の `max` に渡し、超えた分は先頭の max−1 個と「+N」（`orca-mark--more`）になる。
	- orca-web の部品（orca-web の main `373a2c7` の `web/embed/agent-marks.js`）：`max` が整数でないか1より小さいと4とみなす。`.orca-marks` は `flex-wrap: wrap` と `max-width: 100%` を持ち、小さい印（sm）の高さは 16px、印の間は 2px。
	- 置き場の CSS：`app.css` の `.sd-orca { display: inline-flex; flex: none; margin-left: auto; }`。縮まないので、印が増えると折り返さずに横にはみ出す。
	- 構造の図の配置（`views/graph/layout.js`、iss-00583）：箱は幅 178・高さ 88（`SIZE.boxW`・`boxH`）に、線の口の分（`grow:n:<id>`）を足す。枠の見出しは `SIZE.head`（46）に同じく足す。配置は純粋な計算で、orca-web の要約を知らない。
	- iss-00601 の調べ（report.md）：5点とも、コードの筋道の上で起きる。どれも別の相手を開く・送る道ではない（安全側）が、2点は人が普通にする操作で起きる。
	- orca-web の README の要約の契約：`summary.worktrees[i]` は `{ id, path, branch, project, issue, counts, agents }` で、`agents` は並び（エージェントが1人以上いる worktree だけが要約に入る）。
	"""

includes: [
	"構造の図の箱（入れ子の Issue の箱、木の Issue の箱と木の枠の箱）、入れ子の枠の見出し、ボードの札、横の欄の見出しの印を、上限なしで全員分出すこと",
	"印の置き場が縮み、印が置き場の中で折り返すこと",
	"構造の図の配置が、箱と枠の見出しの印の行の数を受けて高さを決めること、画面が描いた印の行の数を測って配置し直すこと",
	"エージェントのタブの5点の直し（iss-00601 の 1〜5）と、それぞれを再現するテスト",
	"配る文書（reference_cli.md）の、印とエージェントのタブの説明の更新",
]

excludes: [
	"orca-web の側の変更（部品、要約、同じセッションの二重の数え。orca-web の iss-00039）",
	"SpecDock の側で、要約のエージェントの重複を消すこと",
	"箱の幅、印の見た目（色、形、大きさ）、印の並び順を変えること",
	"エージェントのタブの帯（1行の横の動き）の形を変えること",
	"SpecDock のサーバーと API の変更",
]

requirements: {
	"R-01": {
		title: "対応した worktree のエージェントを、どの置き場でも1人1つの印ですべて出す"
		text: """
			構造の図の箱（入れ子の Issue の箱、木の Issue の箱、木の枠の箱）、入れ子の枠の見出し、ボードの札、横の欄の見出しのどれでも、その Scope に対応した worktree（複数なら合わせた分）のエージェントを、1人1つの印で出す。「+N」の印（`orca-mark--more`）にまとめない。
			並び順は orca-web の部品（`buildMarks`）の順のまま、経過の表記（now・5m・3h・2d）も部品のとおりに出す。印の数は要約の `agents` の数そのもので、SpecDock は重複を消さない。
			"""
		acceptance: [
			"3人の worktree に対応した Scope の、構造の図の箱・ボードの札・横の欄の見出しのそれぞれに `.orca-mark` が3つあり、`orca-mark--more` がない",
			"8人の worktree でも、どの置き場も8つで、`orca-mark--more` がない",
			"置き場が部品に渡す `max` が、その worktree のエージェントの数以上（1人以上なら）で、部品の結果に overflow がない",
			"印の並びと経過の表記が、部品の `buildMarks` の返す並びと同じ",
		]
	}
	"R-02": {
		title: "1行に入りきらない印は、置き場の中で折り返して2行目以降に並ぶ"
		text: """
			印の置き場は、置かれた行の残りの幅まで縮み、印は置き場の中で折り返す。置き場が箱・札・欄の見出しの外に横にはみ出さない（印1つが置き場より広いときを除く）。箱・札・欄の幅は変えない。
			構造の図の入れ子の枠の見出しでは、置き場は見出しの幅の半分までにし、題名の残りの幅を保つ。
			"""
		acceptance: [
			"1440・1000・390 の幅で、印が8つある構造の図の箱・ボードの札・横の欄の見出しの印の置き場の右端が、箱・札・見出しの右端を越えない（実機の計測）",
			"印の行が2行以上になる置き場で、2行目以降の印の左端が置き場の左端より左に出ない（実機の計測）",
			"構造の図の箱の幅が 178 のまま（印の数によらない）",
		]
	}
	"R-03": {
		title: "構造の図の箱と枠の見出しは、印の行が増えた分だけ高くなり、配置と線がその高さを使う"
		text: """
			構造の図の配置（`layout.js`）は、Scope ごとの印の行の数を入力に受け、行が2行以上なら、箱（入れ子の Issue の箱、木の箱）の高さと、入れ子の枠の見出しの高さに、(行の数 − 1) × 1行の高さを足す。1行の高さは orca-web の小さい印の高さと行の間（16 + 2 = 18px）。印がないか1行なら、今の高さのまま。
			配置（並べ、折り返し、枠の大きさ）と線の計算（口、通り道、広げ）は、その高さを使う。画面は、描いた印の行の数を測り、前の配置と行の数が違えば、配置し直して描き直す。行の数が同じなら配置し直さない。
			"""
		acceptance: [
			"layout に行の数（ある Issue の箱に3行、ある枠に2行、木の箱に2行）を渡すと、その箱の高さが 88 + 36、枠の見出しの高さ（`headY2 − y1`）が今より 18 高くなり、幅は変わらない",
			"行の数が0か1の Scope しかないときの layout の結果が、行の数を渡さないときと同じ",
			"代表の構造（tests の small・context・packing など）で、いくつもの箱と枠に2〜4行を渡した routeLayout の線の確かめ（audit）の違反が0（入れ子と木、PC と 390 の幅）",
			"実機で、印が2行以上の箱がある構造の図の `specdockEdgeAudit()` の違反が0で、印が箱の下の縁からはみ出さない（はみ出しの数0）",
			"要約が同じ行の数のまま変わっても（経過の表記が変わるだけ）、構造の図を配置し直さない",
		]
	}
	"R-04": {
		title: "詳しい画面で、覚えから開いた今の相手を帯で押しても、チャットの枠を置き直さない（iss-00601 の 1、FQG-003）"
		text: """
			問い合わせや欄の Map に `agent` がなく、同じ Scope で最後に開いた相手（覚えの last）を開いたときは、その相手の id を `agent` として書く（詳しい画面は履歴を増やさない問い合わせの書き換え、欄は欄の Map）。すると、帯の今の相手を押す移りは Scope も agent も変わらない移りになり、`iframe.sd-agent` を外さない。
