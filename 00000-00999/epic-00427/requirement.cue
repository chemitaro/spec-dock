	// E. 詳しい画面
	"R-18": {
		title: "詳しい画面に、見出し、状態の理由、依存、配下、実行の順番、作業中の場所、Artifact、コマンドを示す"
		text: """
			- 見出し：GitHub の題名、ID、種類、状態、親の道筋、GitHub の Issue へのリンク、作成と完了の日、担当者。
			- 状態の理由：止められているときは待っているもの（親から引き継いだ依存はそれと分かるように）、作業中のときは作業中の印と、このPCでの worktree とブランチ、終わったときは閉じた日。
			- 依存：待っているもの（依存しているもの）と、待たれているもの（依存されているもの）。
			- 配下：配下と、その状態と、進み具合。終わったものを隠しているときは、隠した数。
			- 配下の実行の順番：配下を依存の段に分けて示す（段1 → 段2 → …）。子孫どうしの依存も配下どうしの順番に数える。同じ段のものは並べて進められることを示す。その Scope の外への依存は別に示す。
			- 作業中の場所：作業中の Scope の担当者。このPCで、その Scope を選んでいる worktree とブランチがあれば、それも示す（ほかのPCの worktree は分からない）。
			- Artifact：Artifact の一覧。HTML の Artifact は R-05 のとおり開ける。
			- 写せるコマンド：その Scope の状態に合った SpecDock のコマンド。

			（旧 R-E1〜R-E8）
			"""
		acceptance: ["詳しい画面に、上の8つの項目が出る。配下の実行の順番が、見本の依存のとおりの段に分かれる（旧 AC-09）"]
	}
	"R-19": {
		title: "要件・設計・計画を、正本の CUE からその場で描いて示す"
		text:  "CUE の Scope の要件、設計、計画を、正本の CUE から、epic-00425 の描画の入口（K5）でその場で HTML に描いて示す。前もって作ったファイルは使わない。図の部品とデザインシステムは、ダッシュボードのサーバーが配る。人向けの説明の `explanation.html` へのリンクを示す。検査の結果（K3、`scope check`）の誤りと警告も示す。段階2で出す（2026-11-03 の決定）。（旧 R-E9）"
		acceptance: ["CUE の Scope の詳しい画面に、その場で描いた要件、設計、計画と、`explanation.html` へのリンクが出る。インターネットにつながらなくても描ける（旧 AC-18）"]
	}

	// F. 片付けの候補
	"R-20": {
		title: "片付けの候補を一覧にする"
		text:  "配下がすべて終わったのに開いている Epic と Initiative、閉じたのに開いた配下がある親、を一覧にする。見るだけで、直すことはしない（直すコマンドは写せる）。（旧 R-F1）"
		acceptance: ["見本で、片付けの候補の2つの種類が挙がる（旧 AC-12。spec-dock の 2026-10-25 時点の構造では14件だったが、今の構造の件数は実装のときに確かめる）"]
	}

	// G. 統合ダッシュボードとエージェントへの情報
	"R-21": {
		title: "リポジトリの要約を、版を持つ JSON として CLI とサーバーの両方から出す"
		text:  "要約に含めるもの：契約の版、リポジトリ、構造を取得した時刻。種類ごと・状態ごとの数と、終わった割合。作業中、着手できる、止められている、片付けの候補の一覧（ID、番号、題名、状態、理由）。構造の異常の数。各 Scope の詳しい画面へのパス（`/r/<host>/<owner>/<name>/scopes/<ID>`）。CLI（`spec-dock dashboard summary`）は、サーバーが動いていなくても、隠したリポジトリでも動き、GitHub に問い合わせない。主な使い手はエージェントと、統合ダッシュボードの数の札で、統合ダッシュボードが画面を作り直すためのものではない。（旧 R-G1、R-G2）"
		acceptance: ["要約の JSON を CLI とサーバーの両方から読め、内容が同じで、契約の版を持つ。CLI は、サーバーが動いていなくても動き、GitHub に要求を送らない（旧 AC-13）"]
	}
	"R-22": {
		title: "ほかのダッシュボード（company-os）が、SpecDock の画面を作り直さずに埋め込める"
		text: """
			- 在りか：サーバーは、ユーザーごとの状態の置き場に1つの在りかの記録（手元の URL、Tailscale の URL、版、起動の時刻）を書き、止まるときに消す。統合ダッシュボードは、これを読んで基点を知る。
			- 埋め込みの表示：どの画面の URL にも `?embed=1` を付けると、SpecDock 自身の題名とリポジトリの切り替えを消した表示になり、iframe（起点の違う枠）に入れて使える。画面のタブと検索は残す。
			- つなぎの約束：埋め込みの表示は、版を持つ postMessage で親の画面とやり取りする（SpecDock から親へ：準備ができた、画面を移った（道筋と題名と Scope）。親から SpecDock へ：この道筋へ移って、明るい・暗い表示）。双方とも、相手の起点を確かめる。高さは親が決め、高さの知らせは作らない。
			- 横断の概況：表示している全リポジトリの概況（各リポジトリの状態ごとの数、作業中、止められているもの、片付けの候補）を、SpecDock が画面として配る（`/`。埋め込みもできる）。統合ダッシュボードは、JSON から画面を作り直さずに、これを埋め込める。
			- 逃げ道：iframe が使えない場面のために、どの画面も普通のリンク（新しいタブ）で開ける。

			（旧 R-G3。2026-11-03 の決定で、埋め込みを主にした）
			"""
		acceptance: [
			"在りかの記録から得た基点と `/r/<host>/<owner>/<name>/scopes/<ID>?embed=1` を、試しの親の画面（別の番号の起点）の iframe に入れると、SpecDock の題名のない画面が出て、画面の移動が postMessage で親に届き、親からの移動の指示で画面が移る（旧 AC-14）",
			"許していない起点からの postMessage を無視する",
		]
	}

	// H. 今の Markdown と PlantUML のダッシュボード
	"R-23": {
		title: "今の Markdown と PlantUML のダッシュボードの生成をやめる"
		text:  "HTML のダッシュボードを出した後の版では、定期の同期は、`spec-dock/dashboard.md` と4つの PlantUML のファイル（`tree.puml`、`tree-all.puml`、`deps-issues.puml`、`deps-raw.puml`）を作らない。それを作るコードを撤去する。エージェントは、代わりに R-21 の要約を読む。（旧 R-H1）"
		acceptance: ["HTML のダッシュボードを出した後の版で、定期の同期が5つのファイルを作らず、その生成のコードが残っていない（旧 AC-16）"]
	}

	// 横断
	"R-24": {
		title: "インターネットにつながらなくても開ける"
		text:  "画面の部品（図の配置の計算、デザインシステム、図の部品など）は、ダッシュボードのサーバーが配り、インターネットの CDN に頼らない。インターネットにつながらないときは、GitHub へのリンクだけが開けない。（旧 AC-17、エージェントの判断）"
		acceptance: ["インターネットにつながらない PC でも、ダッシュボードの画面が開ける（旧 AC-17）"]
	}
	"R-25": {
		title: "Markdown の文書（Markdown の Scope の要件・設計・計画、報告、ADR）を、画面の中で読めるように描く"
		text:  "Markdown の Scope の `requirement.md`、`design.md`、`plan.md` と、どの Scope の `report.md` と ADR も、デザインシステムの薄い HTML に包んで、詳しい画面の中で読めるように描く。前もって作ったファイルは使わない。段階2で出す。（2026-11-03 の決定。2026-10-26 の「Markdown を描くことはしない」を改めた）"
		acceptance: ["Markdown の Scope の詳しい画面で要件・設計・計画が、どの Scope でも報告と ADR が、画面の中で読める。インターネットにつながらなくても描ける"]
	}
	"R-26": {
		title: "CUE の Scope の計画の進み具合を示す"
		text:  "CUE の Issue の `plan.cue` の手順の `status`（todo、doing、done、dropped）を数え、詳しい画面に、計画の進み具合（終わった手順の数と全体の数、作業中の手順）を帯と数で示す。`dropped` は全体から除く。構造の図とボードの補足の1行にも、作業中の Issue の手順の進み具合を示せる。段階2で出す。（2026-11-03 の決定）"
		acceptance: ["見本の `plan.cue`（todo、doing、done、dropped を含む）で、詳しい画面の計画の進み具合の数が正しく出る"]
	}
	"R-27": {
		title: "リポジトリの表示を、止めたり戻したりできる"
		text:  "`spec-dock dashboard hide <リポジトリ>` で、そのリポジトリを表示から外し、`spec-dock dashboard show <リポジトリ>` で戻す。チェックアウトの中では、リポジトリを省ける。隠したリポジトリは、一覧、横断の概況、Tailscale での見せる範囲に出ず、直接の URL には、データを含まない案内（戻すコマンド）だけを返す。印は利用者ごとの状態の置き場に置き、リポジトリ、カタログ、登録簿には置かない。隠しても同期は止まらない。`spec-dock dashboard list` で、各リポジトリが表示中か隠しているかを示す。（2026-11-03 の決定。同期の停止を表す `canonical resume` と区別するため、pause の語を使わない）"
		acceptance: [
			"`dashboard hide` の後、そのリポジトリが一覧と横断の概況から消え、直接の URL が戻すコマンドの案内だけを返し、同期は続く。`dashboard show` で戻る",
		]
	}
	"R-28": {
		title: "ダッシュボードの常駐を、明示して入れたり外したりできる"
		text:  "`spec-dock dashboard service install` で、ログインのときにサーバーを起動する常駐（macOS は launchd、Linux は systemd のユーザーの単位）を入れる。`dashboard service status` で入っているかと動いているかを示し、`dashboard service uninstall` で何も残さず外す。同期の常駐とは別のものにし、ダッシュボードの不具合が同期に及ばない。SpecDock のパッケージを更新したら、常駐は古い版のまま動き続けず、新しい版で起動し直す。Tailscale の住所が起動のときに得られなくても、手元の待ち受けで先に始め、得られたら足す。（2026-11-03 の決定、言い直した約束3）"
		acceptance: [
			"`dashboard service install` の後、ログインし直すとサーバーが動き、`status` が動いていることを示し、`uninstall` の後は常駐の設定のファイルが残らない",
			"パッケージを更新すると、常駐のサーバーが新しい版で動く",
		]
	}
	"R-29": {
		title: "Tailscale の住所でも、コマンドを写せる"
		text:  "`http://<Tailscale の IP>` はブラウザーの安全な文脈ではなく、クリップボードの API が使えない。写すボタンは、使える手段で写し、写せないときは、選んで手で写せるコマンドの文字を示す。（2026-11-03 の分析）"
		acceptance: ["iPhone の Safari で Tailscale の住所から開いたとき、写すボタンで写せるか、手で選べるコマンドの文字が出る"]
	}
}

