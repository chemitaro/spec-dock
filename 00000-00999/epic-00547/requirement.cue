package spec

// 要件（Epic）。型 specdock/v1。書き方は spec-dock/docs/authoring/ のガイドにある。
// 文章の項目には Markdown を書いてよい。型にない項目は、必要に応じて足してよい。

// 型の版。消さない。
schema: "specdock/v1"

// 保証レベル（light、standard、strict、critical）と、その理由。
// 失敗したときの影響と回復の難しさで選ぶ（工数や作業の難しさでは選ばない）。
// 具体化や作業の途中で、上げても下げてもよい。正本はここだけで、ほかの場所に写さない。
assurance: {
	level:  "standard"
	reason: "カタログに新しい記録の形と CLI を足し、ダッシュボードに画面を足す。全リポジトリの利用者に配られるので、契約の誤りは移行で直す必要がある"
}

purpose: "エージェントが人に頼むタスクと、人が自分で登録するタスク（人のタスク）を、各リポジトリの SpecDock のカタログに唯一の正本として置き、SpecDock の CLI で登録・一覧・完了できるようにし、全リポジトリを集約して見せる。人のタスクが Scope（Initiative、Epic、Issue）の進み具合を止めていることを、ダッシュボードの構造の図・ボード・詳しい画面に示す。"

background: """
	### 解く問題

	- 人への依頼が会話のログ、Orca の端末、Company OS の受付簿（`content/office/intake.md`）に散らばり、まとまって見えない。受付簿の未回答の問いは11〜13日開いたままになり、2026-10-23 には担当の3分の2が本人待ちで止まっていた（`.workbench/analysis-human-task-storage-20261104.md` の 2章）。
	- worktree に分かれて並行で作業すると、リポジトリの中の台帳（ファイル）は worktree ごとに分かれ、統合されない。カタログ（canonical branch）は、どの worktree からも同じ場所に見え、定期の同期が保存と push をする（epic-00424）。
	- 1回の返事で複数の項目を人に出し、会話で1つずつ片付けると、残りがログに流れて失われる。

	### 材料

	- 分析：`.workbench/analysis-human-task-storage-20261104.md`（過去の依頼の分類、保存先の比較）、`.workbench/proposal-round3-20261104.md`（サブタスク、上限、形式、ID）。
	- 利用者の決定の経緯：`.workbench/README.md`（2026-11-04 の4回の聞き取り）。
	- 関係する Epic：epic-00427（ダッシュボードの第1段階）、epic-00471（Orca の稼働の表示）、epic-00526（Orca とのチャット）。

	### 関係者

	- **利用者（人）**：人のタスクを片付け、自分のタスクも登録する。PC とスマートフォンで見る。
	- **エージェント**（Claude Code、Codex、Orca の作業者と統括）：会話で終わらない依頼を登録し、答えを受けたら閉じる。
	- **外部の道具**（個人のタスク管理、Company OS の nestboard）：CLI の一覧の JSON を読む。
	"""

includes: [
	"人のタスクの記録の形（JSON のデータと型の定義）と、各リポジトリのカタログへの保存",
	"`spec-dock todo` の CLI（登録、一覧、詳しく、更新、完了、延期、取り消し、開き直し、検査）と、全リポジトリの集約の一覧",
	"サブタスク（1段）、期限、件数の警告、リポジトリごとの設定のファイル",
	"Scope との結び付き（関係する Scope、止めている Scope）と、`dashboard summary` の数",
	"ダッシュボードの人のタスクの画面と、構造の図・ボード・詳しい画面・横断の概況への表示（見るだけ。epic-00427 に依存）",
	"配布するスキル（`.agents/skills/spec-dock/`）に、エージェントが人のタスクを登録・完了する規則を書く",
	"spec-dock での dogfooding",
]
excludes: [
	"個人の用事のタスク管理（SpecDock の中に作らない。外部の道具が CLI の一覧の JSON を読む）",
	"GitHub Issue・GitHub Projects への保存や写し合い",
	"PR のマージ待ちをタスクとして記録すること（ダッシュボードの既存の表示を使う。エージェントが意図して登録するのは妨げない）",
	"画面からの書き込み（登録、完了、延期）。v1 は見るだけ（epic-00427 の R-04）。必要になったら別に判断する",
	"人のタスクで Scope の状態や `work start` を変えること（印だけを示す）",
	"知らせ（Telegram など）、繰り返し、カレンダーへの書き込み、ほかの人への割り当て",
	"Company OS の受付簿の移し替えそのもの（しばらく使って良ければ、Company OS の側で移す）",
]

requirements: {
	"R-01": {
		title: "人のタスクの正本は、各リポジトリのカタログに1件1つのファイルで置かれる"
		text:  "置き場はカタログの `todos/` の下（例 `todos/<作成の年月>/<ID>.json`）。閉じても動かさない（動かすと削除になり、同期の保留に触れる）。どの worktree からも `spec-dock/initiatives/todos/` で見え、定期の同期が保存と push をする。GitHub には書かない。"
		acceptance: [
			"`todo add` で登録したタスクが、同じリポジトリの別の worktree から `todo list` で見える",
			"`todo add`、`done` が GitHub に要求を送らない（テストの `gh` の stub が呼ばれない）",
			"閉じたタスクのファイルが、同じ場所に残る",
		]
	}
	"R-02": {
		title: "データは JSON で、型の定義を CUE でも持ち、2段で検査する"
		text:  "CLI は書く前に Python の型で確かめ、正しい形だけを書く。提供側に CUE の型の定義（`#Todo`）を置き、`todo check` が `cue vet` で全ファイルを一度に確かめる。`cue` がない PC では Python の検査だけで済ませる。2つの型が食い違わないよう、同じ見本で両方を確かめる。"
		acceptance: [
			"形の正しくないファイルを、`todo check` が理由つきで示す",
			"`cue` がないときも、`todo check` が Python の検査で動く",
			"見本のデータで、Python の検査と `cue vet` の結果が一致するテストがある",
		]
	}
	"R-03": {
		title: "タスクは、ID、題名、種類、状態、期限、依頼者、Scope との結び付きを持つ"
		text:  """
			- ID は `t-` と4文字（Crockford の base32 の小文字）。そのリポジトリの中で重ならない。横断では `<リポジトリ>/t-xxxx`。
			- 種類：`decide`（判断・承認）、`check`（実機・目での確かめ）、`operate`（人しかできない操作）、`act`（物理・外部の行為）、`todo`（人が自分で登録したもの）、`checklist`（会話で終わらない複数の項目の束。R-05）。
			- 状態：`open`、`snoozed`、`done`、`cancelled`。
			- 依頼者（エージェントの役割か人）、経緯（いつ、誰が、何をしたか）、閉じたときの答えと、原文の記録へのリンク。
			- エージェントが登録するものは、背景と問い、答える場所（`reply_to`）、所要時間の見込みを必須にし（`decide` は選択肢と推奨も）、欠けたら断る。人が登録するものは題名だけで登録できる。
			- 秘密の値は書かない（操作のコマンドは書いてよい）。
			"""
		acceptance: [
			"エージェントとして必須の欄を欠いた `todo add` が、欠けた欄の名前を示して何も書かずに止まる",
			"人として題名だけで `todo add` ができる",
			"`todo done` が答えと経緯を記録に残す",
		]
	}
	"R-04": {
		title: "タスクは1段のサブタスクを持てる"
		text:  "サブタスクは親のファイルの中に置き、ID は親に `.1`、`.2` を付ける（例 `t-7k3m.2`）。孫は作らない。親の状態はサブタスクから自動で決めず、全部が閉じたら CLI が「親を閉じてよい」と示す。"
		acceptance: [
			"サブタスクを足し、1つずつ閉じられる",
			"全部のサブタスクが閉じたとき、`todo show` が親を閉じてよいことを示す",
		]
	}
	"R-05": {
		title: "1回の会話で終わらない複数の項目を、1つの束として登録できる"
		text:  "エージェントが人に2つ以上の項目を出し、その会話の中で全部の答えが返らないときは、あらかじめ親（種類 `checklist`）とサブタスクとして登録する。答えを受けるたびにサブタスクを閉じ、返事の終わりに残りを示す。1回の会話で終わる複数の問い（Claude Code や Codex の複数の質問）は登録しない。"
		acceptance: [
			"配布するスキルにこの規則がある",
			"`todo show <親>` が、残りのサブタスクの一覧を示す",
		]
	}
	"R-06": {
		title: "期限を持ち、指定しなければ既定の期限が付く"
		text:  "期限（日時）を指定でき、指定しなければ、登録から既定の時間（初めの値は4時間。設定で変える）の後になる。期限を過ぎた開いたタスクを、`todo list` と画面で目立たせる。延期（`snooze`）は、指定の日時まで一覧から隠す。"
		acceptance: [
			"期限を指定しない `todo add` に、登録の4時間後の期限が付く",
			"期限を過ぎたタスクが、`todo list --json` で期限切れと示される",
		]
	}
	"R-07": {
		title: "件数の目安を超えると警告するが、登録はできる"
		text:  "リポジトリごとに、開いている親のタスク（エージェントが登録し、`checklist` でないもの）が目安（初めの値は20件）を超えたら警告する。1つの親のサブタスクが目安（初めの値は30件）を超えたら警告する。人が登録したものと、サブタスクは、リポジトリの件数に数えない。どの場合も登録は止めない。"
		acceptance: [
			"目安を超える `todo add` が、警告を出して登録に成功する",
		]
	}
	"R-08": {
		title: "目安の件数と既定の期限を、リポジトリごとの設定のファイルで変えられる"
		text:  "設定のファイルはカタログに置く（例 `todos/settings.json`）。そのリポジトリの全 worktree と PC で共通。ファイルがなければ初めの値を使う。形の正しくない設定は、警告して初めの値を使う。"
		acceptance: [
			"設定のファイルで目安を変えると、警告の境目が変わる",
			"設定のファイルが壊れていても、`todo` のコマンドが初めの値で動き、警告を出す",
		]
	}
	"R-09": {
		title: "タスクに、関係する Scope と、止めている Scope を結び付けられる"
		text:  "関係する Scope（Initiative、Epic、Issue）と、このタスクが終わるまで進められない Scope（止めている Scope）を ID で持つ。Scope がなければリポジトリに付く。止めていることは印として示すだけで、Scope の状態と `work start` の判定は変えない。"
		acceptance: [
			"`todo list --scope <ID>` が、その Scope に結び付くタスクを返す",
			"人のタスクが開いていても、`dependency check` と `work start` の結果が変わらない",
		]
	}
	"R-10": {
		title: "全リポジトリの人のタスクを、CLI で集約して一覧にできる"
		text:  "`todo list --all-repositories` は、このPCの登録簿にある全リポジトリのカタログを読み、まとめて返す。サーバーが動いていなくても動く。出力の JSON は版つきの契約（例 `specdock.todo-list/v1`）にし、外部の道具が読めるようにする。読めないリポジトリは、理由つきで示し、ほかを返す。"
		acceptance: [
			"2つのリポジトリのタスクが、1回の `todo list --all-repositories --json` に、リポジトリの名前つきで並ぶ",
			"1つのリポジトリのカタログが読めないとき、ほかのリポジトリの分を返し、読めないことを示す",
		]
	}
	"R-11": {
		title: "`dashboard summary` に、人のタスクの数が出る"
		text:  "開いている数、止めている数、期限切れの数を、リポジトリごとに足す。"
		acceptance: ["`dashboard summary --json` に、人のタスクの数がある"]
	}
	"R-12": {
		title: "ダッシュボードに、人のタスクの画面がある（見るだけ）"
		text:  "全リポジトリをまとめた表示、リポジトリごとの表示、1件の詳しい表示を持つ。並びは期限切れ、期限の近いもの、止めているもの、あとで。リポジトリやタグで絞れる。全リポジトリの表示は、横断の概況と同じく R-03（1画面に1リポジトリ）の例外とする。"
		acceptance: [
			"全リポジトリの表示に、2つのリポジトリのタスクが並ぶ",
			"期限切れのタスクが、先頭に目立つ印で並ぶ",
		]
	}
	"R-13": {
		title: "構造の図とボードの各 Scope に、人が止めていることが簡潔に出て、詳しい画面で中身が出る"
		text:  "構造の図の箱とボードのカードに、止めている人のタスクがあるか、何件か、を印で出す。Scope の詳しい画面に、人のタスクのタブ（止めているものと関係するもの）を出す。横断の概況の札に、開いている数と期限切れの数を出す。"
		acceptance: [
			"止めている人のタスクのある Issue の箱に、件数の印が出る",
			"その Issue の詳しい画面に、止めているタスクの題名と期限が出る",
		]
	}
	"R-14": {
		title: "エージェントの規則を、配布するスキルに書く"
		text:  "会話で答えが返るものは登録しない。答えを待ったままターンを終えるとき、人しかできない操作をすぐにしてもらえないとき、数日かかる確かめ、期限のある行為は登録してから、止まらない作業を続ける。答えを受けた担当が閉じ、原文の記録へのリンクを残す。統括は、始めるときに開いているタスクを読み、答えが出たのに閉じていないものを閉じる。"
		acceptance: ["`.agents/skills/spec-dock/SKILL.md`（提供側）に、この規則がある"]
	}
}

failures: {
	"F-01": {
		title: "書く前の検査に通らないときは、何も書かずに止まる"
	}
	"F-02": {
		title: "同じタスクを別の PC で同時に変えたときは、既存の `*.conflict-*` の扱いに乗る"
	}
	"F-03": {
		title: "カタログのリンクがない、または読めないリポジトリでは、`todo` のコマンドは理由と次の1手（`canonical link`）を示して止まる"
	}
}

constraints: [
	"epic-00424 の構造（Scope＝GitHub Issue の3階層）とカタログの形を変えない",
	"epic-00427 の R-04（画面は見るだけ）を保つ",
	"状態の判定の関数（`evaluate_readiness`）を変えない",
]

decisions: [
	"2026-11-04：保存先は各リポジトリのカタログ。GitHub Issue（1件ずつ、受付簿の1件、Projects）は正本にしない（分析の3章）",
	"2026-11-04：PR のマージ待ちはタスクにしない。ダッシュボードの既存の表示を使う",
	"2026-11-04：画面は見るだけ。人が介入しなくてよいものは介入させない",
	"2026-11-04：記録するのは、1回の会話で終わらないものだけ",
	"2026-11-04：ID の形は統括に任された（`t-` と4文字）。コマンドの名前は `todo` を暫定とし、設計で柔軟に変えてよい",
	"2026-11-04：データは JSON、型の定義は CUE でも持つ",
	"2026-11-04：Company OS の受付簿は、しばらく使って良ければ移す（期間は決めない）",
	"2026-11-04：件数の目安は親20件、サブタスク30件で、警告だけで登録は止めない。数はリポジトリごとの設定のファイル（カタログ）で変えられる",
	"2026-11-04：古さの警告（14日）はやめ、期限で目立たせる。既定の期限は4時間",
	"2026-11-04：範囲は各リポジトリに閉じ、SpecDock 全体で集約する。個人のタスク管理との統合は、CLI の一覧の JSON を外部の道具が読む形にする",
	"2026-11-04：人のタスクが Scope を止めるときは印だけ。Scope の状態と `work start` は変えない",
	"2026-11-04：進め方は並行でよい。画面を作る Issue は epic-00427 に依存させる",
]

