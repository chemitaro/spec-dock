package spec

// 要件（Issue）。型 specdock/v1。書き方は spec-dock/docs/authoring/ のガイドにある。
// 親は epic-00427。plan.cue の slice `iss-00556`（covers: R-15、R-31）を、この Issue の番号に書き直した。
// Epic の番号は「Epic R-15」のように書く。この Issue の番号は R-01 などである。

// 型の版。消さない。
schema: "specdock/v1"

// 保証レベル（light、standard、strict、critical）と、その理由。
// 失敗したときの影響と回復の難しさで選ぶ（工数や作業の難しさでは選ばない）。
// 具体化や作業の途中で、上げても下げてもよい。正本はここだけで、ほかの場所に写さない。
assurance: {
	level:  "standard"
	reason: "構造の図の既定の表示と並び順を変える。見せる範囲の誤りは版を戻せば直るが、利用者が毎日見る画面の主な振る舞いを変える"
}

purpose: "構造の図（ホーム）を、開いたときに「全体の計画がここまで進んでいる」と分かる形にする。進行中の枠の中の終わった Scope と、その依存の矢印を残し、もう見る必要のないものは消し、番号順でなく最も活動している順に並べる。"

background: """
	- 2026-11-04、利用者が 0.6.0 の画面を見て決めた：「進行中の Epic の中の完了した Issue は表示を残し、矢印の関係も残してほしい。全体の計画がここまで進んでいると分かるように。ただ、もう人が見る必要のないゴミは消えてほしい。番号順ではなく、最もアクティブな順に表示したい。」
	- 今の構造の図（#532、#544）は、既定で終わったものを隠し（開いた子孫を持つ閉じた親だけ残す。Epic R-12）、依存の線は「待っているものだけ」、同じ段の中は推奨順（`rank`）、最上位は Initiative を先に推奨順で並べる。終わった Issue が消えるので、進行中の Epic の進み具合が図から読めない。
	- 画面は、見せ方の選択（`mode`、`showDone`、`deps`、`fold`）をブラウザーの `localStorage` の `specdock.graph.v1` に残す。既定を変えても、前に保存した値が新しい既定を打ち消す。
	- 構造の API の各 Scope は `created_at` と `closed_at` を持つが、着手（ラベルの付け外し）や PR の変化を含む「最後に動いた時刻」を持たない。
	- Epic R-15・R-31 の文言（既定は終わったものを隠す、線は待っているものだけ、同じ段は推奨順）は、統括が 2026-11-04 に、この slice に合わせて直す（統括の返事。Epic の文書はこの Issue では変えない）。
	"""

includes: [
	"構造の図の可視の判定（入れ子と木の両方）：親が開いていれば終わった Scope も出す",
	"依存の線の既定を「すべての線」にし、終わった依存を薄く出す",
	"枠と箱の並びを活動順にする（依存の左右の段は今のまま）",
	"構造の API の各 Scope に、最後に動いた時刻 `active_at` を足す",
	"見せ方の保存の版を上げ、前の版の `showDone`・`deps` を引き継がない",
	"ボードの「終わった」の列が最近終わった順であることを確かめる",
	"PC のヘッドレスの Chrome で、このPCの spec-dock の実際のスナップショットを使い、PC の幅と 390px の写しを残す",
]
excludes: [
	"Epic の requirement.cue・design.cue の文言の修正（統括が行う）",
	"ボードの列の並び（終わった列のほか）、詳しい画面、時間の軸、横断の概況",
	"モデル（`domain/dashboard_model.py`）の状態、推奨順、片付けの候補の判定",
	"配布資産の文書、`static-inventory.json`、版の番号と `migration.md`",
	"iPhone の Safari での確かめ（統括が利用者に頼む）",
]

requirements: {
	"R-01": {
		title: "既定の表示で、親が開いていれば終わった Scope も出し、親も終わったものは出さない"
		text: """
			「終わったものも」を切った既定の表示（入れ子と木）で、次のとおりに出す。
			- 開いた Scope は今までどおり出す。開いた子孫を持つ閉じた親も今までどおり残す（Epic R-12）。
			- 終わった Scope は、親が開いていれば出す（進行中の Epic の終わった Issue、開いた Initiative の終わった Epic）。
			- 終わった Epic の中（孫）は出さない。終わった Epic は中身のない畳んだ枠になり、配下の進み具合（完了 n/n）を示す。
			- 親も終わった Scope、親のない終わった Scope は出さない。
			- 範囲を1つの Scope に絞ったときは、その Scope の子を、その Scope が終わっていても出す（中を見るために絞るため）。
			- 「終わったものも」を入れると、今までどおりすべてを出す。片付けの候補を畳む振る舞いは変えない。
			"""
		acceptance: [
			"見本で、開いた Epic の終わった Issue と、開いた Initiative の終わった Epic（畳んだ枠）が出て、終わった Epic の終わった Issue と、親のない終わった Epic が出ない（入れ子と木）",
			"開いた子孫を持つ閉じた親は今までどおり枠で残り、片付けの候補は今までどおり畳まれる",
			"終わった Epic に絞ると、その子が出る",
		]
	}
	"R-02": {
		title: "既定で、図に出ている箱どうしの終わった依存の矢印も薄く出す"
		text: """
			依存の線の既定を「すべての線」にする。図に出ている箱、枠、畳んだまとまりどうしの依存は、終わった依存も、今の終わった依存の線（薄い線）で描く。待っている依存は、今のとおり目立つ線で描く。依存の線の3つの切り替え（すべて、待っているものだけ、なし）は残す。図に出ていない Scope への依存は描かない。線の検査（`edgeAudit`）の違反0を保つ。
			"""
		acceptance: [
			"見本の既定の表示で、出ている終わった Issue から開いた Issue への依存が、終わった線（`done: true`）として描かれる",
			"「待っている線」を選ぶと、終わった依存の線が消える（今までどおり）",
			"線の検査のテストの代表のデータ（spec-dock、種 532・15・18）のすべての表し方で問題が0件。このPCの spec-dock の実際のスナップショットの既定の表示でも `edgeAudit` の違反が0件",
		]
	}
	"R-03": {
		title: "枠と箱を、番号順でなく活動順に並べる"
		text: """
			- 枠（Initiative、Epic、子を持つ Scope）は、配下の状態（子がなければ自分の状態）で4つの組に分け、組の順に並べる：作業中を含む → 着手できるを含む → 止められているだけ（ほかに開いたものはない） → 終わったものだけ。同じ組の中は、自分と配下の最後に動いた時刻（R-04 の `active_at` の最大）の新しい順。
			- 枠の中の箱は、開いているものを推奨順（Epic R-31）で上に、終わったものを下に、最近終わった順に並べる。
			- 同じ並びの中に枠と箱があるときは、開いた枠、開いた箱、終わったもの（枠と箱を最近の順）の順にする。
			- 依存の左右の段（作業の順番）の考え方は今のままで、上の並びは同じ段の中の上下の順に効く。終わった子を出す枠（「終わったものも」を入れたとき、親が開いているとき、絞った Scope）の中では、「終わったものも」と同じく、終わったものを含めた段（モデルの `stage.all`）で左右に並べる。こうして、出ている終わった依存の矢印も左から右へ向く（Epic R-15）。終わった子を出さない枠（開いた子孫を持つ閉じた親）の中は、今までどおり開いたものだけの段（`stage.open`）。最上位の枠も同じ規則で並べる。
			- 同じ時刻なら番号の小さい順。
			"""
		acceptance: [
			"見本の最上位で、作業中を含む枠、着手できるを含む枠、止められているだけの枠、終わったものだけの枠の順に並び、同じ組では最近動いた枠が上に来る",
			"見本の Epic の同じ段で、開いた箱が推奨順で上に、終わった箱がその下に最近終わった順で並ぶ",
			"依存の前のものが左、後のものが右に並ぶ。見本の既定の表示で、終わった Issue とそれを待つ開いた Issue が、終わった Issue を左の段にして並ぶ",
		]
	}
	"R-04": {
		title: "構造の API の各 Scope が、最後に動いた時刻 `active_at` を持つ"
		text: "`active_at` は、その Scope の作成、GitHub の Issue の最後の更新（着手のラベルの付け外しを含む）、完了、選ばれた PR の作成・マージ・閉じの時刻のうち、最も新しいもの（ISO 8601 の文字列）。詳しい画面の `scope` にも同じ項目が入る。既存の項目は変えない。"
		acceptance: [
			"作成だけの Scope は `created_at`、完了した Scope は完了の時刻、PR のマージが最も新しい Scope はマージの時刻、Issue の更新が最も新しい Scope は更新の時刻が `active_at` になる",
		]
	}
	"R-05": {
		title: "前に保存した見せ方が、新しい既定を打ち消さない"
		text: "見せ方の保存の版を上げる。前の版（`specdock.graph.v1`）からは、表し方（入れ子・木）、片付けの候補を畳むか、凡例を開くかだけを引き継ぎ、「終わったものも」と依存の線は新しい既定にする。新しい版に保存した後は、利用者の選んだ値を守る。"
		acceptance: [
			"前の版に `showDone: true`、`deps: \"wait\"`、`mode: \"tree\"` を保存した状態で開くと、木で、終わったものを隠し、すべての線で描く",
			"新しい版に `deps: \"wait\"` を保存した状態で開くと、待っている線で描く",
		]
	}
	"R-06": {
		title: "ボードの「終わった」の列が、最近終わった順に並ぶ"
		text: "ボードの「終わった」の列（「終わったものも」を入れたとき）を、完了の時刻の新しい順、同じなら番号の大きい順に並べる。"
		acceptance: ["見本で、「終わった」の列の先頭に最も新しく終わった Scope が来る"]
	}
}

failures: {
	"F-01": {
		title: "時刻が欠けている、読めないときも、並びと API は止まらない"
		text: "`active_at` の候補のうち、欠けているか読めない時刻は使わない（`created_at` は常にある）。画面は、`active_at` がない Scope を最も古いものとして並べる。"
	}
	"F-02": {
		title: "保存した見せ方が読めない、書けないときは、既定で描く"
		text: "`localStorage` が使えない（私的な窓、拒否）、値が壊れている、型が違うときは、その項目を既定にして描き、例外を出さない。"
	}
}

constraints: [
	"編集してよい範囲：`src/spec_dock/assets/dashboard/views/graph*`、`views/board.js`（終わった列の並びだけ）、`presentation/dashboard_api.py`（項目の追加だけ）、`tests/`、この Scope のディレクトリ",
	"構造の API の形（`specdock.dashboard/v1`）は画面のためで、公開の契約ではない（#529 の決定）。項目を足すだけで、既存の項目の意味は変えない",
	"モデルの状態、推奨順、段、片付けの候補の判定は変えない（画面は並べるだけ）",
	"手元の私的なリポジトリの構造はテストに入れない",
]

decisions: [
	"見せ方の保存は、キーを `specdock.graph.v2` に変え、v1 からは `mode`・`fold`・`legend` だけを引き継ぐ（統括が了承。2026-11-04）",
	"`active_at` はモデルを変えずに API（presentation）で計算する（統括が了承。2026-11-04）",
	"枠の組の判定では、マージ待ちは作業中に入る（モデルの状態が作業中のため）。不明は「止められているだけ」の組に入れる（開いているが進められない）",
	"同じ並びに枠と箱が混ざるとき、開いた枠を開いた箱より先にする（slice は枠どうし、箱どうしの順だけを決めている。実際の構造では混ざることは少ない）",
	"最上位の「Initiative を先に」の規則はやめ、Initiative と最上位の Epic を同じ活動順で並べる（利用者の「最もアクティブな順」に従う）",
	"ボードの「終わった」の列は、#531 の実装がすでに完了の時刻の新しい順なので、コードは変えず、テストで確かめる",
]
