package spec

// 要件（Issue）。型 specdock/v1。

schema: "specdock/v1"

assurance: {
	level:  "standard"
	reason: "表示を足すだけで、エージェントへの操作やデータの書き込みはなく、PR を戻せば元に戻る"
}

purpose: """
	『横断の構造』（`/graph`）に、Orca の指揮の関係（親のエージェント → 子のエージェント）を、リポジトリの構造の図（iss-00616）と同じ線・弧・波紋・帯で出す。
	線は、リポジトリの枠をまたいで、印から印へ引く。帯は、各リポジトリの枠の見出しのすぐ下と、全体のいちばん上の『ほかの場所』に置く。
	あわせて、両方の画面で、指揮の線が枠の見出しの文字の上を通らないようにする（統括の決定）。Epic epic-00615 の slice `iss-00617`（R-10、R-11）。
	"""

background: """
	正本は Epic epic-00615 の requirement.cue（R-10、R-11、R-01〜R-09、F-01〜F-05）と design.cue（D-06、D-07、D-10）、本人の決定（`planner-epic-00615.md`・`planner-epic-00615-r2.md`）、
	iss-00616（PR #642、マージ済み）の仕様と report.md。iss-00614・iss-00629・iss-00632 が『横断の構造』の配置（`allgraph/compose.js`）と知らせを、iss-00635 が tier のないことを決めた。

	タスク担当が確かめた今の事実（2026-11-17、`0ef2dfeae`）：
	- `views/allgraph.js` は、各リポジトリの構造を読み、各リポジトリの配置（`routeLayout`、nest）を、`compose`（`allgraph/compose.js`）が置いたリポジトリの枠（`section.ax-repo`）の中の `.ax-body` に描く。
	  `compose` は `options.bands`（key → 帯の高さ）をすでに持ち、見出し・知らせの行の下に帯の高さを足せるが、今は `{}` で呼ばれる。
	- リポジトリの枠（`.ax-repo`）と `.ax-body` は z-index を持たず、重なりの文脈を作らない。中の枠（`.gx-frame`）は z-index 1、箱 2、依存の線 5。
	- 稼働の印は、リポジトリごとに `paintOrcaMarks(body, …)` で描かれ、印の幅はリポジトリごとの `r.marks` に測られる。印を押すと、そのリポジトリの Scope を選び、`A.pn.openAgent(markAgentAt(slot, target))`（iss-00621）。
	- iss-00616 の計算 `views/graph/command.js`（`commandPairs`・`ownWorktrees`・`placeAgents`・`bandItems`・`bandLabel`・`commandModel`・`labelWidth`・`BAND`・`commandKey`）は、1つのリポジトリの配置と、配置の上の負の y の1本の帯を前提にしている。
	- 構造の図（`graph.js`）では、指揮の層 `.gx-cmd`（z-index 1）が枠（z-index 1、重なりの文脈を作る）の後に置かれ、枠の見出し（ID の札・題名・要約の行）の上を線が通る（統括の写し、iss-00616 の shots-r2 の init-00423 の見出し）。
	"""

includes: [
	"『横断の構造』の、worktree とリポジトリの対応、各リポジトリの中の居場所、枠ごとの帯と全体の帯『ほかの場所』、帯だけの入れ物の枠（Epic R-11）",
	"リポジトリをまたぐ線、同じ箱・帯の項目の弧、波紋、点の流れ・止まった点線・薄い線、減らす設定、指揮の選び、帯のエージェントの詳細の欄のチャット、凡例の行（iss-00616 と同じ部品）",
	"帯の出入りで、画面のいちばん上に見えているリポジトリの枠とその中の箱を画面の上で動かさない補い",
	"両方の画面（構造の図と『横断の構造』）で、指揮の線を枠の見出しの文字の下に通す CSS（統括の決定）",
	"`allgraph/compose.js` の帯の幅・入れ物の例外・全体の帯の口、`graph/command.js` の複数の帯の行の口、新しい純粋な計算 `allgraph/command.js`、共有の描画の部品",
	"『横断の構造』の実機の確かめ用の検査 `window.specdockCmdAudit`",
	"iss-00616 の仕様の文面の残り（round-3 の P2・P3）の訂正（decisions に記録する）",
]

excludes: [
	"orca-web の変更、SpecDock のサーバー・API・保存の変更",
	"線そのものを押す操作、線の表示を切り替えるボタン（Epic の excludes のまま）",
	"線を曲げて見出しを避ける道（統括の決定で取らない）",
	"依存の線の道（`router.js`）と `specdockEdgeAudit` の中身の変更",
	"リポジトリの知らせの行（`.ax-warn`）・本文の1行（`.ax-line`）・箱の中の文字の重なりの順の変更（見出しの文字の行だけを上げる）",
]

requirements: {
	"R-01": {
		title: "『横断の構造』で、worktree をリポジトリに対応させ、各リポジトリの中の居場所に置き、リポジトリをまたぐ組もすべて結ぶ（Epic R-10）"
		text: """
			組は iss-00616 R-01 と同じ（`commandPairs`）。各 worktree のリポジトリは、表示しているリポジトリ（一覧の API の順）のうち、構造の `worktrees.paths` にその worktree のパスがある最初のリポジトリ、
			なければ、そうした worktree と同じ `project.id` を持つ最初のリポジトリ（`matchWorktrees`・`ownWorktrees` と同じ判定。名前の規則は使わない）。
			グラフを描いているリポジトリの worktree の端は、そのリポジトリの配置の中で、iss-00616 R-01 と同じ順（箱・枠の印 → 畳んだ塊 → いちばん近い描かれた祖先の枠 → そのリポジトリの帯）に置く。
			枠は出ているがグラフのないリポジトリ（読み込み中・失敗の後の古い構造なし・『全体』で Scope がない、など）の端は、そのリポジトリの帯に置く。
			どのリポジトリにも当たらない worktree（隠した、登録していない、など）の端は、全体の帯『ほかの場所』に置く。両端ともほかのリポジトリの組も含め、すべての組を描く。
			"""
		acceptance: [
			"合成の2つのリポジトリ（親のリポジトリの main のチェックアウトに統括、子のリポジトリの Issue の worktree に子）で、統括の端が親のリポジトリの帯、子の端が子のリポジトリの枠の中の Issue の箱の印になり、線が1本できる（node のテスト）",
			"パスの当たりが、project の当たりより先に効く（同じ project を持つ2つのリポジトリでも、パスのあるリポジトリに対応する）",
			"どのリポジトリにも当たらない worktree の親の端が『ほかの場所』の帯に置かれ、札が「<project.name> · <branch>」になる",
			"両端とも『ほかの場所』の組、両端とも同じリポジトリの帯の組も、結果に入る",
		]
	}
	"R-02": {
		title: "各リポジトリの枠の見出しのすぐ下に、そのリポジトリの帯を置き、全体のいちばん上に帯『ほかの場所』を置く（Epic R-10）"
		text: """
			帯の項目は、そのリポジトリの帯に置かれた端を、worktree ごとに1つの項目にまとめる（iss-00616 R-02 の並び：main のチェックアウト → そのリポジトリのほかの worktree、札で並べる）。
			札は「main のチェックアウト」かブランチ名（iss-00616 の `bandLabel` の own）。帯は、枠の見出しと知らせの行の下、グラフの上に、折り返さない1行で置く（`compose` が帯の高さを見出しと本文の間に足す）。
			帯の行が枠の中の幅より広いときは、その枠を帯の行の幅まで広げる（帯が枠の外へはみ出さない）。
			全体の帯『ほかの場所』は、世界のいちばん上（すべてのリポジトリの枠の上）に、行の頭の『ほかの場所』の文字と、項目（札は「<project.name> · <branch>」）で置き、すべての枠をその高さだけ下げる。
			帯に置く端がないリポジトリと、『ほかの場所』に置く端がないときは、その帯を出さず、高さも足さない。
			"""
		acceptance: [
			"帯のあるリポジトリの枠の、見出し・知らせの行の下に帯の高さ（`REPO.band`）が足され、グラフ（`.ax-body`）がその分だけ下がり、帯の項目がその間にある（node のテストと偽の DOM）",
			"帯の行の幅が枠の中の幅より広いリポジトリの枠が、帯の行が収まる幅になる（node のテスト）",
			"『ほかの場所』の帯があるとき、すべてのリポジトリの枠が `REPO.other` だけ下がり、帯の行の頭に『ほかの場所』の文字がある",
			"組がないとき、`compose` の結果と『横断の構造』の世界の HTML が今と同じ",
		]
	}
	"R-03": {
		title: "『これから』で見える Scope がないリポジトリでも、帯に組の親がいれば、見出しと帯だけの入れ物の枠として出す（Epic R-11）"
		text: """
			epic-00612 R-06（『これから』で見せるものが何もないリポジトリの枠を出さない）の、ただ1つの例外。
			その枠に出るのは見出し・知らせの行・帯だけで、本文の1行（『この範囲で見せる Scope はありません』）は出さない（今の『これから』の空の本文と同じ高さ0）。
			帯に組の子だけがいるときは枠を出さず、その子の端を『ほかの場所』の帯に置く（札は「<project.name> · <branch>」）。
			組の親がいなくなれば（組が消えれば）、次の更新で、その枠は今の規則どおり出なくなる。
			"""
		acceptance: [
			"『これから』で見える Scope のないリポジトリの main のチェックアウトに統括がいて、別のリポジトリに子がいるとき、そのリポジトリの枠が見出しと帯だけで出る（node のテストと偽の DOM）",
			"そのリポジトリに子だけがいるとき、そのリポジトリの枠は出ず、子が『ほかの場所』の帯に出る",
			"その統括の組が要約から消えると、次の描画で、その枠が出なくなる",
		]
	}
	"R-04": {
		title: "線・弧・波紋・色・動き・選び・帯のチャット・凡例は、リポジトリの構造の図と同じ（Epic R-10）"
		text: """
			iss-00616 R-03〜R-07 と同じ部品で描く：親の印から子の印への緩い三次ベジェ、同じ箱・帯の同じ項目の弧、親の端の波紋、子の状態による点の流れ・止まった点線・薄い線、減らす設定、指揮の色の札、
			箱・枠の見出しの印を押したときの線の目立たせ（そのリポジトリの Scope の選びとエージェントのタブは今のまま、iss-00621）、帯のエージェントを押したときの線の目立たせと詳細の欄のチャット（`/embed/agent`）、
			もう一度・閉じる・Esc・空いたところで解けること、凡例の「指揮（親 → 子）」の行（Orca との連携が有効な画面だけ）。
			線は全体の世界に置いた1枚の指揮の層に描き、リポジトリをまたぐ。端の座標は、そのリポジトリの本文の原点に、そのリポジトリの配置の座標を足したもの。
			"""
		acceptance: [
			"組のある合成の要約で、世界に `.gx-cmd`・`.gx-cmd-top`・`.gx-band` が1つずつあり、リポジトリをまたぐ線の始まりと終わりが、それぞれのリポジトリの本文の原点＋配置の座標の印の位置にある（偽の DOM）",
			"帯のエージェントを押すと、欄に `/embed/agent?id=<その id>` の iframe が出て、そのエージェントの線だけが目立ち、もう一度・閉じる・Esc で解ける",
			"箱の印を押すと、今どおりそのリポジトリの Scope が選ばれてエージェントのタブが開き、そのエージェントの線が目立つ",
			"凡例に、Orca との連携が有効なときだけ「指揮（親 → 子）」の行がある",
		]
	}
	"R-05": {
		title: "要約が変わっても各リポジトリの配置をやり直さず、帯の出入りで、画面のいちばん上に見えている枠とその中の箱を動かさない（Epic R-09・R-10）"
		text: """
			要約だけが変わったとき、どのリポジトリの配置（`routeLayout`）もやり直さない（ただし、iss-00620 のとおり、稼働の印の行の数が変わったリポジトリは、そのリポジトリだけ配置をやり直す。Epic R-09 と同じ例外）。帯の形（どのリポジトリに帯があるか、その幅、入れ物の枠、『ほかの場所』の有無と幅）が変わらなければ、指揮の層・端の層・帯だけを描き直す。
			帯の形が変わったときは、枠の組み立て（`compose`）だけをやり直す。そのとき、読む人が図を動かした後（`A.moved`）なら、画面のいちばん上に見えているグラフのあるリポジトリの枠の本文の原点が、画面の上で動かないように、世界の位置を補う。
			それより下の枠と箱は動いてよい。読む人が図を動かす前は、今どおり初めの見え方を置き直す。
			"""
		acceptance: [
			"要約だけの更新で、どのリポジトリの `routeLayout` の呼び数も増えない（偽の DOM）",
			"帯の形が同じ2回目の更新で、`compose` をやり直さず、`.gx-cmd` の要素が同じ",
			"見えている枠より下のリポジトリの枠に帯が出る更新の前後で、見えている枠の本文の原点の画面の位置（`A.tx + 原点 × A.s` と `A.ty + 原点 × A.s`）が変わらない（node のテストと偽の DOM）",
		]
	}
	"R-06": {
		title: "両方の画面で、指揮の線を、枠の見出しの文字の下に通す（統括の決定、2026-11-17）"
		text: """
			構造の図と『横断の構造』の、Initiative・Epic の枠の見出しの行（状態の印・Initiative の文字・ID の札・題名・worktree の印・稼働の印の行）と要約の行（進み具合の棒・数・状態の数・保証レベル・人のタスク・後に続く数など）、
			『横断の構造』のリポジトリの枠の見出し（印・名前・構造の図への矢印）を、指揮の層（線の本体と下地の光）より上に置く。
			その文字と札の背には、その枠と同じ地の色の下地を、その要素の範囲だけに敷く（要素の間のすき間と、見出しの行の残りの幅には敷かない）。自分の地の色を持つ札（ID の札など）は、見え方を今と同じにする。
			新しい色を足さない。線を曲げて見出しを避けない。箱の中、知らせの行、本文の1行、依存の線、端の層（箱の中の短い線・端の点・波紋）、帯の重なりの順は変えない。
			"""
		acceptance: [
			"graph.css で、枠（`.gx-frame`）が重なりの文脈を作らず（z-index が auto）、見出しの行と要約の行が z-index 2、その子の文字と札に枠の地の色の下地がある（静的な検査）",
			"allgraph.css で、リポジトリの枠の見出しが z-index 2、その子に枠の地の色の下地があり、新しい色も独自の変数もない（静的な検査）",
			"実機の写しで、指揮の線が見出しの文字・ID の札・要約の行の上に描かれない（両方の画面、明・暗）。`specdockCmdAudit().heads` の違反が0",
			"組がないとき、構造の図と『横断の構造』の世界の HTML が今と同じ（見え方は、下地が枠と同じ色なので変わらない）",
		]
	}
	"R-07": {
		title: "線と帯があっても、依存の線の検査と指揮の線の検査が通り、初めの見え方と『収める』が帯を含む"
		text: """
			線と帯は依存の線の道と検査を変えない。`window.specdockEdgeAudit()` のすべてのリポジトリの違反が0のまま。
			『横断の構造』にも `window.specdockCmdAudit()` を置き、`commandModel` の数え（`boxOverlaps`・`edgeOverlaps`・`crowded`）、描いた印と `markSpots` の差（`spotDrift`）、位置の分からない印（`spotMissing`）、
			世界の層の順、層の `pointer-events`、見出しの文字の重なりの検査（`heads`）を返す。帯は世界の正の座標に置くので、初めの見え方と『収める』は今の世界の大きさの計算で帯を含む。
			"""
		acceptance: [
			"合成の入力の `commandModel` の `boxOverlaps`・`edgeOverlaps` が0（node のテスト）",
			"実機の 1440・390 × 明・暗 × 全体・いま・これから で、`specdockEdgeAudit().total` の違反が0、`specdockCmdAudit()` の `boxOverlaps`・`edgeOverlaps`・`heads` が0、`spotDrift` ≤ 1、ブラウザーのエラー0、横のスクロールなし",
			"『収める』の後に、帯と全部の枠が図の領域に収まる",
		]
	}
}

