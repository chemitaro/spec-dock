package spec

// 要件（Issue）。型 specdock/v1。

schema: "specdock/v1"

assurance: {
	level:  "standard"
	reason: "構造の図と横断の構造の入力の決まりを変える。ダッシュボードの静的な資産だけで、データや保存には触れず、PR を戻せば元に戻る"
}

purpose: """
	構造の図（`/r/<repo>/graph`）と『横断の構造』（`/graph`）を、キーボードとマウスで直感的に動かせるようにする。
	矢印キーで図を動かし、マウスのホイールを回すとカーソルの位置で拡大・縮小する。トラックパッドの動き（2本指で動かす、ピンチで拡大・縮小）は変えない。
	"""

background: """
	本人の要望（2026-11-17、統括の依頼書）：矢印キー（上・下・左・右）で画面を動かしたい。マウスの真ん中のホイールは拡大・縮小のほうが直感的。

	タスク担当が確かめた今の事実（2026-11-17、`92e26aff7`）：
	- 両方の画面の wheel（`views/graph.js` の `bindView`、`views/allgraph.js` の `bindView`）は、`ctrlKey` か `metaKey` があれば（トラックパッドのピンチは Chrome・Safari・Firefox で `ctrlKey` 付きの wheel として届く）カーソルの位置で `exp(−deltaY·0.01)` 倍に拡大・縮小し、なければ `deltaX`・`deltaY` だけ動かす。マウスのホイールも動かすだけになる。
	- キーは各画面の `onKey`（document の keydown）が、Escape（欄・選びを閉じる）と、箱・帯のエージェントの Enter・Space だけを扱う。矢印キー・`+`・`-`・`0` は扱わない。
	- 拡大・縮小のボタン（`zin` 1.25倍、`zout` 0.8倍、`z100`、`fit`）は、各画面の `zoomCenter`・`fit` を呼ぶ。図を動かす口は各画面の `applyT()` で、そこで iss-00646 の `motion.moved()`（動かす間は線を止める）を呼ぶ。横断の構造は、読み手が動かしたら `A.moved = true`（初めの見え方を置き直さない）にする。
	- 同じ処理が2つの画面に写してある（wheel、zoomAt、zoomCenter）。
	- 図の面（`.gx-view`）は `tabindex="0"`、箱と枠の見出しは `role="button" tabindex="0"`。押すとフォーカスが移る。欄（`.panel`）・道具の棒（`.gx-bar`）は図の面の外にある。
	- マウスのホイールとトラックパッドを確かに見分ける Web の標準はない（W3C Pointer Events の議論）。`deltaMode` が行（1）・ページ（2）ならマウスのホイール（Firefox のマウスのホイール）。Firefox は、`wheelDelta*` を先に読むと `deltaMode` を画素（0）に変えるので、`deltaMode` を先に読む。Chrome・Safari の非標準の `wheelDeltaY` は、マウスのホイールの1刻みで ±120 の倍数になる。
	"""

includes: [
	"両方の画面のホイール（マウスのホイールの拡大・縮小、トラックパッドの2本指・ピンチ、Shift の横の移動）",
	"両方の画面のキー（矢印キーの移動、`+`・`-`・`0`）",
	"見分けとキーの写しを1か所に寄せた新しいモジュールと、その node のテスト",
	"図の面の `aria-label` の操作の説明",
]

excludes: [
	"ドラッグ・2本指のタッチ・ダブルクリック・Escape・Enter・Space の今の動き",
	"拡大・縮小のボタン、拡大率の上限・下限（両方の画面の `minScale`、上限 2）",
	"線・箱・枠の描き方、iss-00646 の止める仕組みそのもの",
	"利用者の設定でホイールの役を選ぶこと",
	"Python の API・保存・モデル・orca-web",
]

requirements: {
	"R-01": {
		title: "マウスのホイールを回すと、カーソルの位置を中心に拡大・縮小する"
		text: """
			マウスのホイールと見分けた wheel（D-01 の決まり）は、カーソルの位置を動かさずに拡大・縮小する。上に回す（`deltaY` が負）と拡大、下に回すと縮小。
			1刻みは 1.15倍（縮小は 1/1.15）。1つのイベントが複数の刻みをまとめて持つとき（`wheelDeltaY` が 240 など）も、1つのイベントで変わるのは最大 2刻み（1.15² 倍）までにし、速く回しても飛びすぎない。拡大率の上限・下限は今のまま。
			"""
		acceptance: [
			"node のテスト：マウスのホイールの代表の値（表、D-01）で、1刻みが 1.15倍・1/1.15倍、`wheelDeltaY` 360 でも 1.15² 倍まで、向きが `deltaY` の符号の逆",
			"実機（1440×900 の Chrome、両方の画面）：CDP の Input.dispatchMouseEvent（mouseWheel）でマウスのホイールを回すと、拡大率が変わり、カーソルの下の世界の点が動かない（前と後の拡大率と、カーソルの下の点のずれを report.md に書く）",
		]
	}
	"R-02": {
		title: "トラックパッドの動きは今のまま"
		text: """
			トラックパッドの2本指でなぞる wheel は今のまま `deltaX`・`deltaY` だけ動かし、ピンチ（`ctrlKey` か `metaKey` 付きの wheel）は今のまま `exp(−deltaY·0.01)` 倍にカーソルの位置で拡大・縮小する。
			マウスのホイールと見分けられないときは、動かす（今の動き）に倒す。一続きの wheel（前の wheel から 200ms の内に来る wheel）は、その一続きの最初の判定を引き継ぐ。2本指の途中でたまたまマウスのホイールに似た値が来ても動かすを続け、拡大・縮小に切り替わらない（D-02 の続きの扱い。統括の決定 2026-11-18）。
			"""
		acceptance: [
			"node のテスト：トラックパッドの2本指とピンチの代表の値（表）で、2本指は動かす（量は deltaX・deltaY）、ピンチは今の倍率。見分けられない値（`wheelDeltaY` がない、120 の倍数でない、deltaX が 0 でない）は動かす",
			"node のテスト：動かす wheel から 200ms の内に来た、`wheelDeltaY` だけでマウスのホイールに見える wheel は動かし、一続きが続く限り（各 wheel の間が 200ms 未満なら、全体が 200ms を超えても）動かすを続ける。らしいマウスのホイールの一続きの途中の、値だけで動かすに見える wheel は拡大・縮小を続ける",
			"実機：前の wheel から 200ms 以上あけた、小さな deltaX・deltaY の wheel（deltaX ≠ 0。CDP の合成の wheel はどんな deltaY でも `wheelDeltaY` ±120 になるので、deltaX で2本指を模す）で、拡大率が変わらず、世界がその量だけ動く。本物のトラックパッドは本人が試しの URL で確かめる（統括が頼む）",
		]
	}
	"R-03": {
		title: "Shift を押しながらのホイールは横に動かす"
		text: "Shift 付きの wheel は、拡大・縮小せず横に動かす。`deltaX` が 0 なら `deltaY` を横の量にする（ブラウザーが Shift で `deltaX` に移していれば、その `deltaX`）。行・ページの単位の値は画素に直す（行は 16px、ページは図の面の幅）。"
		acceptance: ["node のテスト：Shift 付きのマウスのホイール（Chrome・Firefox の値）が横の移動になり、縦は 0"]
	}
	"R-04": {
		title: "矢印キーで図をその向きに見るように動かし、`+`・`-`・`0` で拡大・縮小・全体を収める"
		text: """
			→ を押すと図の右の部分が見えるように（世界が左へ）、← は左、↑ は上、↓ は下の部分が見えるように動かす。1回 80px、Shift 付きは 4倍の 320px。押し続けると、OS のキーの繰り返し（`keydown` の `repeat`）で続けて動く。
			`+`（`=` も同じキー）は拡大のボタン（`zin`、図の面の中央で 1.25倍）、`-` は縮小のボタン（`zout`、0.8倍）、`0` は収めるボタン（`fit`）と同じ動きにする。
			扱ったキーは `preventDefault` し、ページのスクロールを起こさない。
			"""
		acceptance: [
			"node のテスト：キーの写し（4つの向きと量、Shift の4倍、`+`・`=`・`-`・`0`、テンキーの値、ほかのキーは扱わない）",
			"実機：両方の画面で、CDP の Input.dispatchKeyEvent で → ↓ ← ↑ と Shift+→ が世界をその量だけ動かし、`+`・`-` が拡大率を 1.25倍・0.8倍にし、`0` が収める（前と後の写しと数を report.md に書く）",
		]
	}
	"R-05": {
		title: "ほかの入力を邪魔しない"
		text: """
			次のときはキーを横取りしない（何もせず、`preventDefault` もしない）：
			- フォーカスが入力欄（`input`・`textarea`・`select`・`contenteditable`）、ボタン（`button`）、リンク（`a[href]`）、`summary`、`iframe`（チャットの枠）にあるとき。
			- フォーカスが図の面（`.gx-view`）の外の要素（欄・道具の棒・検索など。そこで矢印キーがスクロールや選びに使われる）にあるとき。図の面の中の箱・枠の見出し・帯のエージェント（`role="button"` の div）、図の面そのもの、図の面を包む要素（`body`、画面の入れ物の `main#view`。画面の移動のたびにフォーカスが移る）なら扱う。
			- 修飾キー（Ctrl・Cmd・Alt）が付いているとき、文字の変換の途中（`isComposing`）、ほかの処理がすでに `preventDefault` したとき、画面が隠れているとき。
			チャットの枠（iframe）の中のキーは親のページに届かないので、そもそも扱わない。
			"""
		acceptance: [
			"node のテスト：上の場面のそれぞれで扱わない、扱う場面（図の面を包む `main` を含む）で扱う（偽の DOM）",
			"画面のテスト：画面が隠れているとき、キーで何も起きず `preventDefault` もされない。フォーカスが `main#view` のとき、矢印キーで動く",
		]
	}
	"R-06": {
		title: "両方の画面で同じ動きにし、処理を1か所に寄せる"
		text: """
			見分け・ホイールの写し・キーの写し・つなぎ（イベントを受けて画面の操作を呼ぶ）を、新しいモジュール1つに置き、両方の画面はそれを使う。両方の画面に同じ処理を写さない。
			動かす・拡大・縮小は各画面の今の口（`applyT` を通る）を使い、iss-00646 の『動かす間は線を止める』と、横断の構造の `A.moved` を今と同じに保つ。
			"""
		acceptance: [
			"`views/graph.js`・`views/allgraph.js` に wheel の見分け・キーの写しの式がなく、新しいモジュールを使う（静的な検査）",
			"画面のテスト（偽の DOM、両方の画面）：マウスのホイールで拡大率が変わり、2本指の wheel と矢印キーで世界が動き、どれの後も `.gx-view` に `is-still` が付く。横断の構造は、矢印キーの後に初めの見え方を置き直さない",
		]
	}
	"R-07": {
		title: "操作の説明を書き直す"
		text: "図の面の `aria-label`（両方の画面）を、新しい操作（ドラッグか2本指か矢印キーで移動、ホイールかピンチか `+`・`-` で拡大・縮小、`0` で全体）に書き直す。ダッシュボードの資産と配る文書に、ほかの操作の一覧はない（2026-11-17 に確かめた）。"
		acceptance: ["画面のテスト：両方の画面の `.gx-view` の `aria-label` が新しい説明"]
	}
}

failures: {
	"F-01": {
		title: "見分けられない wheel は動かす（今の動き）"
		text:  "`deltaMode` が 0 で、`wheelDeltaY` がない・0・120 の倍数でない・`deltaX` が 0 でない wheel は、一続きの初め（前の wheel から 200ms 以上あいた、または前が確かな判定）なら動かす。拡大・縮小に倒さない。らしいマウスのホイールの一続きの途中では、R-02 の引き継ぎに従う（その一続きの判定を続ける）。"
	}
	"F-02": {
		title: "線の検査を保つ"
		text:  "両方の画面で `specdockEdgeAudit()` の違反0、`specdockCmdAudit()` の `boxOverlaps`・`edgeOverlaps`・`heads` 0 を、ホイール・キーで動かした後も保つ。"
	}
}

constraints: [
	"本人の環境に特化した決まりを入れない。どのブラウザー・OS でも同じ決まりで、シンプルにする（本人の方針、統括の依頼書）",
	"書いてよいのは `src/spec_dock/assets/dashboard/`、`tests/`、`src/spec_dock/assets/static-inventory.json`（sha256 が変わるなら）、この Issue と epic-00654 の Scope のディレクトリ（統括の依頼書）",
	"並行する iss-00648・iss-00650 が `views/graph/`・`views/_shared/` を触るので、新しいモジュールは新しいファイルにし、今のファイルの変更は小さくする",
]

decisions: [
	"統括の決定（依頼書 2026-11-17）1：ホイールはカーソルの位置で拡大・縮小、1刻み約 1.1〜1.2倍、速く回しても飛びすぎない、上で拡大。タスク担当が 1.15倍、1イベント最大 2刻みに決めた",
	"統括の決定 2：トラックパッドは変えない。見分けは1か所の純粋な関数で、見分けられないときは動かす。Shift のホイールは横に動かす。タスク担当が、見分けの決まり（D-01）と、連続した動かす wheel の 200ms の続きの扱いを足した（トラックパッドの速い縦のなぞりが、たまたま `wheelDeltaY` 120 になる値で拡大・縮小しないため）",
	"統括の決定（2026-11-18、msg_e0c1b3a11a47）：実機の CDP の合成の wheel が、どんな deltaY でも `wheelDeltaY` ±120 になる食い違いは、A（今の決まりのまま進め、CDP の性質として記録し、本人に試しの URL で本物のマウスとトラックパッドを確かめてもらう。統括が頼む）。足すこと：一続きの wheel（前から約 200ms 以内）は、その一続きの最初の判定を引き継ぐ。純粋な関数の状態として持ち、node のテストで確かめる",
	"統括の決定 3：矢印キー 1回約 80px、Shift で約4倍、押し続けると続けて動く、`+`・`-`・`0` はボタンと同じ",
	"統括の決定 4・5・6：入力欄・ボタン・リンク・修飾キー・iframe の中では横取りしない。両方の画面で同じにし、1か所に寄せる。iss-00646 の止める扱いを保つ。説明を書き直す",
	"タスク担当の解釈：『ボタンやリンク』は、ネイティブの `button`・`a[href]` と図の面の外の要素を指す。図の面の中の箱（`role=\"button\"` の div）は押すとフォーカスが移るので、そこで矢印キーが効かないと、箱を押した後に矢印キーで動かせなくなる。図の面の中は扱う",
]
