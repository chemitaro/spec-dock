package spec

// 要件（Issue）。型 specdock/v1。書き方は spec-dock/docs/authoring/ のガイドにある。

schema: "specdock/v1"

assurance: {
	level:  "light"
	reason: "画面の CSS と1か所の属性の小さな不具合の修正"
}

purpose:    "構造の図（と『横断の構造』）の指揮の帯の印から開くチャットを、Scope の欄のエージェントのタブと同じく、欄の本文の高さいっぱいに出し、狭い画面では下からの欄を Scope の欄と同じく指で動かせるようにする"
background: """
	本人の指摘（2026-11-17）：「main のチェックアウト」の帯のエージェントの印を押すと、右の欄にチャットが出るが、枠が欄の上の方に小さく出るだけで、欄の残りが空く。
	原因（タスク担当が確かめた）：帯の欄は `views/graph/command_view.js` の `renderAgentPanel` が `<div class="pn-body">` にじかに `iframe.sd-agent` を入れ、`data-tab` を付けない。
	`views/_shared/panel.css` の本文を縦の flex にする規則は `.pn-body:is([data-tab="docs"], [data-tab="explanation"], [data-tab="agents"])` にだけ効くため、`.sd-agent` の `flex: 1` が効かず、iframe は既定の高さ（約 150px）のままになる。
	構造の図と『横断の構造』の両方が同じ `CV.renderAgentPanel` を使う。
	範囲の追加（統括、2026-11-17）：狭い画面で帯の印をタップして出る下からの欄を、上へ引いて全面にも、下へ引いて閉じることもできない（Scope の欄はできる）。
	原因（タスク担当が確かめた）：`views/_shared/panel.js` の下からの欄の引っぱり（pointerdown）とつまみのタップ（click）が、どちらも `current`（Scope の欄の中身）があるときだけ働く。帯の欄と「片付けの候補」の欄は、`hide()` で `current` を消してから同じ aside の中身を差し替えるので、どちらも最初の判定で返る。見出しは `.pn-top` の外の `.pn-head` で、つまみは `div.pn-grab`。
	"""

includes: ["構造の図と『横断の構造』の帯の欄（同じ関数）", "狭い画面の下からの欄の引っぱりとつまみ（帯の欄、片付けの候補の欄）", "回帰のテスト"]
excludes: ["Scope の欄のエージェントのタブ", "下からの欄の3段の高さと落ち着き先の計算（panel_logic.js）", "orca-web の埋め込みの中身"]

requirements: {
	"R-01": {
		title: "帯の欄のチャットの枠が、欄の本文の高さいっぱいに広がる"
		text:  "チャットを開けるとき、欄の本文はエージェントのタブと同じ縦の flex の規則に乗り、iframe が見出しの下から欄の下まで広がる。余白・角丸・縁取りはエージェントのタブと同じ。PC（右の欄）と狭い画面（下からの欄）の両方。"
		acceptance: [
			"1440×900 と 390×844 で、帯の印を押したときの iframe の高さが、欄の本文の高さから本文の上下の余白を引いた値とほぼ同じ（差 2px 以内）",
			"帯の欄の本文に `data-tab=\"agents\"` が付き、panel.css の縦の flex の規則（PC と狭い画面）に乗る（静的と偽の DOM のテスト）",
		]
	}
	"R-02": {
		title: "ほかの動きを変えない"
		text:  "「チャットを開けません。」の表示（余白も含む）、同じエージェントで開き直したときに読み込み直さない動き（iss-00616 D-04）、欄の引っぱりでの大きさ変え、狭い画面の下からの欄の形、線の検査を変えない。"
		acceptance: [
			"チャットを開けないとき、本文に `data-tab` が付かず、HTML が今と同じ",
			"今の構造の図と『横断の構造』の指揮の画面のテストが通る（iframe が同じ要素のまま）",
			"実機で `specdockEdgeAudit` の違反0、`specdockCmdAudit` の boxOverlaps・edgeOverlaps 0",
		]
	}
	"R-03": {
		title: "狭い画面で、帯の欄と片付けの候補の欄を、Scope の欄と同じく指で動かせる"
		text:  "下からの欄の動き（つまみか見出しを引いて半分・全面・最小・閉じる、つまみのタップで半分と全面の切り替え、引いて閉じたときの後片付け）が、欄の中身（Scope の欄か、帯の欄か、片付けの候補の欄か）によらず同じに働く。動きは panel.js の1か所に保ち、描き手ごとに写さない。引いて閉じたときは閉じるボタンと同じ結果になる（帯の欄は clearAgentPanel の後片付けと、選んだ印の強調の解除）。開いたときの高さは半分。PC の右の欄には何も起きない。"
		acceptance: [
			"偽の DOM（幅 390）：帯の欄と片付けの候補の欄で、つまみのタップで data-snap が half → full → half、見出しを上へ引いて full、下へ引いて欄が閉じる（帯の欄は data-cmd-agent がなく、印の aria-pressed が false、線の強調なし）。Scope の欄も同じ（今の動きのまま）",
			"390×844 の Chrome で、CDP の Input.dispatchTouchEvent で、帯の欄と片付けの候補の欄を、上へ引いて全面、下へ引いて閉じる、つまみのタップで切り替え、の3つが Scope の欄と同じ結果（欄の高さと開閉）になる。前と後の数を report.md に書く",
		]
	}
}

failures: {
	"F-01": {
		title: "チャットの入口がないとき（detail がない・orca の origin がない）は、今の「チャットを開けません。」の表示のまま"
	}
	"F-02": {
		title: "欄が閉じているとき、PC の幅のとき、ボタンやリンクの上で押したとき、本文や iframe の上で押したときは、引っぱりが始まらない（中身は今どおりスクロールする）"
	}
}

constraints: [
	"直し方は既存の決まり（本文の `data-tab=\"agents\"`）に乗せる。帯の欄だけの CSS は足さない",
	"下からの欄の動きは panel.js の1か所に置き、帯の欄・片付けの候補の欄の描き手に写さない",
	"書いてよいのは src/spec_dock/assets/dashboard/、tests/、static-inventory.json、この Scope",
	"本人の環境に特化した決まりを入れない",
]

decisions: [
	"統括の決定（依頼書、2026-11-17）：エージェントのタブと同じ形にし、既存の決まりに乗せる。開けない表示・D-04・引っぱり・狭い画面の形は変えない。『横断の構造』も同じく直す",
	"タスク担当の判断：`data-tab=\"agents\"` はチャットの枠を出すときだけ付ける（開けない表示の余白を変えないため）",
	"統括の決定（範囲の追加、2026-11-17）：下からの欄の動きを Scope の欄と同じにし、帯の欄と片付けの候補の欄の両方に効かせる。動きは1か所に保つ。引いて閉じたときは閉じるボタンと同じ後片付けをする",
]
