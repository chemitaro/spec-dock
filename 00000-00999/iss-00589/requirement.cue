package spec

// 要件（Issue）。型 specdock/v1。書き方は spec-dock/docs/authoring/ のガイドにある。

schema: "specdock/v1"

assurance: {
	level:  "standard"
	reason: "ダッシュボードの表示だけを変え、データや操作には触れない"
}

purpose: "Scope の欄と詳しい画面の「文書」と「説明資料」のタブで、上の要素を詰め、埋め込んだ文書の枠に残りの高さをすべて使わせて、仕様と報告を広く読めるようにする"

background: """
	本人の要望（2026-11-14、統括の依頼書 task_2f2bba9bbf9d）。

	- 文書のタブで、上の要素（検査の帯、計画の進み具合、文書を選ぶ大きな札）が場所を取りすぎている。埋め込まれた文書を見る範囲を最大限まで広げたい。
	- 文書のタブの「説明資料」の札は新しいタブで開くだけ。説明資料は専用のタブで読めるので外してよい。選べる文書を2つに減らしてよい。
	- 文書を選ぶ部分を、もっと小さくコンパクトにする。

	直す前の測り（spec-dock の実データ、epic-00573、開始のコミット 7e50ac583。report.md の「直す前」）：
	欄（1440×900、高さ 824px）の文書のタブで、枠の上端が欄の中身の上端から 359px 下にあり、最初に見える枠の高さは 178px（欄の 21.6%）。
	1000×800 では 0px（枠は中身をスクロールしないと見えない）。390×844 のシートの全体の段では 213px。説明資料のタブの枠は 1440 で 488px（59.3%）。
	今の文書のタブ（views/_shared/scope_tabs.js の docsTab、iss-00587 で欄と詳しい画面の共有にした）は、上から「検査の誤りなし」の帯、
	計画の進み具合（あるとき）、文書の札（要件・設計・計画、説明資料、報告）、文書の枠（高さ min(70vh, 900px) の固定）を縦に積む。
	"""

includes: [
	"src/spec_dock/assets/dashboard/views/_shared/scope_tabs.js の文書のタブと説明資料のタブの HTML",
	"src/spec_dock/assets/dashboard/views/_shared/{scope_tabs.css,panel.css} と views/scope.css の、その2つのタブの見た目と高さ",
	"tests/ の該当するテスト",
	"直す前と後の写しと、枠の高さの測りを report.md に残す",
]
excludes: [
	"欄の見出し（状態、題名、道筋）とタブの帯の高さ",
	"説明資料、概要（計画の進み具合の中身は今のまま）、依存、配下、Artifact、人のタスクのタブの中身",
	"Scope の JSON（runtime の項目）と、/files/ や /doc の配り方（sandbox、frame-ancestors）",
	"新しい色や字体（app.css の --ds-*・--sd-* のまま）",
]

requirements: {
	"R-01": {
		title: "文書のタブで選べるのは、仕様と報告の2つ"
		text: """
			CUE の Scope では、文書のタブで選べる文書は「仕様」（requirement・design・plan を描いたもの。今の「要件・設計・計画」）と「報告」（report.md）の2つ。
			説明資料は文書のタブから外す（説明資料のタブはそのまま）。ADR があれば、その後ろに ADR を1つずつ並べる（今と同じ）。
			Markdown の Scope（requirement.md など）では、今と同じく、要件・設計・計画・報告を別々に並べる（説明資料は外す）。
			ない文書（report.md がまだない、など）は、選べない形で並べ、まだないことを示す。
			"""
		acceptance: [
			"CUE の Scope（epic-00573）の文書のタブで、選ぶ部分の項目が「仕様」「報告」の順の2つで、説明資料がない",
			"report.md がない CUE の Scope では、「報告」が選べない形（aria-disabled）で、まだないことが title にある",
			"Markdown の Scope では、要件・設計・計画・報告が並び、説明資料がない",
		]
	}
	"R-02": {
		title: "文書を選ぶ部分は、1行の小さな切り替えと、右端の「新しいタブで開く」"
		text: """
			大きな札をやめ、1行の小さな切り替え（セグメントのボタン）にする。選んでいる項目が分かる（aria-current）。
			同じ行の右端に、選んでいる文書を新しいタブで開く小さなアイコンのリンクを置く。行の高さは 32px 以下。
			切り替えは今と同じ道を使う（詳しい画面は問い合わせの doc、欄は欄の中の選びで、ページの URL を変えない）。
			"""
		acceptance: [
			"文書のタブに .sd-doc の札がなく、切り替えの行の高さが 32px 以下",
			"右端のリンクの href が選んでいる文書の view で、target=_blank",
			"欄で「報告」を押すと、ページの URL が変わらずに枠の src が報告の道になる。詳しい画面では ?doc=report の道に移る",
		]
	}
	"R-03": {
		title: "検査の帯は誤りがあるときだけ、1行で出す。計画の進み具合は文書のタブに出さない"
		text: """
			「検査の誤りなし」の帯は出さない（警告だけのときも出さない）。誤りがあるときだけ、切り替えの行の上に、1行の短い帯（誤りの件数と次の1手）を出し、
			押すと誤りと警告の一覧を開ける。文書を描けない（render failed）ときの知らせは今のまま（枠は出さない）。
			計画の進み具合は文書のタブに出さない。概要のタブに同じ中身（data-code="plan-progress"、作業中の手順の一覧を含む）が今もあるので、二重に持たない。
			"""
		acceptance: [
			"検査の誤りが 0 件の Scope の文書のタブに、check- の帯がない",
			"誤りがあるとき、data-code=\"check-invalid\" の帯が1行（閉じた状態で高さ 32px 以下）で出て、開くと一覧と spec-dock scope check <ID> がある",
			"文書のタブに data-code=\"plan-progress\" がなく、概要のタブにある",
		]
	}
	"R-04": {
		title: "文書の枠は、残りの高さをすべて使い、枠の外に二重のスクロールを作らない"
		text: """
			欄（PC の横の欄、スマホのシートの全体の段）では、タブの中身が切り替えの行と枠だけになり、枠が中身の下端まで伸びる。中身の領域はスクロールしない（切り替えの行は上に留まる）。
			詳しい画面では、枠の高さを、画面の高さから上の帯と切り替えの行を除いた値にし、切り替えの行と枠が1画面に収まる。
			誤りの帯を開いて一覧が長いときだけ、中身の領域がスクロールしてよい（枠の最小の高さを保つ）。
			"""
		acceptance: [
			"1440×900 と 1000×800 の欄の文書のタブで、枠の下端が中身の領域の下端から 12px 以内、枠の上端が中身の上端から 48px 以内、中身の領域がスクロールしない",
			"390×844 のシートの全体の段の文書のタブで、枠の高さが 600px 以上で、中身の領域がスクロールしない",
			"1440×900 と 1000×800 の詳しい画面の文書のタブで、枠の高さが画面の高さ − 150px 以上、かつ 切り替えの行と枠の高さの和が画面の高さ以下",
		]
	}
	"R-05": {
		title: "説明資料のタブの上の帯も、1行の細いものにする"
		text: """
			説明資料のタブの上の「説明資料 / 新しいタブで開く」の帯を、文書のタブの切り替えの行と同じ形の1行の細い帯（高さ 28px 以下）にし、枠に残りの高さを使わせる。
			新しいタブで開くリンクは右端の小さなアイコンのリンク。雛形・ない・読めないときの知らせは今のまま。
			"""
		acceptance: [
			"欄の説明資料のタブで、帯の高さが 28px 以下、枠の上端が中身の上端から 36px 以内、枠の下端が中身の下端から 12px 以内",
			"390×844 のシートの全体の段の説明資料のタブで、枠の高さが直す前（652px）以上",
		]
	}
	"R-06": {
		title: "直す前と後の写しと、枠の高さの測りを report.md に残す"
		text: """
			spec-dock の実データで、PC の幅（1440、1000）と 390px（シートの全体の段）で、欄と詳しい画面の文書のタブと説明資料のタブを、直す前と後の写しで残し、
			枠の高さ（px と、欄の高さに対する割合、最初に見える高さ）を前と後で書く。直した後のサーバーを、隔離した venv と状態の置き場で、別のポートに --tailscale で立て、URL を残す。
			"""
		acceptance: [
			"report.md に、直す前と後の写しの道と、枠の高さの表と、tailnet の URL がある",
		]
	}
}

failures: {
	"F-01": {
		title: "カタログを読めない、文書を描けない、画面で読める文書がないときは、今と同じ知らせを出し、枠は出さない"
	}
	"F-02": {
		title: "5秒ごとの描き直しで、枠を読み込み直さない"
		text:  "文書のタブの HTML は、選びと Scope の中身が同じなら同じ文字列になり、欄は枠を置き換えない（iss-00587 R-08 の仕組みのまま）。"
	}
}

constraints: [
	"色・字体・角丸は app.css の --ds-*・--sd-* のまま。新しい色を足さない",
	"画面の外への読み込みはしない。枠は同じオリジンの view・href の道だけを使い、sandbox（allow-scripts allow-popups）と referrerpolicy は今のまま",
	"利用者の文字は esc() を通す",
	"欄と詳しい画面は、同じ関数（SCOPE_TABS の render）でタブを描く（二重に作らない）",
]

decisions: [
	"選べる文書は「仕様」と「報告」の2つにし、説明資料の札は外す（統括の決定 1、2026-11-14）",
	"選ぶ部分は1行のセグメントの切り替えと、右端の小さな「新しいタブで開く」にする（統括の決定 2）",
	"検査の帯は誤りがあるときだけ1行で出す。計画の進み具合は概要のタブに移す（統括の決定 3）。概要のタブにすでに同じ planProgress があるので、文書のタブから外すだけにする（タスク担当、2026-11-14）",
	"枠は残りの高さをすべて使い、枠の外に二重のスクロールを作らない（統括の決定 4）。説明資料のタブも同じ方針（統括の決定 5）。色などはデザインシステムのまま（統括の決定 6）",
	"警告だけ（誤り 0 件）のときは帯を出さない（決定 3 の「誤りなしは出さない」を、警告だけも誤りなしとして読む。タスク担当、2026-11-14）",
	"Markdown の Scope は、仕様が1つの描画にまとまらないので、今と同じく要件・設計・計画・報告を並べ、説明資料だけを外す。ADR は今と同じく後ろに並べる（タスク担当、2026-11-14）",
]
