package spec

// 要件（Issue）。型 specdock/v1。

schema: "specdock/v1"

assurance: {
	level:  "standard"
	reason: "ダッシュボードの構造の図の表示とブラウザーの保存だけを変え、データや操作には触れない。PR を戻せば元に戻る"
}

purpose: """
	構造の図（ホーム）の見せる範囲を、道具の帯の1つの切り替え「全体｜いま｜これから」にまとめる。
	全体の中の位置づけ（全体・いま）と、今やっていることとこれからやることだけのコンパクトな見え方（これから）を、ボタンを増やさずに選べるようにする。
	"""

background: """
	今の既定（iss-00556）では、Epic・Initiative の中がすべて終わると消え、中に1つでも開いたものが残ると、終わったものも灰色で出る。
	道具の帯には「終わったものも」（showDone）と「片付けの候補を畳む」（fold、入れ子のときだけ）の2つのボタンがある。
	本人（2026-11-16）は、終わったもの（灰色）を完全に消して着手できる（青）・作業中（緑）・止められている（黄）だけを出す見え方を求め、
	ボタンが増え続けないよう、今の2つと合わせて1つのシンプルな UI にすることを求めた。
	"""

includes: [
	"`views/graph/layout.js` の見せる範囲の判定と依存の線（3つの範囲）",
	"`views/graph/prefs.js` の保存の形と、版2・版1からの移し替え",
	"`views/graph.js` の道具の帯（切り替え、fit の文字）、片付けの候補の印、凡例、これからで何も出ないときの知らせ",
	"`views/graph.css` の切り替えの見た目（既存の部品と色だけ）",
	"テスト（`tests/js/dashboard_graph_check.mjs`、`tests/unit/presentation/test_dashboard_graph_js.py` ほか）",
]

excludes: [
	"状態の札の帯（止められている・着手できる・作業中…の数）。範囲によらず今のまま",
	"線の切り替え（待っている線｜すべての線｜線なし）、入れ子・木、拡大縮小、画面に収める（fit）の動き",
	"ボードの「終わったものも（列を足す）」と、Scope の画面の「終わったものも示す」",
	"構造の API とモデル（`dashboard_model.py` の片付けの候補の判定）",
	"新しい色・字体。配布の手引きやリリースノート（リリースの Issue で書く）",
]

requirements: {
	"R-01": {
		title: "道具の帯の1つの切り替え「全体｜いま｜これから」で見せる範囲を選べる"
		text: """
			「終わったものも」と「片付けの候補を畳む」の2つのボタンをなくし、セグメントの3つのボタンの1つの切り替えにする。
			入れ子と木のどちらでも出し、同じ3つの範囲が効く。押したものだけが押された状態（aria-pressed）になる。
			切り替えは role=group、aria-label「見せる範囲」でまとめ、各 title は「見せる範囲：<名前>（<短い意味>）」の形にする。
			icon は 全体=layers、いま=clock、これから=sparkle。
			"""
		acceptance: [
			"道具の帯に `data-act=\"done\"` と `data-act=\"fold\"` のボタンがなく、role=group・aria-label「見せる範囲」の中に「全体」「いま」「これから」の3つのボタンがある（入れ子と木の両方）",
			"押した範囲のボタンだけが aria-pressed=true になり、図がその範囲で描き直される",
			"各ボタンの title が「見せる範囲：」で始まり、範囲の意味を短く示す",
		]
	}
	"R-02": {
		title: "全体：終わったものもすべて出し、片付けの候補は畳まない"
		text:  "今の「終わったものも」を入れた状態と同じ。片付けの候補は畳まずに箱・枠として出し、Issue の箱にも枠と同じ片付けの候補の印を付ける（統括、2026-11-16）。"
		acceptance: [
			"全体の layout が、今の `{showDone: true, fold: false}` と同じ Scope・同じ座標を返す（入れ子・木）",
			"全体では片付けの候補の Issue の箱（木の箱を含む）に `.cln` の印があり、畳んだ塊（`.gx-clean`）はない",
		]
	}
	"R-03": {
		title: "いま（既定）：今の既定と同じ見え方"
		text:  "開いている親の中の終わったものは灰色で出し、中がすべて終わった親は出さない。入れ子では片付けの候補を畳む（今の fold の既定）。木は今のとおり畳まない。"
		acceptance: [
			"いまの layout が、今の既定 `{showDone: false, fold: true}` と同じ Scope・同じ座標・同じ畳んだ塊を返す（入れ子・木）",
			"保存がないときの範囲は「いま」",
		]
	}
	"R-04": {
		title: "これから：終わったものと片付けの候補を出さず、それを持つ親は開いたものの枠としてだけ出す"
		text: """
			終わった Scope（state done）と片付けの候補（a 開いたまま中がすべて終わった親、b 閉じたのに開いた子孫を持つ親、c 閉じた親の下で開いている Scope。c は黄でも出さない）を、どの段でも出さない。
			ただし、終わったもの・候補でも、その下に終わったもの・候補でない Scope（着手できる・作業中・止められている・不明）があれば、その枠としてだけ出す（本人、2026-11-16）。
			畳んだ塊は作らない。これからでは枠の片付けの候補の印も出さない。
			"""
		acceptance: [
			"これからの layout の箱・枠は、終わったもの・候補でない Scope か、その祖先だけで、state done の箱（子のない Scope）や片付けの候補の箱がない",
			"中がすべて終わった開いた親（a）と、開いた子孫が候補だけの閉じた親（b）は出ず、候補でない開いた子孫を持つ閉じた親（b）は枠として出る",
			"畳んだ塊（groups）が空",
		]
	}
	"R-05": {
		title: "これからでは、終わったものとの依存の線を出さない"
		text:  "線の切り替えによらず、どちらかの端が終わった Scope（枠として出た終わった親を含む）である依存の線を出さない。相手が見えないため。"
		acceptance: [
			"これからの layout の edges の pairs に、state done の Scope が含まれない（線の切り替え all・wait の両方）",
			"線なしでは今のとおり edges が空",
		]
	}
	"R-06": {
		title: "URL の focus で絞った Scope は、これからでも出し、その中の終わったもの・候補は出さない"
		acceptance: [
			"終わった、または片付けの候補の Scope に focus したこれからの layout で、その Scope が枠（子がなければ箱）として出て、その中の終わったもの・候補の箱が出ない",
		]
	}
	"R-07": {
		title: "選んだ範囲をブラウザーに保存し、今の保存から移し替える"
		text: """
			保存の鍵を `specdock.graph.v3` にし、`{mode, range, deps, legend}` を書く（range は "all"・"now"・"next"）。
			版3がなければ版2から、mode・deps・legend を引き継ぎ、range は版2の showDone が真なら "all"、それ以外は "now"（fold は使わない）。
			版2もなければ版1から mode と legend だけを引き継ぐ（版1→版2 の扱いのまま。版1の showDone・fold で新しい既定を隠さない）。
			どの値も確かめ、誤った値は既定に戻す。古い鍵は消さない。
			"""
		acceptance: [
			"版3の正しい値はそのまま戻り、誤った値は項目ごとに既定に戻る",
			"版3がなく版2の showDone が true なら range は all、false・誤り・なしなら now になり、版2の mode・deps・legend が引き継がれる",
			"版3・版2がなく版1だけなら mode と legend だけが引き継がれ、range は now、deps は既定",
			"切り替えを押すと `specdock.graph.v3` に `{mode, range, deps, legend}` だけが書かれる",
		]
	}
	"R-08": {
		title: "画面に収めるボタンの見える文字を「収める」にし、凡例の片付けの候補の説明を範囲に合わせる"
		text: """
			fit の動きは変えず、見える文字を「収める」、title と aria-label を「画面に収める」にする（同じ帯に「全体」が2つ並ぶのを避ける。統括、2026-11-16）。
			凡例の片付けの候補の説明を「片付けの候補（全体では箱と枠に印、いまでは畳んで1つに、これからでは出さない）」にする。
			"""
		acceptance: [
			"`data-act=\"fit\"` のボタンの見える文字が「収める」、title が「画面に収める」",
			"凡例に「片付けの候補（全体では箱と枠に印、いまでは畳んで1つに、これからでは出さない）」がある",
		]
	}
	"R-09": {
		title: "SpecDock のデザインシステムのまま、PC とスマホ（390px）に収まり、実データで確かめられる"
		text:  "新しい色・字体を足さない。390px では今の道具の帯の並びのまま、3つの切り替えが1つの部品（縦に並ぶセグメント）として収まる。"
		acceptance: [
			"graph.css に新しい色の値（#…、rgb() の新しい色、新しい --ds- 以外の変数）を足していない",
			"spec-dock と housing-lifecycle の実データで、3つの範囲それぞれを 1440 と 390、明と暗で写し、edgeAudit の違反が0であることが report.md にある",
		]
	}
}

failures: {
	"F-01": {
		title: "これからで出すものが1つもないときは、道具の帯を残し、図の場所に知らせを出す"
		text:  "すべて終わったリポジトリや範囲では、図が空になる。帯を消すと範囲を戻せないので、帯は残し「これから進める Scope はありません（全体・いまで終わったものを見られます）」のような短い知らせを図の中に出す。"
	}
	"F-02": {
		title: "保存が読めない・壊れている・形が違うときは、既定（入れ子・いま・すべての線・凡例は閉じる）に戻る"
	}
	"F-03": {
		title: "これからで、選んでいた Scope が見えなくなっても、今の「終わったものも」を外したときと同じ扱いで壊れない"
		text:  "選択とパネルの扱いは今のまま（新しい規則を足さない）。ブラウザーのエラーが出ない。"
	}
}

constraints: [
	"layout.js と prefs.js は DOM のない純粋な計算のまま（node のテストで確かめる）",
	"範囲の名前と値：表示は「全体」「いま」「これから」、内部の値は \"all\"・\"now\"・\"next\"、選択の鍵は `range`",
	"保存の鍵 `specdock.graph.v1` と `.v2` の文字は prefs.js だけに書く（graph.js に書かない。今のテストの約束）",
	"iss-00602 が並行して `views/_shared/` を直す。PR の直前に origin/main を取り込み、テストとゲートを最後のコミットでやり直す",
]

decisions: [
	"2026-11-16 本人：見せる範囲の名前を「全体・いま・これから」で確定（「とても分かりやすい概念」。この方針で整理する）。",
	"2026-11-16 本人（図解を見て確定）：これからでは片付けの候補の a・b・c をすべて出さない。b は、その下に候補でない開いた子孫（作業中・着手できる・止められている）があるときだけ、その枠として出す。c は黄でも出さない（案A）。",
	"2026-11-16 本人：URL の focus で絞った Scope 自身は、終わったもの・候補でもこれからで出し、その中の終わったもの・候補は出さない。",
	"2026-11-16 統括（依頼書）：2つのボタンを1つの切り替えにする。全体＝終わったものもすべて・候補は畳まない、いま＝今の既定、これから＝着手できる・作業中・止められている・不明だけ。入れ子と木の両方。札の帯・線の切り替え・ボードは変えない。新しい色を足さない。",
	"2026-11-16 統括（msg_237502e135aa）：fit の見える文字を「収める」、title を「画面に収める」にする（決定5のうちこの文字だけを改め、動きは変えない）。切り替えは role=group aria-label「見せる範囲」、title は「見せる範囲：全体（終わったものも、片付けの候補も出す）」の形。",
	"2026-11-16 統括（msg_237502e135aa）：全体のときは片付けの候補の Issue の箱にも枠と同じ印（box の icon、今の色）を付け、凡例を「片付けの候補（全体では箱と枠に印、いまでは畳んで1つに、これからでは出さない）」にする。icon は 全体=layers、いま=clock、これから=sparkle。",
	"2026-11-16 タスク担当：保存は版3（`specdock.graph.v3`）に上げ、鍵 `range` を持つ。版2→版3 は showDone が真なら all、それ以外は now（fold は使わない）。版1→版3 は今の版1→版2 と同じく mode と legend だけ。いまは版2の既定と同じなので、版2の値が新しい既定を隠すことはない。",
	"2026-11-16 タスク担当：これからでは、枠として出た片付けの候補にも印を出さない（凡例の「これからでは出さない」に合わせる）。",
]
