{
  "version": "context-routing-policy-v1",
  "routing_matrix": {
    "docs-only": {
      "worker": "doc-writer",
      "reasoning_effort": "low",
      "context_mode": "minimal_packet",
      "verification": ["docs_inspection"],
      "reviewers": ["spec-reviewer"]
    },
    "runtime": {
      "worker": "dev-coder",
      "reasoning_effort": "medium",
      "context_mode": "recent_fork",
      "verification": ["unit_tests"],
      "reviewers": ["code-reviewer"]
    },
    "migration": {
      "worker": "dev-coder",
      "reasoning_effort": "high",
      "context_mode": "bounded_packet",
      "verification": ["unit_tests", "integration_tests", "rollback_plan"],
      "reviewers": ["code-reviewer", "qa-reviewer"]
    },
    "security-sensitive": {
      "worker": "dev-coder",
      "reasoning_effort": "xhigh",
      "context_mode": "bounded_packet",
      "verification": ["unit_tests", "security_review", "privacy_review"],
      "reviewers": ["code-reviewer", "qa-reviewer", "spec-reviewer"]
    }
  },
  "reviewer_exclusions": [
    "author_self_assessment",
    "implementation_transcript",
    "previous_reviewer_verdict",
    "private_reasoning",
    "raw_full_logs"
  ],
  "consultant_first_pass_exclusions": [
    "author_self_assessment",
    "implementation_transcript",
    "previous_reviewer_verdict",
    "private_reasoning",
    "raw_full_logs",
    "main_recommendation",
    "architect_recommendation"
  ],
  "bounded_return_fields": [
    "summary",
    "changed_files",
    "verification_result",
    "evidence_refs",
    "unresolved_risks",
    "ledger_note"
  ]
}
