{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-dock.local/schemas/context-routing-policy.schema.json",
  "title": "SpecDock Context Routing Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "routing_matrix",
    "reviewer_exclusions",
    "consultant_first_pass_exclusions",
    "bounded_return_fields"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "context-routing-policy-v1"
    },
    "routing_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["docs-only", "runtime", "migration", "security-sensitive"],
      "properties": {
        "docs-only": {
          "$ref": "#/$defs/routingRule"
        },
        "runtime": {
          "$ref": "#/$defs/routingRule"
        },
        "migration": {
          "$ref": "#/$defs/routingRule"
        },
        "security-sensitive": {
          "$ref": "#/$defs/routingRule"
        }
      }
    },
    "reviewer_exclusions": {
      "$ref": "#/$defs/nonEmptyStringList"
    },
    "consultant_first_pass_exclusions": {
      "$ref": "#/$defs/nonEmptyStringList"
    },
    "bounded_return_fields": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "summary",
          "changed_files",
          "verification_result",
          "evidence_refs",
          "unresolved_risks",
          "ledger_note"
        ]
      }
    }
  },
  "$defs": {
    "routingRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worker", "reasoning_effort", "context_mode", "verification", "reviewers"],
      "properties": {
        "worker": {
          "enum": ["dev-coder", "doc-writer"]
        },
        "reasoning_effort": {
          "enum": ["low", "medium", "high", "max"]
        },
        "context_mode": {
          "enum": ["recent_fork", "bounded_packet", "clean_room", "minimal_packet"]
        },
        "verification": {
          "$ref": "#/$defs/nonEmptyStringList"
        },
        "reviewers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["code-reviewer", "qa-reviewer", "spec-reviewer"]
          }
        }
      }
    },
    "nonEmptyStringList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
